# ==========================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG (ENVIRONMENT VARIABLES)
# ==========================================

# 1. Cấu hình Server Node.js
PORT=3000

# 2. Cấu hình Cơ sở dữ liệu (MySQL / TiDB)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_database_password
DB_NAME=quanly_trungtam_ngoaingu

# 3. Bảo mật Session & Google OAuth 2.0
SESSION_SECRET=your_session_secret_key
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# 4. Cấu hình Email gửi thông báo (Nodemailer SMTP)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
ADMIN_EMAIL=admin@example.com
ADMIN_NOTIFY_EMAIL=admin@example.com

# 5. Cấu hình Cổng thanh toán (VietQR / SePay Webhook)
BANK_ID=MB
BANK_NAME=MB NGÂN HÀNG QUÂN ĐỘI
ACCOUNT_NO=0000000000
ACCOUNT_NAME=TRUNG TAM ANH NGU
PAYMENT_TEMPLATE=compact
SEPAY_API_KEY=your_sepay_api_key