<!-- SweetAlert2 -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<!-- Bootstrap 5 JS Bundle with Popper -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
  function combineRegisterAddress() {
    const district = document.getElementById('reg-district')?.value || '';
    const street = document.getElementById('reg-street')?.value || '';
    const hiddenInput = document.getElementById('reg-address-hidden');
    if (!hiddenInput) return;
    if (street && district) {
      hiddenInput.value = `${street.trim()}, ${district.trim()}`;
    } else if (street) {
      hiddenInput.value = street.trim();
    } else {
      hiddenInput.value = district.trim();
    }
  }

  window.addEventListener('DOMContentLoaded', () => {
    const urlParams = new URLSearchParams(window.location.search);
    let triggered = false;

    // Auto-open registration modal if URL query parameter 'register' is '1'
    if (urlParams.get('register') === '1') {
      const registerModalEl = document.getElementById('registerModal');
      if (registerModalEl) {
        const regModal = new bootstrap.Modal(registerModalEl);
        regModal.show();
        triggered = true;
      }
    }

    // Set the hidden redirect input value from URL query parameter
    const redirectVal = urlParams.get('redirect');
    if (redirectVal) {
      const redirectInput = document.getElementById('registerRedirect');
      if (redirectInput) {
        redirectInput.value = redirectVal;
      }
    }

    // Configure SweetAlert2 Toast
    const Toast = Swal.mixin({
      toast: true,
      position: 'top-end',
      showConfirmButton: false,
      timer: 3500,
      timerProgressBar: true,
      didOpen: (toast) => {
        toast.addEventListener('mouseenter', Swal.stopTimer)
        toast.addEventListener('mouseleave', Swal.resumeTimer)
      }
    });

    // Handle success alerts
    if (urlParams.get('register_success') === '1') {
      Toast.fire({
        icon: 'success',
        title: 'Đăng ký tài khoản thành công! Chào mừng bạn.'
      });
      triggered = true;
    } else if (urlParams.has('register_error')) {
      const err = urlParams.get('register_error');
      let msg = 'Đăng ký thất bại! Đã xảy ra lỗi không mong muốn.';
      if (err === 'name') {
        msg = 'Đăng ký thất bại! Họ và tên phải đầy đủ (bao gồm cả Họ và Tên).';
      } else if (err === 'phone') {
        msg = 'Đăng ký thất bại! Số điện thoại không hợp lệ (phải gồm 10 chữ số bắt đầu bằng 0).';
      } else if (err === 'email_format') {
        msg = 'Đăng ký thất bại! Định dạng email không hợp lệ.';
      } else if (err === 'email_exists') {
        msg = 'Đăng ký thất bại! Email đã tồn tại trên hệ thống.';
      } else if (err === 'phone_exists') {
        msg = 'Đăng ký thất bại! Số điện thoại đã tồn tại trên hệ thống.';
      } else if (err === 'otp_invalid') {
        msg = 'Đăng ký thất bại! Mã OTP không chính xác hoặc đã hết hạn.';
      }
      Toast.fire({
        icon: 'error',
        title: msg
      });
      triggered = true;
    } else if (urlParams.get('login_success') === '1') {
      Toast.fire({
        icon: 'success',
        title: 'Đăng nhập thành công! Chào mừng bạn trở lại.'
      });
      triggered = true;
    } else if (urlParams.get('show_register') === '1') {
      const regModalEl = document.getElementById('registerModal');
      if (regModalEl) {
        const modal = new bootstrap.Modal(regModalEl);
        modal.show();
        triggered = true;
      }
      if (urlParams.get('reason') === 'require_register') {
        Toast.fire({
          icon: 'warning',
          title: 'Vui lòng đăng ký tài khoản đầy đủ để tiếp tục.'
        });
      }
    }

    // Remove query parameters from URL without reloading if any were triggered
    if (triggered) {
      const url = new URL(window.location.href);
      url.searchParams.delete('register');
      url.searchParams.delete('register_success');
      url.searchParams.delete('register_error');
      url.searchParams.delete('login_success');
      url.searchParams.delete('logout_success');
      url.searchParams.delete('show_register');
      url.searchParams.delete('reason');
      window.history.replaceState({}, document.title, url.pathname + url.search);
    }

    // Client-side validation for Register Form
    const registerForm = document.getElementById('registerForm');
    if (registerForm) {
      registerForm.addEventListener('submit', (e) => {
        const hoTenInput = registerForm.querySelector('input[name="HoTen"]');
        const sdtInput = registerForm.querySelector('input[name="SoDienThoai"]');
        const emailInput = registerForm.querySelector('input[name="Email"]');

        const hoTen = hoTenInput.value.trim();
        const sdt = sdtInput.value.trim();
        const email = emailInput.value.trim();

        // 1. Validate HoTen (must contain at least 2 words)
        const nameParts = hoTen.split(/\s+/);
        if (nameParts.length < 2 || nameParts[0] === '' || nameParts[1] === '') {
          e.preventDefault();
          Swal.fire({
            icon: 'warning',
            title: 'Họ và tên không hợp lệ',
            text: 'Vui lòng nhập đầy đủ họ tên (ví dụ: Nguyễn Văn A).',
            confirmButtonColor: '#3498db'
          });
          return;
        }

        // 2. Validate SoDienThoai (Vietnamese mobile carrier prefixes: starts with 03, 05, 07, 08, 09, total 10 digits)
        const phoneRegex = /^(03[2-9]|05[2689]|07[06-9]|08[1-9]|09[0-9])[0-9]{7}$/;
        if (!phoneRegex.test(sdt)) {
          e.preventDefault();
          Swal.fire({
            icon: 'warning',
            title: 'Số điện thoại không hợp lệ',
            text: 'Số điện thoại phải thuộc các đầu số nhà mạng Việt Nam (03, 05, 07, 08, 09) và gồm đúng 10 chữ số.',
            confirmButtonColor: '#3498db'
          });
          return;
        }

        // 3. Validate Email Format (strict pattern without consecutive dots or special character errors)
        const emailRegex = /^[a-zA-Z0-9]+(?:\.[a-zA-Z0-9]+)*@[a-zA-Z0-9]+(?:\.[a-zA-Z0-9]+)*\.[a-zA-Z]{2,}$/;
        if (!emailRegex.test(email)) {
          e.preventDefault();
          Swal.fire({
            icon: 'warning',
            title: 'Email không hợp lệ',
            text: 'Vui lòng nhập đúng định dạng email hợp lệ (ví dụ: email@example.com, không chứa ký tự đặc biệt liền nhau).',
            confirmButtonColor: '#3498db'
          });
          return;
        }
      });
    }

    // OTP sending logic for Registration
    const btnSendRegisterOtp = document.getElementById('btnSendRegisterOtp');
    const registerEmailInput = document.getElementById('registerEmail');
    const otpTimerMsg = document.getElementById('otp-timer-msg');

    if (btnSendRegisterOtp) {
      let otpCooldown = 0;
      let otpInterval = null;

      btnSendRegisterOtp.addEventListener('click', async () => {
        const email = registerEmailInput.value.trim();
        const emailRegex = /^[a-zA-Z0-9]+(?:\.[a-zA-Z0-9]+)*@[a-zA-Z0-9]+(?:\.[a-zA-Z0-9]+)*\.[a-zA-Z]{2,}$/;

        if (!email || !emailRegex.test(email)) {
          Swal.fire({
            icon: 'warning',
            title: 'Email không hợp lệ',
            text: 'Vui lòng nhập email chính xác trước khi nhận mã OTP.',
            confirmButtonColor: '#3498db'
          });
          return;
        }

        btnSendRegisterOtp.disabled = true;
        btnSendRegisterOtp.innerText = 'Đang gửi...';

        try {
          const response = await fetch('/auth/register/send-otp', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({ Email: email })
          });
          const result = await response.json();

          if (result.success) {
            Swal.fire({
              icon: 'success',
              title: 'Đã gửi mã OTP',
              text: result.message || 'Mã OTP đã được gửi đến email của bạn. Vui lòng kiểm tra hộp thư.',
              confirmButtonColor: '#2ecc71'
            });

            // Start countdown timer (60s)
            btnSendRegisterOtp.innerText = 'Đã gửi';
            otpCooldown = 60;
            otpTimerMsg.style.display = 'block';
            otpTimerMsg.innerText = `Bạn có thể gửi lại mã sau ${otpCooldown} giây.`;

            otpInterval = setInterval(() => {
              otpCooldown--;
              if (otpCooldown <= 0) {
                clearInterval(otpInterval);
                btnSendRegisterOtp.disabled = false;
                btnSendRegisterOtp.innerText = 'Lấy mã OTP';
                otpTimerMsg.style.display = 'none';
              } else {
                otpTimerMsg.innerText = `Bạn có thể gửi lại mã sau ${otpCooldown} giây.`;
              }
            }, 1000);
          } else {
            Swal.fire({
              icon: 'error',
              title: 'Không thể gửi mã OTP',
              text: result.message || 'Gửi mã OTP thất bại.',
              confirmButtonColor: '#e74c3c'
            });
            btnSendRegisterOtp.disabled = false;
            btnSendRegisterOtp.innerText = 'Lấy mã OTP';
          }
        } catch (error) {
          console.error(error);
          Swal.fire({
            icon: 'error',
            title: 'Lỗi kết nối',
            text: 'Không thể kết nối đến máy chủ. Vui lòng thử lại sau.',
            confirmButtonColor: '#e74c3c'
          });
          btnSendRegisterOtp.disabled = false;
          btnSendRegisterOtp.innerText = 'Lấy mã OTP';
        }
      });
    }

    // Toggle Password Visibility globally
    document.querySelectorAll('.toggle-password').forEach(button => {
      button.addEventListener('click', function () {
        const targetId = this.getAttribute('data-target');
        const input = document.getElementById(targetId);
        if (input) {
          if (input.type === 'password') {
            input.type = 'text';
            this.innerHTML = `
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-eye-slash" viewBox="0 0 16 16">
                <path d="M13.359 11.238C15.06 9.72 16 8 16 8s-3-5.5-8-5.5a18.883 18.883 0 0 0-2.79.24l.85 1.017c.622-.099 1.29-.15 1.94-.15 4.108 0 7.424 3.61 8.28 4.542-.18.195-.44.472-.73.755l.86 1.026zM7.4 4.51c-.812-.046-1.577.194-2.228.6l1.203 1.44a2.5 2.5 0 0 1 1.025-2.042zM15.502 1.94a.5.5 0 0 1 0 .706L14.459 3.69l-2 2L3.502 14.646a.5.5 0 0 1-.707 0l-1-1a.5.5 0 0 1 0-.707l1.043-1.043 2-2L12.498 2.94a.5.5 0 0 1 .707 0l2 2a.5.5 0 0 1 0 .707zm-1.899 3.82l-1.95-1.95L3.502 11.95l1.95 1.95 8.15-8.14zM8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0z"/>
              </svg>
            `;
          } else {
            input.type = 'password';
            this.innerHTML = `
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-eye" viewBox="0 0 16 16">
                <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5s3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5s-3.879-1.168-5.168-2.457A13 13 0 0 1 1.172 8z"/>
                <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0"/>
              </svg>
            `;
          }
        }
      });
    });

    // Intercept native browser confirm popups in form submissions and clicks,
    // converting them to polished SweetAlert2 modals.

    // Find all forms that have an inline onsubmit with confirm()
    document.querySelectorAll('form[onsubmit*="confirm("]').forEach(form => {
      const onsubmitStr = form.getAttribute('onsubmit');
      const match = onsubmitStr.match(/confirm\(['"](.*?)['"]\)/);
      if (match && match[1]) {
        form.setAttribute('data-confirm', match[1]);
        form.removeAttribute('onsubmit');
      }
    });

    // Find all elements that have an inline onclick with confirm()
    document.querySelectorAll('[onclick*="confirm("]').forEach(el => {
      const onclickStr = el.getAttribute('onclick');
      const match = onclickStr.match(/confirm\(['"](.*?)['"]\)/);
      if (match && match[1]) {
        el.setAttribute('data-confirm-click', match[1]);
        el.removeAttribute('onclick');
      }
    });

    // Global event listener to intercept ANY form submit with confirm()
    document.addEventListener('submit', function (e) {
      const form = e.target;
      if (!form) return;
      
      const onsubmitAttr = form.getAttribute('onsubmit');
      if (form.hasAttribute('data-confirm')) {
        e.preventDefault();
        e.stopPropagation();
        const message = form.getAttribute('data-confirm');
        Swal.fire({
          title: 'Xác nhận hành động',
          text: message,
          icon: 'warning',
          showCancelButton: true,
          confirmButtonColor: '#3085d6',
          cancelButtonColor: '#6c757d',
          confirmButtonText: 'Đồng ý',
          cancelButtonText: 'Hủy'
        }).then((result) => {
          if (result.isConfirmed) {
            form.removeAttribute('data-confirm');
            form.submit();
          }
        });
      } else if (onsubmitAttr && onsubmitAttr.includes('confirm(')) {
        e.preventDefault();
        e.stopPropagation();
        const match = onsubmitAttr.match(/confirm\s*\(\s*['"`](.*?)['"`]\s*\)/);
        const message = match ? match[1] : 'Bạn có chắc chắn muốn thực hiện thao tác này không?';
        Swal.fire({
          title: 'Xác nhận hành động',
          text: message,
          icon: 'warning',
          showCancelButton: true,
          confirmButtonColor: '#3085d6',
          cancelButtonColor: '#6c757d',
          confirmButtonText: 'Đồng ý',
          cancelButtonText: 'Hủy'
        }).then((result) => {
          if (result.isConfirmed) {
            form.removeAttribute('onsubmit');
            form.submit();
          }
        });
      }
    }, true);

    // Listen to click events globally to intercept elements with data-confirm-click or inline confirm
    document.addEventListener('click', function (e) {
      const target = e.target ? e.target.closest('[data-confirm-click], [onclick*="confirm("]') : null;
      if (!target) return;

      const onclickAttr = target.getAttribute('onclick');
      if (target.hasAttribute('data-confirm-click')) {
        e.preventDefault();
        e.stopPropagation();
        const message = target.getAttribute('data-confirm-click');
        Swal.fire({
          title: 'Xác nhận hành động',
          text: message,
          icon: 'warning',
          showCancelButton: true,
          confirmButtonColor: '#3085d6',
          cancelButtonColor: '#6c757d',
          confirmButtonText: 'Đồng ý',
          cancelButtonText: 'Hủy'
        }).then((result) => {
          if (result.isConfirmed) {
            if (target.type === 'submit' || target.closest('form')) {
              const form = target.closest('form');
              if (form) {
                form.removeAttribute('data-confirm');
                form.submit();
              }
            } else if (target.tagName === 'A') {
              window.location.href = target.href;
            }
          }
        });
      } else if (onclickAttr && onclickAttr.includes('confirm(') && !target.hasAttribute('data-confirm-handled')) {
        const match = onclickAttr.match(/confirm\s*\(\s*['"`](.*?)['"`]\s*\)/);
        if (match && match[1]) {
          e.preventDefault();
          e.stopPropagation();
          const message = match[1];
          Swal.fire({
            title: 'Xác nhận hành động',
            text: message,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'Đồng ý',
            cancelButtonText: 'Hủy'
          }).then((result) => {
            if (result.isConfirmed) {
              target.setAttribute('data-confirm-handled', 'true');
              target.removeAttribute('onclick');
              target.click();
            }
          });
        }
      }
    }, true);
  });
</script>
</body>

</html>