        </div>
        <a href="/exams/placement" 
           onclick="checkPlacementTest(event, <%= user ? 'true' : 'false' %>)" 
           class="btn btn-warning fw-bold w-100 py-2.5 rounded-3 shadow">
          Thi thử đầu vào
        </a>
      </div>
    </div>

    <!-- Card 2: Practice Exams -->
    <div class="col-md-4">
      <div class="sidebar-card p-4 text-center h-100 d-flex flex-column justify-content-between">
        <div>
          <h5 class="fw-bold text-dark mb-3"><i class="bi bi-journal-check me-2 text-primary"></i>Luyện đề thi thử</h5>
          <p class="small text-secondary mb-4">Kho đề thi thử TOEIC chuẩn cấu trúc IIG kèm giải thích chi tiết đáp án giúp bạn rèn luyện phản xạ.</p>
        </div>
        <a href="/exams/free" class="btn btn-primary fw-bold w-100 py-2.5 rounded-3 shadow-sm">
          Luyện đề miễn phí
        </a>
      </div>
    </div>

    <!-- Card 3: Related News -->
    <div class="col-md-4">
      <div class="sidebar-card p-4 h-100">
        <h5 class="fw-bold text-dark mb-3 border-bottom pb-2">Tin tức liên quan</h5>
        <div class="d-flex flex-column gap-3 text-start">
          
          <a href="/format-toeic" class="text-decoration-none text-dark d-flex gap-2">
            <div class="rounded overflow-hidden" style="width: 70px; height: 50px; flex-shrink: 0;">
              <img src="/images/Cap_Nhat_Fomat.png" class="w-100 h-100 object-fit-cover" alt="Format" />
            </div>
            <div>
              <h6 class="small fw-bold mb-1 line-clamp-2" style="font-size: 0.85rem; line-height: 1.3;">Cấu trúc đề thi TOEIC mới nhất năm 2026</h6>
              <span class="text-muted" style="font-size: 0.75rem;"><i class="bi bi-calendar3 me-1"></i>Mới nhất</span>
            </div>
          </a>

          <a href="/meo-toeic-listening" class="text-decoration-none text-dark d-flex gap-2">
            <div class="rounded overflow-hidden" style="width: 70px; height: 50px; flex-shrink: 0;">
              <img src="/images/Meo copy.png" class="w-100 h-100 object-fit-cover" alt="Mẹo nghe" />
            </div>
            <div>
              <h6 class="small fw-bold mb-1 line-clamp-2" style="font-size: 0.85rem; line-height: 1.3;">Mẹo làm bài Toeic Listening bứt phá điểm số</h6>
              <span class="text-muted" style="font-size: 0.75rem;"><i class="bi bi-calendar3 me-1"></i>Hot</span>
            </div>
          </a>

        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Web Speech synthesis for word pronunciation
  function speakText(text) {
    if ('speechSynthesis' in window) {
      window.speechSynthesis.cancel();
      // Clean up punctuation text for clean voiceover
      const cleanText = text.replace(/\+/g, ' plus ').replace(/\//g, ' or ').split('(')[0].trim();
      const utterance = new SpeechSynthesisUtterance(cleanText);
      utterance.lang = 'en-US';
      utterance.rate = 0.85; 
      window.speechSynthesis.speak(utterance);
    } else {
      Swal.fire({
        icon: 'warning',
        title: 'Không hỗ trợ âm thanh',
        text: 'Trình duyệt của bạn không hỗ trợ phát âm thanh trực tiếp.',
        confirmButtonText: 'Đồng ý',
        confirmButtonColor: '#3498db'
      });
    }
  }

  // Live filter search for vocabulary rows
  document.addEventListener('DOMContentLoaded', function() {
    const searchInput = document.getElementById('vocabSearch');
    const tableRows = document.querySelectorAll('.vocab-row');
    const countDisplay = document.getElementById('vocabCount');

    function filterVocab() {
      const query = searchInput.value.toLowerCase().trim();
      let visibleCount = 0;
      
      tableRows.forEach(row => {
        const textContent = row.textContent.toLowerCase();
        if (textContent.includes(query)) {
          row.style.setProperty('display', '', 'important');
          visibleCount++;
        } else {
          row.style.setProperty('display', 'none', 'important');
        }
      });

      countDisplay.textContent = visibleCount;
    }

    searchInput.addEventListener('input', filterVocab);

    // Refresh count on tab change
    const tabButtons = document.querySelectorAll('#vocabTabs button');
    tabButtons.forEach(btn => {
      btn.addEventListener('shown.bs.tab', function(e) {
        // Recalculate visible rows in the newly active tab pane
        const activePaneId = e.target.getAttribute('data-bs-target');
        const activePane = document.querySelector(activePaneId);
        const activeRows = activePane.querySelectorAll('.vocab-row');
        
        let visibleCount = 0;
        activeRows.forEach(row => {
          if (row.style.display !== 'none') {
            visibleCount++;
          }
        });
        countDisplay.textContent = visibleCount;
      });
    });

    // Initial count for active tab
    const initialRows = document.querySelectorAll('#tab1 .vocab-row');
    countDisplay.textContent = initialRows.length;
  });
</script>

