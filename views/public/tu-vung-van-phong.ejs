  <!-- Bottom Action Cards Section -->
  <div class="row g-4 mt-4">
    <!-- Card 1: Placement Test -->
    <div class="col-md-4">
      <div class="sidebar-card p-4 text-center border-0 h-100 d-flex flex-column justify-content-between" style="background: linear-gradient(135deg, #1a252f, #2c3e50); color: white;">
        <div>
          <h5 class="fw-bold mb-3"><i class="bi bi-pencil-square me-2 text-warning"></i>Đánh giá năng lực</h5>
