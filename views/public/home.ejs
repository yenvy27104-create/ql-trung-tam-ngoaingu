<script>
  let currentProgram = null;
  let courseBsModal = null;
  let teacherBsModal = null;

  function cleanClassName(name) {
    if (name.includes('Foundation A')) return 'Lớp Foundation A';
    if (name.includes('Foundation B')) return 'Lớp Foundation B';
    if (name.includes('Foundation C')) return 'Lớp Foundation C';
    if (name.includes('450+ - Lớp A') || name.includes('450A')) return 'Lớp 450A';
    if (name.includes('450+ - Lớp B') || name.includes('450B')) return 'Lớp 450B';
    if (name.includes('450+ - Lớp C') || name.includes('450C')) return 'Lớp 450C';
    if (name.includes('650+ - Lớp A') || name.includes('650A')) return 'Lớp 650A';
    if (name.includes('650+ - Lớp B') || name.includes('650B')) return 'Lớp 650B';
    return name;
  }

  function openProgramModal(element) {
    // 1. Lấy dữ liệu dbCourses (Chỉ khai báo 1 lần duy nhất ở đây)
    const dbCourses = JSON.parse(element.dataset.classes || '[]');
    
    let calculatedFee = element.dataset.hocphi;
    if (dbCourses && dbCourses.length > 0 && dbCourses[0].HocPhi !== null && dbCourses[0].HocPhi !== undefined) {
      calculatedFee = Number(dbCourses[0].HocPhi).toLocaleString('vi-VN');
    }

    let currentProgram = {
      ten: element.dataset.ten,
      mota: element.dataset.mota,
      thoiluong: element.dataset.thoiluong,
      hocphi: calculatedFee,
      capdo: element.dataset.capdo
    };

    document.getElementById('modalTen').innerText = currentProgram.ten;
    document.getElementById('modalMoTa').innerText = currentProgram.mota;
    document.getElementById('modalThoiLuong').innerText = currentProgram.thoiluong;
    document.getElementById('modalHocPhi').innerText = currentProgram.hocphi;
    document.getElementById('modalCapDo').innerText = currentProgram.capdo;

    // Render classes from course objects
    const classesListContainer = document.getElementById('modalClassesList');
    classesListContainer.innerHTML = '';
    
    if (dbCourses.length === 0) {
      classesListContainer.innerHTML = `
        <div class="alert alert-warning py-3 small mb-0">
          Hiện tại chưa có lớp học nào mở cho chương trình này. Vui lòng liên hệ trung tâm để nhận lịch học mới nhất.
        </div>
      `;
    } else {
      dbCourses.forEach(kh => {
        const cleanName = typeof cleanClassName === 'function' ? cleanClassName(kh.TenKhoaHoc) : kh.TenKhoaHoc;
        const subClassItem = document.createElement('div');
        subClassItem.className = 'border rounded-4 p-4 mb-4 bg-light shadow-sm';
        
        let schedulesHtml = '';
        if (kh.classes && kh.classes.length > 0) {
          kh.classes.forEach(cls => {
            const getLocalDateStr = (d) => {
              if (!d) return '';
              if (typeof d === 'string') return d.split('T')[0];
              const dt = new Date(d);
              const year = dt.getFullYear();
              const month = String(dt.getMonth() + 1).padStart(2, '0');
              const day = String(dt.getDate()).padStart(2, '0');
              return `${year}-${month}-${day}`;
            };
            const todayStr = getLocalDateStr(new Date());
            const classStartStr = getLocalDateStr(cls.NgayKhaiGiang);
            const isPast = classStartStr && classStartStr <= todayStr;

            if (isPast) {
              cls.TrangThaiLop = 'Đã khai giảng';
            }

            const startDate = cls.NgayKhaiGiang ? new Date(cls.NgayKhaiGiang).toLocaleDateString('vi-VN') : 'Đang cập nhật';
            const spotsLeft = cls.SiSoToiDa - (cls.SiSoHienTai || 0);
            const isFull = spotsLeft <= 0;

            const isSapMo = (cls.TrangThaiLop === 'Sắp mở' || cls.TrangThaiLop === 'Đang mở') && !isPast;
            const isDangDienRa = cls.TrangThaiLop === 'Đang diễn ra';

            let displayStatus = cls.TrangThaiLop;
            let displayBadgeClass = 'bg-secondary text-white';

            if (isSapMo || cls.TrangThaiLop === 'Đang mở') {
              if (isFull) {
                displayStatus = 'Hết chỗ';
                displayBadgeClass = 'bg-danger text-white';
              } else {
                displayStatus = `Còn chỗ (Còn ${spotsLeft} chỗ)`;
                displayBadgeClass = 'bg-success text-white';
              }
            } else if (isDangDienRa) {
              displayBadgeClass = 'bg-info text-white';
            }
            
            let enrollButton;
            if (isSapMo) {
              if (isFull) {
                enrollButton = `<button class="btn btn-outline-danger px-3 py-2 fw-bold" disabled>Lớp đã đầy</button>`;
              } else {
                enrollButton = `<div class="d-flex gap-2">
                   <button class="btn btn-outline-primary px-3 py-2" onclick="addtoCartHandler(${cls.MaLopHoc}, '${cls.TenLop}')" title="Thêm vào giỏ hàng"><i class="bi bi-cart-plus fs-5"></i></button>
                   <button class="btn btn-primary px-4 py-2 fw-bold shadow-sm" onclick="enrollInClass(${cls.MaLopHoc}, '${cls.TenLop}', ${kh.MaKhoaHoc})">Đăng ký lớp</button>
                   </div>`;
              }
            } else if (isDangDienRa) {
              enrollButton = `<span class="badge bg-info-subtle text-info px-3 py-2 fw-bold fs-6"><i class="bi bi-play-circle me-1"></i>Đang diễn ra</span>`;
            } else {
              enrollButton = `<button class="btn btn-outline-secondary px-3 py-2 fw-bold" disabled>Đã khai giảng</button>`;
            }

            const endDate = cls.NgayKetThuc ? new Date(cls.NgayKetThuc).toLocaleDateString('vi-VN') : '';
            const durationText = endDate ? `Từ ${startDate} đến ${endDate}` : `Khai giảng: ${startDate}`;

            const loaiLopBadge = cls.LoaiLop === 'Cấp tốc' 
              ? `<span class="badge bg-danger text-white rounded-pill px-2.5 py-1 fw-bold" style="font-size: 0.78rem;"><i class="bi bi-lightning-charge-fill me-1"></i>🔥 Cấp tốc (1 tháng)</span>`
              : `<span class="badge bg-secondary-subtle text-secondary rounded-pill px-2.5 py-1 fw-semibold" style="font-size: 0.78rem;"><i class="bi bi-clock me-1"></i>Tiêu chuẩn (2-3 tháng)</span>`;

            const classFeeText = Number(cls.HocPhi || kh.HocPhi).toLocaleString('vi-VN');

            schedulesHtml += `
              <div class="d-flex flex-wrap align-items-center justify-content-between p-3.5 mt-3 bg-white rounded-3 border border-light-subtle shadow-sm gap-3">
                <div class="flex-grow-1">
                  <div class="d-flex align-items-center gap-2 mb-2.5 flex-wrap">
                    <span class="fw-bold text-dark fs-5 me-1">${cls.TenLop}</span>
                    ${loaiLopBadge}
                    <span class="badge ${displayBadgeClass} px-3 py-1.5 rounded-pill fw-semibold" style="font-size: 0.78rem;">${displayStatus}</span>
                    <span class="badge bg-light text-success border border-success-subtle px-3 py-1.5 rounded-pill fw-bold" style="font-size: 0.78rem;"><i class="bi bi-tag-fill me-1"></i>${classFeeText} VNĐ</span>
                  </div>
                  
                  <div class="d-flex flex-wrap gap-4 text-muted small mt-2">
                    <div class="d-flex align-items-center gap-2">
                      <div class="bg-primary-subtle p-2 rounded-3 text-primary"><i class="bi bi-calendar-range fs-6"></i></div>
                      <div>
                        <span class="d-block text-secondary small">Thời gian học (Kéo dài)</span>
                        <strong class="text-dark">${durationText}</strong>
                      </div>
                    </div>
                    
                    <div class="d-flex align-items-center gap-2">
                      <div class="bg-success-subtle p-2 rounded-3 text-success"><i class="bi bi-journal-check fs-6"></i></div>
                      <div>
                        <span class="d-block text-secondary small">Tổng số buổi</span>
                        <strong class="text-success fs-6">${kh.ThoiLuong || 30} buổi học</strong>
                      </div>
                    </div>
                    
                    <div class="d-flex align-items-center gap-2">
                      <div class="bg-info-subtle p-2 rounded-3 text-info"><i class="bi bi-clock fs-6"></i></div>
                      <div>
                        <span class="d-block text-secondary small">Lịch học cố định</span>
                        <strong class="text-dark">${cls.LichHoc || 'Chưa có lịch'}</strong>
                      </div>
                    </div>
                    
                    <div class="d-flex align-items-center gap-2">
                      <div class="bg-warning-subtle p-2 rounded-3 text-warning"><i class="bi bi-people fs-6"></i></div>
                      <div>
                        <span class="d-block text-secondary small">Sĩ số</span>
                        <strong class="text-dark">${cls.SiSoHienTai || 0} / ${cls.SiSoToiDa} học viên</strong>
                      </div>
                    </div>
                  </div>
                </div>
                <div>
                  ${enrollButton}
                </div>
              </div>
            `;
          });
        } else {
          schedulesHtml = `
            <div class="text-muted fs-6 mt-3 ps-2">
              <i class="bi bi-info-circle me-2 text-warning"></i>Hiện tại chưa có lịch khai giảng mới cho khóa học này.
            </div>
          `;
        }

        subClassItem.innerHTML = `
          <div class="d-flex justify-content-between align-items-center pb-2 border-bottom border-secondary-subtle">
            <h5 class="fw-bold mb-0 text-primary fs-5">${cleanName}</h5>
            <span class="text-success fw-bold fs-5">${Number(kh.HocPhi).toLocaleString('vi-VN')} VNĐ</span>
          </div>
          <div class="text-secondary fs-6 my-3 bg-white p-3 rounded-3 border border-light-subtle" style="line-height: 1.6;">
            <i class="bi bi-info-circle text-primary me-2 fs-6"></i>${kh.MoTa || 'Chi tiết nội dung giảng dạy đang được cập nhật.'}
          </div>
          ${schedulesHtml}
        `;
        classesListContainer.appendChild(subClassItem);
      });

      const firstCourseId = dbCourses.length > 0 ? dbCourses[0].MaKhoaHoc : 1;
      if (typeof loadCourseSyllabus === 'function') {
        loadCourseSyllabus(firstCourseId);
      }
    }
    
    // Đảm bảo biến courseBsModal đã được khởi tạo trước đó
    if (typeof courseBsModal !== 'undefined') {
      courseBsModal.show();
    } else {
      // Khởi tạo nếu chưa có
      const modalEl = document.getElementById('courseModal');
      if (modalEl) {
        const modal = new bootstrap.Modal(modalEl);
        modal.show();
      }
    }
}

  async function loadCourseSyllabus(courseId) {
    const container = document.getElementById('modalSyllabusContainer');
    if (!container) return;
    container.innerHTML = '<div class="text-center py-4"><div class="spinner-border text-primary" role="status"></div><p class="mt-2 text-muted">Đang tải đề cương chi tiết...</p></div>';
    try {
      const res = await fetch(`/courses/syllabus/${courseId}`);
      const data = await res.json();
      if (data.success && data.syllabus && data.syllabus.length > 0) {
        let metaHtml = '';
        if (data.meta) {
          metaHtml = `
            <div class="card border-0 bg-light rounded-3 mb-4 shadow-sm">
              <div class="card-body p-4">
                <div class="row g-3">
                  <div class="col-md-6">
                    <div class="d-flex align-items-start gap-2 mb-2.5">
                      <i class="bi bi-person-badge-fill text-primary fs-5"></i>
                      <div>
                        <strong class="text-dark">Đối tượng đầu vào:</strong> <span class="text-secondary d-block mt-0.5">${data.meta.inputLevel}</span>
                      </div>
                    </div>
                    <div class="d-flex align-items-start gap-2 mb-2.5">
                      <i class="bi bi-headset text-success fs-5"></i>
                      <div>
                        <strong class="text-dark">Dịch vụ bổ trợ:</strong> <span class="text-secondary d-block mt-0.5">${data.meta.services}</span>
                      </div>
                    </div>
                    <div class="d-flex align-items-start gap-2">
                      <i class="bi bi-clipboard-check-fill text-warning fs-5"></i>
                      <div>
                        <strong class="text-dark">Kiểm tra đánh giá:</strong> <span class="text-secondary d-block mt-0.5">${data.meta.tests}</span>
                      </div>
                    </div>
                  </div>
                  <div class="col-md-6">
                    <div class="bg-white p-3.5 rounded-3 border">
                      <h6 class="fw-bold text-dark mb-2.5"><i class="bi bi-book-half text-danger me-2"></i>Trọng tâm kiến thức chính (Listening & Reading)</h6>
                      <ul class="list-unstyled mb-0 small text-secondary" style="line-height: 1.6;">
                        <li class="mb-2"><strong class="text-dark">🗣️ Ngữ âm:</strong> ${data.meta.phonetics}</li>
                        <li class="mb-2"><strong class="text-dark">📖 Từ vựng:</strong> ${data.meta.vocabulary}</li>
                        <li><strong class="text-dark">📝 Ngữ pháp:</strong> ${data.meta.grammar}</li>
                      </ul>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          `;
        }

        let rowsHtml = '';
        data.syllabus.forEach(item => {
          let skillBadge = 'bg-primary-subtle text-primary';
          if (item.type.includes('Listening')) skillBadge = 'bg-info-subtle text-info-emphasis';
          else if (item.type.includes('Reading')) skillBadge = 'bg-success-subtle text-success';
          else if (item.type.includes('Exam') || item.type.includes('Test') || item.type.includes('PROGRESS')) skillBadge = 'bg-danger text-white';

          let testBadge = item.test ? `<span class="badge bg-warning-subtle text-dark border border-warning fw-bold"><i class="bi bi-pencil-square me-1"></i>${item.test}</span>` : '<span class="text-muted small">--</span>';

          rowsHtml += `
            <tr>
              <td class="fw-bold text-center" style="width: 100px;">Buổi ${item.session}</td>
              <td style="width: 150px;"><span class="badge ${skillBadge} px-2.5 py-1 fw-semibold">${item.type}</span></td>
              <td class="fw-semibold text-dark">${item.content}</td>
              <td class="text-center" style="width: 160px;">${testBadge}</td>
            </tr>
          `;
        });

        container.innerHTML = `
          ${metaHtml}
          <div class="table-responsive rounded-3 border">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-dark">
                <tr>
                  <th class="text-center">Buổi học</th>
                  <th>Kỹ năng / Chủ đề</th>
                  <th>Nội dung chi tiết</th>
                  <th class="text-center">Bài kiểm tra / Đánh giá</th>
                </tr>
              </thead>
              <tbody>
                ${rowsHtml}
              </tbody>
            </table>
          </div>
        `;
      } else {
        container.innerHTML = '<div class="alert alert-warning">Chưa có thông tin đề cương chi tiết cho khóa học này.</div>';
      }
    } catch (err) {
      container.innerHTML = '<div class="alert alert-warning">Không thể tải đề cương chi tiết.</div>';
    }
  }

  function addtoCartHandler(classId, className) {
    const isLoggedIn = <%= user ? 'true' : 'false' %>;
    const isGoogleGuest = <%= user && user.isGoogleGuest ? 'true' : 'false' %>;
    const userRole = '<%= user ? user.TenVaiTro : "null" %>';

    if (!isLoggedIn) {
      Swal.fire({
        icon: 'info',
        title: 'Yêu cầu tài khoản',
        text: `Vui lòng đăng nhập hoặc đăng ký tài khoản để thêm lớp ${className} vào giỏ hàng.`,
        showCancelButton: true,
        confirmButtonText: 'Đăng nhập / Đăng ký',
        cancelButtonText: 'Hủy',
        confirmButtonColor: '#3498db'
      }).then((result) => {
        if (result.isConfirmed) {
          window.location.href = `/login?redirect=/`;
        }
      });
      return;
    }

    if (isGoogleGuest) {
      Swal.fire({
        icon: 'warning',
        title: 'Yêu cầu đăng ký tài khoản',
        text: 'Tài khoản Google của bạn chưa hoàn tất đăng ký thông tin học viên. Vui lòng đăng ký tài khoản trước khi đăng ký lớp học.',
        showCancelButton: true,
        confirmButtonText: 'Đăng ký ngay',
        cancelButtonText: 'Hủy',
        confirmButtonColor: '#3498db'
      }).then((result) => {
        if (result.isConfirmed) {
          window.location.href = '/register';
        }
      });
      return;
    }

    if (userRole !== 'Học viên') {
      Swal.fire({
        icon: 'warning',
        title: 'Thông báo',
        text: 'Chỉ tài khoản học viên mới được thêm lớp học vào giỏ hàng.',
        confirmButtonText: 'Đồng ý',
        confirmButtonColor: '#3498db'
      });
      return;
    }

    const processHomeCartResult = (data, isDirectEnroll = false) => {
      if (data.requireInputWarning) {
        const displayTitle = data.className || className || 'lớp học';
        const checkboxText = data.confirmCheckboxText || `Tôi xác nhận đã đọc kỹ yêu cầu đầu vào của lớp ${displayTitle} và tự chịu trách nhiệm về lựa chọn này.`;

        Swal.fire({
          icon: 'warning',
          title: 'Cảnh báo điều kiện đầu vào',
          html: `
            <div class="text-start p-1">
              <div class="alert alert-warning border-warning rounded-3 mb-3 p-3" style="background-color: #fff3cd; color: #664d03;">
                <div class="fw-bold mb-1"><i class="bi bi-exclamation-triangle-fill text-warning me-2 fs-5"></i>Lưu ý điều kiện đầu vào:</div>
                <div class="small" style="line-height: 1.5;">
                  Hệ thống ghi nhận học viên <strong>chưa làm Bài Test đầu vào</strong> hoặc <strong>chưa học Khóa học tiền đề</strong> (Pre-TOEIC / Cơ bản) trước khi đăng ký lớp <strong>"${displayTitle}"</strong>.
                </div>
              </div>
              <div class="form-check p-3 bg-light rounded-3 border border-secondary-subtle">
                <input class="form-check-input ms-0 me-2" type="checkbox" id="inputConditionCheckboxHome" style="cursor: pointer; width: 1.2em; height: 1.2em;">
                <label class="form-check-label fw-semibold text-dark small" for="inputConditionCheckboxHome" style="cursor: pointer; user-select: none;">
                  ${checkboxText}
                </label>
              </div>
            </div>
          `,
          showCancelButton: true,
          confirmButtonText: '<i class="bi bi-check-circle-fill me-1"></i>Xác nhận & Đăng ký',
          cancelButtonText: 'Hủy',
          confirmButtonColor: '#f39c12',
          cancelButtonColor: '#6c757d',
          focusConfirm: false,
          preConfirm: () => {
            const chk = document.getElementById('inputConditionCheckboxHome');
            if (!chk || !chk.checked) {
              Swal.showValidationMessage('Vui lòng tích chọn xác nhận đã đọc kỹ yêu cầu đầu vào trước khi tiếp tục!');
              return false;
            }
            return true;
          }
        }).then((warnRes) => {
          if (warnRes.isConfirmed) {
            fetch('/courses/cart/add', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ MaLopHoc: classId, confirmedInputWarning: true })
            })
            .then(res => res.json())
            .then(resData => processHomeCartResult(resData, isDirectEnroll))
            .catch(err => {
              console.error(err);
              Swal.fire({ icon: 'error', title: 'Lỗi', text: 'Có lỗi xảy ra khi thêm vào giỏ hàng.' });
            });
          }
        });
        return;
      }

      if (data.success) {
        if (isDirectEnroll) {
          window.location.href = '/courses/cart';
        } else {
          const badge = document.getElementById('header-cart-badge');
          if (badge) {
            badge.innerText = data.cartCount;
            badge.classList.remove('d-none');
          }
          Swal.fire({
            icon: 'success',
            title: 'Thêm vào giỏ hàng thành công!',
            text: `Đã thêm lớp học "${className}" vào giỏ hàng. Bạn có muốn đến giỏ hàng ngay không?`,
            showCancelButton: true,
            confirmButtonText: 'Đến giỏ hàng',
            cancelButtonText: 'Hủy',
            confirmButtonColor: '#28a745',
            cancelButtonColor: '#6c757d'
          }).then((navRes) => {
            if (navRes.isConfirmed) {
              window.location.href = '/courses/cart';
            }
          });
        }
      } else {
        Swal.fire({
          icon: 'info',
          title: 'Thông báo',
          text: data.message || `Lớp học "${className}" đã có trong giỏ hàng. Bạn có muốn đến giỏ hàng không?`,
          showCancelButton: true,
          confirmButtonText: 'Đến giỏ hàng',
          cancelButtonText: 'Hủy',
          confirmButtonColor: '#3498db',
          cancelButtonColor: '#6c757d'
        }).then((navRes) => {
          if (navRes.isConfirmed) {
            window.location.href = '/courses/cart';
          }
        });
      }
    };

    fetch('/courses/cart/add', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ MaLopHoc: classId })
    })
    .then(res => res.json())
    .then(data => processHomeCartResult(data, false))
    .catch(err => {
      console.error(err);
      Swal.fire({
        icon: 'error',
        title: 'Lỗi',
        text: 'Đã xảy ra lỗi khi thêm vào giỏ hàng.',
        confirmButtonText: 'Đồng ý',
        confirmButtonColor: '#e74c3c'
      });
    });
  }

