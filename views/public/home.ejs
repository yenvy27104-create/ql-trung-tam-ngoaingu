<%- include('../layouts/header') %>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Comfortaa:wght@700&family=Outfit:wght@900&family=Pacifico&family=Great+Vibes&display=swap');
  
  /* Top Banner */
  .banner-container {
    width: 100%;
    overflow: hidden;
    border-bottom: 5px solid var(--accent-color);
  }
  .banner-container img {
    width: 100%;
    height: auto;
    display: block;
  }
  
  /* Intro Stats Custom */
  .stat-card-custom {
    background: #e8f4fd;
    border-radius: 16px;
    padding: 40px 20px;
    text-align: center;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.04);
    border: 1px solid rgba(52, 152, 219, 0.08);
    transition: all 0.3s ease;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }
  .stat-card-custom:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 30px rgba(52, 152, 219, 0.12);
  }
  .stat-number {
    font-size: 2.8rem;
    font-weight: 800;
    color: #ff0000;
    margin-bottom: 10px;
    line-height: 1.1;
  }
  .stat-label {
    font-size: 1.1rem;
    font-weight: 600;
    color: #2c3e50;
  }
  
  
  /* Course Grid Items */
  .course-item {
    background: #ffffff;
    border-radius: 12px;
    border: 1px solid #eef2f5;
    padding: 25px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.02);
    cursor: pointer;
    transition: all 0.3s;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .course-item:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 25px rgba(52, 152, 219, 0.15);
    border-color: var(--accent-color);
  }
  
  /* News & Promotions Cards */
  .custom-card {
    border: none;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 15px rgba(0,0,0,0.02);
    transition: all 0.3s;
    background: #fff;
  }
  .custom-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 25px rgba(0,0,0,0.08);
  }
  .custom-card img {
    width: 100%;
    height: auto;
    display: block;
  }
  
  /* Staff Cards */
  .staff-card {
    background: #ffffff;
    border-radius: 16px;
    transition: all 0.3s ease;
    border: 1px solid rgba(0, 0, 0, 0.03);
  }
  .staff-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 15px 35px rgba(52, 152, 219, 0.12);
  }
  .avatar-wrapper {
    width: 110px;
    height: 110px;
    position: relative;
    border-radius: 50%;
    background: linear-gradient(135deg, #3498db, #1a252f);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .staff-avatar {
    width: 100px;
    height: 100px;
    object-fit: cover;
    border: 3px solid #000080;
    border-radius: 50%;
  }
  .staff-avatar-placeholder {
    width: 100px;
    height: 100px;
    border: 3px solid #000080;
    background: linear-gradient(135deg, #3498db, #2c3e50);
    letter-spacing: 1px;
  }
  .staff-info {
    background: rgba(248, 249, 250, 0.7);
    padding: 15px;
    border-radius: 12px;
    border: 1px solid #f1f3f5;
  }

  /* Teacher Poster Card Styles */
  .teacher-poster-card {
    background: #ffffff;
    border-radius: 20px;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.08);
    border: 1px solid #eef2f5;
    overflow: hidden;
    position: relative;
    padding: 30px 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all 0.3s ease;
    min-height: 380px;
  }
  .teacher-poster-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.12);
  }
  .teacher-poster-card::before {
    content: "";
    position: absolute;
    top: -90px;
    right: -90px;
    width: 220px;
    height: 220px;
    background: radial-gradient(circle, #e74c3c 60%, #c0392b 100%);
    border-radius: 50%;
    z-index: 1;
  }
  .teacher-poster-card::after {
    content: "";
    position: absolute;
    top: 115px;
    right: 115px;
    width: 10px;
    height: 10px;
    background: #ffffff;
    border-radius: 50%;
    z-index: 2;
    box-shadow: 0 0 0 8px rgba(255, 255, 255, 0.2);
  }
  .poster-logo {
    position: absolute;
    top: 20px;
    right: 20px;
    z-index: 3;
    color: #ffffff;
    font-family: 'Great Vibes', cursive;
    font-size: 1.8rem;
    font-weight: normal;
    text-align: right;
    line-height: 0.95;
    transform: rotate(-3deg);
    text-shadow: 1px 1px 3px rgba(0,0,0,0.3);
  }
  .poster-content-layout {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 20px;
    height: 100%;
    z-index: 2;
    position: relative;
    align-items: center;
  }
  .poster-left-col {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }
  .poster-avatar-ring {
    width: 170px;
    height: 170px;
    border-radius: 50%;
    border: 5px solid #3498db;
    padding: 4px;
    background: #ffffff;
    box-shadow: 0 8px 20px rgba(0,0,0,0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
  }
  .poster-avatar-ring img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
  }
  .poster-badge-yellow {
    background: linear-gradient(135deg, #f1c40f, #f39c12);
    color: #1a252f;
    font-weight: 800;
    font-size: 0.75rem;
    padding: 6px 14px;
    border-radius: 8px;
    box-shadow: 0 4px 10px rgba(241, 196, 15, 0.3);
    transform: rotate(-3deg);
    margin-bottom: 8px;
    border: 2px solid #1a252f;
    text-align: center;
    display: inline-block;
  }
  .poster-badge-red {
    background: linear-gradient(135deg, #e74c3c, #c0392b);
    color: #ffffff;
    font-weight: 800;
    font-size: 0.75rem;
    padding: 6px 14px;
    border-radius: 8px;
    box-shadow: 0 4px 10px rgba(231, 76, 60, 0.3);
    transform: rotate(2deg);
    border: 2px solid #ffffff;
    text-align: center;
    display: inline-block;
  }
  .poster-right-col {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-right: 75px;
    padding-top: 10px;
  }
  .poster-teacher-name {
    font-size: 1.55rem;
    font-weight: 850;
    color: #1abc9c;
    line-height: 1.2;
    margin-bottom: 12px;
    word-break: break-word;
  }
  .poster-bullets-list {
    list-style: none;
    padding: 0;
    margin: 0 0 15px 0;
  }
  .poster-bullets-list li {
    font-size: 0.82rem;
    color: #2c3e50;
    margin-bottom: 8px;
    line-height: 1.4;
    position: relative;
    padding-left: 12px;
    font-weight: 550;
  }
  .poster-bullets-list li::before {
    content: "-";
    position: absolute;
    left: 0;
    color: #2c3e50;
    font-weight: bold;
  }
  .poster-footer-url {
    font-size: 0.8rem;
    color: #3498db;
    font-weight: bold;
    text-decoration: none;
  }
</style>

<!-- TOP CAROUSEL BANNER -->
<div class="banner-container mb-5">
  <div id="homeBannerCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="4500">
    <div class="carousel-indicators">
      <button type="button" data-bs-target="#homeBannerCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
      <% if (typeof promotions !== 'undefined' && promotions && promotions.length > 0) { %>
        <% promotions.forEach((p, idx) => { %>
          <button type="button" data-bs-target="#homeBannerCarousel" data-bs-slide-to="<%= idx + 1 %>" aria-label="Slide <%= idx + 2 %>"></button>
        <% }) %>
      <% } %>
    </div>
    <div class="carousel-inner">
      <!-- Default Main Slide -->
      <div class="carousel-item active">
        <img src="/images/panel.JPG" class="d-block w-100" alt="Banner Y&V" style="height: auto;" />
      </div>
      <!-- Active Promotions Slides -->
      <% if (typeof promotions !== 'undefined' && promotions && promotions.length > 0) { %>
        <% promotions.forEach((p, idx) => { %>
          <div class="carousel-item">
            <div class="w-100 position-relative">
              <img src="<%= p.HinhAnh || '/images/logo.png' %>" class="d-block w-100" alt="<%= p.TenKhuyenMai %>" style="height: auto;" />
            </div>
          </div>
        <% }) %>
      <% } %>
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#homeBannerCarousel" data-bs-slide="prev">
      <span class="carousel-control-prev-icon" aria-hidden="true"></span>
      <span class="visually-hidden">Previous</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#homeBannerCarousel" data-bs-slide="next">
      <span class="carousel-control-next-icon" aria-hidden="true"></span>
      <span class="visually-hidden">Next</span>
    </button>
  </div>
</div>

<!-- VỀ TRUNG TÂM Y&V (ABOUT STATS) -->
<section class="container mb-5 py-4">
  <div class="text-center mb-4 mx-auto" style="max-width: 950px;">
    <h2 class="fw-bold mb-3" style="font-size: 2.2rem; color: #1a252f;">Về Trung tâm Y&V</h2>
    <p class="text-dark fs-5 fw-semibold mb-0" style="line-height: 1.6; opacity: 0.95;">
      Trung tâm Y&V là đơn vị đào tạo TOEIC uy tín với hàng chục ngàn học viên đạt mục tiêu mỗi&nbsp;năm. Chúng tôi mang đến chương trình học chất lượng, lộ trình rõ ràng và cam kết đầu ra.
    </p>
  </div>
  
  <div class="row g-4 justify-content-center mt-2">
    <div class="col-md-4">
      <div class="stat-card-custom">
        <div class="stat-number">10,000+</div>
        <div class="stat-label">Học viên đã luyện thi</div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="stat-card-custom">
        <div class="stat-number">650+</div>
        <div class="stat-label">Điểm TOEIC trung bình</div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="stat-card-custom">
        <div class="stat-number">100%</div>
        <div class="stat-label">Cam kết chất lượng</div>
      </div>
    </div>
  </div>
</section>

<!-- DANH SÁCH KHÓA HỌC (GRID) -->
<section id="KhoaHoc" class="container mb-5 py-4">
  <div class="text-center mb-4">
    <h2 class="fw-bold">Khóa học</h2>
    <p class="text-muted">Nhấp vào từng chương trình dưới đây để hiển thị danh sách các lớp học đang mở tuyển sinh.</p>
  </div>

  <div class="row g-4 justify-content-center">
    <% if (courses && courses.length > 0) { %>
      <% courses.forEach(course => { 
        const formattedFee = (course.HocPhi !== null && course.HocPhi !== undefined) ? Number(course.HocPhi).toLocaleString('vi-VN') : 'Liên hệ';
        const nameLower = (course.TenKhoaHoc || '').toLowerCase();
        let badgeColor = 'bg-primary-subtle text-primary';
        let badgeIcon = 'bi-award';

        if (nameLower.includes('cấp tốc')) {
          badgeColor = 'bg-danger text-white';
          badgeIcon = 'bi-lightning-charge-fill';
        } else if (nameLower.includes('luyện đề')) {
          badgeColor = 'bg-warning-subtle text-dark border border-warning';
          badgeIcon = 'bi-pencil-square';
        } else if (nameLower.includes('pre') || nameLower.includes('foundation')) {
          badgeColor = 'bg-info-subtle text-info-emphasis border border-info-subtle';
          badgeIcon = 'bi-star';
        }

        const courseClassesData = [course];
      %>
        <div class="col-md-6 col-lg-4">
          <div class="course-item h-100 d-flex flex-column justify-content-between shadow-sm border rounded-4 p-4 bg-white"
            data-ten="<%= course.TenKhoaHoc %>"
            data-mota="<%= course.MoTa || 'Chương trình đào tạo ngoại ngữ chất lượng cao chuẩn quốc tế.' %>"
            data-thoiluong="<%= course.ThoiLuong || 26 %> buổi"
            data-hocphi="<%= formattedFee %>"
            data-capdo="<%= course.CapDo || 'Mọi trình độ' %>"
            data-classes='<%- JSON.stringify(courseClassesData).replace(/'/g, "&#39;") %>'
            onclick="openProgramModal(this)"
            style="cursor: pointer;">
            
            <div>
              <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="badge <%= badgeColor %> px-3 py-1.5 fw-semibold rounded-pill">
                  <i class="bi <%= badgeIcon %> me-1"></i><%= course.CapDo || course.TenKhoaHoc %>
                </span>
                <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1.5 fw-bold rounded-pill">
                  <i class="bi bi-journal-check me-1"></i><%= course.ThoiLuong || 26 %> buổi học
                </span>
              </div>
              <h4 class="fw-bold mb-2 text-dark"><%= course.TenKhoaHoc %></h4>
              <p class="text-secondary small line-clamp-3"><%= course.MoTa || 'Chương trình đào tạo ngoại ngữ chất lượng cao chuẩn quốc tế.' %></p>
            </div>
            
            <div class="mt-4 pt-3 border-top d-flex justify-content-between align-items-center">
              <div>
                <span class="text-muted d-block small">Học phí</span>
                <strong class="text-success fs-5"><%= formattedFee %> <%= (course.HocPhi !== null && course.HocPhi !== undefined) ? 'đ' : '' %></strong>
              </div>
              <span class="text-primary fw-semibold small">Xem chi tiết & Lớp học <i class="bi bi-arrow-right"></i></span>
            </div>
          </div>
        </div>
      <% }); %>
    <% } else { %>
      <div class="col-12 text-center py-5">
        <div class="alert alert-info py-4">
          <i class="bi bi-info-circle fs-3 d-block mb-2"></i>
          Hiện chưa có khóa học nào được xuất bản. Vui lòng quay lại sau!
        </div>
      </div>
    <% } %>
  </div>
</section>

<!-- ĐỘI NGŨ NHÂN SỰ -->
<% if (typeof staff !== 'undefined' && staff && staff.length > 0) { %>
<section id="NhanSu" class="container mb-5 py-4 border-top">
  <div class="text-center mb-5">
    <h2 class="fw-bold">Đội Ngũ Giảng Viên </h2>
    <p class="text-muted">Đội ngũ giảng viên giàu kinh nghiệm, tận tâm, cam kết đồng hành cùng học viên bứt phá điểm số.</p>
  </div>
  
  <div class="row g-4 justify-content-center">
    <% staff.forEach(member => { %>
      <% const imgSrc = member.AnhDaiDien && member.AnhDaiDien !== 'default_avatar.png' ? ((member.AnhDaiDien.startsWith('/') || member.AnhDaiDien.startsWith('http')) ? member.AnhDaiDien : '/images/' + member.AnhDaiDien) : ''; %>
      <div class="col-xl-6 col-lg-6">
        <div class="teacher-poster-card shadow-lg"
             data-hoten="<%= member.HoTen %>"
             data-chucvu="<%= member.ChucVu %>"
             data-hocvi="<%= member.HocVi %>"
             data-chungchi="<%= member.ChungChiNgoaiNgu %>"
             data-kinhnghiem="<%= member.KinhNghiem %>"
             data-ngayvaolam="<%= new Date(member.NgayVaoLam).toLocaleDateString('vi-VN') %>"
             data-avatar="<%= imgSrc %>"
             onclick="openTeacherModal(this)">
          
          <!-- Logo in top-right -->
          <div class="poster-logo">
            Anh Ngữ<br>Y & V
          </div>

          <!-- Main Layout -->
          <div class="poster-content-layout">
            <!-- Left Column: Avatar & Sticker badges -->
            <div class="poster-left-col">
              <div class="poster-avatar-ring">
                <% if (member.AnhDaiDien && member.AnhDaiDien !== 'default_avatar.png') { %>
                  <img src="<%= imgSrc %>" alt="<%= member.HoTen %>" <% if (member.HoTen.includes('Khoa')) { %>style="object-position: center 15%;"<% } %> onerror="this.src='https://api.dicebear.com/7.x/adventurer/svg?seed=<%= encodeURIComponent(member.HoTen) %>'" />
                <% } else { %>
                  <div class="rounded-circle d-flex align-items-center justify-content-center bg-primary text-white fw-bold fs-3" style="width: 100%; height: 100%;">
                    <%= member.HoTen.split(' ').map(n => n[0]).slice(-2).join('').toUpperCase() %>
                  </div>
                <% } %>
              </div>
              <div class="poster-badge-yellow">Top Giáo viên Ưu Tú</div>
              <div class="poster-badge-red">tại Anh ngữ Y&V</div>
            </div>

            <!-- Right Column: Name & Bullet Points -->
            <div class="poster-right-col">
              <h3 class="poster-teacher-name"><%= member.HoTen %></h3>
              <ul class="poster-bullets-list">
                <li><%= member.ChungChiNgoaiNgu %></li>
                <li>Học vị: <%= member.HocVi %></li>
                <li><%= member.KinhNghiem %></li>
                <li>Hơn <%= new Date().getFullYear() - new Date(member.NgayVaoLam).getFullYear() %> năm đồng hành tại Anh ngữ Y&V</li>
              </ul>
            </div>
          </div>

        </div>
      </div>
    <% }) %>
  </div>
</section>
<% } %>

<!-- TIN TỨC & BÀI VIẾT NỔI BẬT -->
<section id="TinTuc" class="container mb-5 py-4 border-top">
  <div class="text-center mb-4">
    <h2 class="fw-bold">Tin tức nổi bật</h2>
    <p class="text-secondary small">Cập nhật tin tức mới nhất và bí kíp ôn thi TOEIC hiệu quả</p>
  </div>
  <div class="row g-4">
    <% if (typeof news !== 'undefined' && news && news.length > 0) { %>
      <% news.forEach(n => { 
        let link = `/news/detail/${n.MaTinTuc}`;
        const titleLower = (n.TieuDe || '').toLowerCase();
        if (n.MaTinTuc === 1 || titleLower.includes('format') || titleLower.includes('cấu trúc')) {
          link = '/format-toeic';
        } else if (n.MaTinTuc === 2 || titleLower.includes('mẹo') || titleLower.includes('listening')) {
          link = '/meo-toeic-listening';
        } else if (n.MaTinTuc === 3 || titleLower.includes('từ vựng') || titleLower.includes('văn phòng')) {
          link = '/tu-vung-van-phong';
        }
      %>
        <div class="col-md-4">
          <div class="card custom-card h-100 border-0 shadow-sm overflow-hidden rounded-4 transition-all"
               style="cursor: pointer;"
               onclick="window.location.href='<%= link %>'">
            <div style="height: 230px; overflow: hidden; background-color: #fcfcfc;" class="position-relative d-flex align-items-center justify-content-center border-bottom">
              <img src="<%= n.HinhAnh ? n.HinhAnh : '/images/Cap_Nhat_Fomat.png' %>" 
                   class="img-fluid w-100 h-100 p-2" 
                   style="object-fit: contain;" 
                   alt="<%= n.TieuDe %>" 
                   onerror="this.onerror=null; this.src='/images/Cap_Nhat_Fomat.png';" />
            </div>
            <div class="card-body p-4 d-flex flex-column">
              <h5 class="card-title fw-bold text-dark mb-2" style="font-size: 1.1rem; line-height: 1.4;"><%= n.TieuDe %></h5>
              <p class="card-text text-secondary small flex-grow-1 mb-3" style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.5;">
                <%= n.TomTat || 'Nội dung thông tin bài viết...' %>
              </p>
              <div class="d-flex align-items-center justify-content-between pt-3 border-top text-muted small mt-auto">
                <span><i class="bi bi-calendar3 me-1"></i><%= n.NgayDang ? new Date(n.NgayDang).toLocaleDateString('vi-VN') : '' %></span>
                <span class="text-primary fw-semibold">Xem chi tiết <i class="bi bi-arrow-right"></i></span>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <div class="col-12 text-center text-muted py-4">Chưa có bài viết nào được đăng.</div>
    <% } %>
  </div>
</section>


<!-- MODAL CHI TIẾT KHÓA HỌC -->
<div class="modal fade" id="courseModal" tabindex="-1" aria-labelledby="courseModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-xl">
    <div class="modal-content border-0 rounded-4 shadow-lg">
      <div class="modal-header border-0 bg-light p-4">
        <h3 class="modal-title fw-bold text-dark fs-3 mb-0" id="modalTen">Tên chương trình</h3>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-4 p-md-5">
        <p id="modalMoTa" class="text-secondary fs-6 mb-4 line-height-base"></p>
        
        <div class="row g-3 mb-4">
          <div class="col-md-4">
            <div class="bg-light p-3.5 rounded-3 text-center border shadow-sm">
              <span class="text-secondary d-block fs-6 mb-1">Thời lượng trung bình</span>
              <strong id="modalThoiLuong" class="fs-4 fw-bold text-primary">--</strong>
            </div>
          </div>
          <div class="col-md-4">
            <div class="bg-light p-3.5 rounded-3 text-center border shadow-sm">
              <span class="text-secondary d-block fs-6 mb-1">Học phí gốc</span>
              <strong class="text-success fs-4 fw-bold"><span id="modalHocPhi">--</span> VNĐ</strong>
            </div>
          </div>
          <div class="col-md-4">
            <div class="bg-light p-3.5 rounded-3 text-center border shadow-sm">
              <span class="text-secondary d-block fs-6 mb-1">Cấp độ tối thiểu</span>
              <strong id="modalCapDo" class="fs-4 fw-bold text-dark">--</strong>
            </div>
          </div>
        </div>

        <!-- Nav Tabs cho Lớp học & Đề cương đào tạo -->
        <ul class="nav nav-tabs nav-justified mb-4" id="courseModalTab" role="tablist">
          <li class="nav-item" role="presentation">
            <button class="nav-link active fw-bold fs-6 py-2.5" id="classes-tab" data-bs-toggle="tab" data-bs-target="#classes-pane" type="button" role="tab" aria-controls="classes-pane" aria-selected="true">
              <i class="bi bi-calendar3 me-2 text-primary"></i>Danh sách lớp học mở tuyển sinh
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold fs-6 py-2.5" id="syllabus-tab" data-bs-toggle="tab" data-bs-target="#syllabus-pane" type="button" role="tab" aria-controls="syllabus-pane" aria-selected="false">
              <i class="bi bi-journal-bookmark-fill me-2 text-success"></i>Đề cương đào tạo chi tiết (Syllabus)
            </button>
          </li>
        </ul>

        <div class="tab-content" id="courseModalTabContent">
          <!-- Pane 1: Danh sách lớp học -->
          <div class="tab-pane fade show active" id="classes-pane" role="tabpanel" aria-labelledby="classes-tab" tabindex="0">
            <div id="modalClassesList" class="mb-3">
              <!-- Injected via JavaScript -->
            </div>
          </div>

          <!-- Pane 2: Đề cương đào tạo chi tiết -->
          <div class="tab-pane fade" id="syllabus-pane" role="tabpanel" aria-labelledby="syllabus-tab" tabindex="0">
            <div id="modalSyllabusContainer" class="mb-3">
              <!-- Injected via JavaScript -->
            </div>
          </div>
        </div>

        <div class="d-flex gap-2 pt-2">
          <button type="button" class="btn btn-secondary btn-lg w-100 fw-bold" data-bs-dismiss="modal">Đóng</button>
        </div>
      </div>
    </div>
  </div>
</div>

