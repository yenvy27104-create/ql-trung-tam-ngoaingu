  function openTeacherModal(element) {
    // Lấy dữ liệu và gán vào Modal giảng viên
    document.getElementById('tModalName').innerText = element.getAttribute('data-hoten');
    document.getElementById('tModalBadge').innerText = element.getAttribute('data-chucvu') + ' - ' + element.getAttribute('data-hocvi');
    document.getElementById('tModalChungChi').innerText = element.getAttribute('data-chungchi');
    document.getElementById('tModalKinhNghiem').innerText = element.getAttribute('data-kinhnghiem');
    document.getElementById('tModalNgayLam').innerText = element.getAttribute('data-ngayvaolam');
    
    const avatarSrc = element.getAttribute('data-avatar');
    const avatarEl = document.getElementById('tModalAvatar');
    if (avatarSrc) {
      avatarEl.src = avatarSrc;
    } else {
      // Fallback nếu không có ảnh
      avatarEl.src = 'https://api.dicebear.com/7.x/adventurer/svg?seed=' + encodeURIComponent(element.getAttribute('data-hoten'));
    }

    // Khởi tạo và hiển thị Modal
    const teacherModal = new bootstrap.Modal(document.getElementById('teacherModal'));
    teacherModal.show();
  }

  let infoBsModal = null;
  function openInfoModal(element) {
    const title = element.dataset.title;
    const content = element.dataset.content;
    const image = element.dataset.image;

    document.getElementById('infoModalTitle').innerText = title;
    document.getElementById('infoModalContent').innerText = content;
    document.getElementById('infoModalImage').src = image;

    if (!infoBsModal) {
      infoBsModal = new bootstrap.Modal(document.getElementById('infoModal'));
    }
    infoBsModal.show();
  }

  let promoBsModal = null;
  function openPromoDetailModal(element) {
    const title = element.dataset.title;
    const code = element.dataset.code;
    const percent = element.dataset.percent;
    const content = element.dataset.content;
    const image = element.dataset.image;

    document.getElementById('promoModalTitle').innerText = title;
    document.getElementById('promoModalContent').innerText = content;
    document.getElementById('promoModalImage').src = image;
    document.getElementById('promoPercent').innerText = percent;
    document.getElementById('promoCodeVal').innerText = code;

    if (!promoBsModal) {
      promoBsModal = new bootstrap.Modal(document.getElementById('promoDetailModal'));
    }
    promoBsModal.show();
  }

  function copyPromoCode(btn) {
    const codeVal = document.getElementById('promoCodeVal').innerText;
    navigator.clipboard.writeText(codeVal).then(() => {
      const origText = btn.innerHTML;
      btn.innerHTML = '<i class="bi bi-check-lg me-1"></i>Đã chép!';
      btn.classList.replace('btn-success', 'btn-light');
      btn.classList.add('text-success');
      setTimeout(() => {
        btn.innerHTML = origText;
        btn.classList.replace('btn-light', 'btn-success');
        btn.classList.remove('text-success');
      }, 2000);
    }).catch(err => {
      console.error('Sao chép thất bại: ', err);
      Swal.fire({
        icon: 'error',
        title: 'Lỗi sao chép',
        text: 'Không thể tự động chép, vui lòng bôi đen và sao chép thủ công!',
        confirmButtonText: 'Đồng ý',
        confirmButtonColor: '#e74c3c'
      });
    });
  }

  window.addEventListener('DOMContentLoaded', () => {
    courseBsModal = new bootstrap.Modal(document.getElementById('courseModal'));

    const urlParams = new URLSearchParams(window.location.search);
    const courseId = urlParams.get('courseId');
    if (courseId) {
      let card = null;
      const courseLower = courseId.toString();
      if (courseLower === '1' || courseLower === '2' || courseLower === '3') {
        card = document.querySelector('.course-item[data-ten*="nền tảng"]') || document.querySelector('.course-item[data-ten*="Pre"]');
      } else if (courseLower === '4' || courseLower === '5' || courseLower === '6') {
        card = document.querySelector('.course-item[data-ten*="450"]') || document.querySelector('.course-item[data-ten*="TOEIC A"]');
      } else if (courseLower === '7' || courseLower === '8') {
        card = document.querySelector('.course-item[data-ten*="650"]') || document.querySelector('.course-item[data-ten*="TOEIC B"]');
      }
      
      if (card) {
        setTimeout(() => {
          document.getElementById('KhoaHoc').scrollIntoView({ behavior: 'smooth' });
          openProgramModal(card);
        }, 300);
      }
    }
  });
</script>

