                                                                value="<%= s.MaHocVien %>" />
                                                              <input type="hidden" name="MaLopHoc"
                                                                value="<%= c.MaLopHoc %>" />
                                                              <input type="hidden" name="StudentName"
                                                                value="<%= s.HoTen %>" />
                                                              <input type="hidden" name="ClassName"
