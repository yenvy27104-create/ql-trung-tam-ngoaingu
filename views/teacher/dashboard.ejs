                                              const isPastMidtermPhase = daysSinceMidterm > 5;

                                                  const reviewMidtermSession = minMidterm + 1;
                                                  const reviewFinalSession = Math.min(tongBuoiCls, minFinal + 1);

                                                  const shiftEndTimeStr = (todaySchedules.length > 0 &&
