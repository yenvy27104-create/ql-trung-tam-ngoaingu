    <script>
      function submitStatusUpdate(maDangKy, trangThai, message) {
        if (typeof Swal !== 'undefined') {
          Swal.fire({
            title: 'Xác nhận thay đổi trạng thái',
            text: `Bạn có chắc chắn muốn ${message}?`,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'Đồng ý',
            cancelButtonText: 'Hủy'
          }).then((result) => {
            if (result.isConfirmed) {
              const form = document.createElement('form');
              form.method = 'POST';
              form.action = '/classes/update-registration-status';

              const input1 = document.createElement('input');
              input1.type = 'hidden';
              input1.name = 'MaDangKy';
              input1.value = maDangKy;
              form.appendChild(input1);

              const input2 = document.createElement('input');
              input2.type = 'hidden';
              input2.name = 'TrangThai';
              input2.value = trangThai;
              form.appendChild(input2);

              document.body.appendChild(form);
              form.submit();
            }
          });
        } else {
          if (confirm(`Bạn có chắc chắn muốn ${message}?`)) {
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = '/classes/update-registration-status';

            const input1 = document.createElement('input');
            input1.type = 'hidden';
            input1.name = 'MaDangKy';
            input1.value = maDangKy;
            form.appendChild(input1);

            const input2 = document.createElement('input');
            input2.type = 'hidden';
            input2.name = 'TrangThai';
            input2.value = trangThai;
            form.appendChild(input2);

            document.body.appendChild(form);
            form.submit();
          }
        }
      }

      function showOutsideAttendanceReportWarning() {
        if (typeof Swal !== 'undefined') {
          Swal.fire({
            icon: 'warning',
            title: 'Thông báo',
            text: 'Ngoài thời gian điểm danh không thể thực hiện được báo cáo admin Vui lòng quay lại sau',
            confirmButtonText: 'Đồng ý',
            confirmButtonColor: '#e74c3c'
          });
        } else {
          alert('Ngoài thời gian điểm danh không thể thực hiện được báo cáo admin Vui lòng quay lại sau');
        }
      }

      // Helper to switch class tabs on dropdown selection
      function switchClassTab(tabName, classId) {
        // Hide all sections for this tab
        document.querySelectorAll(`.class-section-${tabName}`).forEach(el => el.classList.add('d-none'));

        const emptyNotice = document.getElementById(`${tabName}-empty-notice`);
        let targetEl = null;

        if (classId) {
          targetEl = document.getElementById(`${tabName}-class-${classId}`);
          if (!targetEl) {
            // Fallback: search by matching text or value if classId is TenLop (e.g. "A_101")
            const selectEl = document.getElementById(`${tabName}ClassSelect`);
            if (selectEl) {
              for (let i = 0; i < selectEl.options.length; i++) {
                if (selectEl.options[i].text.trim() === String(classId).trim() || selectEl.options[i].value === String(classId)) {
                  const realId = selectEl.options[i].value;
                  selectEl.value = realId;
                  targetEl = document.getElementById(`${tabName}-class-${realId}`);
                  break;
                }
              }
            }
          }
        }

        if (targetEl) {
          targetEl.classList.remove('d-none');
          if (emptyNotice) emptyNotice.classList.add('d-none');
        } else {
          if (emptyNotice) emptyNotice.classList.remove('d-none');
        }
      }

      // Pre-select dropdown based on URL query parameter or default to the FIRST class automatically
      function initTeacherTabs() {
        const urlParams = new URLSearchParams(window.location.search);
        let classId = urlParams.get('classId');

        ['attendance', 'grades'].forEach(tabName => {
          const selectEl = document.getElementById(`${tabName}ClassSelect`);
          if (selectEl && selectEl.options.length > 1) {
            let matchedVal = null;
            if (classId) {
              for (let i = 0; i < selectEl.options.length; i++) {
                if (selectEl.options[i].value === String(classId) || selectEl.options[i].text.trim() === String(classId).trim()) {
                  matchedVal = selectEl.options[i].value;
                  break;
                }
              }
            }
            if (!matchedVal) {
              matchedVal = selectEl.options[1].value;
            }
            if (matchedVal) {
              selectEl.value = matchedVal;
              switchClassTab(tabName, matchedVal);
            }
          } else if (selectEl) {
            switchClassTab(tabName, '');
          }
        });
      }

      if (document.readyState === 'complete' || document.readyState === 'interactive') {
        setTimeout(initTeacherTabs, 1);
      } else {
        window.addEventListener('DOMContentLoaded', initTeacherTabs);
      }

      window.addEventListener('DOMContentLoaded', () => {

    <% if (success) { %>
      if (typeof Swal !== 'undefined') {
            Swal.fire({
              icon: 'success',
              title: 'Thành công',
              text: <%- JSON.stringify(success) %>,
              confirmButtonText: 'Đồng ý',
              confirmButtonColor: '#3498db'
            });
          }
    <% } %>
    <% if (error) { %>
      if (typeof Swal !== 'undefined') {
            Swal.fire({
              icon: 'error',
              title: 'Thông báo lỗi',
              text: <%- JSON.stringify(error) %>,
              confirmButtonText: 'Đồng ý',
              confirmButtonColor: '#e74c3c'
            });
          }
    <% } %>
  });

