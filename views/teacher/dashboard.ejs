                                                      } else {
                                                        canEnterFinal = false;
                                                        finalBadgeText = '(Đã khóa lúc ' + shiftEndTimeStr + ' Buổi ' + reviewFinalSession + ')';
                                                      }
                                                    } else {
                                                      canEnterFinal = false;
                                                      finalBadgeText = '(Đã hết hạn nhập Cuối kỳ)';
                                                    }
                                                  }
                                                %>
