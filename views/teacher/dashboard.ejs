                                                                                class="text-secondary small fw-bold"><i
                                                                                  class="bi bi-arrow-right-circle-fill me-1"></i>Đã
                                                                                chuyển lớp</span>
                                                                              <% } else if
                                                                                (s.TrangThai==='Đã hoàn thành' || s.TrangThai==='Hoàn thành' ||
