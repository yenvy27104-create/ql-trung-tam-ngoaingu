      function updateExamTypeVisibility() {
        const examTypeSelect = document.getElementById('examTypeSelect');
        if (!examTypeSelect) return;
        const val = examTypeSelect.value;

        const isTestDauVao = val.includes('Đầu vào');
        const isKhachVangLai = val.includes('Mẫu') || val.includes('Miễn phí') || val.includes('Khách vãng lai');
        const isHocVienChinhThuc = !isTestDauVao && !isKhachVangLai;

        const cards = document.querySelectorAll('.question-card');
        cards.forEach(card => {
          const idx = card.id.replace('question-card-', '');
          const scriptContainer = document.getElementById(`q-script-container-${idx}`);
          const explanationContainer = document.getElementById(`q-explanation-container-${idx}`);
          const recommendationContainer = document.getElementById(`q-recommendation-container-${idx}`);

          if (scriptContainer) {
            if (isTestDauVao) scriptContainer.classList.add('d-none');
            else scriptContainer.classList.remove('d-none');
          }

          if (explanationContainer) {
            if (isTestDauVao) explanationContainer.classList.add('d-none');
            else explanationContainer.classList.remove('d-none');
          }

          if (recommendationContainer) {
            if (isHocVienChinhThuc) recommendationContainer.classList.remove('d-none');
            else recommendationContainer.classList.add('d-none');
          }
        });
      }

      function removeQuestionBlock(index) {
        const card = document.getElementById(`question-card-${index}`);
        if (card) {
          card.remove();
        }
      }

      // Adjust options and passage visibility based on TOEIC Part choice
      function adjustQuestionOptions(index, part) {
        const passageContainer = document.getElementById(`q-passage-container-${index}`);
        const optDSelect = document.getElementById(`q-${index}-optD-select`);

        // Part 6 & 7 have passages
        if (part === '6' || part === '7') {
          passageContainer.classList.remove('d-none');
        } else {
          passageContainer.classList.add('d-none');
        }

        // Part 2 has only 3 choices (A, B, C)
        if (part === '2') {
          if (optDSelect) optDSelect.disabled = true;
        } else {
          if (optDSelect) optDSelect.disabled = false;
        }
      }

      function confirmCreatePractice(event) {
        event.preventDefault();
        const form = event.target;

        if (typeof Swal !== 'undefined') {
          Swal.fire({
            title: 'Xác nhận tạo bài luyện tập',
            text: 'Bạn có chắc chắn muốn tạo và lưu bài luyện tập mới này không?',
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#3498db',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'Đồng ý tạo',
            cancelButtonText: 'Hủy bỏ'
          }).then((result) => {
            if (result.isConfirmed) {
              form.submit();
            }
          });
        } else {
          if (confirm('Bạn có chắc chắn muốn tạo và lưu bài luyện tập mới này không?')) {
            form.submit();
          }
        }
        return false;
      }

      function unlockTeacherProfileEdit() {
        document.querySelectorAll('.teacher-profile-field').forEach(el => el.disabled = false);
        document.getElementById('btn-unlock-teacher-profile').classList.add('d-none');
        document.getElementById('btn-save-teacher-profile').classList.remove('d-none');
        document.getElementById('btn-cancel-teacher-profile').classList.remove('d-none');
      }

      function lockTeacherProfileEdit() {
        document.querySelectorAll('.teacher-profile-field').forEach(el => el.disabled = true);
        document.getElementById('btn-unlock-teacher-profile').classList.remove('d-none');
        document.getElementById('btn-save-teacher-profile').classList.add('d-none');
        document.getElementById('btn-cancel-teacher-profile').classList.add('d-none');
      }

      function combineTeacherAddress() {
        const distEl = document.getElementById('teacher-district');
        const streetEl = document.getElementById('teacher-street');
        const hiddenEl = document.getElementById('teacher-address-hidden');
        if (!distEl || !streetEl || !hiddenEl) return;

        const streetVal = streetEl.value.trim();
        const distVal = distEl.value.trim();

        if (streetVal && distVal && distVal !== 'Chưa chọn khu vực') {
          hiddenEl.value = `${streetVal}, ${distVal}`;
        } else if (streetVal) {
          hiddenEl.value = streetVal;
        } else if (distVal && distVal !== 'Chưa chọn khu vực') {
          hiddenEl.value = distVal;
        } else {
          hiddenEl.value = '';
        }
      }

      function initTeacherAddress() {
        const rawAddress = "<%= nhansu.DiaChi || '' %>";
        const distEl = document.getElementById('teacher-district');
        const streetEl = document.getElementById('teacher-street');
        if (!distEl || !streetEl || !rawAddress) return;

        let matchedOption = null;
        for (let i = 0; i < distEl.options.length; i++) {
          const optVal = distEl.options[i].value;
          if (optVal !== 'Chưa chọn khu vực' && rawAddress.includes(optVal)) {
            matchedOption = optVal;
            break;
          }
        }

        if (matchedOption) {
          distEl.value = matchedOption;
          const parts = rawAddress.split(matchedOption);
          let streetPart = parts[0].trim();
          if (streetPart.endsWith(',')) streetPart = streetPart.slice(0, -1).trim();
          streetEl.value = streetPart;
        } else {
          streetEl.value = rawAddress;
        }
      }

      function confirmSaveAttendance(e) {
        if (e && e.preventDefault) e.preventDefault();
        const form = e ? (e.target || e.srcElement) : null;
        if (!form) return false;

        const payload = {};
        const checkedInputs = form.querySelectorAll('input[type="radio"][name^="records["]:checked');
        checkedInputs.forEach(input => {
          const match = input.name.match(/records\[(.+)\]/);
          if (match && match[1]) {
            payload[match[1]] = input.value;
          }
        });

        const hiddenField = form.querySelector('input[name="recordsJson"]');
        if (hiddenField) {
          hiddenField.value = JSON.stringify(payload);
        }

        if (typeof Swal !== 'undefined') {
          Swal.fire({
            title: 'Xác nhận lưu điểm danh?',
            text: 'Bạn có chắc chắn muốn lưu thông tin điểm danh của các học viên trong buổi học này không?',
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#198754',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'Đồng ý lưu',
            cancelButtonText: 'Hủy',
            reverseButtons: true
          }).then((result) => {
            if (result.isConfirmed) {
              form.submit();
            }
          });
        } else {
          if (confirm('Bạn có chắc chắn muốn lưu thông tin điểm danh của các học viên trong buổi học này không?')) {
            form.submit();
          }
        }
        return false;
      }

      function confirmSaveGrades(e) {
        if (e && e.preventDefault) e.preventDefault();
        const form = e ? (e.target || e.srcElement) : null;
        if (!form) return false;

        // Kiểm tra xem giảng viên đã gõ giá trị điểm nào chưa
        const inputs = form.querySelectorAll('input[type="number"]:not([disabled])');
        let hasValueEntered = false;
        inputs.forEach(inp => {
          if (inp.value !== undefined && inp.value !== null && inp.value.trim() !== '') hasValueEntered = true;
        });

        if (!hasValueEntered) {
          const firstInput = form.querySelector('input[type="number"]:not([disabled])');
          if (firstInput) {
            firstInput.focus();
            firstInput.classList.add('is-invalid');
            firstInput.style.boxShadow = '0 0 0 0.25rem rgba(220, 53, 69, 0.25)';
          }
          if (typeof Swal !== 'undefined') {
            Swal.fire({
              title: 'Chưa nhập điểm số!',
              text: 'Vui lòng nhấp vào ô "Điểm Cuối Kỳ" và gõ điểm số (từ 0 đến 990, ví dụ: 500 hoặc 520) trước khi bấm Lưu Bảng Điểm.',
              icon: 'warning',
              confirmButtonColor: '#0d6efd',
              confirmButtonText: 'Đã hiểu'
            }).then(() => {
              if (firstInput) firstInput.focus();
            });
          } else {
            alert('Vui lòng nhấp vào ô "Điểm Cuối Kỳ" và gõ điểm số (từ 0 đến 990) trước khi bấm Lưu Bảng Điểm!');
            if (firstInput) firstInput.focus();
          }
          return false;
        }

        if (typeof Swal !== 'undefined') {
          Swal.fire({
            title: 'Xác nhận lưu bảng điểm?',
            text: 'Hệ thống sẽ lưu điểm số và tự động chuyển học viên sang trạng thái Hoàn thành khóa học!',
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#0d6efd',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'Đồng ý lưu',
            cancelButtonText: 'Hủy',
            reverseButtons: true
          }).then((result) => {
            if (result.isConfirmed) {
              form.submit();
            }
          });
        } else {
          if (confirm('Bạn có chắc chắn muốn lưu bảng điểm cho các học viên trong lớp này không?')) {
            form.submit();
          }
        }
        return false;
      }

      function confirmTeacherProfileUpdate(e) {
        if (e && e.preventDefault) e.preventDefault();
        combineTeacherAddress();
        const form = e ? (e.target || document.getElementById('teacherProfileForm')) : document.getElementById('teacherProfileForm');
        if (typeof Swal !== 'undefined') {
          Swal.fire({
            title: 'Xác nhận cập nhật',
            text: 'Bạn có chắc chắn muốn lưu các thay đổi cho hồ sơ giảng viên không?',
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#3498db',
            cancelButtonColor: '#95a5a6',
            confirmButtonText: 'Đồng ý cập nhật',
            cancelButtonText: 'Hủy'
          }).then((result) => {
            if (result.isConfirmed) {
              form.submit();
            }
          });
        } else {
          if (confirm('Bạn có chắc chắn muốn lưu các thay đổi cho hồ sơ giảng viên không?')) {
            form.submit();
          }
        }
        return false;
      }

      // Add initial question block on load if in practice tab
      window.addEventListener('DOMContentLoaded', () => {
        initTeacherAddress();
        const container = document.getElementById('questions-container');
        if (container) {
          addQuestionBlock();
        }
        if (window.history && window.history.replaceState && (window.location.search.includes('error=') || window.location.search.includes('success='))) {
          const url = new URL(window.location.href);
          url.searchParams.delete('error');
          url.searchParams.delete('success');
          window.history.replaceState({}, document.title, url.pathname + url.search);
        }
      });
    </script>
