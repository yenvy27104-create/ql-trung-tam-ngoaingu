<%- include('../layouts/header.ejs') %>

  </div> <!-- Close default container from header.ejs -->
  <div class="container-fluid px-4 px-md-5 py-4 bg-light min-vh-100">
    <div class="row g-4">
      <!-- Left Sidebar Navigation -->
      <div class="col-lg-3">
        <!-- Profile Card -->
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
          <div class="card-body text-center p-4 bg-white">
            <div class="position-relative d-inline-block mb-3">
              <img src="<%= user.AnhDaiDien || '/images/avatar-default.png' %>"
                class="rounded-circle border border-3 border-primary shadow-sm"
                style="width: 100px; height: 100px; object-fit: cover;" />
              <span class="position-absolute bottom-0 end-0 bg-success border border-white border-2 rounded-circle p-2"
                title="Đang hoạt động"></span>
            </div>
            <h5 class="fw-bold mb-1 text-dark text-nowrap">
              <%= user.HoTen %>
            </h5>
            <span class="badge bg-primary-subtle text-primary mb-3 px-3 py-1 rounded-pill text-nowrap">
              <%= nhansu.ChucVu || 'Giảng viên' %>
            </span>

            <div class="text-start mt-3 pt-3 border-top small text-secondary">
              <p class="mb-2 text-nowrap" style="font-size: 0.88rem;"><i
                  class="bi bi-mortarboard-fill me-2 text-primary"></i><strong>Học vị:</strong>
                <%= nhansu.HocVi || 'Chưa cập nhật' %>
              </p>
              <p class="mb-2 text-nowrap" style="font-size: 0.88rem;"><i
                  class="bi bi-patch-check-fill me-2 text-primary"></i><strong>Chứng chỉ:</strong>
                <%= nhansu.ChungChiNgoaiNgu || 'Chưa cập nhật' %>
              </p>
              <p class="mb-0 text-nowrap" style="font-size: 0.88rem;"><i
                  class="bi bi-clock-history me-2 text-primary"></i><strong>Kinh nghiệm:</strong>
                <%= nhansu.KinhNghiem || 'Chưa cập nhật' %>
              </p>
            </div>
          </div>
        </div>

        <!-- Navigation Menu -->
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
          <div class="list-group list-group-flush">
            <a href="?tab=overview"
              class="list-group-item list-group-item-action py-3 px-3 border-0 d-flex align-items-center text-nowrap <%= tab === 'overview' ? 'active bg-primary-subtle text-primary fw-bold' : '' %>">
              <i class="bi bi-calendar3 me-2.5 fs-5"></i> Lịch giảng dạy
            </a>
            <a href="?tab=attendance"
              class="list-group-item list-group-item-action py-3 px-3 border-0 d-flex align-items-center text-nowrap <%= tab === 'attendance' ? 'active bg-primary-subtle text-primary fw-bold' : '' %>">
              <i class="bi bi-check2-square me-2.5 fs-5"></i> Điểm danh lớp học
            </a>
            <a href="?tab=grades"
              class="list-group-item list-group-item-action py-3 px-3 border-0 d-flex align-items-center text-nowrap <%= tab === 'grades' ? 'active bg-primary-subtle text-primary fw-bold' : '' %>">
              <i class="bi bi-journal-check me-2.5 fs-5"></i> Nhập điểm thi
            </a>
            <a href="?tab=practice"
              class="list-group-item list-group-item-action py-3 px-3 border-0 d-flex align-items-center text-nowrap <%= tab === 'practice' ? 'active bg-primary-subtle text-primary fw-bold' : '' %>">
              <i class="bi bi-file-earmark-plus-fill me-2.5 fs-5"></i> Tạo bài luyện tập
            </a>
            <a href="?tab=profile"
              class="list-group-item list-group-item-action py-3 px-3 border-0 d-flex align-items-center text-nowrap <%= tab === 'profile' ? 'active bg-primary-subtle text-primary fw-bold' : '' %>">
              <i class="bi bi-person-lines-fill me-2.5 fs-5"></i> Quản lý hồ sơ cá nhân
            </a>
          </div>
        </div>
      </div>

      <!-- Right Content Area -->
      <div class="col-lg-9">
        <!-- Status Alerts -->
        <% if (success) { %>
          <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-4 mb-4 p-3"
            role="alert">
            <div class="d-flex align-items-center">
              <i class="bi bi-check-circle-fill me-2 fs-5"></i>
              <div>
                <%= success %>
              </div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
          </div>
          <% } %>

            <% if (error) { %>
              <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-4 mb-4 p-3"
                role="alert">
                <div class="d-flex align-items-center">
                  <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                  <div>
                    <%= error %>
                  </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
              </div>
              <% } %>

                <!-- TAB: OVERVIEW / TEACHING SCHEDULE -->
                <% if (tab==='overview' ) { %>
                  <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
                    <h4 class="fw-bold text-dark mb-4"><i class="bi bi-calendar3 text-primary me-2"></i>Lịch giảng dạy
                      giảng viên</h4>

                    <div class="table-responsive">
                      <table class="table table-hover align-middle">
                        <thead class="table-light">
                          <tr class="text-nowrap">
                            <th>Lớp Học (Khóa)</th>
                            <th>Phòng Học</th>
                            <th>Buổi Học</th>
                            <th>Thời Gian</th>
                            <th>Các Thứ Trong Tuần</th>
                          </tr>
                        </thead>
                        <tbody>
                          <% timetables.forEach(t=> { %>
                            <tr>
                              <td class="fw-bold text-primary text-nowrap">
                                <%= t.TenLop %>
                                  <small class="text-muted d-block fw-normal">
                                    <%= t.TenKhoaHoc %>
                                  </small>
                              </td>
                              <td class="text-nowrap">
                                <span class="badge bg-secondary-subtle text-secondary px-2.5 py-1.5 fs-6"><i
                                    class="bi bi-building me-1"></i>
                                  <%= t.TenPhong %>
                                </span>
                                <div class="small text-muted mt-0.5">
                                  <%= t.ViTri %>
                                </div>
                              </td>
                              <td class="text-nowrap">
                                <span class="badge bg-light text-dark border px-2.5 py-1.5 fw-semibold">
                                  <%= t.TenBuoi %>
                                </span>
                              </td>
                              <td class="text-nowrap">
                                <span class="text-dark fw-bold"><i class="bi bi-clock me-1 text-primary"></i>
                                  <%= t.GioBatDau %> - <%= t.GioKetThuc %>
                                </span>
                              </td>
                              <td>
                                <span
                                  class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1.5 rounded-pill fw-bold"
                                  style="font-size: 0.85rem;">
                                  <i class="bi bi-calendar-week me-1"></i>
                                  <%= t.CacThu %>
                                </span>
                              </td>
                            </tr>
                            <% }) %>
                              <% if (timetables.length===0) { %>
                                <tr>
                                  <td colspan="5" class="text-center py-4 text-muted">
                                    <i class="bi bi-calendar-x fs-1 d-block mb-2 text-secondary"></i>
                                    Không có lịch giảng dạy nào được sắp xếp.
                                  </td>
                                </tr>
                                <% } %>
                        </tbody>
                      </table>
                    </div>
                  </div>

                  <div class="row g-4">
                    <% myClasses.forEach(c=> { %>
                      <div class="col-md-6">
                        <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                          <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                              <span class="badge bg-primary-subtle text-primary px-3 rounded-pill">
                                <%= c.CapDo %>
                              </span>
                              <span class="badge bg-success-subtle text-success">
                                <%= c.TrangThaiLop %>
                              </span>
                            </div>
                            <h5 class="fw-bold text-dark mb-3">
                              <%= c.TenLop %>
                            </h5>
                            <div class="small text-secondary mb-4">
                              <p class="mb-1"><i class="bi bi-calendar-event me-2 text-primary"></i><strong>Khai
                                  giảng:</strong>
                                <%= new Date(c.NgayKhaiGiang).toLocaleDateString('vi-VN') %>
                              </p>
                              <p class="mb-1"><i class="bi bi-calendar-x me-2 text-primary"></i><strong>Kết
                                  thúc:</strong>
                                <%= new Date(c.NgayKetThuc).toLocaleDateString('vi-VN') %>
                              </p>
                              <p class="mb-0"><i class="bi bi-clock-history me-2 text-primary"></i><strong>Thời
                                  lượng:</strong>
                                <%= c.ThoiLuong || '--' %> buổi học
                              </p>
                            </div>
                            <div class="d-flex gap-2">
                              <a href="?tab=attendance&classId=<%= c.MaLopHoc %>"
                                class="btn btn-sm btn-outline-primary flex-grow-1 fw-bold">Điểm danh</a>
                              <a href="?tab=grades&classId=<%= c.MaLopHoc %>"
                                class="btn btn-sm btn-primary flex-grow-1 fw-bold">Nhập điểm</a>
                            </div>
                          </div>
                        </div>
                      </div>
                      <% }) %>
                  </div>
                  <% } %>

                    <!-- TAB: ATTENDANCE -->
                    <% if (tab==='attendance' ) { %>
                      <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
                        <h4 class="fw-bold text-dark mb-4"><i class="bi bi-check2-square text-primary me-2"></i>Điểm
                          danh lớp học</h4>

                        <div class="row g-3 mb-4">
                          <div class="col-md-6">
                            <label class="form-label fw-bold text-secondary">Chọn lớp học</label>
                            <select class="form-select border-2" id="attendanceClassSelect"
                              onchange="switchClassTab('attendance', this.value)">
                              <option value="">-- Chọn lớp học --</option>
                              <% classes.forEach(c=> { %>
                                <option value="<%= c.MaLopHoc %>">
                                  <%= c.TenLop %>
                                </option>
                                <% }) %>
                            </select>
                          </div>
                        </div>

                        <% if (classes.length===0) { %>
                          <div class="alert alert-warning border-0 shadow-sm rounded-4 p-4 text-center">
                            <i class="bi bi-exclamation-circle text-warning fs-1 d-block mb-2"></i>
                            <h5 class="fw-bold text-dark mb-1">Chưa có lớp học được phân công</h5>
                            <p class="text-secondary mb-0">Hiện tại bạn chưa được phân công giảng dạy lớp học nào để
                              điểm danh.</p>
                          </div>
                          <% } else { %>
                            <div id="attendance-empty-notice"
                              class="alert alert-info border-0 shadow-sm rounded-4 p-4 text-center d-none">
                              <i class="bi bi-info-circle text-primary fs-2 d-block mb-2"></i>
                              <h6 class="fw-bold text-dark mb-0">Vui lòng chọn một lớp học từ danh sách phía trên để xem
                                thông tin điểm danh.</h6>
                            </div>
                            <% } %>

                              <% classes.forEach((c, idx)=> { %>
                                <div class="class-section class-section-attendance <%= idx === 0 ? '' : 'd-none' %>"
                                  id="attendance-class-<%= c.MaLopHoc %>">
                                  <div class="border p-4 rounded-4 bg-light mb-4">
                                    <h5 class="fw-bold text-dark mb-3">
                                      <%= c.TenLop %> - Nhập điểm danh ngày hôm nay
                                    </h5>

                                    <% 
                                      const vnNowStr = new Date().toLocaleString("en-US", { timeZone: "Asia/Ho_Chi_Minh" });
                                      const todayDate = new Date(vnNowStr);
                                      todayDate.setHours(0,0,0,0);
                                      const startDate = new Date(c.NgayKhaiGiang);
                                      startDate.setHours(0,0,0,0);
                                      const endDate = new Date(c.NgayKetThuc);
                                      endDate.setHours(23,59,59,999);

                                      const notStartedYet = todayDate < startDate;
                                      const alreadyEnded = todayDate > endDate;
                                      const isCourseActive = !notStartedYet && !alreadyEnded;

                                      const dayNamesVN = ['Chủ Nhật', 'Thứ Hai', 'Thứ Ba', 'Thứ Tư', 'Thứ Năm', 'Thứ Sáu', 'Thứ Bảy'];
                                      const todayVNName = dayNamesVN[todayDate.getDay()];
                                      const cTimetables = (typeof timetables !== 'undefined' ? timetables : []).filter(t => t.MaLopHoc === c.MaLopHoc);
                                      const todaySchedules = cTimetables.filter(t => t.CacThu && t.CacThu.includes(todayVNName));

                                      const vnTimeStr = new Date().toLocaleString("en-US", { timeZone: "Asia/Ho_Chi_Minh" });
                                      const vnDateObj = new Date(vnTimeStr);
                                      const nowH = vnDateObj.getHours();
                                      const nowM = vnDateObj.getMinutes();
                                      const nowTotalMins = nowH * 60 + nowM;

                                      let isWithinSessionTime = true;
                                      let timeWarningReason = '';

                                      if (isCourseActive) {
                                        if (todaySchedules.length === 0 && cTimetables.length > 0) {
                                          isWithinSessionTime = false;
                                          timeWarningReason = `Hôm nay (${todayVNName}) không có ca học của lớp này.`;
                                        } else if (todaySchedules.length > 0) {
                                          const getAllowTimeInfoUI = (gioBatDauStr) => {
                                            const [startH, startM] = gioBatDauStr.split(':').map(Number);
                                            const startMins = startH * 60 + startM;
                                            const allowMins = startMins + 90;
                                            const allowH = Math.floor(allowMins / 60) % 24;
                                            const allowM = allowMins % 60;
                                            const formattedTime = `${String(allowH).padStart(2, '0')}h${String(allowM).padStart(2, '0')}`;
                                            return { startMins, allowMins, formattedTime };
                                          };

                                          const validSlot = todaySchedules.find(s => {
                                            const { allowMins } = getAllowTimeInfoUI(s.GioBatDau);
                                            const [endH, endM] = s.GioKetThuc.split(':').map(Number);
                                            const endMins = endH * 60 + endM;
                                            if (c.GhiChu && c.GhiChu.includes('TEST_MODE_247')) {
                                          isWithinSessionTime = true;
                                        }
                                            return nowTotalMins >= allowMins && nowTotalMins <= endMins;
                                          });

                                          if (validSlot) {
                                            isWithinSessionTime = true;
                                          } else {
                                            isWithinSessionTime = false;
                                            const notYetSlot = todaySchedules.find(s => {
                                              const { allowMins } = getAllowTimeInfoUI(s.GioBatDau);
                                              return nowTotalMins < allowMins;
                                            });

                                            if (notYetSlot) {
                                              const { formattedTime } = getAllowTimeInfoUI(notYetSlot.GioBatDau);
                                              timeWarningReason = `Buổi học chưa đủ 90 phút (bắt đầu lúc ${notYetSlot.GioBatDau.substring(0, 5)}). Vui lòng quay lại điểm danh và báo cáo Admin lúc ${formattedTime}.`;
                                            } else {
                                              const schedTimeText = todaySchedules.map(s => `${s.GioBatDau.substring(0, 5)} - ${s.GioKetThuc.substring(0, 5)}`).join(', ');
                                              timeWarningReason = `Đã quá hạn thời gian điểm danh cho ca học hôm nay (${schedTimeText}).`;
                                            }
                                          }
                                        }
                                      }
                                    %>

                                          <% if (notStartedYet) { %>
                                            <div class="alert alert-warning border-0 shadow-sm rounded-3 mb-3 p-3">
                                              <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                                              <strong>Thông báo:</strong> Lớp học chưa đến ngày khai giảng (Khai giảng:
                                              <strong>
                                                <%= new Date(c.NgayKhaiGiang).toLocaleDateString('vi-VN') %>
                                              </strong>). Điểm danh chỉ được phép khi lớp đang diễn ra.
                                            </div>
                                            <% } else if (alreadyEnded) { %>
                                              <div class="alert alert-danger border-0 shadow-sm rounded-3 mb-3 p-3">
                                                <i class="bi bi-slash-circle-fill me-2 fs-5"></i>
                                                <strong>Thông báo:</strong> Lớp học đã kết thúc thời gian đào tạo (Kết
                                                thúc: <strong>
                                                  <%= new Date(c.NgayKetThuc).toLocaleDateString('vi-VN') %>
                                                </strong>). Không thể điểm danh bổ sung.
                                              </div>
                                              <% } else if (!isWithinSessionTime) { %>
                                                <div
                                                  class="alert alert-warning border-start border-4 border-warning shadow-sm rounded-3 mb-3 p-3">
                                                  <i class="bi bi-clock-history me-2 fs-5 text-warning"></i>
                                                  <strong>Ngoài giờ điểm danh:</strong>
                                                  <%= timeWarningReason %> Điểm danh chỉ được phép thực hiện đúng trong
                                                    khung giờ ca học.
                                                </div>
                                                <% } else { %>
                                                  <div
                                                    class="alert alert-success border-0 shadow-sm rounded-3 mb-3 p-2.5 small">
                                                    <i class="bi bi-check-circle-fill me-2 text-success"></i>Thời gian
                                                    khóa học: <strong>
                                                      <%= new Date(c.NgayKhaiGiang).toLocaleDateString('vi-VN') %>
                                                    </strong> - <strong>
                                                      <%= new Date(c.NgayKetThuc).toLocaleDateString('vi-VN') %>
                                                    </strong> (Đang trong ca học).
                                                  </div>
                                                  <% } %>

                                                    <form action="/classes/save-attendance" method="POST"
                                                      onsubmit="return confirmSaveAttendance(event)"
                                                      id="attendance-form-<%= c.MaLopHoc %>">
                                                      <input type="hidden" name="MaLopHoc" value="<%= c.MaLopHoc %>" />
                                                      <input type="hidden" name="recordsJson"
                                                        id="recordsJson-<%= c.MaLopHoc %>" value="{}" />

                                                      <% const dNow=new Date(); const
                                                        todayLocalStr=`${dNow.getFullYear()}-${String(dNow.getMonth() +
                                                        1).padStart(2, '0' )}-${String(dNow.getDate()).padStart(2, '0'
                                                        )}`; %>
                                                        <div class="row mb-4 align-items-end">
                                                          <div class="col-md-4">
                                                            <label class="form-label fw-semibold">Ngày điểm danh</label>
                                                            <input type="date" name="NgayHoc" class="form-control"
                                                              value="<%= todayLocalStr %>" max="<%= todayLocalStr %>"
                                                              required />
                                                          </div>
                                                        </div>

                                                        <% const listForClass=studentsByClass[c.MaLopHoc] || []; const
                                                          inCount=listForClass.filter(s=> s.isNewlyTransferredIn ||
                                                          (s.GhiChu && s.GhiChu.includes('Chuyển từ lớp'))).length;
                                                          const outCount = listForClass.filter(s => s.isTransferredOut
                                                          || s.TrangThai === 'Đã chuyển lớp' || (s.GhiChu && s.GhiChu.includes('Đã chuyển sang lớp'))).length;
                                                          %>
                                                          <% if (inCount> 0 || outCount > 0) { %>
                                                            <div
                                                              class="alert alert-info py-2 px-3 mb-3 small rounded-3 border-0 bg-info-subtle text-info-emphasis d-flex align-items-center justify-content-between">
                                                              <div>
                                                                <i
                                                                  class="bi bi-arrow-left-right me-1.5 fw-bold fs-6"></i>
                                                                <strong>Thống kê học viên biến động:</strong>
                                                                <% if (inCount> 0) { %><span
                                                                    class="badge bg-success text-white me-2"><i
                                                                      class="bi bi-arrow-left-circle-fill me-1"></i>+<%=
                                                                      inCount %> Học viên mới chuyển đến</span>
                                                                  <% } %>
                                                                    <% if (outCount> 0) { %><span
                                                                        class="badge bg-warning text-dark me-2"><i
                                                                          class="bi bi-arrow-right-circle-fill me-1"></i>-
                                                                        <%= outCount %> Học viên đã chuyển lớp đi</span>
                                                                      <% } %>
                                                              </div>
                                                              <span class="text-muted small">Cập nhật tự động</span>
                                                            </div>
                                                            <% } %>

                                                              <div class="table-responsive bg-white rounded-3 border"
                                                                style="overflow-x: auto;">
                                                                <table class="table align-middle mb-0"
                                                                  style="width: 100%;">
                                                                  <thead class="table-light">
                                                                    <tr class="text-nowrap" style="font-size: 0.85rem;">
                                                                      <th style="min-width: 180px;">Học Viên</th>
                                                                      <th style="min-width: 190px;">Thông Tin Liên Hệ
                                                                      </th>
                                                                      <th class="text-center" style="min-width: 120px;">
                                                                        Tiến Độ Học Tập</th>
                                                                      <th class="text-center" style="min-width: 110px;">
                                                                        Tình Trạng</th>
                                                                      <th class="text-center" style="min-width: 150px;">
                                                                        Điểm Danh</th>
                                                                      <th class="text-end text-nowrap"
                                                                        style="min-width: 160px;">Hành động</th>
                                                                    </tr>
                                                                  </thead>
                                                                  <tbody>
                                                                    <% listForClass.forEach(s=> { %>
                                                                      <tr
                                                                        class="<%= (s.TrangThai === 'Đã chuyển lớp' || s.isTransferredOut || s.isBlurred) ? 'opacity-50 bg-light text-muted' : '' %>">
                                                                        <td>
                                                                          <div class="fw-bold text-dark"
                                                                            style="font-size: 0.92rem;">
                                                                            <%= s.HoTen %>
                                                                          </div>
                                                                          <span
                                                                            class="badge bg-primary-subtle text-primary border border-primary-subtle fw-semibold rounded-pill px-2 py-0.5 mt-1 d-inline-block"
                                                                            style="font-size: 0.75rem;"><i
                                                                              class="bi bi-mortarboard-fill me-1"></i>Trình
                                                                            độ: <%= s.TrinhDoHienTai || 'Chưa cập nhật'
                                                                              %></span>
                                                                          <% if (s.isNewlyTransferredIn || (s.GhiChu &&
                                                                            s.GhiChu.includes('Chuyển từ lớp'))) { %>
                                                                            <div class="mt-1"><span
                                                                                class="badge bg-info text-white fw-semibold rounded-pill px-2 py-0.5"
                                                                                style="font-size: 0.75rem;"><i
                                                                                  class="bi bi-arrow-left-circle-fill me-1"></i>
                                                                                <%= s.GhiChu %>
                                                                              </span></div>
                                                                            <% } else if (s.isTransferredOut ||
                                                                              s.TrangThai==='Đã chuyển lớp' || (s.GhiChu && s.GhiChu.includes('Đã chuyển sang lớp'))) { %>
                                                                              <div class="mt-1"><span
                                                                                  class="badge bg-warning text-dark fw-semibold rounded-pill px-2 py-0.5"
                                                                                  style="font-size: 0.75rem;"><i
