                                                  const nowObj = new Date();
                                                  const nowMins = nowObj.getHours() * 60 + nowObj.getMinutes();

                                                  // 1. Kiểm tra quyền nhập điểm Giữa kỳ (Từ buổi minMidterm đến hết giờ ca học Buổi minMidterm + 1)
