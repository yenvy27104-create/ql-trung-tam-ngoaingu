                                                                                  class="text-success small fw-bold"><i
                                                                                    class="bi bi-check-circle-fill me-1"></i>Đã
                                                                                  hoàn thành</span>
                                                                                <% } else { %>
                                                                                  <% const studentIdKey=s.MaHocVien ||
                                                                                    s.MaNguoiDung; const
                                                                                    hasTodayAttendance=!!s.todayStatus;
                                                                                    const
                                                                                    isAbsentChecked=hasTodayAttendance
                                                                                    && (s.todayStatus==='Vắng mặt' || s.todayStatus==='Vắng' ); const
                                                                                    isPresentChecked=!hasTodayAttendance
                                                                                    || s.todayStatus==='Có mặt' ; %>
