                                                                                  <i
                                                                                    class="bi bi-check-circle-fill me-1"></i>Hoàn
                                                                                  thành
                                                                                </button>
                                                                                <% } %>
                                                                                  <% if (isCourseActive &&
                                                                                    isWithinSessionTime) { %>
