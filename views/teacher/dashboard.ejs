                                                                  <td class="fw-bold">
                                                                    <%= new
                                                                      Date(log.NgayHoc).toLocaleDateString('vi-VN') %>
                                                                  </td>
                                                                  <td>
                                                                    <%= log.HoTen %>
                                                                  </td>
                                                                  <td>
                                                                    <% const isAttPresent=log.TrangThai==='Có mặt' || log.TrangThai==='1' ; %>
                                                                      <span
                                                                        class="badge <%= isAttPresent ? 'bg-success' : 'bg-danger' %>">
                                                                        <%= isAttPresent ? 'Có mặt' : log.TrangThai %>
                                                                      </span>
                                                                  </td>
                                                                </tr>
                                                                <% }) %>
                                                                  <% if ((attendanceByClass[c.MaLopHoc] ||
                                                                    []).length===0) { %>
                                                                    <tr>
                                                                      <td colspan="3"
                                                                        class="text-center py-3 text-muted">Chưa có lịch
                                                                        sử điểm danh nào được ghi nhận.</td>
                                                                    </tr>
                                                                    <% } %>
                                                            </tbody>
                                                           </table>
                                                          </div>
                                                        </div>
                                                      <% }) %>
                                                    </div>
                                                  <% } %>

                                  <!-- TAB: GRADES -->
                                  <% if (tab==='grades' ) { %>
                                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
                                      <h4 class="fw-bold text-dark mb-4"><i
                                          class="bi bi-journal-check text-primary me-2"></i>Nhập điểm thi khóa học</h4>

                                      <div class="row g-3 mb-4">
                                        <div class="col-md-6">
                                          <label class="form-label fw-bold text-secondary">Chọn lớp học</label>
                                          <select class="form-select border-2" id="gradesClassSelect"
                                            onchange="switchClassTab('grades', this.value)">
                                            <option value="">-- Chọn lớp học --</option>
                                            <% classes.forEach(c=> { %>
                                              <option value="<%= c.MaLopHoc %>">
                                                <%= c.TenLop %>
                                              </option>
                                              <% }) %>
                                          </select>
                                        </div>
                                      </div>

                                      <% if (classes.length===0) { %>
                                        <div class="alert alert-warning border-0 shadow-sm rounded-4 p-4 text-center">
                                          <i class="bi bi-exclamation-circle text-warning fs-1 d-block mb-2"></i>
                                          <h5 class="fw-bold text-dark mb-1">Chưa có lớp học được phân công</h5>
                                          <p class="text-secondary mb-0">Hiện tại bạn chưa được phân công giảng dạy lớp
                                            học nào để nhập điểm.</p>
                                        </div>
                                        <% } else { %>
                                          <div id="grades-empty-notice"
                                            class="alert alert-info border-0 shadow-sm rounded-4 p-4 text-center d-none">
                                            <i class="bi bi-info-circle text-primary fs-2 d-block mb-2"></i>
                                            <h6 class="fw-bold text-dark mb-0">Vui lòng chọn một lớp học từ danh sách
                                              phía trên để xem bảng điểm.</h6>
                                          </div>
                                          <% } %>

                                            <% classes.forEach((c, idx)=> {
                                              const tongBuoiCls = Number(c.ThoiLuong || 0);
                                              let minMidterm = Math.max(1, Math.floor(tongBuoiCls * 0.5));
                                              let minFinal = Math.max(1, Math.floor(tongBuoiCls * 0.8));

                                              if (typeof getExamSessionsFromSyllabus === 'function') {
                                              const examSessions = getExamSessionsFromSyllabus(c.MaKhoaHoc,
                                              tongBuoiCls);
                                              minMidterm = examSessions.midtermSession;
                                              minFinal = examSessions.finalSession;
                                              }

                                              const clsTimetables = (typeof timetables !== 'undefined' ? timetables :
                                              []).filter(t => t.MaLopHoc === c.MaLopHoc);
                                              const scheduleDays = [];
                                              clsTimetables.forEach(t => {
                                                if (t.CacThu) {
                                                  t.CacThu.split(', ').forEach(day => {
                                                    if (!scheduleDays.includes(day)) scheduleDays.push(day);
                                                  });
                                                }
                                              });

                                              const todayVNName = new Date().toLocaleDateString('vi-VN', { weekday: 'long', timeZone: 'Asia/Ho_Chi_Minh' });
                                              const todaySchedules = clsTimetables.filter(t => t.CacThu && t.CacThu.includes(todayVNName));

                                              const vnTimeStr = new Date().toLocaleString("en-US", { timeZone: "Asia/Ho_Chi_Minh" });
                                              const vnDateObj = new Date(vnTimeStr);
                                              const nowH = vnDateObj.getHours();
                                              const nowM = vnDateObj.getMinutes();
                                              const nowTotalMins = nowH * 60 + nowM;

                                              let isTimeValidForGrade = true;
                                              let gradeTimeReason = '';

                                              if (todaySchedules.length > 0) {
                                                const notYetSlot = todaySchedules.find(s => {
                                                  const [startH, startM] = (s.GioBatDau || '00:00').split(':').map(Number);
                                                  return nowTotalMins < (startH * 60 + startM);
                                                });
                                                if (notYetSlot && (c.TrangThaiLop === 'Đang diễn ra' || c.TrangThaiLop === 'Đang mở')) {
                                                  isTimeValidForGrade = false;
                                                  gradeTimeReason = `Chưa đến giờ ca học (bắt đầu lúc ${notYetSlot.GioBatDau.substring(0, 5)}).`;
                                                }
                                              }

                                              // Lấy số buổi đã diễn ra theo lịch
                                              let currentElapsed = 0;
                                              if (typeof calculateElapsedSessions === 'function') {
                                                currentElapsed = calculateElapsedSessions(c.NgayKhaiGiang, scheduleDays, tongBuoiCls);
                                              }

                                              // Hàm tính ngày diễn ra của buổi học số N
                                              const calcSessionDate = (startDateStr, schedDays, sessionNum) => {
                                                if (!startDateStr || !schedDays || schedDays.length === 0 || !sessionNum) return null;
                                                const dayMap = { 'Chủ Nhật': 0, 'Thứ Hai': 1, 'Thứ Ba': 2, 'Thứ Tư': 3, 'Thứ Năm': 4, 'Thứ Sáu': 5, 'Thứ Bảy': 6 };
                                                const targetDays = schedDays.map(d => dayMap[d]).filter(d => d !== undefined);
                                                if (targetDays.length === 0) return null;
                                                const curr = new Date(startDateStr);
                                                curr.setHours(0,0,0,0);
                                                let count = 0;
                                                while (count < sessionNum) {
                                                  if (targetDays.includes(curr.getDay())) {
                                                    count++;
                                                    if (count === sessionNum) return new Date(curr);
                                                  }
                                                  curr.setDate(curr.getDate() + 1);
                                                }
                                                return curr;
                                              };

                                              const todayZero = new Date();
                                              todayZero.setHours(0,0,0,0);
                                              const midtermDate = calcSessionDate(c.NgayKhaiGiang, scheduleDays, minMidterm);
                                              const finalDate = calcSessionDate(c.NgayKhaiGiang, scheduleDays, minFinal);
                                              let daysSinceMidterm = -1;
                                              if (midtermDate) {
                                                midtermDate.setHours(0,0,0,0);
