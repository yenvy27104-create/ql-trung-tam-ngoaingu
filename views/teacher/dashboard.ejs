                                                                                            class="form-check-label text-success fw-bold small"
                                                                                            for="att-present-<%= studentIdKey %>">Có
                                                                                            mặt</label>
                                                                                      </div>
                                                                                      <div
                                                                                        class="form-check form-check-inline m-0">
                                                                                        <input class="form-check-input"
                                                                                          type="radio"
                                                                                          name="records[<%= studentIdKey %>]"
                                                                                          id="att-absent-<%= studentIdKey %>"
                                                                                          value="Vắng mặt"
                                                                                          <%=isAbsentChecked ? 'checked' : '' %>
                                                                                        <%= (!isCourseActive ||
                                                                                          !isWithinSessionTime)
                                                                                          ? 'disabled' : '' %>>
