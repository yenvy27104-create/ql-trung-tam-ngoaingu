                                                                                            for="att-absent-<%= studentIdKey %>">Vắng
                                                                                            mặt</label>
                                                                                      </div>
                                                                                    </div>
                                                                                    <% } %>
                                                                        </td>
                                                                        <td class="text-end text-nowrap">
                                                                          <div class="d-flex justify-content-end gap-1">
                                                                            <% if (!s.isBlurred && !s.isTransferred &&
                                                                              s.TrangThai !=='Đã chuyển lớp' && s.TrangThai !=='Ngừng học' && s.TrangThai !=='Hoàn thành' ) { %>
                                                                              <% if (s.BuoiHienTai>= s.TongSoBuoi) { %>
