                                                                        </td>
                                                                        <td>
                                                                          <small class="d-block text-truncate"
                                                                            style="max-width: 180px;"
                                                                            title="<%= s.Email %>"><i
                                                                              class="bi bi-envelope me-1 text-primary"></i>
                                                                            <%= s.Email %>
                                                                          </small>
                                                                          <small class="d-block text-secondary"><i
                                                                              class="bi bi-phone me-1 text-primary"></i>
                                                                            <%= s.SoDienThoai %>
                                                                          </small>
                                                                        </td>
                                                                        <td class="text-center text-nowrap">
                                                                          <span
                                                                            class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 fw-bold"
                                                                            style="font-size: 0.8rem;">
                                                                            <i
                                                                              class="bi bi-check-circle-fill me-1"></i>Buổi
                                                                            <%= (s.BuoiHienTai !==undefined &&
                                                                              s.BuoiHienTai !==null) ? s.BuoiHienTai :
                                                                              (s.SoBuoiDaHoc || 0) %> / <%= s.TongSoBuoi
                                                                                %>
