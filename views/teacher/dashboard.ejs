                                                                                        title="Gửi báo cáo / Yêu cầu xử lý cho Admin">
                                                                                        <i
                                                                                          class="bi bi-send-exclamation-fill me-1"></i>Báo
                                                                                        cáo Admin
                                                                                      </button>
                                                                                      <% } %>
                                                                                        <% } else if
                                                                                          (s.TrangThai==='Ngừng học' || s.TrangThai==='Đã ngừng học' )
                                                                                          { %>
                                                                                          <span
                                                                                            class="badge bg-danger-subtle text-danger"
                                                                                            style="font-size: 0.75rem;"><i
                                                                                              class="bi bi-x-circle me-1"></i>Ngừng
                                                                                            học</span>
                                                                                          <% } else if
                                                                                            (s.TrangThai==='Hoàn thành'
