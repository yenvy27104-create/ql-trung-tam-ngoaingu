                                                    </form>

                                                    <!-- Modals Báo Cáo Hỗ Trợ Cho Admin (Đặt ngoài form điểm danh để tránh lồng form) -->
                                                    <% listForClass.forEach(s=> { %>
                                                      <div class="modal fade"
                                                        id="teacherReportModal<%= s.MaHocVien %>_<%= c.MaLopHoc %>"
                                                        tabindex="-1" aria-hidden="true">
                                                        <div class="modal-dialog modal-dialog-centered">
                                                          <div
                                                            class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
