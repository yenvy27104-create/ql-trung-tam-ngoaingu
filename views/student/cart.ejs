  function executeCheckout() {
    const spinner = document.getElementById('checkout-spinner');
    if (spinner) spinner.classList.remove('d-none');

    const allItemBoxes = document.querySelectorAll('.cart-item-checkbox');
    let checkedBoxes = Array.from(allItemBoxes).filter(cb => cb.checked);

    // Fallback: If cart has items but none selected, auto-check all items
    if (checkedBoxes.length === 0 && allItemBoxes.length > 0) {
      allItemBoxes.forEach(cb => cb.checked = true);
      const masterCb = document.getElementById('select-all-cart');
      if (masterCb) masterCb.checked = true;
      recalculateCartTotals();
      checkedBoxes = Array.from(allItemBoxes);
    }

    const selectedIds = checkedBoxes.map(cb => parseInt(cb.getAttribute('data-id') || cb.dataset.id || cb.value)).filter(id => !isNaN(id));

    if (selectedIds.length === 0) {
      if (spinner) spinner.classList.add('d-none');
      Swal.fire({
        icon: 'warning',
        title: 'Chưa chọn lớp học',
        text: 'Vui lòng chọn ít nhất một lớp học để thanh toán.',
        confirmButtonText: 'Đồng ý',
        confirmButtonColor: '#3498db'
      });
      return;
    }

    const studentAssignments = {};
    const pendingFutureShifts = {};
    checkedBoxes.forEach(cb => {
      const itemKey = cb.getAttribute('data-item-key') || cb.getAttribute('data-id');
      const classId = cb.getAttribute('data-id');
      const select = document.querySelector(`.cart-student-select[data-class-id="${itemKey}"]`) || document.querySelector(`.cart-student-select[data-class-id="${classId}"]`);
      if (select) {
        studentAssignments[itemKey] = select.value;
        studentAssignments[classId] = select.value;
      }
      const futureChk = document.getElementById(`futureShift_${itemKey}`) || document.getElementById(`futureShift_${classId}`);
      if (futureChk && futureChk.checked) {
        pendingFutureShifts[itemKey] = true;
        pendingFutureShifts[classId] = true;
      }
    });

    fetch('/courses/cart/checkout', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ 
        promoCode: appliedPromoCode || '',
        selectedClassIds: selectedIds,
        studentAssignments: studentAssignments,
        pendingFutureShifts: pendingFutureShifts
      })
    })
    .then(res => res.json())
    .then(data => {
      if (spinner) spinner.classList.add('d-none');
      if (data.success) {
        if (data.alreadyEnrolled) {
          Swal.fire({
            icon: 'info',
            title: 'Đã tham gia lớp học',
            text: data.message || 'Lớp học này bạn đã đăng ký và thanh toán thành công từ trước.',
            confirmButtonText: 'Đến Lớp học của tôi',
            confirmButtonColor: '#2ecc71'
          }).then(() => {
            window.location.href = data.redirect || '/classes/my-classes';
          });
          return;
        }

        // Store registered IDs
        activeRegisteredIds = data.registeredIds || [];
        cartTotalAmount = data.discountedAmount || totalFee;

        // Populate activeCartItemsInfo with selected class data
        activeCartItemsInfo = Array.from(checkedBoxes).map(cb => {
          return {
            TenLop: cb.dataset.name,
            TenKhoaHoc: cb.dataset.course,
            NgayKhaiGiang: cb.dataset.start,
            HocPhi: cb.dataset.fee,
            MaKhoaHoc: cb.dataset.courseId,
            CapDo: cb.dataset.level
          };
        });

        // Set details in modal
        const classNames = activeCartItemsInfo.map(item => `${item.TenLop} - ${item.TenKhoaHoc}`).join(', ');
        const detailsEl = document.getElementById('payment-cart-details');
        if (detailsEl) detailsEl.innerText = classNames;

        // Set promotion details and fees
        const originalFeeSum = activeCartItemsInfo.reduce((sum, item) => sum + parseFloat(item.HocPhi || 0), 0);
        const origFeeEl = document.getElementById('cart-payment-original-fee');
        if (origFeeEl) origFeeEl.innerText = Number(originalFeeSum).toLocaleString('vi-VN') + ' đ';
        
        const promoSelect = document.getElementById('cart-payment-promo');
        if (promoSelect) {
          let matched = false;
          if (appliedPromoCode) {
            for (let i = 0; i < promoSelect.options.length; i++) {
              const opt = promoSelect.options[i];
              if (opt.dataset.code === appliedPromoCode) {
                promoSelect.selectedIndex = i;
                matched = true;
                break;
              }
            }
          }
          if (!matched) {
            promoSelect.selectedIndex = 0; // "Không sử dụng"
          }
        }

        const finalFeeEl = document.getElementById('cart-payment-final-fee');
        if (finalFeeEl) finalFeeEl.innerText = Number(cartTotalAmount).toLocaleString('vi-VN') + ' đ';
        
        const qrAmountEl = document.getElementById('cart-qr-detail-amount');
        if (qrAmountEl) qrAmountEl.innerText = Number(cartTotalAmount).toLocaleString('vi-VN') + ' đ';

        function removeVietnameseTones(str) {
          if (!str) return '';
          str = str.replace(/à|á|ạ|ả|ã|â|ầ|ấ|ậ|ẩ|ẫ|ă|ằ|ắ|ặ|ẳ|ẵ/g, "a");
          str = str.replace(/è|é|ẹ|ẻ|ẽ|ê|ề|ế|ệ|ể|ễ/g, "e");
          str = str.replace(/ì|í|ị|ỉ|ĩ/g, "i");
          str = str.replace(/ò|ó|ọ|ỏ|õ|ô|ồ|ố|ộ|ổ|ỗ|ơ|ờ|ớ|ợ|ở|ỡ/g, "o");
          str = str.replace(/ù|ú|ụ|ủ|ũ|ư|ừ|ứ|ự|ử|ữ/g, "u");
          str = str.replace(/ỳ|ý|ỵ|ỷ|ỹ/g, "y");
          str = str.replace(/đ/g, "d");
          str = str.replace(/À|Á|Ạ|Ả|Ã|Â|Ầ|Ấ|Ậ|Ẩ|Ẫ|Ă|Ằ|Ắ|Ặ|Ẳ|Ẵ/g, "A");
          str = str.replace(/È|É|Ẹ|Ẻ|Ẽ|Ê|Ề|Ế|Ệ|Ể|Ễ/g, "E");
          str = str.replace(/Ì|Í|Ị|Ỉ|Ĩ/g, "I");
          str = str.replace(/Ò|Ó|Ọ|Ỏ|Õ|Ô|Ồ|Ố|Ộ|Ổ|Ỗ|Ơ|Ờ|Ớ|Ợ|Ở|Ỡ/g, "O");
          str = str.replace(/Ù|Ú|Ụ|Ủ|Ũ|Ư|Ừ|Ứ|Ự|Ử|Ữ/g, "U");
          str = str.replace(/Ỳ|Ý|Ỵ|Ỷ|Ỹ/g, "Y");
          str = str.replace(/Đ/g, "D");
          return str.normalize('NFD').replace(/[\u0300-\u036f]/g, '');
        }

        const cleanTitles = activeCartItemsInfo.map(item => {
          return removeVietnameseTones(item.TenLop || '').replace(/[^a-zA-Z0-9 ]/g, '').replace(/\s+/g, ' ');
        }).join(' ').trim();
        activeCartQrContent = (activeRegisteredIds.map(id => 'DK' + id).join(' ') + ' ' + cleanTitles).substring(0, 50);
        
        const qrContentEl = document.getElementById('cart-qr-detail-content');
        if (qrContentEl) qrContentEl.innerText = activeCartQrContent;

        // Generate VietQR Image
        const customQr = '<%= paymentConfig.qrImage %>';
        let qrUrl = '';
        if (customQr && customQr !== 'null' && customQr.trim() !== '') {
          qrUrl = customQr;
        } else {
          const bankId = '<%= paymentConfig.bankId %>';
          const accountNo = '<%= paymentConfig.accountNo %>';
          const template = '<%= paymentConfig.template %>';
          const accountName = encodeURIComponent('<%= paymentConfig.accountName %>');
          qrUrl = `https://img.vietqr.io/image/${bankId}-${accountNo}-${template}.png?amount=${cartTotalAmount}&addInfo=${encodeURIComponent(activeCartQrContent)}&accountName=${accountName}`;
        }
        const qrImgEl = document.getElementById('cart-vietqr-image');
        if (qrImgEl) qrImgEl.src = qrUrl;

        // Open Modal using bootstrap
        const modalEl = document.getElementById('cartPaymentModal');
        if (modalEl) {
          const modalInstance = bootstrap.Modal.getOrCreateInstance(modalEl);
          modalInstance.show();
          if (typeof startCartQrCountdownTimer === 'function') {
            startCartQrCountdownTimer();
          }
        }
      } else {
        if (data.requireRegister) {
          Swal.fire({
            icon: 'warning',
            title: 'Yêu cầu đăng ký tài khoản',
            text: data.message || 'Tài khoản Google chưa đăng ký thông tin cá nhân. Bạn bắt buộc phải đăng ký tài khoản trước khi đăng ký lớp học.',
            confirmButtonText: 'Đăng ký ngay',
            showCancelButton: true,
            cancelButtonText: 'Đóng',
            confirmButtonColor: '#3498db'
          }).then((result) => {
            if (result.isConfirmed) {
              window.location.href = '/register';
            }
          });
          return;
        }
        if (data.requirePhone) {
          Swal.fire({
            title: 'Cập nhật số điện thoại',
            text: 'Vui lòng bổ sung số điện thoại liên lạc để đăng ký lớp học:',
            input: 'text',
            inputPlaceholder: 'Nhập số điện thoại (10 chữ số)...',
            showCancelButton: true,
            confirmButtonText: 'Xác nhận',
            cancelButtonText: 'Hủy',
            confirmButtonColor: '#3498db',
            inputValidator: (value) => {
              if (!value) {
                return 'Bạn cần nhập số điện thoại!';
              }
              if (!/^[0-9]{10}$/.test(value.trim())) {
                return 'Số điện thoại không hợp lệ (yêu cầu 10 chữ số)!';
              }
            }
          }).then((result) => {
            if (result.isConfirmed) {
              const sdt = result.value.trim();
              fetch('/classes/update-phone', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ SoDienThoai: sdt })
              })
              .then(res => res.json())
              .then(updateData => {
                if (updateData.success) {
                  Swal.fire({
                    icon: 'success',
                    title: 'Đã cập nhật số điện thoại!',
                    text: 'Hệ thống đang tiến hành thanh toán...',
                    timer: 1500,
                    showConfirmButton: false
                  }).then(() => {
                    executeCheckout();
                  });
                } else {
                  Swal.fire({
                    icon: 'error',
                    title: 'Lỗi',
                    text: updateData.message || 'Cập nhật số điện thoại thất bại.'
                  });
                }
              })
              .catch(err => {
                console.error(err);
                Swal.fire({
                  icon: 'error',
                  title: 'Lỗi',
                  text: 'Lỗi kết nối máy chủ khi cập nhật.'
                });
              });
            }
          });
          return;
        }

        Swal.fire({
          icon: 'error',
          title: 'Lỗi',
          text: data.message || 'Có lỗi xảy ra khi thực hiện checkout.',
          confirmButtonText: 'Đồng ý'
        });
      }
    })
    .catch(err => {
      if (spinner) spinner.classList.add('d-none');
      console.error(err);
      Swal.fire({
        icon: 'error',
        title: 'Lỗi',
        text: 'Lỗi kết nối máy chủ.',
        confirmButtonText: 'Đồng ý'
      });
    });
  }

  function applyCartPromoCodeInModal() {
    const promoSelect = document.getElementById('cart-payment-promo');
    if (!promoSelect) return;
    const selectedOpt = promoSelect.selectedIndex >= 0 ? promoSelect.options[promoSelect.selectedIndex] : null;
    const pct = selectedOpt ? parseFloat(selectedOpt.dataset.pct || 0) : 0;
    const promoCode = selectedOpt ? (selectedOpt.dataset.code || '') : '';
    
    const today = new Date();
    today.setHours(0,0,0,0);

    let invalidCartItem = null;
    for (const item of activeCartItemsInfo) {
      if (item.NgayKhaiGiang) {
        const startDate = new Date(item.NgayKhaiGiang);
        startDate.setHours(0,0,0,0);
        const diffTime = startDate.getTime() - today.getTime();
        const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
        if (diffDays < 10) {
          invalidCartItem = {
            name: item.TenLop || item.TenKhoaHoc || 'Lớp học',
            date: startDate.toLocaleDateString('vi-VN'),
            days: diffDays < 0 ? 0 : diffDays
          };
          break;
        }
      }
    }

    // 1. Kiểm tra điều kiện COMBO20 (Áp dụng cho 2 lớp/khóa trở lên, TẤT CẢ phải khai giảng sau tối thiểu 10 ngày)
    if (promoCode === 'COMBO20') {
      if (activeCartItemsInfo.length < 2) {
        Swal.fire({
          icon: 'warning',
          title: 'Không đủ điều kiện',
          text: 'Khuyến mãi "Combo 2 khóa học" (COMBO20) yêu cầu đăng ký từ 2 lớp/khóa học (hoặc 2 suất học) trở lên.',
          confirmButtonText: 'Đồng ý',
          confirmButtonColor: '#3498db'
        });
        promoSelect.value = '';
        setTimeout(() => { applyCartPromoCodeInModal(); }, 50);
        return;
      }

      if (invalidCartItem) {
        Swal.fire({
          icon: 'warning',
          title: 'Không đủ điều kiện',
          text: `Khuyến mãi "Combo 2 khóa học" (COMBO20) yêu cầu TẤT CẢ các lớp học phải đăng ký trước ngày khai giảng tối thiểu 10 ngày. Lớp "${invalidCartItem.name}" khai giảng ngày ${invalidCartItem.date} (chỉ còn ${invalidCartItem.days} ngày).`,
          confirmButtonText: 'Đồng ý',
          confirmButtonColor: '#3498db'
        });
        promoSelect.value = '';
        setTimeout(() => { applyCartPromoCodeInModal(); }, 50);
        return;
      }
    }

    // 2. Kiểm tra điều kiện FLASHSALE15 (TẤT CẢ phải đăng ký trước ngày khai giảng tối thiểu 10 ngày)
    if (promoCode === 'FLASHSALE15') {
      if (invalidCartItem) {
        Swal.fire({
          icon: 'warning',
          title: 'Không đủ điều kiện',
          text: `Khuyến mãi "Flash Sale Đăng Ký Sớm" (FLASHSALE15) yêu cầu TẤT CẢ các lớp học phải đăng ký trước ngày khai giảng tối thiểu 10 ngày. Lớp "${invalidCartItem.name}" khai giảng ngày ${invalidCartItem.date} (chỉ còn ${invalidCartItem.days} ngày).`,
          confirmButtonText: 'Đồng ý',
          confirmButtonColor: '#3498db'
        });
        promoSelect.value = '';
        setTimeout(() => { applyCartPromoCodeInModal(); }, 50);
        return;
      }
    }

    // 3. Tính toán lại tổng tiền sau khi áp dụng mã hợp lệ
    let finalAmount = 0;
    activeCartItemsInfo.forEach(item => {
      let itemDiscountPct = 0;
      if (promoCode) {
        const startDate = new Date(item.NgayKhaiGiang);
        startDate.setHours(0,0,0,0);
        const diffTime = startDate.getTime() - today.getTime();
        const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));

        if (promoCode === 'FLASHSALE15' || promoCode === 'COMBO20') {
          if (diffDays >= 10) {
            itemDiscountPct = pct;
          }
        } else {
          itemDiscountPct = pct;
        }
      }
      const baseFee = parseFloat(item.HocPhi);
      finalAmount += baseFee - (baseFee * itemDiscountPct / 100);
    });

    cartTotalAmount = finalAmount;

    document.getElementById('cart-payment-final-fee').innerText = Number(cartTotalAmount).toLocaleString('vi-VN') + ' đ';
    document.getElementById('cart-qr-detail-amount').innerText = Number(cartTotalAmount).toLocaleString('vi-VN') + ' đ';

    // Update VietQR code source dynamically (Luôn nhúng số tiền & nội dung chuyển khoản động)
    const bankId = '<%= paymentConfig.bankId %>' || 'MBBank';
    const accountNo = '<%= paymentConfig.accountNo %>' || '111180304111';
    const template = '<%= paymentConfig.template %>' || 'compact2';
    const accountName = encodeURIComponent('<%= paymentConfig.accountName %>' || 'ANH NGU Y V');
    const qrUrl = `https://img.vietqr.io/image/${bankId}-${accountNo}-${template}.png?amount=${cartTotalAmount}&addInfo=${encodeURIComponent(activeCartQrContent)}&accountName=${accountName}`;
    document.getElementById('cart-vietqr-image').src = qrUrl;
  }

  function confirmCartPaymentSubmit() {
