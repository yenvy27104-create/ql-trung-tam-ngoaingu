        Swal.fire({
          icon: 'error',
          title: 'Lỗi',
          text: data.message || 'Có lỗi xảy ra khi gửi xác nhận thanh toán.',
          confirmButtonText: 'Đồng ý'
        });
      }
    })
    .catch(err => {
      if (spinner) spinner.classList.remove('d-none');
      console.error(err);
      Swal.fire({
        icon: 'error',
        title: 'Lỗi',
        text: 'Lỗi kết nối máy chủ.',
        confirmButtonText: 'Đồng ý'
      });
    });
  }

  function toggleCartPaymentMethodDisplay() {
    const vnpayInput = document.getElementById('cart-method-vnpay');
    const isVNPay = vnpayInput ? vnpayInput.checked : false;
    const vietqrDetails = document.getElementById('cart-vietqr-details');
    const vnpayDetails = document.getElementById('cart-vnpay-details');
    if (isVNPay) {
      if (vietqrDetails) vietqrDetails.classList.add('d-none');
      if (vnpayDetails) vnpayDetails.classList.remove('d-none');
    } else {
      if (vietqrDetails) vietqrDetails.classList.remove('d-none');
      if (vnpayDetails) vnpayDetails.classList.add('d-none');
    }
  }

  function payWithVNPay() {
    if (cartModalTimerInterval) {
      clearInterval(cartModalTimerInterval);
      cartModalTimerInterval = null;
    }
    const spinner = document.getElementById('cart-vnpay-spinner');
    if (spinner) spinner.classList.remove('d-none');

    const promoSelect = document.getElementById('cart-payment-promo');
    const promoId = promoSelect.value || null;

    fetch('/classes/create-vnpay-payment', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        MaDangKy: activeRegisteredIds,
        SoTien: cartTotalAmount,
        MaKhuyenMai: promoId
      })
    })
    .then(res => res.json())
    .then(data => {
      if (spinner) spinner.classList.remove('d-none');
      if (data.success && data.paymentUrl) {
        window.location.href = data.paymentUrl;
      } else {
        Swal.fire({
          icon: 'error',
          title: 'Lỗi',
          text: data.message || 'Có lỗi xảy ra khi tạo giao dịch VNPay.',
          confirmButtonText: 'Đồng ý'
        });
      }
    })
    .catch(err => {
      if (spinner) spinner.classList.remove('d-none');
      console.error(err);
      Swal.fire({
        icon: 'error',
        title: 'Lỗi',
        text: 'Lỗi kết nối máy chủ.',
        confirmButtonText: 'Đồng ý'
      });
    });
  }

  let cartModalTimerInterval = null;
  let cartQrCountdownSeconds = 30;

  function startCartQrCountdownTimer() {
    if (cartModalTimerInterval) {
      clearInterval(cartModalTimerInterval);
      cartModalTimerInterval = null;
    }
    cartQrCountdownSeconds = 30;
    const timerEl = document.getElementById('cart-qr-modal-timer');
    if (timerEl) timerEl.innerText = '30s';

    cartModalTimerInterval = setInterval(() => {
      cartQrCountdownSeconds--;
      if (timerEl) {
        timerEl.innerText = cartQrCountdownSeconds + 's';
      }

      if (cartQrCountdownSeconds <= 0) {
        clearInterval(cartModalTimerInterval);
        cartModalTimerInterval = null;
        cancelCartPaymentSubmit(true);
      }
    }, 1000);
  }

  function cancelCartPaymentSubmit(isExpired = false) {
    if (cartModalTimerInterval) {
      clearInterval(cartModalTimerInterval);
      cartModalTimerInterval = null;
    }
    const spinner = document.getElementById('cart-cancel-spinner');
    if (spinner) spinner.classList.remove('d-none');

    fetch('/classes/cancel-payment', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        MaDangKy: activeRegisteredIds,
        SoTien: cartTotalAmount,
        NoiDungChuyenKhoan: activeCartQrContent
      })
    })
    .then(res => res.json())
    .then(data => {
      if (spinner) spinner.classList.remove('d-none');
      
      // Hide modal
      const modalEl = document.getElementById('cartPaymentModal');
      const modalInstance = bootstrap.Modal.getInstance(modalEl);
      if (modalInstance) modalInstance.hide();

      if (isExpired) {
        Swal.fire({
          icon: 'error',
          title: '❌ Mã QR đã hết hiệu lực!',
          text: 'Giao dịch thanh toán đã bị HỦY tự động do mã QR hết thời gian 30 giây.',
          confirmButtonText: 'Đồng ý',
          confirmButtonColor: '#e74c3c'
        }).then(() => {
          window.location.reload();
        });
      } else {
        Swal.fire({
          icon: 'error',
          title: 'Thanh toán thất bại',
          text: data.message || 'Giao dịch thanh toán đã bị hủy.',
          confirmButtonText: 'Đồng ý',
          confirmButtonColor: '#e74c3c'
        }).then(() => {
          window.location.reload();
        });
      }
    })
    .catch(err => {
      if (spinner) spinner.classList.remove('d-none');
      console.error(err);
      Swal.fire({
        icon: 'error',
        title: 'Lỗi',
        text: 'Lỗi kết nối máy chủ.',
        confirmButtonText: 'Đồng ý'
      });
    });
  }

  // Auto-polling: Kiểm tra trạng thái thanh toán từ ngân hàng mỗi 2 giây, 
  function startPaymentPolling(registeredIds, redirectUrl) {
    const ids = Array.isArray(registeredIds) ? registeredIds : [registeredIds];
    const maxWaitSeconds = 30; 
    let elapsed = 0;
    const targetUrl = redirectUrl || '/classes/my-classes?tab=overview';

    Swal.fire({
      icon: 'info',
      title: 'Đang chờ ngân hàng xác nhận...',
      html: `<div class="text-center">
        <div class="spinner-border text-primary mb-3" role="status" style="width: 3rem; height: 3rem;">
          <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mb-1">Hệ thống đang tự động xác thực giao dịch từ Ngân hàng / SePay.</p>
        <p class="text-muted small">Thời gian chờ xác thực ngân hàng: <strong id="poll-timer" class="text-danger fs-6">30</strong>s / ${maxWaitSeconds}s</p>
        <div class="progress mt-2" style="height: 6px;">
          <div class="progress-bar progress-bar-striped progress-bar-animated bg-danger" id="poll-progress" role="progressbar" style="width: 0%"></div>
        </div>
      </div>`,
      showConfirmButton: false,
      showCancelButton: true,
      cancelButtonText: 'Hủy giao dịch',
      cancelButtonColor: '#d33',
      allowOutsideClick: false
    }).then((result) => {
      if (result.dismiss) {
        cancelCartPaymentSubmit(false);
      }
    });

    const pollInterval = setInterval(async () => {
      elapsed += 2;

      // Update timer UI
      const timerEl = document.getElementById('poll-timer');
      const progressEl = document.getElementById('poll-progress');
      const remain = Math.max(0, maxWaitSeconds - elapsed);
      if (timerEl) timerEl.innerText = remain;
      if (progressEl) progressEl.style.width = Math.min((elapsed / maxWaitSeconds) * 100, 100) + '%';

      // Poll API
      try {
        const queryIds = ids.join(',');
        const response = await fetch(`/api/payment-status/${queryIds}`);
        const data = await response.json();

        if (data.success && data.isPaid) {
          clearInterval(pollInterval);
          Swal.fire({
            icon: 'success',
            title: '🎉 Thanh toán thành công!',
            html: '<p class="mb-1">Ngân hàng / SePay đã xác nhận giao dịch thành công.</p><p class="fw-bold text-success">Bạn đã trở thành Học viên chính thức và thời khóa biểu của các lớp học đã được cập nhật!</p>',
            confirmButtonText: 'Đến Lớp học của tôi',
            confirmButtonColor: '#2ecc71'
          }).then(() => {
            window.location.href = '/classes/my-classes?tab=overview&success=' + encodeURIComponent('Thanh toán học phí thành công! Bạn đã trở thành Học viên chính thức.');
          });
          return;
        }

        if (data.success && data.isFailed) {
          clearInterval(pollInterval);
          Swal.fire({
            icon: 'error',
            title: '❌ Giao dịch thất bại',
            html: '<p>Giao dịch của bạn không thể hoàn tất hoặc đã bị hủy.</p>',
            confirmButtonText: 'Đóng & Kiểm tra lại',
            confirmButtonColor: '#e74c3c'
          }).then(() => {
            window.location.href = targetUrl;
          });
          return;
        }
      } catch (err) {
        console.error('Polling error:', err);
      }

      // Timeout 60s → Thông báo giao dịch thất bại nếu SePay chưa nhận tín hiệu
      if (elapsed >= maxWaitSeconds) {
        clearInterval(pollInterval);
        Swal.fire({
          icon: 'error',
          title: '❌ Giao dịch thất bại',
          html: '<p class="fw-bold text-danger">Chưa nhận được xác nhận thanh toán từ ngân hàng trong vòng 60 giây.</p><p class="small text-muted">Vui lòng kiểm tra lại thông tin chuyển khoản hoặc liên hệ trung tâm để được hỗ trợ.</p>',
          confirmButtonText: 'Đóng & Thử lại',
          confirmButtonColor: '#e74c3c'
        }).then(() => {
          window.location.href = targetUrl;
        });
      }
    }, 2000);
  }

  // Initialize total fee on page load
  document.addEventListener('DOMContentLoaded', () => {
    recalculateCartTotals();
  });
</script>

