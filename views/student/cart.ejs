<%- include('../layouts/header') %>

<style>
  :root {
    --cart-primary: #1a252f;
    --cart-accent: #3498db;
    --cart-success: #2ecc71;
    --cart-danger: #e74c3c;
    --cart-card-shadow: 0 12px 35px rgba(0, 0, 0, 0.05);
    --cart-bg-gradient: linear-gradient(135deg, #3498db, #2ecc71);
  }

  /* Cart Layout */
  .cart-container {
    margin-top: 30px;
    margin-bottom: 60px;
  }

  .cart-card {
    background: #ffffff;
    border-radius: 18px;
    border: 1px solid #eef2f5;
    box-shadow: var(--cart-card-shadow);
    padding: 30px;
    height: 100%;
    transition: all 0.3s ease;
  }

  .cart-card-header {
    border-bottom: 1px solid #eaeef2;
    padding-bottom: 18px;
    margin-bottom: 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .cart-title {
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--cart-primary);
    margin: 0;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  /* Cart Items Table */
  .cart-table-wrapper {
    overflow-x: auto;
  }

  .cart-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }

  .cart-table th {
    background: #f8f9fa;
    color: #4a5568;
    font-weight: 600;
    padding: 14px 18px;
    text-align: left;
    border-bottom: 2px solid #eaeef2;
    text-transform: uppercase;
    font-size: 0.8rem;
    letter-spacing: 0.05em;
  }

  .cart-table td {
    padding: 20px 18px;
    border-bottom: 1px solid #eaeef2;
    color: #2c3e50;
    vertical-align: middle;
  }

  .cart-item-title {
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--cart-primary);
    margin-bottom: 4px;
  }

  .cart-item-course {
    font-size: 0.85rem;
    color: #7f8c8d;
    font-weight: 500;
  }

  .cart-item-badge {
    font-size: 0.75rem;
    background: rgba(52, 152, 219, 0.1);
    color: var(--cart-accent);
    padding: 3px 10px;
    border-radius: 20px;
    font-weight: 600;
  }

  .cart-item-price {
    font-weight: 750;
    color: var(--cart-success);
    font-size: 1.1rem;
  }

  .btn-remove {
    background: transparent;
    border: none;
    color: var(--cart-danger);
    font-size: 1.25rem;
    padding: 5px 10px;
    border-radius: 8px;
    transition: all 0.2s ease;
    cursor: pointer;
  }

  .btn-remove:hover {
    background: rgba(231, 76, 60, 0.08);
    transform: scale(1.08);
  }

  /* Summary Section */
  .summary-card {
    background: #f8f9fa;
    border-radius: 14px;
    padding: 24px;
    border: 1px solid #eaeef2;
  }

  .summary-title {
    font-weight: 700;
    font-size: 1.15rem;
    margin-bottom: 20px;
    color: var(--cart-primary);
    border-bottom: 1.5px solid #eaeef2;
    padding-bottom: 12px;
  }

  .summary-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 16px;
    font-size: 0.95rem;
    color: #4a5568;
  }

  .summary-total {
    border-top: 1.5px solid #eaeef2;
    padding-top: 16px;
    margin-top: 12px;
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--cart-primary);
  }

  .btn-checkout {
    width: 100%;
    padding: 12px;
    font-weight: 700;
    font-size: 1.05rem;
    border-radius: 10px;
    border: none;
    background: var(--cart-bg-gradient);
    color: #fff;
    box-shadow: 0 4px 15px rgba(52, 152, 219, 0.25);
    transition: all 0.25s ease;
    cursor: pointer;
  }

  .btn-checkout:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(52, 152, 219, 0.35);
  }

  .btn-checkout:active {
    transform: translateY(0);
  }

  .empty-cart-state {
    text-align: center;
    padding: 60px 20px;
  }

  .empty-cart-icon {
    font-size: 4rem;
    color: #cbd5e0;
    margin-bottom: 20px;
  }

  /* Payment Modal Styles */
  .qr-code-box {
    background: #fff;
    border: 1px solid #eaeef2;
    border-radius: 12px;
    padding: 8px;
    text-align: center;
    max-width: 340px;
    margin: 0 auto 15px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.03);
  }

  .qr-code-img {
    width: 100%;
    max-width: 320px;
    height: auto;
  }

  .qr-bank-details {
    background: #f8f9fa;
    border-radius: 8px;
    padding: 12px;
    font-size: 0.85rem;
    color: #4a5568;
    text-align: left;
  }

  .qr-bank-details p {
    margin-bottom: 6px;
  }
  .qr-bank-details p:last-child {
    margin-bottom: 0;
  }
</style>
<% 
  let totalAmount = 0;
  cart.forEach(item => { 
    totalAmount += Number(item.HocPhi);
  });
%>

<div class="container cart-container">
  <!-- Dynamic Breadcrumb -->
  <nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Trang chủ</a></li>
      <li class="breadcrumb-item active" aria-current="page">Giỏ hàng của bạn</li>
    </ol>
  </nav>

  <div class="row g-4">
    <!-- Main Cart Content -->
    <div class="col-12">
      <div class="cart-card">
        <div class="cart-card-header">
          <h2 class="cart-title">
            <i class="bi bi-cart3 text-primary"></i> Giỏ hàng khóa học
            <span class="badge bg-primary rounded-pill fs-6" id="cart-badge"><%= cart.length %></span>
          </h2>
          <% if (cart.length > 0) { %>
            <a href="/#KhoaHoc" class="btn btn-outline-secondary btn-sm fw-semibold rounded-3"><i class="bi bi-plus-circle me-1"></i>Thêm lớp khác</a>
          <% } %>
        </div>

        <% if (cart.length === 0) { %>
          <div class="empty-cart-state">
            <i class="bi bi-cart-x empty-cart-icon"></i>
            <h4 class="fw-bold text-dark">Giỏ hàng của bạn đang trống</h4>
            <p class="text-muted mb-4">Hãy tham khảo các chương trình đào tạo TOEIC chất lượng và chọn lớp học phù hợp để bắt đầu lộ trình học tập của mình.</p>
            <a href="/#KhoaHoc" class="btn btn-primary px-4 py-2.5 fw-bold shadow-sm rounded-3"><i class="bi bi-search me-2"></i>Tìm lớp học ngay</a>
          </div>
        <% } else { %>
          <div class="cart-table-wrapper">
            <table class="cart-table" id="cart-items-table">
              <thead>
                <tr>
                  <th style="width: 40px; text-align: center;">
                    <input type="checkbox" id="select-all-cart" class="form-check-input shadow-none" checked onchange="toggleSelectAllCart(this)">
                  </th>
                  <th>Lớp học & Khóa học</th>
                  <th>Học viên đăng ký</th>
                  <th>Khai giảng</th>
                  <th>Học phí</th>
                  <th style="width: 50px;"></th>
                </tr>
              </thead>
              <tbody>
                <% 
                  cart.forEach((item, idx) => { 
                    const itemKey = item.cartItemId || item.MaLopHoc;
                    const defaultProfileIdx = profiles && profiles.length > 0 ? (idx % profiles.length) : 0;
                %>
                  <tr id="cart-row-<%= itemKey %>">
                    <td style="text-align: center; vertical-align: middle;">
                      <input type="checkbox" class="form-check-input cart-item-checkbox shadow-none" data-item-key="<%= itemKey %>" data-id="<%= item.MaLopHoc %>" data-course-id="<%= item.MaKhoaHoc %>" data-level="<%= item.CapDo %>" data-fee="<%= item.HocPhi %>" data-start="<%= item.NgayKhaiGiang %>" data-name="<%= item.TenLop %>" data-course="<%= item.TenKhoaHoc %>" checked onchange="onCartCheckboxChange()">
                    </td>
                    <td>
                      <div class="cart-item-title"><%= item.TenLop %></div>
                      <div class="d-flex align-items-center gap-2">
                        <span class="cart-item-course"><%= item.TenKhoaHoc %></span>
                        <span class="cart-item-badge">TOEIC <%= item.CapDo %></span>
                      </div>
                    </td>
                    <td>
                      <% if (profiles && profiles.length > 0) { %>
                        <select class="form-select form-select-sm cart-student-select shadow-none rounded-3" data-class-id="<%= itemKey %>">
                          <% profiles.forEach((p, pIdx) => { %>
                            <option value="<%= p.MaHocVien %>" <%= pIdx === defaultProfileIdx ? 'selected' : '' %>><%= p.HoTen %> (<%= p.QuanHe || 'Bản thân' %>)</option>
                          <% }) %>
                        </select>
                        <div class="mt-1.5 d-flex flex-wrap gap-2 align-items-center">
                          <button type="button" class="btn btn-sm btn-light-primary text-primary border border-primary-subtle rounded-pill py-0.5 px-2 fw-semibold shadow-none" onclick="addAnotherChildSeat(<%= item.MaLopHoc %>, '<%= item.TenLop %>')" style="font-size: 0.76rem;" title="Bấm để đăng ký thêm 1 suất học cho con khác cùng lớp này">
                            <i class="bi bi-plus-circle-fill me-1 text-primary"></i>+ Thêm suất cho con khác
                          </button>
                          <a href="/classes/my-classes?tab=profile" class="small text-decoration-none text-muted" style="font-size: 0.76rem;" title="Tạo thêm hồ sơ con mới trong Quản lý hồ sơ">
                            <i class="bi bi-person-plus me-1"></i>Tạo hồ sơ mới
                          </a>
                        </div>
                        <% if (item.conflictNotice) { %>
                          <div class="mt-2 alert alert-danger py-1.5 px-2.5 small rounded-3 border-danger-subtle fw-semibold mb-1" style="font-size: 0.78rem;">
                            <i class="bi bi-exclamation-triangle-fill text-danger me-1"></i>⚠️ Lịch học bị <strong>TRÙNG NHAU</strong> với lớp "<%= item.conflictNotice.withClassName %>" (<%= item.conflictNotice.detail %>).
                          </div>
                        <% } %>
                        <div class="mt-1.5 form-check p-2 <%= item.conflictNotice ? 'bg-warning-subtle border-warning' : 'bg-light-subtle border-secondary-subtle' %> rounded-3 border" style="font-size: 0.78rem;">
                          <input type="checkbox" class="form-check-input future-shift-checkbox shadow-none ms-0 me-1" id="futureShift_<%= itemKey %>" data-class-id="<%= itemKey %>" <%= item.autoCheckFutureShift ? 'checked' : '' %>>
                          <label class="form-check-label fw-semibold <%= item.conflictNotice ? 'text-danger-emphasis' : 'text-primary' %>" for="futureShift_<%= itemKey %>" style="cursor: pointer; user-select: none;">
                            <i class="bi bi-clock-history me-1"></i>Đăng ký giữ chỗ suất ưu đãi / Chờ xếp ca đợt mở mới <%= item.autoCheckFutureShift ? '(Tự động tích giữ chỗ né trùng)' : '(Né trùng lịch)' %>
                          </label>
                        </div>
                      <% } else { %>
                        <span class="text-secondary small">Mặc định</span>
                      <% } %>
                    </td>
                    <td>
                      <div class="fw-semibold text-secondary small"><%= new Date(item.NgayKhaiGiang).toLocaleDateString('vi-VN') %></div>
                      <div class="text-muted small" style="font-size: 0.75rem;"><%= item.ThoiLuong %> buổi học</div>
                    </td>
                    <td>
                      <span class="cart-item-price"><%= Number(item.HocPhi).toLocaleString('vi-VN') %> đ</span>
                    </td>
                    <td>
                      <button class="btn-remove" onclick="removeClassFromCart('<%= itemKey %>', <%= item.HocPhi %>, <%= item.MaLopHoc %>)" title="Xóa khỏi giỏ hàng">
                        <i class="bi bi-trash3-fill"></i>
                      </button>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          
          <!-- Checkout Action Bar -->
          <div class="d-flex flex-wrap align-items-center justify-content-between p-3 bg-light border-top rounded-bottom gap-3 mt-3">
            <div class="d-flex align-items-center gap-4">
              <div class="text-dark">
                Đã chọn <strong id="summary-qty" class="text-primary fs-5"><%= cart.length %> lớp</strong>
              </div>
              <div class="text-dark">
                Tổng tạm tính: <strong id="summary-subtotal" class="text-success fs-5"><%= totalAmount.toLocaleString('vi-VN') %> đ</strong>
              </div>
            </div>
            <div>
              <% if (!user) { %>
                <a href="/login?redirect=/courses/cart" class="btn btn-primary px-4 py-2.5 fw-bold rounded-3 shadow-sm"><i class="bi bi-box-arrow-in-right me-2"></i>Đăng nhập để thanh toán</a>
              <% } else if (user.TenVaiTro !== 'Học viên') { %>
                <div class="alert alert-warning py-2 small mb-0 rounded-3">
                  <i class="bi bi-exclamation-triangle-fill me-1"></i> Chỉ tài khoản <strong>Học viên</strong> mới được đăng ký.
                </div>
              <% } else { %>
                <button class="btn btn-primary px-4 py-2.5 fw-bold rounded-3 shadow-sm d-flex align-items-center gap-2" onclick="checkoutCart()">
                  <span class="spinner-border spinner-border-sm d-none" id="checkout-spinner" role="status" aria-hidden="true"></span>
                  <i class="bi bi-credit-card me-1"></i> Thanh toán
                </button>
              <% } %>
            </div>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<!-- VIETQR CART PAYMENT MODAL -->
<div class="modal fade" id="cartPaymentModal" data-bs-backdrop="static" tabindex="-1" aria-labelledby="cartPaymentModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 rounded-4 shadow-lg">
      <div class="modal-header border-bottom py-3">
        <h5 class="modal-title fw-bold" id="cartPaymentModalLabel"><i class="bi bi-wallet2 text-primary me-2"></i>Thanh toán học phí</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-4 text-center">
          <p class="text-secondary small mb-1">Học sinh đăng ký lớp:</p>
          <h5 class="fw-bold text-dark mb-3" id="payment-cart-details">---</h5>
          
          <!-- Discount Promo Display -->
          <div class="mb-4 text-start bg-light p-3 rounded-3 border border-light-subtle">
            <label for="cart-payment-promo" class="form-label small fw-semibold text-secondary">Áp dụng mã khuyến mãi</label>
            <div class="d-flex gap-2">
              <select class="form-select form-select-sm" id="cart-payment-promo" onchange="applyCartPromoCodeInModal()">
                <option value="" data-pct="0" data-code="">Không sử dụng</option>
                <% promotions.forEach(promo => { %>
                  <option value="<%= promo.MaKhuyenMai %>" data-pct="<%= promo.PhanTramGiam %>" data-code="<%= promo.MaCode %>"><%= promo.TenKhuyenMai %> (-<%= promo.PhanTramGiam %>%)</option>
                <% }) %>
              </select>
            </div>
            <div class="d-flex justify-content-between mt-3 pt-2 border-top">
              <span class="small text-muted">Học phí gốc:</span>
              <span class="small text-muted text-decoration-line-through fw-semibold" id="cart-payment-original-fee">0 đ</span>
            </div>
            <div class="d-flex justify-content-between mt-1">
              <span class="fw-bold text-dark">Số tiền cần thanh toán:</span>
              <span class="fw-bold text-success fs-5" id="cart-payment-final-fee">0 đ</span>
            </div>
          </div>

          <!-- Payment Method Selection -->
          <div class="mb-3 text-start bg-light p-3 rounded-3 border border-light-subtle">
            <div class="d-flex align-items-center gap-2">
              <i class="bi bi-qr-code text-primary fs-5"></i>
              <div>
                <strong class="d-block text-dark small">Phương thức thanh toán: Chuyển khoản ngân hàng (VietQR)</strong>
                <span class="text-muted extra-small">Quét mã QR bằng ứng dụng ngân hàng hoặc Momo để tự động đối soát thành công.</span>
              </div>
            </div>
          </div>

          <!-- VietQR Details -->
          <div id="cart-vietqr-details">
            <div class="alert alert-warning py-2 mb-3 text-center fw-bold small d-flex justify-content-between align-items-center rounded-3 border-warning-subtle">
              <span class="text-dark"><i class="bi bi-clock-history text-danger me-1"></i> Mã QR hết hiệu lực trong:</span>
              <span id="cart-qr-modal-timer" class="badge bg-danger fs-6 px-2.5 py-1 rounded-pill">30s</span>
            </div>
            
            <p class="text-muted small mb-2 text-start">Vui lòng quét mã QR dưới đây hoặc chuyển khoản qua ngân hàng để kích hoạt lớp học:</p>
            
            <div class="qr-code-box">
              <img id="cart-vietqr-image" src="" alt="QR Code" class="qr-code-img" />
            </div>

            <div class="qr-bank-details mb-3">
              <p><strong>Ngân hàng:</strong> <%= paymentConfig.bankName %></p>
              <p><strong>Số tài khoản:</strong> <%= paymentConfig.accountNo %></p>
              <p><strong>Chủ tài khoản:</strong> <%= paymentConfig.accountName %></p>
              <p><strong>Số tiền:</strong> <span class="fw-bold text-success" id="cart-qr-detail-amount">0 đ</span></p>
              <p><strong>Nội dung chuyển khoản:</strong> <span class="text-danger fw-bold" id="cart-qr-detail-content">PAYMENT</span></p>
            </div>

            <div class="row g-2">
              <div class="col-6">
                <button type="button" class="btn btn-danger w-100 py-2.5 fw-bold shadow-sm" onclick="cancelCartPaymentSubmit()">
                  <span class="spinner-border spinner-border-sm d-none me-1" id="cart-cancel-spinner" role="status" aria-hidden="true"></span>
                  Hủy thanh toán
                </button>
              </div>
              <div class="col-6">
                <button type="button" class="btn btn-primary w-100 py-2.5 fw-bold shadow-sm" onclick="confirmCartPaymentSubmit()">
                  <span class="spinner-border spinner-border-sm d-none me-1" id="cart-payment-spinner" role="status" aria-hidden="true"></span>
                  Đã chuyển khoản
                </button>
              </div>
            </div>
          </div>
      </div>
    </div>
  </div>
</div>

<script>
  let totalFee = <%= cart.length > 0 ? totalAmount : 0 %>;
  let activeRegisteredIds = [];
  let cartTotalAmount = 0;
  let activeCartQrContent = '';
  const cartItemsInfo = <%- JSON.stringify(cart.map(item => ({ 
    TenLop: item.TenLop, 
    TenKhoaHoc: item.TenKhoaHoc,
    NgayKhaiGiang: item.NgayKhaiGiang,
    HocPhi: item.HocPhi
  }))) %>;
  let activeCartItemsInfo = [];
  let appliedDiscountPercent = 0;
  let appliedPromoCode = '';

  function toggleSelectAllCart(masterCb) {
    const checkboxes = document.querySelectorAll('.cart-item-checkbox');
    checkboxes.forEach(cb => {
      cb.checked = masterCb.checked;
    });
    recalculateCartTotals();
  }

  function onCartCheckboxChange() {
    const checkboxes = document.querySelectorAll('.cart-item-checkbox');
    const masterCb = document.getElementById('select-all-cart');
    const allChecked = Array.from(checkboxes).every(cb => cb.checked);
    if (masterCb) masterCb.checked = allChecked;
    recalculateCartTotals();
  }

  function recalculateCartTotals() {
    const checkboxes = document.querySelectorAll('.cart-item-checkbox');
    let subtotal = 0;
    let checkedCount = 0;

    checkboxes.forEach(cb => {
      if (cb.checked) {
        subtotal += parseFloat(cb.dataset.fee);
        checkedCount++;
      }
    });

    totalFee = subtotal;

    // Update subtotal display
    const subtotalEl = document.getElementById('summary-subtotal');
    if (subtotalEl) subtotalEl.innerText = Number(totalFee).toLocaleString('vi-VN') + ' đ';

    const qtyEl = document.getElementById('summary-qty');
    if (qtyEl) qtyEl.innerText = `${checkedCount} lớp`;
  }

  function removeVietnameseTones(str) {
    if (!str) return '';
    str = str.replace(/à|á|ạ|ả|ã|â|ầ|ấ|ậ|ẩ|ẫ|ă|ằ|ắ|ặ|ẳ|ẵ/g,"a");
    str = str.replace(/è|é|ẹ|ẻ|ẽ|ê|ề|ế|ệ|ể|ẫ/g,"e");
    str = str.replace(/ì|í|ị|ỉ|ĩ/g,"i");
    str = str.replace(/ò|ó|ọ|ỏ|õ|ô|ồ|ố|ộ|ổ|ỗ|ơ|ờ|ớ|ợ|ở|ỡ/g,"o");
    str = str.replace(/ù|ú|ụ|ủ|ũ|ư|ừ|ứ|ự|ử|ữ/g,"u");
    str = str.replace(/ỳ|ý|ỵ|ỷ|ỹ/g,"y");
    str = str.replace(/đ/g,"d");
    str = str.replace(/À|Á|Ạ|Ả|Ã|Â|Ầ|Ấ|Ậ|Ẩ|Ẫ|Ă|Ằ|Ắ|Ặ|Ẳ|Ẵ/g, "A");
    str = str.replace(/È|É|Ẹ|Ẻ|Ẽ|Ê|Ề|Ế|Ệ|Ể|Ễ/g, "E");
    str = str.replace(/Ì|Í|Ị|Ỉ|Ĩ/g, "I");
    str = str.replace(/Ò|Ó|Ọ|Ỏ|Õ|Ô|Ồ|Ố|Ộ|Ổ|Ỗ|Ơ|Ờ|Ớ|Ợ|Ở|Ỡ/g, "O");
    str = str.replace(/Ù|Ú|Ụ|Ủ|Ũ|Ư|Ừ|Ứ|Ự|Ử|Ữ/g, "U");
    str = str.replace(/Ỳ|Ý|Ỵ|Ỷ|Ỹ/g, "Y");
    str = str.replace(/Đ/g, "D");
    return str;
  }

  function addAnotherChildSeat(classId, className) {
    fetch('/cart/add', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ MaLopHoc: classId })
    })
    .then(res => res.json())
    .then(data => {
      if (data.success) {
        Swal.fire({
          icon: 'success',
          title: '🎉 Thêm suất học thành công!',
          text: `Đã thêm 1 suất học cho con/người thân khác vào lớp "${className}".`,
          timer: 1500,
          showConfirmButton: false
        }).then(() => {
          window.location.reload();
        });
      } else if (data.requireChildProfile) {
        Swal.fire({
          icon: 'info',
