                        window.applyOverviewPromoCodeInModal = function () {
                          var promoSelect = document.getElementById('ov-cart-payment-promo');
                          if (!promoSelect) return;
                          var selectedOpt = promoSelect.selectedIndex >= 0 ? promoSelect.options[promoSelect.selectedIndex] : null;
                          var promoCode = selectedOpt ? (selectedOpt.getAttribute('data-code') || '') : '';
                          var pct = selectedOpt ? parseFloat(selectedOpt.getAttribute('data-pct') || 0) : 0;

                          var regCount = 0;
                          if (currentOvRegId) {
                            regCount = currentOvRegId.toString().split(',').filter(function (x) { return x.trim() !== ''; }).length;
                          }

                          var datesList = Array.isArray(currentOvStartDate) ? currentOvStartDate : (currentOvStartDate ? [currentOvStartDate] : []);
                          var today = new Date();
                          today.setHours(0, 0, 0, 0);

                          var hasInvalidDate = false;
                          var invalidDateText = '';
                          var minDiffDays = 999;

                          for (var i = 0; i < datesList.length; i++) {
                            if (!datesList[i]) continue;
                            var sDate = new Date(datesList[i]);
                            sDate.setHours(0, 0, 0, 0);
                            var diff = Math.ceil((sDate.getTime() - today.getTime()) / (1000 * 60 * 60 * 24));
                            if (diff < 10) {
                              hasInvalidDate = true;
                              invalidDateText = sDate.toLocaleDateString('vi-VN');
                              minDiffDays = diff < 0 ? 0 : diff;
                              break;
                            }
                          }

                          if (promoCode === 'COMBO20') {
                            if (regCount < 2) {
                              Swal.fire({
                                icon: 'warning',
                                title: 'Không đủ điều kiện áp dụng',
                                text: 'Khuyến mãi "Combo 2 khóa học" (COMBO20) chỉ áp dụng khi thanh toán từ 2 lớp/khóa học trở lên. Vui lòng sử dụng tính năng Giỏ hàng hoặc Thanh toán gộp!',
                                confirmButtonText: 'Đã hiểu',
                                confirmButtonColor: '#3498db'
                              });
                              promoSelect.selectedIndex = 0;
                              pct = 0;
                            } else if (hasInvalidDate) {
                              Swal.fire({
                                icon: 'warning',
                                title: 'Không đủ điều kiện áp dụng',
                                text: 'Khuyến mãi "Combo 2 khóa học" (COMBO20) yêu cầu TẤT CẢ các lớp học đăng ký phải khai giảng trước ngày khai giảng tối thiểu 10 ngày. Có lớp khai giảng ngày ' + invalidDateText + ' (chỉ còn ' + minDiffDays + ' ngày).',
                                confirmButtonText: 'Đã hiểu',
                                confirmButtonColor: '#3498db'
                              });
                              promoSelect.selectedIndex = 0;
                              pct = 0;
                            }
                          }

                          if (promoCode === 'FLASHSALE15' && (hasInvalidDate || datesList.length === 0)) {
                            Swal.fire({
                              icon: 'warning',
                              title: 'Không đủ điều kiện áp dụng',
                              text: 'Mã Flash Sale Đăng Ký Sớm (FLASHSALE15) chỉ áp dụng cho các lớp học khai giảng sau ít nhất 10 ngày.' + (invalidDateText ? ' Có lớp khai giảng ngày ' + invalidDateText + ' (chỉ còn ' + minDiffDays + ' ngày) nên không được áp dụng!' : ''),
                              confirmButtonText: 'Đã hiểu',
                              confirmButtonColor: '#3498db'
                            });
                            promoSelect.selectedIndex = 0;
                            pct = 0;
                          }

                          currentOvFinalFee = currentOvOrigFee - (currentOvOrigFee * pct / 100);

                          var finalFeeEl = document.getElementById('ov-cart-payment-final-fee');
                          if (finalFeeEl) finalFeeEl.innerText = Number(currentOvFinalFee).toLocaleString('vi-VN') + ' đ';

                          var qrAmountEl = document.getElementById('ov-cart-qr-detail-amount');
                          if (qrAmountEl) qrAmountEl.innerText = Number(currentOvFinalFee).toLocaleString('vi-VN') + ' đ';

                          updateOverviewVietQRUrl();
                        };

