                    <script>
                      // Tab switcher
                      function switchTab(tabName) {
                        if (!tabName) tabName = 'overview';

                        const urlParams = new URLSearchParams(window.location.search);
                        const currentTab = urlParams.get('tab') || 'overview';

                        // Xóa class active ở tất cả các nút
                          document.querySelectorAll('.nav-link-btn').forEach(btn => {
                            btn.classList.remove('active');
                          });
                          // Thêm class active vào nút vừa được click
                          const activeBtn = document.querySelector(`.nav-link-btn[onclick="switchTab('${tabName}')"]`);
                          if (activeBtn) {
                            activeBtn.classList.add('active');
                          }

                        document.querySelectorAll('.portal-tab-panel').forEach(panel => {
                          if (panel.id === `panel-${tabName}`) {
                            panel.classList.add('active');
                            panel.style.setProperty('display', 'block', 'important');
                          } else {
                            panel.classList.remove('active');
                            panel.style.setProperty('display', 'none', 'important');
                          }
                        });

                        if (currentTab !== tabName) {
                          window.location.href = '/classes/my-classes?tab=' + encodeURIComponent(tabName);
                        }
                      }
                      window.switchTab = switchTab;

                      const availableClassesData = <%- JSON.stringify(locals.availableClasses || []) %>;
                      const registeredClassesData = <%- JSON.stringify(locals.registeredClasses || []) %>;
                      const pendingClassesData = <%- JSON.stringify(locals.pendingClasses || []) %>;
                      const pendingOverviewClassesData = <%- JSON.stringify(locals.pendingOverviewClasses || []) %>;

                      window.showClassDetailsModal = function (classIdOrObj) {
                        if (typeof Swal !== 'undefined') {
                          Swal.close();
                        }

                        let cls = null;

                        if (typeof classIdOrObj === 'object' && classIdOrObj !== null) {
                          cls = classIdOrObj;
                        } else {
                          const targetId = String(classIdOrObj).trim();

                          const available = typeof availableClassesData !== 'undefined' ? availableClassesData : [];
                          const registered = typeof registeredClassesData !== 'undefined' ? registeredClassesData : [];
                          const pending = typeof pendingClassesData !== 'undefined' ? pendingClassesData : [];
                          const pendingOverview = typeof pendingOverviewClassesData !== 'undefined' ? pendingOverviewClassesData : [];

                          const matchId = (c) => c && c.MaLopHoc && String(c.MaLopHoc).trim() === targetId;

                          cls = available.find(matchId)
                            || registered.find(matchId)
                            || pending.find(matchId)
                            || pendingOverview.find(matchId);
                        }

                        if (!cls) {
                          console.warn("Không tìm thấy lớp với ID:", classIdOrObj);
                          if (typeof Swal !== 'undefined') {
                            Swal.fire('Thông báo', 'Không tải được chi tiết lớp học này. Vui lòng tải lại trang.', 'warning');
                          }
                          return;
                        }

                        const spotsLeft = (cls.SiSoToiDa || 25) - (cls.SiSoHienTai || 0);
                        const isFull = spotsLeft <= 0;

                        // TÌM BẢN GHI ĐĂNG KÝ (NẾU CÓ) ĐỂ KIỂM TRA TRẠNG THÁI THANH TOÁN
                        const safeRegistered = typeof registeredClassesData !== 'undefined' ? registeredClassesData : [];
                        const safePendingOverview = typeof pendingOverviewClassesData !== 'undefined' ? pendingOverviewClassesData : [];
                        const safePendingGuest = typeof pendingClassesData !== 'undefined' ? pendingClassesData : [];

                        const totalProfilesCount = (typeof userProfilesData !== 'undefined' && userProfilesData && userProfilesData.length > 0) ? userProfilesData.length : 1;
