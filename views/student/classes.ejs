                                                          </div>
                                                          <% if (isReserved) { %>
                                                            <div class="small text-warning-emphasis fw-semibold mt-0.5" style="font-size: 0.78rem;">
                                                              <i class="bi bi-shield-lock-fill text-warning me-1"></i>Lớp giữ chỗ · Chờ hoàn thành <%= prereqCourseName %>
                                                            </div>
                                                          <% } %>
                                                          <div class="small text-primary fw-semibold"><i
                                                              class="bi bi-person-badge me-1"></i>GV: <%= cls.TenGiangVien || 'Chưa phân công' %>
                                                          </div>
                                                          <div class="small text-success fw-semibold mt-0.5"><i
                                                              class="bi bi-person-circle me-1"></i>Học viên: <%= cls.TenHocVien || (typeof user !== 'undefined' && user.HoTen) || 'Học viên' %>
                                                              <% if (cls.QuanHe) { %> (<%= cls.QuanHe %>)<% } %>
                                                          </div>
                                                        </td>
                                                        <td>
                                                          <div class="small">
                                                            <span class="d-block text-dark"><strong>Khai giảng:</strong>
                                                              <%= cls.NgayKhaiGiang ? new Date(cls.NgayKhaiGiang).toLocaleDateString('vi-VN') : 'Đang cập nhật' %>
                                                            </span>
                                                            <span class="d-block text-muted"><strong>Kết thúc:</strong>
                                                              <%= cls.NgayKetThuc ? new Date(cls.NgayKetThuc).toLocaleDateString('vi-VN') : 'Đang cập nhật' %>
                                                            </span>
                                                            <% if (isClassUpcoming) { %>
                                                              <span class="badge bg-info-subtle text-info border border-info-subtle px-2 py-0.5 mt-1 small fw-normal">
                                                                <i class="bi bi-clock-history me-1"></i>Sắp khai giảng
                                                              </span>
                                                            <% } %>
                                                          </div>
                                                        </td>
                                                        <td>
                                                          <% if (isReserved) { %>
                                                            <div class="small" style="min-width: 160px;">
                                                              <div class="d-flex justify-content-between align-items-center mb-1">
                                                                <span class="fw-bold text-warning-emphasis">Buổi 0 / <%= cls.TongSoBuoi %></span>
                                                                <span class="badge bg-warning-subtle text-warning-emphasis border-0 px-1.5 py-0.5" style="font-size: 0.72rem;">Chờ khóa trước</span>
                                                              </div>
                                                              <div class="progress" style="height: 6px; border-radius: 4px;" title="Tạm khóa bài học. Lớp sẽ tự động kích hoạt khi bạn hoàn thành <%= prereqCourseName %>">
                                                                <div class="progress-bar bg-warning opacity-50 progress-bar-striped" role="progressbar" style="width: 100%;" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100"></div>
                                                              </div>
                                                            </div>
                                                          <% } else if (isClassUpcoming) { %>
                                                            <div class="small" style="min-width: 160px;">
                                                              <div class="d-flex justify-content-between align-items-center mb-1">
                                                                <span class="fw-bold text-info">Buổi 0 / <%= cls.TongSoBuoi %></span>
                                                                <span class="badge bg-info-subtle text-info border-0 px-1.5 py-0.5" style="font-size: 0.75rem;">Chưa diễn ra</span>
                                                              </div>
                                                              <div class="progress" style="height: 6px; border-radius: 4px;" title="Lớp chưa tới ngày khai giảng (<%= cls.NgayKhaiGiang ? new Date(cls.NgayKhaiGiang).toLocaleDateString('vi-VN') : '' %>)">
                                                                <div class="progress-bar bg-info opacity-50 progress-bar-striped" role="progressbar" style="width: 100%;" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100"></div>
                                                              </div>
                                                            </div>
                                                          <% } else { %>
                                                            <div class="small" style="min-width: 160px;">
                                                              <div class="d-flex justify-content-between align-items-center mb-1">
                                                                <span class="fw-bold text-primary">Buổi <%= cls.BuoiHienTai %> / <%= cls.TongSoBuoi %></span>
                                                                <span class="text-muted small">Còn <%= cls.SoBuoiConLai %> buổi</span>
                                                              </div>
                                                              <div class="progress" style="height: 6px; border-radius: 4px;" title="Đã học <%= cls.SoBuoiDaHoc %>/<%= cls.TongSoBuoi %> buổi">
                                                                <div class="progress-bar bg-primary" role="progressbar" style="width: <%= cls.TienDoPercent %>%;" aria-valuenow="<%= cls.TienDoPercent %>" aria-valuemin="0" aria-valuemax="100"></div>
                                                              </div>
                                                            </div>
                                                          <% } %>
                                                        </td>
                                                        <td>
                                                          <% if (cls.LichHoc && cls.LichHoc !=='Chưa có lịch' ) { %>
                                                            <span
                                                              class="badge bg-light text-dark border px-2.5 py-1.5 fw-normal"
                                                              style="font-size: 0.82rem;">
                                                              <i class="bi bi-clock me-1 text-primary"></i>
                                                              <%= cls.LichHoc %>
                                                            </span>
                                                            <% } else { %>
                                                              <span class="text-muted small">Chưa có lịch</span>
                                                              <% } %>
                                                        </td>
                                                        <td>
                                                          <span class="fw-bold text-dark">
                                                            <%= Number(cls.HocPhiDaGiam || cls.HocPhi || 0).toLocaleString('vi-VN') %> đ
                                                          </span>
                                                        </td>
                                                        <td>
                                                          <% if (cls.TrangThai === 'Chờ xử lý - Xin chuyển lớp') { %>
                                                            <span class="badge bg-warning text-dark border border-warning rounded-pill px-3 py-1 fw-semibold"><i class="bi bi-clock-history me-1"></i>Chờ duyệt chuyển lớp</span>
                                                          <% } else if (['Chờ Admin duyệt ngừng học', 'Ngừng học', 'Đã ngừng học'].includes(cls.TrangThai)) { %>
                                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-1 fw-semibold"><i class="bi bi-x-circle-fill me-1"></i><%= cls.TrangThai === 'Chờ Admin duyệt ngừng học' ? 'Ngừng học chờ duyệt' : 'Ngừng học' %></span>
                                                          <% } else if (cls.SoLanChuyenLop >= 2) { %>
                                                            <span class="badge bg-secondary text-white border border-secondary rounded-pill px-3 py-1 fw-semibold" title="Đã đạt giới hạn chuyển lớp tối đa (2/2 lần)"><i class="bi bi-lock-fill me-1"></i>Đã đạt giới hạn chuyển (2/2)</span>
                                                          <% } else if (isReserved) { %>
                                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning rounded-pill px-3 py-1 fw-semibold" title="Bạn đã đăng ký giữ chỗ thành công. Lớp này sẽ tự động kích hoạt bài học khi bạn hoàn thành <%= prereqCourseName %>"><i class="bi bi-shield-lock-fill me-1"></i>Giữ chỗ (Chờ hoàn thành <%= prereqCourseName %>)</span>
                                                            <button type="button" class="btn btn-sm btn-outline-primary fw-semibold rounded-pill px-2.5 py-1 ms-2 shadow-sm" data-bs-toggle="modal" data-bs-target="#studentTransferModal<%= cls.MaDangKy %>" onclick="event.stopPropagation();" title="Gửi yêu cầu xin chuyển sang lớp khác">
                                                              <i class="bi bi-arrow-left-right me-1"></i>Xin chuyển lớp (<%= (cls.SoLanChuyenLop || 0) %>/2)
                                                            </button>
                                                          <% } else if (isClassUpcoming) { %>
                                                            <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill px-3 py-1 fw-semibold" title="Đã kích hoạt, chờ tới ngày khai giảng <%= cls.NgayKhaiGiang ? new Date(cls.NgayKhaiGiang).toLocaleDateString('vi-VN') : '' %>"><i class="bi bi-calendar-event me-1"></i>Sắp khai giảng</span>
                                                            <button type="button" class="btn btn-sm btn-outline-primary fw-semibold rounded-pill px-2.5 py-1 ms-2 shadow-sm" data-bs-toggle="modal" data-bs-target="#studentTransferModal<%= cls.MaDangKy %>" onclick="event.stopPropagation();" title="Gửi yêu cầu xin chuyển sang lớp khác">
                                                              <i class="bi bi-arrow-left-right me-1"></i>Xin chuyển lớp (<%= (cls.SoLanChuyenLop || 0) %>/2)
                                                            </button>
                                                          <% } else if (['Hoàn thành', 'Đã hoàn thành'].includes(cls.TrangThai)) { %>
                                                            <span class="badge bg-success text-white border border-success rounded-pill px-3 py-1 fw-semibold"><i class="bi bi-patch-check-fill me-1"></i>Hoàn thành</span>
                                                          <% } else { %>
                                                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1 fw-semibold"><i class="bi bi-check-circle-fill me-1"></i>Đang học</span>
                                                            <button type="button" class="btn btn-sm btn-outline-primary fw-semibold rounded-pill px-2.5 py-1 ms-2 shadow-sm" data-bs-toggle="modal" data-bs-target="#studentTransferModal<%= cls.MaDangKy %>" onclick="event.stopPropagation();" title="Gửi yêu cầu xin chuyển sang lớp khác">
                                                              <i class="bi bi-arrow-left-right me-1"></i>Xin chuyển lớp (<%= (cls.SoLanChuyenLop || 0) %>/2)
                                                            </button>
                                                          <% } %>
                                                          <% if (cls.GhiChu && cls.GhiChu.includes('Từ chối chuyển lớp')) { %>
                                                             <div class="mt-1 text-start">
                                                               <small class="badge bg-danger-subtle text-danger border border-danger-subtle fw-medium text-wrap" style="max-width: 280px;" title="<%= cls.GhiChu %>"><i class="bi bi-exclamation-circle-fill me-1"></i><%= cls.GhiChu %></small>
                                                             </div>
                                                           <% } %></td>


                                                            <!-- Modal Xin Chuyển Lớp Cho Học Viên -->
                                                            <div class="modal fade" id="studentTransferModal<%= cls.MaDangKy %>" tabindex="-1" aria-hidden="true" onclick="event.stopPropagation();">
                                                              <div class="modal-dialog modal-dialog-centered">
                                                                <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
                                                                  <div class="modal-header border-bottom bg-light py-3 px-4">
                                                                    <h5 class="modal-title fw-bold text-primary"><i class="bi bi-arrow-left-right me-2"></i>Gửi phiếu xin chuyển lớp</h5>
                                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                                  </div>
                                                                  <form action="/classes/student-request-transfer" method="POST">
                                                                    <input type="hidden" name="MaDangKy" value="<%= cls.MaDangKy %>" />
                                                                    
                                                                    <div class="p-3 bg-light border-bottom text-start">
                                                                      <% if (cls.SoLanChuyenLop >= 2) { %>
                                                                        <div class="alert alert-danger border-danger rounded-3 mb-2 p-3 text-start small">
                                                                          <div class="fw-bold text-danger mb-1"><i class="bi bi-exclamation-octagon-fill me-1"></i>ĐÃ ĐẠT GIỚI HẠN CHUYỂN LỚP (Tối đa 2 lần)</div>
                                                                          <div>Học viên đã chuyển lớp <strong><%= cls.SoLanChuyenLop %>/2 lần</strong> cho phép. Theo quy định của trung tâm, hệ thống <strong>từ chối tiếp nhận</strong> thêm phiếu yêu cầu xin chuyển lớp.</div>
                                                                        </div>
                                                                      <% } else if (cls.SoLanChuyenLop === 1) { %>
                                                                        <div class="alert alert-warning border-warning rounded-3 mb-2 p-3 text-start small">
                                                                          <div class="fw-bold text-dark mb-1"><i class="bi bi-exclamation-triangle-fill text-warning me-1"></i>LƯU Ý NGOẠI LỆ (Lần chuyển thứ 2 / Tối đa)</div>
                                                                          <div>Tiêu chuẩn trung tâm hỗ trợ đổi lớp 1 lần. Đây là <strong>lần chuyển thứ 2 (ngoại lệ tối đa)</strong>. Học viên cần nêu rõ <strong>LÝ DO BẤT KHẢ KHÁNG</strong> (như tai nạn, ốm đau, trung tâm đổi lịch học...) để Admin xem xét linh động.</div>
                                                                        </div>
                                                                      <% } else { %>
                                                                        <div class="alert alert-info border-info rounded-3 mb-2 p-2.5 text-start small">
                                                                          <i class="bi bi-info-circle-fill text-info me-1"></i><strong>Quy định chuẩn:</strong> Học viên được xin chuyển lớp 1 lần duy nhất trong suốt khóa học.
                                                                        </div>
                                                                      <% } %>

                                                                      <% if (cls.BuoiHienTai > 2) { %>
                                                                        <div class="alert alert-warning border-warning rounded-3 mb-0 p-2.5 text-start small">
                                                                          <div class="fw-bold text-dark mb-1"><i class="bi bi-clock-history text-warning me-1"></i>Lớp đã qua <strong><%= cls.BuoiHienTai %> buổi</strong> (> 2 buổi quy định)</div>
                                                                          <div>Phiếu của bạn sẽ được chuyển lên Ban Quản Lý Admin để thẩm định trường hợp đặc biệt trước khi duyệt.</div>
                                                                        </div>
                                                                      <% } else { %>
                                                                        <div class="alert alert-success border-success rounded-3 mb-0 p-2.5 text-start small">
                                                                          <i class="bi bi-check-circle-fill text-success me-1"></i>Lớp đang ở buổi thứ <strong><%= cls.BuoiHienTai || 1 %></strong> (&le; 2 buổi quy định). Đủ điều kiện chuẩn xin chuyển lớp!
                                                                        </div>
                                                                      <% } %>
                                                                    </div>

                                                                    <div class="modal-body p-4 text-start">
                                                                      <div class="mb-3 p-3 bg-light rounded-3 border">
                                                                        <div><strong>Học viên:</strong> <%= cls.TenHocVien || (typeof user !== 'undefined' && user.HoTen) || 'Học viên' %></div>
                                                                        <div><strong>Lớp hiện tại:</strong> <span class="text-danger fw-bold"><%= cls.TenLop %></span> (<%= cls.TenKhoaHoc %>)</div>
                                                                        <div><strong>Số lần đã chuyển lớp:</strong> <span class="badge <%= cls.SoLanChuyenLop >= 2 ? 'bg-danger' : (cls.SoLanChuyenLop === 1 ? 'bg-warning text-dark' : 'bg-success') %> rounded-pill px-2.5 py-1"><%= cls.SoLanChuyenLop || 0 %> / 2 lần</span></div>
                                                                      </div>

                                                                      <!-- 1. Lý do xin chuyển lớp -->
                                                                      <div class="mb-3">
                                                                        <label class="form-label fw-semibold text-dark"><i class="bi bi-question-circle-fill text-primary me-1"></i>1. Lý do xin chuyển lớp</label>
                                                                        <select class="form-select border-2 mb-2" id="reasonPresetSelect<%= cls.MaDangKy %>" <% if (cls.SoLanChuyenLop >= 2) { %>disabled<% } %>>
                                                                          <option value="Chuyển đổi cấp độ/Sai trình độ" selected>🎯 Chuyển đổi cấp độ/Sai trình độ (Hiển thị tất cả các trình độ)</option>
                                                                          <option value="Trùng lịch học trường / ca làm việc">⏰ Trùng lịch học trường / ca làm việc (Chỉ đề xuất lớp cùng trình độ)</option>
                                                                          <option value="Lý do sức khỏe / cá nhân">🏥 Lý do sức khỏe / cá nhân (Chỉ đề xuất lớp cùng trình độ)</option>
                                                                          <option value="Muốn đổi ca / giảng viên khác">👨‍🏫 Muốn đổi ca / giảng viên khác (Chỉ đề xuất lớp cùng trình độ)</option>
                                                                          <option value="Khác">📝 Lý do khác (Tự nhập...)</option>
                                                                        </select>
                                                                        <textarea class="form-control border-2" name="LyDoXinChuyenLop" id="reasonTextarea<%= cls.MaDangKy %>" rows="2" placeholder="Chi tiết lý do xin chuyển lớp..." required <% if (cls.SoLanChuyenLop >= 2) { %>disabled<% } %>>Chuyển đổi cấp độ/Sai trình độ</textarea>
                                                                        <small class="text-muted mt-1 d-block"><i class="bi bi-info-circle text-info me-1"></i>Lý do Sai trình độ cho phép chọn mọi lớp. Lý do khác hệ thống sẽ tự động chỉ đề xuất các lớp ngang tầm.</small>
                                                                      </div>

                                                                      <!-- 2. Chọn lớp học mới -->
                                                                      <div class="mb-3">
                                                                        <label class="form-label fw-semibold text-dark"><i class="bi bi-arrow-right-circle-fill text-success me-1"></i>2. Chọn lớp học mới muốn chuyển tới</label>
                                                                        <select class="form-select border-2" name="MaLopHocMoi" id="targetClassSelect<%= cls.MaDangKy %>" required <% if (cls.SoLanChuyenLop >= 2) { %>disabled<% } %>>
                                                                           <% 
                                                                             const getProfGroup = (capDo, courseName) => {
                                                                               const cap = (capDo || '').trim().toLowerCase();
                                                                               if (cap) {
                                                                                 if (cap.includes('foundation') || cap.includes('300') || cap.includes('pre')) return 'LEVEL_FOUNDATION_300';
                                                                                 if (cap.includes('650') || cap.includes('600')) return 'LEVEL_ADVANCED_650';
                                                                                 return cap;
                                                                               }

                                                                               const text = (courseName || '').trim().toLowerCase();
                                                                               if (text.includes('foundation') || text.includes('300') || text.includes('pre')) return 'LEVEL_FOUNDATION_300';
                                                                               if (text.includes('650') || text.includes('600') || text.includes('luyện đề') || text.includes('luyen de')) return 'LEVEL_ADVANCED_650';
                                                                               if (text.includes('450') || text.includes('500') || text.includes('toeic a') || text.includes('cấp tốc') || text.includes('cap toc')) return 'LEVEL_INTERMEDIATE_450';
                                                                               return text;
                                                                             };
                                                                             const sameLevelClasses = availableClasses.filter(c => c.MaLopHoc !== cls.MaLopHoc && getProfGroup(c.CapDo, c.TenKhoaHoc || c.TenLop) === getProfGroup(cls.CapDo, cls.TenKhoaHoc || cls.TenLop));
                                                                             const diffLevelClasses = availableClasses.filter(c => c.MaLopHoc !== cls.MaLopHoc && getProfGroup(c.CapDo, c.TenKhoaHoc || c.TenLop) !== getProfGroup(cls.CapDo, cls.TenKhoaHoc || cls.TenLop));
                                                                           %>
                                                                            <option value="BAO_LUU">🔒 Đăng ký giữ chỗ trước / Chưa có lớp mở phù hợp (Bảo lưu kết quả chờ đợt khai giảng mới)</option>
                                                                            <% if (sameLevelClasses.length > 0) { %>
                                                                              <optgroup label="📌 Lớp có trình độ ngang tầm (Đề xuất cùng cấp độ)" data-group="same-level">
                                                                                <% sameLevelClasses.forEach(c => { 
                                                                                     const oldFee = Number(cls.HocPhiDaGiam || cls.HocPhi || 0);
                                                                                     const newFee = Number(c.HocPhi || 0);
                                                                                     const diff = Math.max(0, newFee - oldFee);
                                                                                     const diffText = diff > 0 ? " [BẮT BUỘC NỘP THÊM: +" + diff.toLocaleString('vi-VN') + " đ]" : "";
                                                                                %>
                                                                                  <option value="<%= c.MaLopHoc %>" data-fee-diff="<%= diff %>" data-fee-new="<%= newFee %>"><%= c.TenLop %> - <%= c.TenKhoaHoc %> (Trình độ: <%= c.CapDo || 'Khác' %>, Sĩ số: <%= c.SiSoHienTai || 0 %> / <%= c.SiSoToiDa %>)<%= diffText %></option>
                                                                                <% }) %>
                                                                              </optgroup>
                                                                            <% } %>
                                                                            <% if (diffLevelClasses.length > 0) { %>
                                                                              <optgroup label="🎯 Lớp cấp độ khác (Chuyển cấp độ / Sai trình độ)" data-group="diff-level">
                                                                                <% diffLevelClasses.forEach(c => { 
                                                                                     const oldFee = Number(cls.HocPhiDaGiam || cls.HocPhi || 0);
                                                                                     const newFee = Number(c.HocPhi || 0);
                                                                                     const diff = Math.max(0, newFee - oldFee);
                                                                                     const diffText = diff > 0 ? " [BẮT BUỘC NỘP THÊM: +" + diff.toLocaleString('vi-VN') + " đ]" : "";
                                                                                %>
                                                                                  <option value="<%= c.MaLopHoc %>" data-fee-diff="<%= diff %>" data-fee-new="<%= newFee %>"><%= c.TenLop %> - <%= c.TenKhoaHoc %> (Trình độ: <%= c.CapDo || 'Khác' %>, Sĩ số: <%= c.SiSoHienTai || 0 %> / <%= c.SiSoToiDa %>)<%= diffText %></option>
                                                                                <% }) %>
                                                                              </optgroup>
                                                                            <% } %>
                                                                        </select>
                                                                      </div>

                                                                      <!-- Dynamic Notice Box -->
                                                                      <div class="mb-3 p-3 bg-info-subtle rounded-3 border border-info" id="transferFeeNotice<%= cls.MaDangKy %>" style="display: none;">
                                                                        <div class="small fw-semibold text-info-emphasis" id="transferFeeNoticeText<%= cls.MaDangKy %>"></div>
                                                                      </div>

                                                                      <script>
                                                                        (function() {
                                                                          const modalId = 'studentTransferModal<%= cls.MaDangKy %>';
                                                                          const initModalLogic = function() {
                                                                            const modalEl = document.getElementById(modalId);
                                                                            if (!modalEl) return;
                                                                            const sel = modalEl.querySelector('#targetClassSelect<%= cls.MaDangKy %>');
                                                                            const reasonPreset = modalEl.querySelector('#reasonPresetSelect<%= cls.MaDangKy %>');
                                                                            const reasonTxt = modalEl.querySelector('#reasonTextarea<%= cls.MaDangKy %>');
                                                                            const box = modalEl.querySelector('#transferFeeNotice<%= cls.MaDangKy %>');
                                                                            const txt = modalEl.querySelector('#transferFeeNoticeText<%= cls.MaDangKy %>');
                                                                            if (!sel || !box || !txt) return;

                                                                            function updateNotice() {
                                                                              const opt = sel.options[sel.selectedIndex];
                                                                              if (!opt || opt.disabled || opt.hidden) return;
                                                                              if (opt.value === 'BAO_LUU') {
                                                                                box.style.display = 'block';
                                                                                box.className = 'mb-3 p-3 bg-warning-subtle rounded-3 border border-warning text-warning-emphasis';
                                                                                txt.innerHTML = '<i class="bi bi-clock-history me-1"></i> <strong>Chế độ Bảo lưu:</strong> Trạng thái học tập sẽ được tự động chuyển sang <strong>Bảo lưu kết quả</strong> cho đến khi trung tâm mở đợt lớp mới.';
                                                                              } else {
                                                                                const diff = Number(opt.getAttribute('data-fee-diff') || 0);
                                                                                if (diff > 0) {
                                                                                  box.style.display = 'block';
                                                                                  box.className = 'mb-3 p-3 bg-danger-subtle rounded-3 border border-danger text-danger-emphasis';
                                                                                  txt.innerHTML = '<i class="bi bi-wallet2 text-danger me-1"></i> <strong>BẮT BUỘC THANH TOÁN BỔ SUNG:</strong> Lớp mới có học phí cao hơn lớp cũ. Bạn <strong>bắt buộc phải nộp bổ sung <span class="text-danger fw-bold fs-6">' + diff.toLocaleString('vi-VN') + ' đ</span></strong> sau khi Ban Quản Lý Admin phê duyệt để chính thức hoàn tất chuyển lớp.';
                                                                                } else {
                                                                                  box.style.display = 'block';
                                                                                  box.className = 'mb-3 p-3 bg-success-subtle rounded-3 border border-success text-success-emphasis';
                                                                                  txt.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i> Học phí lớp mới bằng hoặc thấp hơn lớp cũ. Không phát sinh chi phí đóng thêm.';
                                                                                }
                                                                              }
                                                                            }

                                                                            function filterClassesByReason() {
                                                                              const rVal = (reasonPreset ? reasonPreset.value : '') || (reasonTxt ? reasonTxt.value : '');
                                                                              const isWrongLevel = rVal.includes('Sai trình độ') || rVal.includes('Chuyển đổi cấp độ');
                                                                              const diffGroup = sel.querySelector('optgroup[data-group="diff-level"]');
                                                                              if (diffGroup) {
                                                                                diffGroup.hidden = !isWrongLevel;
                                                                                diffGroup.style.display = isWrongLevel ? '' : 'none';
                                                                                diffGroup.querySelectorAll('option').forEach(opt => {
                                                                                  opt.hidden = !isWrongLevel;
                                                                                  opt.disabled = !isWrongLevel;
                                                                                });
                                                                                if (!isWrongLevel && sel.selectedOptions[0] && sel.selectedOptions[0].parentElement === diffGroup) {
                                                                                  sel.selectedIndex = 0;
                                                                                }
                                                                              }
                                                                              updateNotice();
                                                                            }

                                                                            if (reasonPreset) {
                                                                              reasonPreset.addEventListener('change', function() {
                                                                                if (this.value === 'Chuyển đổi cấp độ/Sai trình độ') {
                                                                                  if (reasonTxt) reasonTxt.value = 'Chuyển đổi cấp độ/Sai trình độ';
                                                                                } else if (this.value && this.value !== 'Khác') {
                                                                                  if (reasonTxt) reasonTxt.value = this.value;
                                                                                } else if (this.value === 'Khác') {
                                                                                  if (reasonTxt) { reasonTxt.value = ''; reasonTxt.focus(); }
                                                                                }
                                                                                filterClassesByReason();
                                                                              });
                                                                            }

                                                                            if (reasonTxt) {
                                                                              reasonTxt.addEventListener('input', filterClassesByReason);
                                                                            }

                                                                            sel.addEventListener('change', updateNotice);
                                                                            filterClassesByReason();
                                                                          };

                                                                          if (document.readyState === 'loading') {
                                                                            document.addEventListener('DOMContentLoaded', initModalLogic);
                                                                          } else {
                                                                            initModalLogic();
                                                                          }
                                                                        })();
                                                                      </script>
                                                                      <small class="text-muted mt-2 d-block"><i class="bi bi-shield-check text-success me-1"></i>Phiếu xin chuyển lớp của bạn sẽ được gửi tới Ban Quản Lý Admin để xem xét và duyệt.</small>
                                                                    </div>
                                                                    <div class="modal-footer border-top bg-light px-4 py-3">
                                                                      <button type="button" class="btn btn-outline-secondary rounded-3" data-bs-dismiss="modal">Hủy</button>
                                                                      <button type="submit" class="btn btn-primary fw-bold px-4 rounded-3" <% if (cls.SoLanChuyenLop >= 2) { %>disabled<% } %>><i class="bi bi-send-fill me-1"></i>Gửi phiếu yêu cầu</button>
                                                                    </div>
                                                                  </form>
                                                                </div>
                                                              </div>
                                                            </div>
                                                        
                                                      </tr>
                                                      <% }) %>
                                                  </tbody>
                                                </table>
                                              </div>
                                              <% } %>
                                        </div>

<!-- Attendance History -->
