                      function openBulkPaymentModal() {
                        const checked = Array.from(document.querySelectorAll('.unpaid-reg-checkbox:checked'));
                        if (checked.length === 0) {
                          Swal.fire({ icon: 'warning', title: 'Thông báo', text: 'Vui lòng chọn ít nhất 1 lớp học để thanh toán!' });
                          return;
                        }

                        const regIds = checked.map(cb => cb.value).join(',');
                        let totalFee = 0;
                        const startDates = [];
                        checked.forEach(cb => {
                          totalFee += parseFloat(cb.getAttribute('data-fee') || 0);
                          if (cb.getAttribute('data-start')) {
                            startDates.push(cb.getAttribute('data-start'));
                          }
                        });

                        if (typeof window.openOverviewCartPaymentModal === 'function') {
                          window.openOverviewCartPaymentModal(regIds, `Thanh toán gộp (${checked.length} lớp)`, totalFee, startDates);
                        } else {
                          openPaymentModal(regIds, `Thanh toán gộp (${checked.length} lớp)`, totalFee, startDates);
                        }
