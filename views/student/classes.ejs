                      function unlockProfileEdit() {
                        ['profile-name', 'profile-phone', 'profile-dob', 'profile-district', 'profile-street'].forEach(id => {
                          const el = document.getElementById(id);
                          if (el) {
                            el.disabled = false;
                            el.removeAttribute('disabled');
                          }
                        });
                        const btnUnlock = document.getElementById('btn-unlock-profile');
                        const btnSave = document.getElementById('btn-save-profile');
                        const btnCancel = document.getElementById('btn-cancel-profile');

                        if (btnUnlock) btnUnlock.style.setProperty('display', 'none', 'important');
                        if (btnSave) btnSave.classList.remove('d-none');
                        if (btnCancel) btnCancel.classList.remove('d-none');

                        initProfileAddress();
                      }
                      window.unlockProfileEdit = unlockProfileEdit;

                      document.addEventListener('DOMContentLoaded', () => {
                        const unlockBtn = document.getElementById('btn-unlock-profile');
                        if (unlockBtn) {
                          unlockBtn.addEventListener('click', (e) => {
                            e.preventDefault();
                            unlockProfileEdit();
                          });
                        }

                        const addChildBtn = document.getElementById('btn-add-child-profile');
                        if (addChildBtn) {
                          addChildBtn.addEventListener('click', (e) => {
                            e.preventDefault();
                            openAddStudentProfileModal();
                          });
                        }
                      });

                      function initProfileAddress() {
                        const hiddenVal = document.getElementById('profile-address-hidden')?.value || '';
                        if (hiddenVal) {
                          const distEl = document.getElementById('profile-district');
                          const streetEl = document.getElementById('profile-street');
                          if (distEl) {
                            Array.from(distEl.options).forEach(opt => {
                              if (hiddenVal.includes(opt.value) && opt.value !== 'Chưa chọn khu vực') {
                                opt.selected = true;
                              }
                            });
                          }
                          if (streetEl) {
                            if (distEl && distEl.value && distEl.value !== 'Chưa chọn khu vực') {
                              streetEl.value = hiddenVal.replace(distEl.value, '').replace(/,\s*$/, '').trim();
                            } else {
                              streetEl.value = hiddenVal;
                            }
                          }
                        }
                      }

                      document.addEventListener('DOMContentLoaded', initProfileAddress);
                      initProfileAddress();

                      function lockProfileEdit() {
                        ['profile-name', 'profile-phone', 'profile-dob', 'profile-district', 'profile-street'].forEach(id => {
                          const el = document.getElementById(id);
                          if (el) el.setAttribute('disabled', 'disabled');
                        });
                        document.getElementById('btn-unlock-profile')?.classList.remove('d-none');
                        document.getElementById('btn-save-profile')?.classList.add('d-none');
                        document.getElementById('btn-cancel-profile')?.classList.add('d-none');
                      }
                      window.lockProfileEdit = lockProfileEdit;

                      function combineProfileAddress() {
                        const distEl = document.getElementById('profile-district');
                        const streetEl = document.getElementById('profile-street');
                        const hiddenEl = document.getElementById('profile-address-hidden');
                        if (!distEl || !streetEl || !hiddenEl) return;

                        const streetVal = streetEl.value.trim();
                        const distVal = distEl.value.trim();

                        if (streetVal && distVal && distVal !== 'Chưa chọn khu vực') {
                          hiddenEl.value = `${streetVal}, ${distVal}`;
                        } else if (streetVal) {
                          hiddenEl.value = streetVal;
                        } else if (distVal && distVal !== 'Chưa chọn khu vực') {
                          hiddenEl.value = distVal;
                        } else {
                          hiddenEl.value = '';
                        }
                      }

                      function confirmProfileUpdate(event) {
                        combineProfileAddress();
                        return true;
                      }

