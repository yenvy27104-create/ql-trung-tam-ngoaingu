                                                                </div>
                                                              </div>
                                                            </div>
                                                          </div>
                                                        <% }) %>
                                                      <% } %>
                                                    </div>
                                                  </div>
                                                </div>


                      <% } %>
</section>

                      <!-- PANEL 2: TIMETABLE -->
                      <section class="portal-tab-panel <%= currentTab === 'timetable' ? 'active' : '' %>"
                        id="panel-timetable"
                        style="display: <%= currentTab === 'timetable' ? 'block' : 'none' %> !important;">
                        <div class="portal-card">
                          <div class="portal-card-header">
                            <h4 class="portal-card-title"><i class="bi bi-calendar-range-fill text-primary"></i> Thời
                              khóa biểu hàng tuần</h4>
                            <span class="text-muted small">Thời khóa biểu dựa trên các lớp học đã đăng ký thành
                              công</span>
                          </div>

<%
  // Ẩn lớp Sắp khai giảng (chưa tới ngày học) khỏi Thời khóa biểu tuần, chỉ hiển thị lớp Đang diễn ra thực tế
  const nowDateTimetable = new Date();
  nowDateTimetable.setHours(0, 0, 0, 0);

  const activeOnlyTimetable = (typeof timetable !== 'undefined' ? timetable : []).filter(t => {
    const clsMatch = registeredClasses.find(c => c.MaLopHoc === t.MaLopHoc && c.MaHocVien === t.MaHocVien) || registeredClasses.find(c => c.MaLopHoc === t.MaLopHoc);
    if (!clsMatch) return true;
    return !isPrerequisiteReserved(clsMatch);
  });

  const slotColors = [
    { bg: 'linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%)', border: '#2563eb', badgeBg: 'bg-primary text-white' },
    { bg: 'linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%)', border: '#16a34a', badgeBg: 'bg-success text-white' },
    { bg: 'linear-gradient(135deg, #faf5ff 0%, #f3e8ff 100%)', border: '#9333ea', badgeBg: 'bg-primary text-white' },
    { bg: 'linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%)', border: '#ea580c', badgeBg: 'bg-warning text-dark' }
  ];
%>

                          <div class="timetable-grid">
                            <!-- Header -->
                            <div class="timetable-header-cell">Buổi</div>
                            <div class="timetable-header-cell">Thứ 2</div>
                            <div class="timetable-header-cell">Thứ 3</div>
                            <div class="timetable-header-cell">Thứ 4</div>
                            <div class="timetable-header-cell">Thứ 5</div>
                            <div class="timetable-header-cell">Thứ 6</div>
                            <div class="timetable-header-cell">Thứ 7</div>
                            <div class="timetable-header-cell">Chủ Nhật</div>

                            <!-- Morning Row -->
                            <div class="timetable-time-column">Sáng<br><span class="text-muted small">07:00 - 11:30</span></div>
                            <% ['Thứ Hai', 'Thứ Ba' , 'Thứ Tư' , 'Thứ Năm' , 'Thứ Sáu' , 'Thứ Bảy' , 'Chủ Nhật' ].forEach(day=> { %>
                              <div class="timetable-cell p-1.5">
                                <% const slots = activeOnlyTimetable.filter(t=> t.ThuTrongTuan === day && t.GioBatDau < '12:00:00'); slots.forEach(slot=> { const scheme = slotColors[slot.MaLopHoc % slotColors.length]; %>
                                    <div class="timetable-slot shadow p-2 rounded-3 mb-2">
                                          <div class="d-flex justify-content-between align-items-center mb-1 flex-wrap gap-1">
                                            <span class="badge bg-primary text-white fw-bold px-2 py-1 rounded-2 shadow-xs" style="font-size: 0.82rem;"><i class="bi bi-book-half me-1"></i><%= slot.TenLop %></span>
                                            <span class="badge bg-white text-primary border border-primary-subtle fw-bold px-1.5 py-0.5" style="font-size: 0.75rem;"><i class="bi bi-door-open-fill me-1"></i><%= slot.TenPhong %></span>
                                          </div>
                                          <div class="small text-primary fw-bold mb-1" style="font-size: 0.8rem;">
                                            <i class="bi bi-person-badge-fill me-1"></i>GV: <%= slot.TenGiangVien || 'Đang phân công' %>
                                          </div>
                                          <div class="small text-success fw-semibold mb-1" style="font-size: 0.78rem;">
                                            <i class="bi bi-person-circle me-1"></i>HV: <%= slot.TenHocVien || (typeof user !== 'undefined' && user.HoTen) || 'Học viên' %><% if (slot.QuanHe) { %> (<%= slot.QuanHe %>)<% } %>
                                          </div>
                                          <div class="small text-dark fw-bold" style="font-size: 0.78rem;">
                                            <i class="bi bi-clock-fill text-warning me-1"></i><%= slot.GioBatDau.substring(0, 5) %> - <%= slot.GioKetThuc.substring(0, 5) %>
                                          </div>
                                        </div>
                                    <% }) %>
                              </div>
                              <% }) %>

                                <!-- Afternoon Row -->
                                <div class="timetable-time-column">Chiều<br><span class="text-muted small">13:30 - 17:00</span></div>
                                <% ['Thứ Hai', 'Thứ Ba' , 'Thứ Tư' , 'Thứ Năm' , 'Thứ Sáu' , 'Thứ Bảy' , 'Chủ Nhật' ].forEach(day=> { %>
                                  <div class="timetable-cell p-1.5">
                                    <% const slots = activeOnlyTimetable.filter(t=> t.ThuTrongTuan === day && t.GioBatDau >= '12:00:00' && t.GioBatDau < '18:00:00'); slots.forEach(slot=> { const scheme = slotColors[slot.MaLopHoc % slotColors.length]; %>
                                        <div class="timetable-slot shadow p-2 rounded-3 mb-2">
                                          <div class="d-flex justify-content-between align-items-center mb-1 flex-wrap gap-1">
                                            <span class="badge bg-primary text-white fw-bold px-2 py-1 rounded-2 shadow-xs" style="font-size: 0.82rem;"><i class="bi bi-book-half me-1"></i><%= slot.TenLop %></span>
                                            <span class="badge bg-white text-primary border border-primary-subtle fw-bold px-1.5 py-0.5" style="font-size: 0.75rem;"><i class="bi bi-door-open-fill me-1"></i><%= slot.TenPhong %></span>
                                          </div>
                                          <div class="small text-primary fw-bold mb-1" style="font-size: 0.8rem;">
                                            <i class="bi bi-person-badge-fill me-1"></i>GV: <%= slot.TenGiangVien || 'Đang phân công' %>
                                          </div>
                                          <div class="small text-success fw-semibold mb-1" style="font-size: 0.78rem;">
                                            <i class="bi bi-person-circle me-1"></i>HV: <%= slot.TenHocVien || (typeof user !== 'undefined' && user.HoTen) || 'Học viên' %><% if (slot.QuanHe) { %> (<%= slot.QuanHe %>)<% } %>
                                          </div>
                                          <div class="small text-dark fw-bold" style="font-size: 0.78rem;">
                                            <i class="bi bi-clock-fill text-warning me-1"></i><%= slot.GioBatDau.substring(0, 5) %> - <%= slot.GioKetThuc.substring(0, 5) %>
                                          </div>
                                        </div>
                                        <% }) %>
                                  </div>
                                  <% }) %>

                                    <!-- Evening Row -->
                                    <div class="timetable-time-column">Tối<br><span class="text-muted small">18:00 - 21:00</span></div>
                                    <% ['Thứ Hai', 'Thứ Ba' , 'Thứ Tư' , 'Thứ Năm' , 'Thứ Sáu' , 'Thứ Bảy' , 'Chủ Nhật' ].forEach(day=> { %>
                                      <div class="timetable-cell p-1.5">
                                        <% const slots = activeOnlyTimetable.filter(t=> t.ThuTrongTuan === day && t.GioBatDau >= '18:00:00'); slots.forEach(slot => { const scheme = slotColors[slot.MaLopHoc % slotColors.length]; %>
                                          <div class="timetable-slot shadow p-2 rounded-3 mb-2">
                                          <div class="d-flex justify-content-between align-items-center mb-1 flex-wrap gap-1">
                                            <span class="badge bg-primary text-white fw-bold px-2 py-1 rounded-2 shadow-xs" style="font-size: 0.82rem;"><i class="bi bi-book-half me-1"></i><%= slot.TenLop %></span>
                                            <span class="badge bg-white text-primary border border-primary-subtle fw-bold px-1.5 py-0.5" style="font-size: 0.75rem;"><i class="bi bi-door-open-fill me-1"></i><%= slot.TenPhong %></span>
                                          </div>
                                          <div class="small text-primary fw-bold mb-1" style="font-size: 0.8rem;">
                                            <i class="bi bi-person-badge-fill me-1"></i>GV: <%= slot.TenGiangVien || 'Đang phân công' %>
                                          </div>
                                          <div class="small text-success fw-semibold mb-1" style="font-size: 0.78rem;">
                                            <i class="bi bi-person-circle me-1"></i>HV: <%= slot.TenHocVien || (typeof user !== 'undefined' && user.HoTen) || 'Học viên' %><% if (slot.QuanHe) { %> (<%= slot.QuanHe %>)<% } %>
                                          </div>
                                          <div class="small text-dark fw-bold" style="font-size: 0.78rem;">
                                            <i class="bi bi-clock-fill text-warning me-1"></i><%= slot.GioBatDau.substring(0, 5) %> - <%= slot.GioKetThuc.substring(0, 5) %>
                                          </div>
                                        </div>
                                        <% }) %>
                                      </div>
                                    <% }) %>
                                  </div>
                                </div>
                              </section>

                      <!-- PANEL 3: CLASS REGISTRATION -->
                      <section class="portal-tab-panel <%= currentTab === 'registration' ? 'active' : '' %>"
                        id="panel-registration"
                        style="display: <%= currentTab === 'registration' ? 'block' : 'none' %> !important;">
                        <div class="portal-card">
                          <div class="portal-card-header">
                            <h4 class="portal-card-title"><i class="bi bi-journal-plus text-primary"></i> Khóa học & Lớp
                              học đang mở tuyển sinh</h4>
                            <span class="text-muted small">Lựa chọn lớp học phù hợp để đăng ký học hoặc thêm vào giỏ
                              hàng</span>
                          </div>

                          <!-- Search bar for classes -->
                          <div
                            class="mb-4 bg-light p-3 rounded-4 border border-light-subtle d-flex flex-column flex-sm-row gap-3 align-items-center mt-3">
                            <div class="position-relative flex-grow-1 w-100">
                              <span class="position-absolute top-50 start-0 translate-middle-y ms-3 text-muted">
                                <i class="bi bi-search"></i>
                              </span>
                              <input type="text" id="class-search-input"
                                class="form-control ps-5 py-2.5 rounded-3 border-0 shadow-sm"
                                placeholder="Tìm kiếm lớp học, khóa học hoặc cấp độ (ví dụ: TOEIC 450)..."
                                oninput="filterAvailableClasses()" />
                            </div>
                            <button class="btn btn-primary px-4 py-2.5 fw-semibold shadow-sm rounded-3 w-100 w-sm-auto"
                              onclick="filterAvailableClasses()">
                              <i class="bi bi-funnel-fill me-2"></i>Tìm kiếm
                            </button>
                          </div>

                          <div class="class-reg-grid">
                            <% if (availableClasses.length===0) { %>
                              <div class="text-center py-5 w-100">
                                <i class="bi bi-journal-x fs-1 text-muted d-block mb-3"></i>
                                <p class="text-muted">Hiện chưa có lớp học nào đang mở tuyển sinh.</p>
                              </div>
                              <% } else { %>
                                <% availableClasses.forEach(cls=> { const totalUserProfiles = (profiles && profiles.length > 0) ? profiles.length : 1; const registeredProfilesForClass = registeredClasses.filter(rc => rc.MaLopHoc === cls.MaLopHoc && (rc.TrangThai === 'Thành công' || rc.TrangThai === 'Đang học' || rc.TrangThai === 'Chờ thanh toán' || rc.TrangThai === 'Chờ duyệt' || rc.TrangThai === 'Đã thanh toán')); const isReg = registeredProfilesForClass.length >= totalUserProfiles; const spotsLeft = cls.SiSoToiDa - (cls.SiSoHienTai || 0); const isFull = spotsLeft <= 0; let statusBadgeClass='bg-success-subtle text-success' ; let statusText=cls.TrangThaiLop; if (isFull) { statusBadgeClass='bg-danger-subtle text-danger' ; statusText='Hết chỗ' ; } else if (cls.TrangThaiLop==='Đang mở' ) { statusText=`Còn chỗ (Còn ${spotsLeft} chỗ)`; } %>
                                    <div class="class-reg-card" data-course-id="<%= cls.MaKhoaHoc %>">
                                      <div class="class-reg-badge-wrapper">
                                        <div class="d-flex align-items-center gap-2">
                                          <h5 class="class-reg-title mb-0 text-white fw-bold">
                                            <%= cls.TenLop %>
                                          </h5>
                                          <% if (cls.LoaiLop==='Cấp tốc' ) { %>
                                            <span class="badge bg-warning text-dark fw-bold rounded-pill px-2.5 py-1 shadow-xs"
                                              style="font-size: 0.78rem; color: #000000 !important; background: #fef08a !important;"><i
                                                class="bi bi-lightning-charge-fill me-1 text-danger"></i>🔥 Cấp tốc</span>
                                            <% } else { %>
                                              <span class="badge bg-white text-dark fw-bold rounded-pill px-2.5 py-1 shadow-xs"
                                                style="font-size: 0.78rem; color: #1e3a8a !important; background: #ffffff !important;"><i class="bi bi-clock me-1 text-primary"></i>Tiêu
                                                chuẩn</span>
                                              <% } %>
                                        </div>
                                        <span class="badge bg-white text-dark fw-bold rounded-pill px-3 py-1 shadow-xs" style="font-size: 0.82rem; color: #0f172a !important; background: #ffffff !important;"><i class="bi bi-award-fill text-primary me-1"></i>TOEIC <%= cls.CapDo %></span>
                                      </div>
                                      <div class="class-reg-body">
                                        <div class="d-flex flex-column gap-2">
                                          <div class="class-reg-info-row">
                                            <i class="bi bi-journal-bookmark-fill text-primary mt-1"></i>
                                            <span><strong>Khóa học:</strong>
                                              <%= cls.TenKhoaHoc %>
                                            </span>
                                          </div>
                                          <div class="class-reg-info-row">
                                            <i class="bi bi-info-circle text-primary mt-1"></i>
                                            <span><strong>Nội dung:</strong> <span class="text-secondary small">
                                                <%= cls.MoTa || 'Chi tiết nội dung giảng dạy đang được cập nhật.' %>
                                              </span></span>
                                          </div>

                                          <div class="row g-2 mt-1">
                                            <div class="col-sm-6">
                                              <div class="class-reg-info-row">
                                                <i class="bi bi-calendar-range text-primary"></i>
                                                <span><strong>Khai giảng:</strong>
                                                  <%= new Date(cls.NgayKhaiGiang).toLocaleDateString('vi-VN') %>
                                                </span>
                                              </div>
                                            </div>
                                            <div class="col-sm-6">
                                              <div class="class-reg-info-row">
                                                <i class="bi bi-calendar-x text-secondary"></i>
                                                <span><strong>Kết thúc:</strong>
                                                  <%= new Date(cls.NgayKetThuc).toLocaleDateString('vi-VN') %>
                                                </span>
                                              </div>
                                            </div>
                                            <div class="col-sm-6">
                                              <div class="class-reg-info-row">
                                                <i class="bi bi-alarm-fill text-primary"></i>
                                                <span><strong>Lịch học:</strong>
                                                  <%= cls.LichHoc %>
                                                </span>
                                              </div>
                                            </div>
                                            <div class="col-sm-6">
                                              <div class="class-reg-info-row">
                                                <i class="bi bi-clock text-primary"></i>
                                                <span><strong>Thời lượng:</strong>
                                                  <%= cls.ThoiLuong %> buổi
                                                </span>
                                              </div>
                                            </div>
                                            <div class="col-sm-6">
                                              <div class="class-reg-info-row">
                                                <i class="bi bi-people text-primary"></i>
                                                <span><strong>Sĩ số:</strong>
                                                  <%= cls.SiSoHienTai || 0 %> / <%= cls.SiSoToiDa %> học viên
                                                </span>
                                              </div>
                                            </div>
                                            <div class="col-sm-6">
                                              <div class="class-reg-info-row">
                                                <i class="bi bi-tag text-primary"></i>
                                                <span><strong>Trạng thái:</strong> <span
                                                    class="badge <%= statusBadgeClass %>">
                                                    <%= statusText %>
                                                  </span></span>
                                              </div>
                                            </div>
                                          </div>
                                        </div>

                                        <div
                                          class="pt-3 border-top mt-2 d-flex justify-content-between align-items-center flex-wrap gap-2">
                                          <div>
                                            <span class="text-muted small d-block">Học phí trọn khóa</span>
                                            <div class="class-reg-price">
                                              <%= Number(cls.HocPhi).toLocaleString('vi-VN') %> đ
                                            </div>
                                          </div>
                                          <div>
                                            <% if (isReg) { const regStatus=registeredClasses.find(rc=> rc.MaLopHoc === cls.MaLopHoc).TrangThai; %>
                                              <div class="d-flex gap-2">
                                                <button
                                                  class="btn btn-light text-primary border py-2 px-3 fw-semibold shadow-sm"
                                                  onclick="showClassDetailsModal(<%= cls.MaLopHoc %>)"
                                                  title="Xem chi tiết lớp học"><i class="bi bi-eye-fill me-1"></i>Chi
                                                  tiết</button>
                                                <button class="btn btn-secondary px-3 py-2 fw-semibold" disabled>
                                                  <%= (regStatus==='Thành công' || regStatus==='Đang học' ) ? 'Đã đăng ký' : 'Chờ thanh toán' %>
                                                </button>
                                              </div>
                                              <% } else { %>
                                                <div class="d-flex gap-2">
                                                  <button type="button"
                                                    class="btn btn-light text-primary border py-2 px-2.5 fw-semibold shadow-sm"
                                                    onclick="showClassDetailsModal(<%= cls.MaLopHoc %>)"
                                                    title="Xem chi tiết lớp học"><i class="bi bi-eye-fill me-1"></i>Chi
                                                    tiết</button>
                                                  <% if (!isFull) { %>
                                                    <button type="button"
                                                      class="btn btn-outline-primary py-2 px-2.5 fw-semibold shadow-sm"
                                                      onclick="handleAddToCart(<%= cls.MaLopHoc %>, '<%= cls.TenLop %>')"
                                                      title="Thêm vào giỏ hàng"><i
                                                        class="bi bi-cart-plus fs-5"></i></button>
                                                    <button type="button"
                                                      class="btn btn-primary px-3 py-2 fw-semibold shadow-sm"
                                                      onclick="handleDirectRegistration(<%= cls.MaLopHoc %>, <%= cls.HocPhi %>, '<%= cls.NgayKhaiGiang %>', '<%= cls.TenLop %>', '<%= cls.TenKhoaHoc %>')">Đăng
                                                      ký học</button>
                                                    <% } else { %>
                                                      <button type="button"
                                                        class="btn btn-outline-danger px-3 py-2 fw-semibold" disabled>Đã
                                                        hết chỗ</button>
                                                      <% } %>
                                                </div>
                                                <% } %>
                                          </div>
                                        </div>
                                      </div>
                                    </div>
                                    <% }) %>
                                      <% } %>
                          </div>
                        </div>
                      </section>

                      <!-- PANEL 4: LỊCH SỬ LUYỆN ĐỀ -->
                      <section class="portal-tab-panel <%= currentTab === 'luyenthi' ? 'active' : '' %>"
                        id="panel-luyenthi"
                        style="display: <%= currentTab === 'luyenthi' ? 'block' : 'none' %> !important;">
                        <div class="portal-card">
                          <div class="portal-card-header">
                            <h4 class="portal-card-title"><i class="bi bi-clock-history text-primary"></i> Lịch sử luyện
                              đề</h4>
                            <span class="text-muted small">Xem lại danh sách và kết quả chi tiết các bài thi thử TOEIC
                              bạn đã thực hiện</span>
                          </div>

                          <% const practiceHistory=examHistory.filter(h=> h.LoaiDe !== 'Đầu vào'); %>

                            <% if (practiceHistory.length===0) { %>
                              <div class="text-center py-5">
                                <i class="bi bi-journal-x fs-1 text-muted d-block mb-3"></i>
                                <p class="text-muted mb-3">Bạn chưa thực hiện bài luyện đề nào.</p>
                                <a href="/exams/free" class="btn btn-primary fw-semibold px-4 py-2 shadow-sm rounded-3">
                                  <i class="bi bi-award-fill me-2"></i>Bắt đầu luyện đề ngay
                                </a>
                              </div>
                              <% } else { %>
                                <div class="portal-table-wrapper">
                                  <table class="portal-table">
                                    <thead>
                                      <tr>
                                        <th>Tên đề thi</th>
                                        <th>Loại đề</th>
                                        <th>Ngày làm bài</th>
                                        <th>Điểm Nghe</th>
                                        <th>Điểm Đọc</th>
                                        <th>Tổng điểm</th>
                                        <th>Thao tác</th>
                                      </tr>
                                    </thead>
                                    <tbody>
                                      <% practiceHistory.forEach(h=> { %>
                                        <tr>
                                          <td>
                                            <strong class="text-dark">
                                              <%= h.TenDeThi %>
                                            </strong>
                                          </td>
                                          <td>
                                            <span class="badge bg-secondary-subtle text-secondary">
                                              <%= h.LoaiDe %>
                                            </span>
                                          </td>
                                          <td>
                                            <span class="small text-muted"><i class="bi bi-calendar-event me-1"></i>
                                              <%= new Date(h.NgayThi).toLocaleDateString('vi-VN') %>
                                            </span>
                                          </td>
                                          <td>
                                            <span class="fw-semibold text-primary">
                                              <%= h.DiemNghe %> / 495
                                            </span>
                                          </td>
                                          <td>
                                            <span class="fw-semibold text-info">
                                              <%= h.DiemDoc %> / 495
                                            </span>
                                          </td>
                                          <td>
                                            <strong class="fs-6 text-success">
                                              <%= h.DiemNghe + h.DiemDoc %> / 990
                                            </strong>
                                          </td>
                                          <td>
                                            <div class="d-flex gap-2 align-items-center">
                                              <a href="/exams/result/<%= h.MaKetQua %>"
                                                class="btn btn-sm btn-outline-primary fw-semibold rounded-3 px-3 shadow-sm">
                                                <i class="bi bi-eye me-1"></i>Xem lại bài thi
                                              </a>
                                              <a href="/exams/free"
                                                class="btn btn-sm btn-primary fw-semibold rounded-3 px-3 shadow-sm">
                                                <i class="bi bi-arrow-counterclockwise me-1"></i>Làm lại
                                              </a>
                                            </div>
                                          </td>
                                        </tr>
                                        <% }) %>
                                    </tbody>
                                  </table>
                                </div>
                                <% } %>
                        </div>
                      </section>

                      <!-- PANEL 5: STUDENT PROFILE -->
                      <section class="portal-tab-panel <%= currentTab === 'profile' ? 'active' : '' %>"
                        id="panel-profile"
                        style="display: <%= currentTab === 'profile' ? 'block' : 'none' %> !important;">
                        <div class="portal-card">
                          <div class="portal-card-header">
                            <h4 class="portal-card-title"><i class="bi bi-person-lines-fill text-primary"></i> Quản lý
                              thông tin cá nhân</h4>
                          </div>

                          <form action="/classes/update-profile" method="POST" class="needs-validation" novalidate
                            onsubmit="return confirmProfileUpdate(event)">
                            <div class="row g-3">
                              <div class="col-md-6">
                                <label for="profile-name" class="form-label fw-semibold">Họ và tên</label>
                                <input type="text" class="form-control py-2.5 rounded-3" id="profile-name" name="HoTen"
                                  value="<%= user.HoTen %>" disabled required />
                              </div>

                              <div class="col-md-6">
                                <label for="profile-email" class="form-label fw-semibold">Email <span
                                    class="text-muted fw-normal small">(Không thể thay đổi)</span></label>
                                <input type="email" class="form-control py-2.5 rounded-3 bg-light" id="profile-email"
                                  name="Email" value="<%= user.Email %>" disabled readonly required />
                              </div>

                              <div class="col-md-6">
                                <label for="profile-phone" class="form-label fw-semibold">Số điện thoại</label>
                                <input type="tel" class="form-control py-2.5 rounded-3" id="profile-phone"
                                  name="SoDienThoai" value="<%= user.SoDienThoai %>" disabled required />
                              </div>

                              <div class="col-md-6">
                                <label for="profile-dob" class="form-label fw-semibold">Ngày sinh</label>
                                <% let formattedDob='' ; if (profile.NgaySinh) { const d=new Date(profile.NgaySinh); formattedDob=d.toISOString().split('T')[0]; } %>
                                  <input type="date" class="form-control py-2.5 rounded-3" id="profile-dob"
                                    name="NgaySinh" value="<%= formattedDob %>" disabled />
                              </div>

                              <% let initialDistrict='Chưa chọn khu vực' ; let initialStreet=profile.DiaChi || '' ; const districtOptionsList=[ "Quận 1, TP. Hồ Chí Minh" , "Quận 3, TP. Hồ Chí Minh" , "Quận 4, TP. Hồ Chí Minh" , "Quận 5, TP. Hồ Chí Minh" , "Quận 6, TP. Hồ Chí Minh" , "Quận 7, TP. Hồ Chí Minh" , "Quận 8, TP. Hồ Chí Minh" , "Quận 10, TP. Hồ Chí Minh" , "Quận 11, TP. Hồ Chí Minh" , "Quận 12, TP. Hồ Chí Minh" , "Quận Bình Thạnh, TP. Hồ Chí Minh" , "Quận Gò Vấp, TP. Hồ Chí Minh" , "Quận Phú Nhuận, TP. Hồ Chí Minh" , "Quận Tân Bình, TP. Hồ Chí Minh" , "Quận Tân Phú, TP. Hồ Chí Minh" , "Quận Bình Tân, TP. Hồ Chí Minh" , "TP. Thủ Đức, TP. Hồ Chí Minh" , "Huyện Hóc Môn, TP. Hồ Chí Minh" , "Huyện Củ Chi, TP. Hồ Chí Minh" , "Huyện Bình Chánh, TP. Hồ Chí Minh" , "Huyện Nhà Bè, TP. Hồ Chí Minh" , "Tỉnh / TP Khác" ]; if (profile.DiaChi) { for (let dOpt of districtOptionsList) { if (profile.DiaChi.includes(dOpt)) { initialDistrict=dOpt; initialStreet=profile.DiaChi.replace(dOpt, '' ).replace(/,\s*$/, '' ).trim(); break; } } } %>

                                <div class="col-md-6">
                                  <label for="profile-district" class="form-label fw-semibold">Tỉnh / Thành phố / Quận
                                    Huyện</label>
                                  <select class="form-select py-2.5 rounded-3" id="profile-district" disabled
                                    onchange="combineProfileAddress()">
                                    <option value="Chưa chọn khu vực" <%=initialDistrict==='Chưa chọn khu vực' ? 'selected' : '' %>>-- Chọn Quận/Huyện --</option>
                                    <% districtOptionsList.forEach(dOpt=> { %>
                                      <option value="<%= dOpt %>" <%=initialDistrict===dOpt ? 'selected' : '' %>><%= dOpt %>
                                      </option>
                                      <% }) %>
                                  </select>
                                </div>

                                <div class="col-md-6">
                                  <label for="profile-street" class="form-label fw-semibold">Địa chỉ cụ thể (Số nhà, tên
                                    đường, hẻm...)</label>
                                  <input type="text" class="form-control py-2.5 rounded-3" id="profile-street"
                                    value="<%= initialStreet %>"
                                    placeholder="Ví dụ: 123 Đường Nguyễn Trãi, P. Bến Thành" disabled
                                    oninput="combineProfileAddress()" />
                                </div>

                                <input type="hidden" id="profile-address-hidden" name="DiaChi"
                                  value="<%= profile.DiaChi || '' %>" />

                                <%
                                  const hasChildProfiles = (typeof profiles !== 'undefined' && profiles) ? profiles.some(p => p.QuanHe && p.QuanHe !== 'Bản thân') : false;
                                  const selfClasses = (typeof registeredClasses !== 'undefined' && registeredClasses) ? registeredClasses.filter(c => 
                                    c.MaHocVien === profile.MaHocVien
                                  ) : [];
                                  const sortedSelfClasses = [...selfClasses].sort((a, b) => (b.MaDangKy || 0) - (a.MaDangKy || 0));
                                  const currentLearningClass = sortedSelfClasses.find(c => 
                                    ['Đang học', 'Thành công', 'Đã thanh toán'].includes(c.TrangThai) && !isPrerequisiteReserved(c)
                                  );
                                  const isSelfActiveStudent = !hasChildProfiles && !!currentLearningClass;
                                  let activeSelfLevelName = currentLearningClass ? (currentLearningClass.TenKhoaHoc || currentLearningClass.TenLop) : '';
                                %>

                                <% if (isSelfActiveStudent) { %>
                                  <div class="col-md-6">
                                    <label for="profile-level"
                                      class="form-label fw-semibold d-flex align-items-center justify-content-between">
                                      <span>Trình độ hiện tại / Mục tiêu</span>
                                      <span class="badge bg-primary-subtle text-primary fw-semibold"
                                        style="font-size: 0.75rem;"
