                      let classesModalTimerInterval = null;
                      let classesQrCountdownSeconds = 30;

                      function startClassesQrCountdownTimer() {
                        if (classesModalTimerInterval) {
                          clearInterval(classesModalTimerInterval);
                          classesModalTimerInterval = null;
                        }
                        classesQrCountdownSeconds = 30;
                        const timerEl = document.getElementById('qr-modal-timer');
                        if (timerEl) timerEl.innerText = '30s';

                        classesModalTimerInterval = setInterval(() => {
                          classesQrCountdownSeconds--;
                          if (timerEl) {
                            timerEl.innerText = classesQrCountdownSeconds + 's';
                          }

                          if (classesQrCountdownSeconds <= 0) {
                            clearInterval(classesModalTimerInterval);
                            classesModalTimerInterval = null;
                            cancelPaymentSubmit(true);
                          }
                        }, 1000);
                      }

                      function cancelPaymentSubmit(isExpired = false) {
                        if (classesModalTimerInterval) {
                          clearInterval(classesModalTimerInterval);
                          classesModalTimerInterval = null;
                        }
                        const spinner = document.getElementById('cancel-spinner');
                        if (spinner) spinner.classList.remove('d-none');

                        const promoSelect = document.getElementById('payment-promo');
                        const selectedOpt = promoSelect && promoSelect.selectedIndex >= 0 ? promoSelect.options[promoSelect.selectedIndex] : null;
                        const pct = selectedOpt && selectedOpt.dataset ? parseFloat(selectedOpt.dataset.pct || 0) : 0;

                        fetch('/classes/cancel-payment', {
                          method: 'POST',
                          headers: { 'Content-Type': 'application/json' },
                          body: JSON.stringify({
                            MaDangKy: activeRegistrationId,
                            SoTien: activeFinalAmount || activeClassFee,
                            NoiDungChuyenKhoan: activeQrContent
                          })
                        })
                          .then(res => res.json())
                          .then(data => {
                            if (spinner) spinner.classList.add('d-none');

                            const modalEl = document.getElementById('paymentModal');
                            const modalInstance = bootstrap.Modal.getInstance(modalEl);
                            if (modalInstance) modalInstance.hide();

                            Swal.fire({
                              icon: 'info',
                              title: isExpired ? 'Mã QR đã hết hạn' : 'Đã hủy giao dịch',
                              text: isExpired ? 'Hệ thống đã tự động hủy giao dịch do quá thời gian chờ.' : 'Giao dịch đăng ký lớp học đã bị hủy.',
                              confirmButtonText: 'Đồng ý',
                              confirmButtonColor: '#e74c3c'
                            });
                          })
                          .catch(err => {
                            if (spinner) spinner.classList.add('d-none');
                            console.error(err);
                            Swal.fire({
                              icon: 'error',
                              title: 'Lỗi',
                              text: err.message || 'Lỗi kết nối máy chủ.',
                              confirmButtonText: 'Đồng ý'
                            });
                          });
                      }

                      function startPaymentPolling(registeredId, redirectUrl) {
                        const id = Array.isArray(registeredId) ? registeredId[0] : registeredId;
                        const maxWaitSeconds = 30;
                        let elapsed = 0;
                        const targetUrl = redirectUrl || '/classes/my-classes';

                        const modalEl = document.getElementById('paymentModal');
                        const modalInstance = bootstrap.Modal.getInstance(modalEl);
                        if (modalInstance) modalInstance.hide();

                        Swal.fire({
                          icon: 'info',
                          title: 'Đang chờ ngân hàng xác nhận...',
                          html: `<div class="text-center">
        <div class="spinner-border text-primary mb-3" role="status" style="width: 3rem; height: 3rem;">
          <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mb-1">Hệ thống đang kiểm tra giao dịch từ ngân hàng.</p>
        <p class="text-muted small">Thời gian chờ xác thực ngân hàng: <strong id="poll-timer" class="text-danger fs-6">30</strong>s / ${maxWaitSeconds}s</p>
        <div class="progress mt-2" style="height: 6px;">
          <div class="progress-bar progress-bar-striped progress-bar-animated bg-danger" id="poll-progress" role="progressbar" style="width: 0%"></div>
        </div>
      </div>`,
                          showConfirmButton: false,
                          showCancelButton: true,
                          cancelButtonText: 'Đóng & chờ sau',
                          cancelButtonColor: '#6c757d',
                          allowOutsideClick: false
                        }).then((result) => {
                          if (result.dismiss) {
                            clearInterval(pollInterval);
                          }
                        });

                        const pollInterval = setInterval(async () => {
                          elapsed += 2;

                          const timerEl = document.getElementById('poll-timer');
                          const progressEl = document.getElementById('poll-progress');
                          const remain = Math.max(0, maxWaitSeconds - elapsed);
                          if (timerEl) timerEl.innerText = remain;
                          if (progressEl) progressEl.style.width = Math.min((elapsed / maxWaitSeconds) * 100, 100) + '%';

                          if (elapsed >= maxWaitSeconds) {
                            clearInterval(pollInterval);
                            Swal.fire({
                              icon: 'warning',
                              title: 'Hết thời gian chờ',
                              html: '<p class="fw-bold text-danger">Chưa nhận được tín hiệu xác nhận tự động từ ngân hàng trong vòng 30 giây.</p><p class="small text-muted">Vui lòng kiểm tra lại thông tin chuyển khoản hoặc liên hệ trung tâm để được hỗ trợ.</p>',
                              confirmButtonText: 'Đóng',
                              confirmButtonColor: '#3498db'
                            });
                            return;
                          }

                          try {
                            const response = await fetch(`/api/payment-status/${id}`);
                            const data = await response.json();

                            if (data.success && data.isPaid) {
                              clearInterval(pollInterval);
                              Swal.fire({
                                icon: 'success',
                                title: '🎉 Thanh toán thành công!',
                                html: '<p class="fs-6">Ngân hàng / SePay đã xác nhận giao dịch thành công.</p><p class="fw-bold text-success fs-6 mb-0">Lớp học của bạn đã được kích hoạt VIP và mở khóa ngay!</p>',
                                confirmButtonText: 'Đi đến Lớp học của tôi',
                                confirmButtonColor: '#2ecc71',
                                allowOutsideClick: false
                              }).then(() => {
                                window.location.href = '/classes/my-classes?tab=overview&success=payment_success';
                              });
                              return;
                            }

                            if (data.success && data.isFailed) {
                              clearInterval(pollInterval);
                              Swal.fire({
                                icon: 'error',
                                title: '❌ Giao dịch thất bại',
                                html: '<p>Giao dịch của bạn không thể hoàn tất hoặc đã bị hủy.</p><p class="small text-muted">Vui lòng kiểm tra lại số tiền hoặc liên hệ trung tâm để được hỗ trợ.</p>',
                                confirmButtonText: 'Đóng & Kiểm tra lại',
                                confirmButtonColor: '#e74c3c'
                              });
                              return;
                            }
                          } catch (err) {
                            console.error('Polling error:', err);
                          }
                        }, 2000);
                      }

                      // --- CLIENT-SIDE EXAM PRACTICE ---
                      let activeExamId = null;
                      let examQuestions = [];
                      let structuredParts = [];
                      let examTimerInterval = null;
                      let examTimeRemaining = 0;
                      let studentAnswers = {};
                      let activePart = 1;

                      function formatPassageText(text) {
                        if (!text) return '';
                        if (text.includes('\t') && (text.toLowerCase().includes('monday') || text.toLowerCase().includes('time'))) {
                          const lines = text.trim().split('\n');
                          let tableHtml = '<div class="table-responsive"><table class="table table-bordered align-middle" style="background-color: #fff; width: 100%; border-collapse: collapse; font-size: 0.9rem; text-align: left; margin-bottom: 0;">';

                          lines.forEach((line, index) => {
                            const cells = line.split('\t');
                            if (index === 0) {
                              tableHtml += '<thead class="table-light"><tr>';
                              cells.forEach(cell => {
                                tableHtml += `<th style="padding: 10px; border: 1px solid #dee2e6; font-weight: 600;">${cell.trim()}</th>`;
                              });
                              tableHtml += '</tr></thead><tbody>';
                            } else {
                              tableHtml += '<tr>';
                              cells.forEach(cell => {
                                tableHtml += `<td style="padding: 10px; border: 1px solid #dee2e6;">${cell.trim()}</td>`;
                              });
                              tableHtml += '</tr>';
                            }
                          });
                          tableHtml += '</tbody></table></div>';
                          return tableHtml;
                        }

                        let cleanText = text.trim().replace(/\r\n/g, '\n');
                        cleanText = cleanText.replace(/\n{3,}/g, '\n\n');
                        cleanText = cleanText.replace(/^(Woman|Man|Speaker\s*\d+|[A-ZÀ-ỸđĐ][a-zA-ZÀ-ỹđĐ0-9. -]{0,25}):/gm, '<strong>$1:</strong>');
                        return cleanText;
                      }

                      function startExam(examId, jsonPath) {
                        Swal.fire({
                          title: 'Sẵn sàng làm bài?',
                          text: 'Bạn đã sẵn sàng làm đề thi này? Thời gian làm bài sẽ bắt đầu ngay lập tức.',
                          icon: 'question',
                          showCancelButton: true,
                          confirmButtonColor: '#3085d6',
                          cancelButtonColor: '#d33',
                          confirmButtonText: 'Bắt đầu làm bài',
                          cancelButtonText: 'Hủy'
                        }).then((result) => {
                          if (result.isConfirmed) {
                            activeExamId = examId;
                            studentAnswers = {};
                            activePart = 1;

                            fetch(`/${jsonPath}`)
                              .then(res => {
                                if (!res.ok) throw new Error('Không thể tải file đề thi.');
                                return res.json();
                              })
                              .then(data => {
                                examQuestions = data.questions;
                                structuredParts = processClientQuestions(examQuestions);

                                document.getElementById('exam-title-name').innerText = data.title || "Bài luyện thi TOEIC";
                                document.getElementById('exam-badge-type').innerText = data.type || "Luyện tập";

                                const audioBlock = document.getElementById('client-audio-block');
                                const audioEl = document.getElementById('client-global-audio');
                                if (data.audio) {
                                  audioEl.src = data.audio;
                                  audioBlock.style.display = 'flex';
                                } else {
                                  audioEl.src = '';
                                  audioBlock.style.display = 'none';
                                }

                                renderClientExamUI();

                                examTimeRemaining = (data.duration || 60) * 60;
                                document.getElementById('examOverlay').classList.add('active');

                                updateExamTimer();
                                clearInterval(examTimerInterval);
                                examTimerInterval = setInterval(updateExamTimer, 1000);
                              })
                              .catch(err => {
                                console.error(err);
                                Swal.fire({
                                  icon: 'error',
                                  title: 'Lỗi',
                                  text: err.message || 'Có lỗi xảy ra khi tải dữ liệu đề thi.',
                                  confirmButtonText: 'Đồng ý',
                                  confirmButtonColor: '#e74c3c'
                                });
                              });
                          }
                        });
                      }

                      function processClientQuestions(questions) {
                        const parts = {};
                        for (let p = 1; p <= 7; p++) {
                          parts[p] = {
                            partNum: p,
                            partName: `Part ${p}`,
                            groups: []
                          };
                        }

                        const partQuestionCounts = { 3: 0, 4: 0 };

                        questions.forEach((q, index) => {
                          const partNum = q.part || 1;
                          const part = parts[partNum];

                          let groupHeader = null;
                          let passageText = q.passage || null;
                          let cleanQuestion = q.question;

                          if (partNum === 3 || partNum === 4) {
                            const qCount = partQuestionCounts[partNum];
                            const groupIdx = Math.floor(qCount / 3);
                            groupHeader = `Part${partNum}Group${groupIdx}`;
                            partQuestionCounts[partNum]++;
                          } else {
                            const groupRegex = /^(Questions?\s+\d+[-–]\d+\s+refer\s+to\s+the\s+following\s+[^.\n]+[:.]?)\s*([\s\S]*)$/i;
                            const match = q.question.match(groupRegex);

                            if (match) {
                              groupHeader = match[1].trim();
                              const rest = match[2].trim();

                              const questionIndex = rest.indexOf("Question:");
                              if (questionIndex !== -1) {
                                if (!passageText) {
                                  passageText = rest.substring(0, questionIndex).trim();
                                }
                                cleanQuestion = rest.substring(questionIndex + 9).trim();
                              } else {
                                cleanQuestion = rest;
                              }
                            }
                          }

                          cleanQuestion = cleanQuestion.replace(/^Question:\s*/i, '').trim();
                          if (!cleanQuestion && q.passage) {
                            cleanQuestion = q.question;
                          }

                          let group = null;
                          if (partNum === 3 || partNum === 4) {
                            group = part.groups.find(g => g.header === groupHeader);
                          } else if (passageText) {
                            group = part.groups.find(g => g.passage === passageText);
                          } else if (q.image && (partNum === 6 || partNum === 7)) {
                            group = part.groups.find(g => g.image === q.image);
                          }

                          if (!group && groupHeader) {
                            group = part.groups.find(g => g.header === groupHeader);
                          }

                          if (!group) {
                            group = {
                              header: groupHeader || (passageText ? "Đoạn văn đọc hiểu" : null),
                              passage: passageText,
                              image: q.image || null,
                              questions: []
                            };
                            part.groups.push(group);
                          } else {
                            if (passageText && !group.passage) {
                              group.passage = passageText;
                            }
                            if (groupHeader && !group.header) {
                              group.header = groupHeader;
                            }
                            if (q.image && !group.image) {
                              group.image = q.image;
                            }
                          }

                          group.questions.push({
                            ...q,
                            originalIndex: index,
                            cleanQuestion: cleanQuestion || q.question
                          });
                        });

                        Object.values(parts).forEach(part => {
                          part.groups.forEach(group => {
                            if (part.partNum === 3 || part.partNum === 4) {
                              const startNum = group.questions[0].originalIndex + 1;
                              const endNum = group.questions[group.questions.length - 1].originalIndex + 1;
                              group.header = `Questions ${startNum}-${endNum}`;
                            } else if (group.header) {
                              const headerRegex = /^Questions?\s+(\d+[-–]\d+)\s+(refer\s+to\s+the\s+following\s+.*)$/i;
                              const headerMatch = group.header.match(headerRegex);
                              if (headerMatch) {
                                const referSuffix = headerMatch[2];
                                const startNum = group.questions[0].originalIndex + 1;
                                const endNum = group.questions[group.questions.length - 1].originalIndex + 1;

                                if (startNum === endNum) {
                                  group.header = `Question ${startNum} ${referSuffix}`;
                                } else {
                                  group.header = `Questions ${startNum}-${endNum} ${referSuffix}`;
                                }
                              }
                            } else if (group.image && (part.partNum === 6 || part.partNum === 7)) {
                              const startNum = group.questions[0].originalIndex + 1;
                              const endNum = group.questions[group.questions.length - 1].originalIndex + 1;
                              if (startNum === endNum) {
                                group.header = `Question ${startNum} refer to the following graphic:`;
                              } else {
                                group.header = `Questions ${startNum}-${endNum} refer to the following graphic:`;
                              }
                            }
                          });
                        });

                        return Object.values(parts);
                      }

                      function renderClientExamUI() {
                        const tabsContainer = document.getElementById('client-parts-tabs');
                        const contentContainer = document.getElementById('client-parts-content');
                        const sidebarNav = document.getElementById('client-sidebar-nav-container');

                        tabsContainer.innerHTML = '';
                        contentContainer.innerHTML = '';
                        sidebarNav.innerHTML = '';

                        structuredParts.forEach((part) => {
                          const partNum = part.partNum;
                          const hasQuestions = part.groups.some(g => g.questions.length > 0);
                          if (!hasQuestions) return;

                          const tabLi = document.createElement('li');
                          tabLi.className = 'nav-item';
                          tabLi.innerHTML = `
        <button class="nav-link ${partNum === activePart ? 'active' : ''}" 
                id="client-part-${partNum}-tab" 
                type="button" 
                role="tab" 
                onclick="changeClientPart(${partNum})">
          Part ${partNum}
        </button>
      `;
                          tabsContainer.appendChild(tabLi);

                          const tabPane = document.createElement('div');
                          tabPane.className = `tab-pane fade ${partNum === activePart ? 'show active' : ''}`;
                          tabPane.id = `client-part-pane-${partNum}`;
                          tabPane.role = 'tabpanel';

                          part.groups.forEach((group) => {
                            const groupDiv = document.createElement('div');
                            groupDiv.className = 'group-card';

                            let headerHtml = '';

                            let groupImage = null;
                            group.questions.forEach(gq => {
                              if (gq.image) groupImage = gq.image;
                            });

                            let bodyHtml = '';
                            if (groupImage) {
                              bodyHtml = `
            <div class="split-passage-container">
              <div class="image-passage-card text-center bg-white border-0">
                <img src="${groupImage}" class="img-fluid rounded border shadow-sm" alt="Graphic Question Image" />
              </div>
              <div class="questions-list-column">
                ${group.questions.map(q => {
                  const qCopy = { ...q, image: null };
                  return renderClientQuestionHtml(qCopy);
                }).join('')}
              </div>
            </div>
          `;
                            } else if (group.passage) {
                              bodyHtml = `
            <div class="split-passage-container">
              <div class="passage-card">
                <h6 class="fw-bold mb-2">Đọc hiểu đoạn văn / Passage:</h6>
                <div style="white-space: pre-line;">${formatPassageText(group.passage)}</div>
              </div>
              <div class="questions-list-column">
                ${group.questions.map(q => {
                  const qCopy = { ...q, image: null };
                  return renderClientQuestionHtml(qCopy);
                }).join('')}
              </div>
            </div>
          `;
                            } else {
                              bodyHtml = `
            <div class="normal-questions-container">
              ${group.questions.map(q => renderClientQuestionHtml(q)).join('')}
            </div>
          `;
                            }

                            groupDiv.innerHTML = headerHtml + bodyHtml;
                            tabPane.appendChild(groupDiv);
                          });
                          contentContainer.appendChild(tabPane);

                          const navSection = document.createElement('div');
                          navSection.className = 'part-nav-section';
                          const allQuestions = part.groups.flatMap(g => g.questions);

                          navSection.innerHTML = `
        <div class="part-nav-title">
          <span>Part ${partNum}</span>
          <span class="small text-muted" id="client-part-count-${partNum}">0/${allQuestions.length}</span>
        </div>
        <div class="part-nav-grid">
          ${allQuestions.map(q => {
                            return `
              <div class="question-nav-btn" 
                   id="client-nav-q-${q.id}" 
                   onclick="jumpToClientQuestion(${partNum}, ${q.id})">
                ${q.originalIndex + 1}
              </div>
            `;
                          }).join('')}
        </div>
      `;
                          sidebarNav.appendChild(navSection);
                        });

                        updateClientPartControlButtons();
                      }

                      function renderClientQuestionHtml(q) {
                        let audioHtml = '';
                        if (q.audio) {
                          audioHtml = `
        <div class="mb-3">
          <audio controls preload="none" class="w-100">
            <source src="${q.audio}" type="audio/mpeg">
          </audio>
        </div>
      `;
                        }

                        let imageHtml = '';
                        if (q.image) {
                          imageHtml = `
        <div class="mb-3 text-center">
          <img src="${q.image}" class="img-fluid rounded border shadow-sm" style="max-height: 250px; object-fit: contain;" alt="Question Image" />
        </div>
      `;
                        }

                        let questionTextHtml = '';
                        if (q.part !== 1 && q.part !== 2) {
                          questionTextHtml = `<p class="fs-6 fw-semibold text-dark mb-3">${q.cleanQuestion}</p>`;
                        }

                        let optionsHtml = '';
                        q.options.forEach(opt => {
                          const optLetter = opt.split('.')[0].trim().toUpperCase();
                          const displayText = (q.part === 1 || q.part === 2) ? optLetter : opt;

                          optionsHtml += `
        <div class="option-item mb-2">
          <input type="radio" 
                 id="client-q-${q.id}-opt-${optLetter}" 
                 name="client-answers-${q.id}" 
                 value="${optLetter}" 
                 class="option-input"
                 onchange="saveClientAnswer(${q.id}, '${optLetter}', ${q.part})" />
          <label for="client-q-${q.id}-opt-${optLetter}" class="option-label">
            <span class="option-circle">${optLetter}</span>
            <span class="option-text">${displayText}</span>
          </label>
        </div>
      `;
                        });

                        const isPart6or7 = q.part === 6 || q.part === 7;
                        const badgeHtml = isPart6or7
                          ? `<div class="d-flex align-items-center gap-2 mb-2"><span class="q-circle-badge">${q.originalIndex + 1}</span></div>`
                          : `<span class="q-circle-badge">${q.originalIndex + 1}</span>`;

                        return `
      <div class="question-item-card" id="client-q-container-${q.id}">
        ${badgeHtml}
        ${audioHtml}
        ${imageHtml}
        ${questionTextHtml}
        <div class="option-wrapper">
          ${optionsHtml}
        </div>
      </div>
    `;
                      }

                      function saveClientAnswer(qId, val, partNum) {
                        studentAnswers[qId] = val;
                        const btn = document.getElementById(`client-nav-q-${qId}`);
                        if (btn) btn.classList.add('answered');

                        updateClientPartAnsweredCount(partNum);
                      }

                      function updateClientPartAnsweredCount(partNum) {
                        const part = structuredParts.find(p => p.partNum === partNum);
                        if (!part) return;

                        const allQuestions = part.groups.flatMap(g => g.questions);
                        const answeredCount = allQuestions.filter(q => studentAnswers[q.id]).length;

                        const label = document.getElementById(`client-part-count-${partNum}`);
                        if (label) {
                          label.innerText = `${answeredCount}/${allQuestions.length}`;
                        }
                      }

                      function changeClientPart(partNum) {
                        activePart = partNum;

                        document.querySelectorAll('#client-parts-tabs .nav-link').forEach(btn => {
                          btn.classList.remove('active');
                        });
                        const activeTabButton = document.getElementById(`client-part-${partNum}-tab`);
                        if (activeTabButton) activeTabButton.classList.add('active');

                        document.querySelectorAll('#client-parts-content .tab-pane').forEach(pane => {
                          pane.classList.remove('show', 'active');
                        });
                        const activePane = document.getElementById(`client-part-pane-${partNum}`);
                        if (activePane) activePane.classList.add('show', 'active');

                        const audioBlock = document.getElementById('client-audio-block');
                        if (audioBlock) {
                          if (partNum <= 4) {
                            audioBlock.style.display = 'flex';
                          } else {
                            audioBlock.style.display = 'none';
                          }
                        }

                        updateClientPartControlButtons();
                        document.getElementById('examOverlay').scrollTo({ top: 0, behavior: 'smooth' });
                      }

                      function jumpToClientQuestion(partNum, qId) {
                        if (activePart !== partNum) {
                          changeClientPart(partNum);
                        }

                        setTimeout(() => {
                          const qContainer = document.getElementById(`client-q-container-${qId}`);
                          if (qContainer) {
                            qContainer.scrollIntoView({ behavior: 'smooth', block: 'center' });

                            qContainer.style.outline = '2px solid var(--exam-accent)';
                            qContainer.style.boxShadow = '0 0 15px rgba(52, 152, 219, 0.2)';
                            setTimeout(() => {
                              qContainer.style.outline = 'none';
                              qContainer.style.boxShadow = '';
                            }, 1500);
                          }
                        }, 100);
                      }

                      function switchClientPart(direction) {
                        const activeIdx = structuredParts.findIndex(p => p.partNum === activePart);
                        let nextIdx = activeIdx + direction;

                        if (nextIdx >= 0 && nextIdx < structuredParts.length) {
                          changeClientPart(structuredParts[nextIdx].partNum);
                        }
                      }

                      function updateClientPartControlButtons() {
                        const activeIdx = structuredParts.findIndex(p => String(p.partNum) === String(activePart));
                        const prevBtn = document.getElementById('client-prev-part-btn');
                        const nextBtn = document.getElementById('client-next-part-btn');

                        if (activeIdx <= 0) {
                          prevBtn.style.display = 'none';
                        } else {
                          prevBtn.style.display = 'block';
                        }

                        if (activeIdx >= 0 && activeIdx === structuredParts.length - 1) {
                          nextBtn.innerText = 'Nộp bài thi';
                          nextBtn.classList.remove('btn-primary');
                          nextBtn.classList.add('btn-success');
                          nextBtn.onclick = (e) => confirmSubmitClient(e);
                        } else {
                          nextBtn.innerHTML = `Phần tiếp theo<i class="bi bi-chevron-right ms-2"></i>`;
                          nextBtn.classList.remove('btn-success');
                          nextBtn.classList.add('btn-primary');
                          nextBtn.onclick = () => switchClientPart(1);
                        }
                      }

                      function updateExamTimer() {
                        const minutes = Math.floor(examTimeRemaining / 60);
                        const seconds = examTimeRemaining % 60;
                        document.getElementById('exam-timer').innerText = `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;

                        if (examTimeRemaining <= 0) {
                          clearInterval(examTimerInterval);
                          Swal.fire({
                            title: 'Hết giờ làm bài!',
                            text: 'Đã hết thời gian làm bài. Hệ thống sẽ tự động nộp bài của bạn.',
                            icon: 'warning',
                            timer: 3000,
                            showConfirmButton: false
                          }).then(() => {
                            submitExamClient();
                          });
                        }
                        examTimeRemaining--;
                      }

                      function closeExamWindow() {
                        Swal.fire({
                          title: 'Hủy bài thi?',
                          text: 'Bạn có chắc muốn hủy bài thi? Mọi câu trả lời của bạn sẽ bị mất.',
                          icon: 'warning',
                          showCancelButton: true,
                          confirmButtonColor: '#3085d6',
                          cancelButtonColor: '#d33',
                          confirmButtonText: 'Đồng ý',
                          cancelButtonText: 'Hủy'
                        }).then((result) => {
                          if (result.isConfirmed) {
                            clearInterval(examTimerInterval);
                            document.getElementById('examOverlay').classList.remove('active');
                          }
                        });
                      }

                      function confirmSubmitClient(event) {
                        if (event) event.preventDefault();

                        const totalCount = examQuestions.length;
                        const answeredCount = Object.keys(studentAnswers).length;
                        const unansweredCount = totalCount - answeredCount;

                        let title = 'Nộp bài thi?';
                        let text = 'Bạn có chắc chắn muốn nộp bài thi ngay không?';
                        let icon = 'question';

                        if (unansweredCount > 0) {
                          title = 'Chưa hoàn thành tất cả câu hỏi!';
                          text = `Bạn còn ${unansweredCount} câu hỏi chưa trả lời. Bạn vẫn muốn nộp bài thi chứ?`;
                          icon = 'warning';
                        }

                        Swal.fire({
                          title: title,
                          text: text,
                          icon: icon,
                          showCancelButton: true,
                          confirmButtonColor: '#2ecc71',
                          cancelButtonColor: '#d33',
                          confirmButtonText: 'Nộp bài',
                          cancelButtonText: 'Làm tiếp'
                        }).then((result) => {
                          if (result.isConfirmed) {
                            submitExamClient();
                          }
                        });
                      }

                      function submitExamClient() {
                        clearInterval(examTimerInterval);

                        const form = document.createElement('form');
                        form.method = 'POST';
                        form.action = '/exams/submit-placement';

                        const idInput = document.createElement('input');
                        idInput.type = 'hidden';
                        idInput.name = 'MaDeThi';
                        idInput.value = activeExamId;
                        form.appendChild(idInput);

                        for (const [qId, ans] of Object.entries(studentAnswers)) {
                          const ansInput = document.createElement('input');
                          ansInput.type = 'hidden';
                          ansInput.name = `answers[${qId}]`;
                          ansInput.value = ans;
                          form.appendChild(ansInput);
                        }
                        document.body.appendChild(form);
                        form.submit();
                      }

                      function confirmProfileUpdate(event) {
                        if (event) event.preventDefault();
                        const form = event.target;
                        Swal.fire({
                          title: 'Cập nhật hồ sơ?',
                          text: 'Bạn có chắc chắn muốn cập nhật thông tin hồ sơ cá nhân của mình không?',
                          icon: 'question',
                          showCancelButton: true,
                          confirmButtonColor: '#3085d6',
                          cancelButtonColor: '#d33',
                          confirmButtonText: 'Đồng ý',
                          cancelButtonText: 'Hủy'
                        }).then((result) => {
                          if (result.isConfirmed) {
                            form.submit();
                          }
                        });
                        return false;
                      }

                      function filterAvailableClasses(targetCourseId) {
                        const input = document.getElementById('class-search-input');
                        const rawFilter = input ? input.value.toLowerCase().trim() : '';
                        const filter = rawFilter.split('(')[0].trim();
                        const cards = document.querySelectorAll('.class-reg-card');

                        cards.forEach(card => {
                          const courseId = card.getAttribute('data-course-id');
                          const title = card.querySelector('.class-reg-title') ? card.querySelector('.class-reg-title').innerText.toLowerCase() : '';
                          const courseEl = card.querySelector('.class-reg-info-row span');
                          const course = courseEl ? courseEl.innerText.toLowerCase() : '';
                          const levelEl = card.querySelector('.class-reg-level');
                          const level = levelEl ? levelEl.innerText.toLowerCase() : '';

                          const isMatchByCourseId = targetCourseId && courseId && String(courseId) === String(targetCourseId);
                          const isMatchByText = filter && (title.includes(filter) || course.includes(filter) || level.includes(filter) || rawFilter.includes(title));

                          if (!filter && !targetCourseId) {
                            card.style.display = '';
                          } else if (isMatchByCourseId || isMatchByText) {
                            card.style.display = '';
                          } else {
                            card.style.display = 'none';
                          }
                        });
                      }

                      window.navigateToCourseRegistration = function(courseId, courseName) {
                        const urlParams = new URLSearchParams(window.location.search);
                        const currentTab = urlParams.get('tab') || 'overview';

                        if (currentTab !== 'registration') {
                          window.location.href = '/classes/my-classes?tab=registration&search=' + encodeURIComponent(courseName || '');
                        } else {
                          const searchInput = document.getElementById('class-search-input');
                          if (searchInput) {
                            searchInput.value = courseName || '';
                            filterAvailableClasses(courseId);
                          }
                          setTimeout(function() {
                            const visibleCards = Array.from(document.querySelectorAll('.class-reg-card')).filter(c => c.style.display !== 'none');
                            const firstMatchingCard = visibleCards.find(c => String(c.getAttribute('data-course-id')) === String(courseId)) || visibleCards[0];
                            const targetEl = firstMatchingCard || document.getElementById('class-search-input') || document.getElementById('panel-registration');
                            if (targetEl) {
                              targetEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
                              if (firstMatchingCard) {
                                firstMatchingCard.style.transition = 'all 0.3s ease';
                                firstMatchingCard.style.boxShadow = '0 0 0 4px rgba(52, 152, 219, 0.5)';
                                firstMatchingCard.style.borderRadius = '16px';
                                setTimeout(() => { firstMatchingCard.style.boxShadow = ''; }, 2500);
                              }
                            }
                          }, 150);
                        }
                      };
