                      function updateBulkPaymentBtn() {
                        const checkboxes = document.querySelectorAll('.unpaid-reg-checkbox:checked');
                        const bulkBar = document.getElementById('bulk-payment-bar');
                        const countEl = document.getElementById('bulk-selected-count');
                        const totalEl = document.getElementById('bulk-selected-total');

                        if (!bulkBar) return;

                        if (checkboxes.length > 0) {
                          let totalFee = 0;
                          checkboxes.forEach(cb => {
                            totalFee += parseFloat(cb.getAttribute('data-fee') || 0);
                          });
                          if (countEl) countEl.innerText = checkboxes.length;
                          if (totalEl) totalEl.innerText = Number(totalFee).toLocaleString('vi-VN') + ' đ';
                          bulkBar.classList.remove('d-none');
                        } else {
                          bulkBar.classList.add('d-none');
                        }
