                                                                    <button class="btn btn-outline-primary w-100 py-2 fw-semibold rounded-3" onclick="navigateToCourseRegistration('<%= rc.MaKhoaHoc %>', '<%= rc.TenKhoaHoc %>');">
                                                                      <i class="bi bi-calendar-event me-2"></i>Xem danh sách lớp sắp mở
                                                                    </button>
