                            }).then(function (result) {
                              if (result.isConfirmed) {
                                var deletePromises = selectedIds.map(function (id) {
                                  return fetch('/classes/delete-registration/' + id, {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' }
                                  }).then(function (res) { return res.json(); });
                                });

                                Promise.all(deletePromises)
                                  .then(function (results) {
                                    Swal.fire({
                                      icon: 'success',
                                      title: 'Thành công!',
                                      text: 'Đã xóa các đơn đăng ký được chọn thành công.',
                                      timer: 1500,
                                      showConfirmButton: false
                                    }).then(function () {
                                      window.location.reload();
                                    });
                                  })
                                  .catch(function (err) {
                                    console.error('Bulk delete error:', err);
                                    Swal.fire({
                                      icon: 'error',
                                      title: 'Lỗi',
                                      text: 'Có lỗi xảy ra khi xóa các đơn đăng ký.'
                                    });
                                  });
                              }
                            });
                          };

                        document.addEventListener('click', function (e) {
                          var overviewDeleteBtn = e.target.closest('.overview-delete-btn');
                          if (overviewDeleteBtn) {
                            e.preventDefault();
                            e.stopPropagation();
                            var regId = overviewDeleteBtn.getAttribute('data-reg-id');
                            var title = overviewDeleteBtn.getAttribute('data-title') || 'Lớp học';

                            Swal.fire({
                              title: 'Xác nhận xóa đơn đăng ký?',
                              text: 'Bạn có chắc chắn muốn xóa đơn đăng ký cho ' + title + '?',
                              icon: 'warning',
                              showCancelButton: true,
                              confirmButtonText: 'Đồng ý xóa',
                              cancelButtonText: 'Hủy bỏ',
                              confirmButtonColor: '#e74c3c',
                              cancelButtonColor: '#6c757d'
                            }).then(function (result) {
                              if (result.isConfirmed) {
                                fetch('/classes/delete-registration/' + regId, {
                                  method: 'POST',
                                  headers: { 'Content-Type': 'application/json' }
                                })
                                  .then(function (res) { return res.json(); })
                                  .then(function (data) {
                                    if (data.success) {
                                      Swal.fire({
                                        icon: 'success',
                                        title: 'Đã xóa!',
                                        text: data.message || 'Đã xóa đơn đăng ký thành công.',
                                        timer: 1500,
                                        showConfirmButton: false
                                      }).then(function () {
                                        window.location.reload();
                                      });
                                    } else {
                                      Swal.fire({
                                        icon: 'error',
                                        title: 'Lỗi',
                                        text: data.message || 'Không thể xóa đơn đăng ký này.'
                                      });
                                    }
                                  })
                                  .catch(function (err) {
                                    console.error('Delete error:', err);
                                    Swal.fire({
                                      icon: 'error',
                                      title: 'Lỗi kết nối',
                                      text: 'Không thể kết nối đến máy chủ.'
                                    });
                                  });
                              }
                            });
                            return;
                          }

                          var overviewPayBtn = e.target.closest('.overview-pay-btn');
                          if (overviewPayBtn) {
                            e.preventDefault();
                            e.stopPropagation();
                            var regId = overviewPayBtn.getAttribute('data-reg-id');
                            var title = overviewPayBtn.getAttribute('data-title') || 'Lớp học';
                            var fee = parseFloat(overviewPayBtn.getAttribute('data-fee') || 0);
                            var startDate = overviewPayBtn.getAttribute('data-start');
                            if (typeof window.openOverviewCartPaymentModal === 'function') {
                              window.openOverviewCartPaymentModal(regId, title, fee, startDate);
                            }
                            return;
                          }

                          var regBtn = e.target.closest('.btn-register-cls');
                          if (regBtn) {
                            e.preventDefault();
                            var classId = parseInt(regBtn.getAttribute('data-class-id'));
                            var fee = parseFloat(regBtn.getAttribute('data-fee'));
                            var start = regBtn.getAttribute('data-start');
                            var title = regBtn.getAttribute('data-title');
                            var course = regBtn.getAttribute('data-course');
                            if (typeof window.handleDirectRegistration === 'function') {
                              window.handleDirectRegistration(classId, fee, start, title, course);
                            }
                            return;
                          }

                          var cartBtn = e.target.closest('.btn-add-cart-cls');
                          if (cartBtn) {
                            e.preventDefault();
                            var classId = parseInt(cartBtn.getAttribute('data-class-id'));
                            var title = cartBtn.getAttribute('data-title');
                            if (typeof window.handleAddToCart === 'function') {
                              window.handleAddToCart(classId, title);
                            }
                            return;
                          }

                          var detailBtn = e.target.closest('.btn-detail-cls');
                          if (detailBtn) {
                            e.preventDefault();
                            var classId = parseInt(detailBtn.getAttribute('data-class-id'));
                            if (typeof showClassDetailsModal === 'function') {
                              showClassDetailsModal(classId);
                            }
                            return;
                          }
                        });

                        window.showInputConditionWarningModal = function(classId, classTitle, data, onSuccessCallback) {
                          const displayTitle = data.className || classTitle || 'lớp học';
                          const checkboxText = data.confirmCheckboxText || `Tôi xác nhận đã đọc kỹ yêu cầu đầu vào của lớp ${displayTitle} và tự chịu trách nhiệm về lựa chọn này.`;

                          Swal.fire({
                            icon: 'warning',
                            title: 'Cảnh báo điều kiện đầu vào',
                            html: `
                              <div class="text-start p-1">
                                <div class="alert alert-warning border-warning rounded-3 mb-3 p-3" style="background-color: #fff3cd; color: #664d03;">
                                  <div class="fw-bold mb-1"><i class="bi bi-exclamation-triangle-fill text-warning me-2 fs-5"></i>Lưu ý điều kiện đầu vào:</div>
                                  <div class="small" style="line-height: 1.5;">
                                    Hệ thống ghi nhận học viên <strong>chưa làm Bài Test đầu vào</strong> hoặc <strong>chưa học Khóa học tiền đề</strong> (Pre-TOEIC / Cơ bản) trước khi đăng ký lớp <strong>"${displayTitle}"</strong>.
                                  </div>
                                </div>
                                <div class="form-check p-3 bg-light rounded-3 border border-secondary-subtle">
                                  <input class="form-check-input ms-0 me-2" type="checkbox" id="inputConditionCheckboxConfirm" style="cursor: pointer; width: 1.2em; height: 1.2em;">
                                  <label class="form-check-label fw-semibold text-dark small" for="inputConditionCheckboxConfirm" style="cursor: pointer; user-select: none;">
                                    ${checkboxText}
                                  </label>
                                </div>
                              </div>
                            `,
                            showCancelButton: true,
                            confirmButtonText: '<i class="bi bi-check-circle-fill me-1"></i>Xác nhận & Đăng ký',
                            cancelButtonText: 'Hủy',
                            confirmButtonColor: '#f39c12',
                            cancelButtonColor: '#6c757d',
                            focusConfirm: false,
                            preConfirm: () => {
                              const chk = document.getElementById('inputConditionCheckboxConfirm');
                              if (!chk || !chk.checked) {
                                Swal.showValidationMessage('Vui lòng tích chọn xác nhận đã đọc kỹ yêu cầu đầu vào trước khi tiếp tục!');
                                return false;
                              }
                              return true;
                            }
                          }).then((result) => {
                            if (result.isConfirmed) {
                              fetch('/courses/cart/add', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ MaLopHoc: classId, confirmedInputWarning: true })
                              })
                              .then(res => res.json())
                              .then(resData => {
                                if (typeof onSuccessCallback === 'function') {
                                  onSuccessCallback(resData);
                                }
                              })
                              .catch(err => {
                                console.error(err);
                                Swal.fire({ icon: 'error', title: 'Lỗi', text: 'Đã xảy ra lỗi khi thêm vào giỏ hàng.' });
                              });
                            }
                          });
                        };

                      window.handleAddToCart = function (classId, classTitle) {
  if (!classId) return;

  // Hàm xử lý kết quả trả về chung để không bị lặp code
  const processAddToCartResult = (data) => {
    if (data.requireInputWarning) {
      window.showInputConditionWarningModal(classId, classTitle, data, processAddToCartResult);
      return;
    }
    if (data.success) {
      const badge = document.getElementById('header-cart-badge');
      if (badge) {
        badge.innerText = data.cartCount || '';
        badge.classList.remove('d-none');
      }
      Swal.fire({
        icon: 'success',
        title: 'Thêm vào giỏ hàng thành công! 🛒',
        text: `Đã thêm lớp học "${classTitle || ''}" vào giỏ hàng. Bạn có muốn chuyển đến giỏ hàng ngay không?`,
        showCancelButton: true,
        confirmButtonText: 'Đến giỏ hàng',
        cancelButtonText: 'Tiếp tục xem',
        confirmButtonColor: '#28a745',
        cancelButtonColor: '#6c757d'
      }).then((navRes) => {
        if (navRes.isConfirmed) {
          window.location.href = '/courses/cart';
        }
      });
    } else {
      Swal.fire({
        icon: 'info',
        title: 'Thông báo',
        text: data.message || `Lớp học "${classTitle || ''}" đã có trong giỏ hàng.`,
        showCancelButton: true,
        confirmButtonText: 'Đến giỏ hàng',
        cancelButtonText: 'Hủy',
        confirmButtonColor: '#3498db',
        cancelButtonColor: '#6c757d'
      }).then((navRes) => {
        if (navRes.isConfirmed) {
          window.location.href = '/courses/cart';
        }
      });
    }
  };

  // Gọi API lên server kiểm tra điều kiện & thêm giỏ hàng ngay lập tức
  fetch('/courses/cart/add', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ MaLopHoc: classId })
  })
  .then(res => res.json())
  .then(data => {
    processAddToCartResult(data);
  })
  .catch(err => {
    console.error(err);
    Swal.fire({
      icon: 'error',
      title: 'Lỗi',
      text: 'Đã xảy ra lỗi khi thêm vào giỏ hàng.',
      confirmButtonText: 'Đồng ý'
    });
  });
};

window.addtoCartHandler = window.handleAddToCart;

window.handleDirectRegistration = function (classId, fee, startDateStr, classTitle, courseTitle) {
  if (!classId) return;

  const processDirectRegResult = (data) => {
    if (data.requireInputWarning) {
      window.showInputConditionWarningModal(classId, classTitle, data, processDirectRegResult);
      return;
    }
    if (data.success) {
      Swal.fire({
        icon: 'success',
        title: 'Thành công! 🎉',
        text: 'Đã thêm lớp vào danh sách đăng ký. Đang chuyển tới giỏ hàng...',
        timer: 1200,
        showConfirmButton: false
      }).then(() => {
        window.location.href = '/courses/cart';
      });
    } else {
      Swal.fire({
        icon: 'info',
        title: 'Thông báo',
        text: data.message || 'Lớp học này đã có trong giỏ hàng.',
        showCancelButton: true,
        confirmButtonText: 'Đến giỏ hàng',
        cancelButtonText: 'Hủy',
        confirmButtonColor: '#3498db'
      }).then((navRes) => {
        if (navRes.isConfirmed) {
          window.location.href = '/courses/cart';
        }
      });
    }
  };

  fetch('/courses/cart/add', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ MaLopHoc: classId })
  })
  .then(res => res.json())
  .then(data => processDirectRegResult(data))
  .catch(err => {
    console.error(err);
    Swal.fire({ icon: 'error', title: 'Lỗi', text: 'Đã xảy ra lỗi khi đăng ký lớp.' });
  });
};

window.registerClassSubmit = window.handleDirectRegistration;

})();
</script>

