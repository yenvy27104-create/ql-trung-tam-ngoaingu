                        window.updateOverviewVietQRUrl = function () {
                          var customQr = '<%= (typeof paymentConfig !== "undefined" && paymentConfig && paymentConfig.qrImage) ? paymentConfig.qrImage : "" %>';
                          var qrUrl = '';
                          if (customQr && customQr !== 'null' && customQr.trim() !== '') {
                            qrUrl = customQr;
                          } else {
                            var bankId = '<%= (typeof paymentConfig !== "undefined" && paymentConfig && paymentConfig.bankId) ? paymentConfig.bankId : "970436" %>';
                            var accountNo = '<%= (typeof paymentConfig !== "undefined" && paymentConfig && paymentConfig.accountNo) ? paymentConfig.accountNo : "" %>';
                            var template = '<%= (typeof paymentConfig !== "undefined" && paymentConfig && paymentConfig.template) ? paymentConfig.template : "compact2" %>';
                            var accountName = encodeURIComponent('<%= (typeof paymentConfig !== "undefined" && paymentConfig && paymentConfig.accountName) ? paymentConfig.accountName : "" %>');
                            qrUrl = 'https://img.vietqr.io/image/' + bankId + '-' + accountNo + '-' + template + '.png?amount=' + currentOvFinalFee + '&addInfo=' + encodeURIComponent(currentOvQrContent) + '&accountName=' + accountName;
                          }
                          var qrImgEl = document.getElementById('ov-cart-vietqr-image');
                          if (qrImgEl) qrImgEl.src = qrUrl;
