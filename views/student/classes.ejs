                                                               const cuoiVal = (g.DiemCuoiKy !== undefined && g.DiemCuoiKy !== null) ? g.DiemCuoiKy : (cls.DiemCuoiKy !== undefined && cls.DiemCuoiKy !== null ? cls.DiemCuoiKy : null);
                                                               const nhanXet = g.NhanXetGiangVien || cls.NhanXetGiangVien || '';
                                                        %>
