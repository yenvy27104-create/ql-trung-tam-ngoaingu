                      window.openBulkPaymentModal = openBulkPaymentModal;

                      function bulkDeleteRegistrations() {
                        const checked = Array.from(document.querySelectorAll('.unpaid-reg-checkbox:checked'));
                        if (checked.length === 0) return;

                        Swal.fire({
                          title: `Hủy đăng ký ${checked.length} lớp?`,
