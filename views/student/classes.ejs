                      function handleRegisterErrors(data, retryFn) {
                        if (data.requireRegister) {
                          Swal.fire({
                            icon: 'warning',
                            title: 'Yêu cầu đăng ký tài khoản',
                            text: data.message || 'Tài khoản Google chưa đăng ký thông tin cá nhân. Bạn bắt buộc phải đăng ký tài khoản trước khi đăng ký lớp học.',
                            confirmButtonText: 'Đăng ký ngay',
                            showCancelButton: true,
                            cancelButtonText: 'Đóng',
                            confirmButtonColor: '#3498db'
                          }).then((r) => { if (r.isConfirmed) window.location.href = '/register'; });
                          return true;
                        }
                        if (data.requirePhone) {
                          Swal.fire({
                            title: 'Cập nhật số điện thoại',
                            text: 'Vui lòng bổ sung số điện thoại liên lạc để đăng ký lớp học:',
                            input: 'text',
                            inputPlaceholder: 'Nhập số điện thoại (10 chữ số)...',
                            showCancelButton: true,
                            confirmButtonText: 'Xác nhận',
                            cancelButtonText: 'Hủy',
                            confirmButtonColor: '#3498db',
                            inputValidator: (value) => {
                              if (!value) return 'Bạn cần nhập số điện thoại!';
                              if (!/^[0-9]{10}$/.test(value.trim())) return 'Số điện thoại không hợp lệ (yêu cầu 10 chữ số)!';
                            }
                          }).then((r) => {
                            if (r.isConfirmed) {
                              fetch('/classes/update-phone', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ SoDienThoai: r.value.trim() })
                              })
                                .then(res => res.json())
                                .then(updateData => {
                                  if (updateData.success && typeof retryFn === 'function') retryFn();
                                  else Swal.fire({ icon: 'error', title: 'Lỗi', text: updateData.message || 'Cập nhật số điện thoại thất bại.' });
                                });
                            }
                          });
                          return true;
                        }
                        return false;
                      }

                      function submitRegisterForStudent(maLopHoc, hocPhi, startDateStr, classTitle, courseTitle, maHocVien) {
                        const displayTitle = `${courseTitle} — ${classTitle}`;
                        fetch('/classes/register-class', {
                          method: 'POST',
                          headers: { 'Content-Type': 'application/json' },
                          body: JSON.stringify({
                            MaLopHoc: maLopHoc,
                            MaHocVien: maHocVien,
                            HocPhiDaGiam: hocPhi,
                            MaKhuyenMai: null
                          })
                        })
                          .then(res => res.json())
                          .then(data => {
                            if (data.success) {
                              openPaymentModal(data.registrationId, displayTitle, hocPhi, startDateStr);
                            } else {
                              if (handleRegisterErrors(data, () => submitRegisterForStudent(maLopHoc, hocPhi, startDateStr, classTitle, courseTitle, maHocVien))) return;
                              Swal.fire({ icon: 'error', title: 'Lỗi đăng ký', text: data.message || 'Lỗi xảy ra khi đăng ký lớp.', confirmButtonText: 'Đồng ý' });
                            }
                          })
                          .catch(() => {
                            Swal.fire({ icon: 'error', title: 'Lỗi kết nối', text: 'Đã xảy ra lỗi kết nối mạng.', confirmButtonText: 'Đồng ý' });
                          });
                      }

                      function registerClassSubmit(maLopHoc, hocPhi, startDateStr, classTitle, courseTitle) {
                        const profiles = userProfilesData || [];
                        if (profiles.length === 0) {
                          Swal.fire({ icon: 'warning', title: 'Chưa có hồ sơ học viên', text: 'Vui lòng tạo hồ sơ học viên trước khi đăng ký lớp.' });
                          return;
                        }

                        const feeFormatted = Number(hocPhi || 0).toLocaleString('vi-VN') + ' đ';

                        if (profiles.length === 1) {
                          Swal.fire({
                            title: 'Xác nhận đăng ký học?',
                            html: `Bạn có chắc chắn muốn đăng ký lớp học <strong>${classTitle}</strong> (${courseTitle}) với học phí <strong>${feeFormatted}</strong>?`,
                            icon: 'question',
                            showCancelButton: true,
                            confirmButtonColor: '#3498db',
                            cancelButtonColor: '#6c757d',
                            confirmButtonText: 'Đồng ý & Thanh toán',
                            cancelButtonText: 'Hủy'
                          }).then((result) => {
                            if (result.isConfirmed) {
                              submitRegisterForStudent(maLopHoc, hocPhi, startDateStr, classTitle, courseTitle, profiles[0].MaHocVien);
                            }
                          });
                          return;
                        }

                        const safeRegsForClass = (typeof registeredClassesData !== 'undefined' ? registeredClassesData : []).filter(rc => rc && String(rc.MaLopHoc).trim() === String(maLopHoc).trim());
                        const regStudentIds = safeRegsForClass.map(rc => Number(rc.MaHocVien));

                        let firstAvailableId = null;
                        const optionsHtml = profiles.map(p => {
                          const isAlreadyReg = regStudentIds.includes(Number(p.MaHocVien));
                          if (!isAlreadyReg && !firstAvailableId) {
                            firstAvailableId = p.MaHocVien;
                          }
                          if (isAlreadyReg) {
                            return `<option value="${p.MaHocVien}" disabled>${p.HoTen || 'Học viên'} (${p.QuanHe || 'Bản thân'}) - Đã đăng ký lớp này</option>`;
                          }
                          return `<option value="${p.MaHocVien}" ${p.MaHocVien === firstAvailableId ? 'selected' : ''}>${p.HoTen || 'Học viên'} (${p.QuanHe || 'Bản thân'})</option>`;
                        }).join('');

                        Swal.fire({
                          title: 'Xác nhận đăng ký học',
                          html: `
        <p class="text-muted small mb-2">Bạn đang đăng ký lớp <strong>${classTitle}</strong> (${courseTitle}) với học phí <strong>${feeFormatted}</strong>.</p>
        <p class="text-dark small fw-semibold mb-2">Vui lòng chọn hồ sơ học viên cần ghi danh:</p>
        <select id="swal-pick-student" class="form-select">${optionsHtml}</select>
      `,
                          icon: 'question',
                          showCancelButton: true,
                          confirmButtonText: 'Đồng ý & Thanh toán',
                          cancelButtonText: 'Hủy',
                          confirmButtonColor: '#3498db',
                          cancelButtonColor: '#6c757d',
                          preConfirm: () => {
                            const val = document.getElementById('swal-pick-student').value;
                            if (!val) Swal.showValidationMessage('Vui lòng chọn học viên!');
                            return val;
                          }
                        }).then((result) => {
                          if (result.isConfirmed) {
                            submitRegisterForStudent(maLopHoc, hocPhi, startDateStr, classTitle, courseTitle, Number(result.value));
                          }
                        });
                      }

                      let activeRegistrationId = null;
                      let activeClassFee = 0;
                      let activeClassTitle = '';
                      let activeFinalAmount = 0;
                      let activeQrContent = '';

                      function triggerPaymentModal(btn) {
                        if (!btn) return;
                        const regId = btn.getAttribute('data-reg-id');
                        const title = btn.getAttribute('data-title');
                        const fee = parseFloat(btn.getAttribute('data-fee') || 0);
                        const start = btn.getAttribute('data-start');
                        openPaymentModal(regId, title, fee, start);
                      }

                      function openPaymentModal(registrationId, classTitle, origFee, startDateStr) {
                        try {
                          activeRegistrationId = registrationId;
                          activeClassFee = parseFloat(origFee || 0);
                          activeClassTitle = classTitle || 'Lớp học';
                          activeClassStartDate = startDateStr ? new Date(startDateStr) : null;

                          const titleEl = document.getElementById('payment-class-title');
                          if (titleEl) titleEl.innerText = activeClassTitle;

                          const feeEl = document.getElementById('payment-original-fee');
                          if (feeEl) feeEl.innerText = Number(activeClassFee).toLocaleString('vi-VN') + ' đ';

                          const promoEl = document.getElementById('payment-promo');
                          if (promoEl) promoEl.value = '';

                          if (typeof updatePaymentAmounts === 'function') {
                            updatePaymentAmounts();
                          }

                          const methodVietqr = document.getElementById('method-vietqr');
                          if (methodVietqr) methodVietqr.checked = true;

                          if (typeof togglePaymentMethodDisplay === 'function') {
                            togglePaymentMethodDisplay();
                          }

                          const modalEl = document.getElementById('paymentModal');
                          if (modalEl) {
                            const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
                            modal.show();
                            if (typeof startClassesQrCountdownTimer === 'function') {
                              startClassesQrCountdownTimer();
                            }
                          } else {
                            console.error('Modal paymentModal not found!');
                          }
                        } catch (err) {
                          console.error('Error opening payment modal:', err);
                        }
                      }

                      function removeVietnameseTones(str) {
                        if (!str) return '';
                        str = str.replace(/à|á|ạ|ả|ã|â|ầ|ấ|ậ|ẩ|ẫ|ă|ằ|ắ|ặ|ẳ|ẵ/g, "a");
                        str = str.replace(/è|é|ẹ|ẻ|ẽ|ê|ề|ế|ệ|ể|ễ/g, "e");
                        str = str.replace(/ì|í|ị|ỉ|ĩ/g, "i");
                        str = str.replace(/ò|ó|ọ|ỏ|õ|ô|ồ|ố|ộ|ổ|ỗ|ơ|ờ|ớ|ợ|ở|ỡ/g, "o");
                        str = str.replace(/ù|ú|ụ|ủ|ũ|ư|ừ|ứ|ự|ử|ữ/g, "u");
                        str = str.replace(/ỳ|ý|ỵ|ỷ|ỹ/g, "y");
                        str = str.replace(/đ/g, "d");
                        str = str.replace(/À|Á|Ạ|Ả|Ã|Â|Ầ|Ấ|Ậ|Ẩ|Ẫ|Ă|Ằ|Ắ|Ặ|Ẳ|Ẵ/g, "A");
                        str = str.replace(/È|É|Ẹ|Ẻ|Ẽ|Ê|Ề|Ế|Ệ|Ể|Ễ/g, "E");
                        str = str.replace(/Ì|Í|Ị|Ỉ|Ĩ/g, "I");
                        str = str.replace(/Ò|Ó|Ọ|Ỏ|Õ|Ô|Ồ|Ố|Ộ|Ổ|Ỗ|Ơ|Ờ|Ớ|Ợ|Ở|Ỡ/g, "O");
                        str = str.replace(/Ù|Ú|Ụ|Ủ|Ũ|Ư|Ừ|Ứ|Ự|Ử|Ữ/g, "U");
                        str = str.replace(/Ỳ|Ý|Ỵ|Ỷ|Ỹ/g, "Y");
                        str = str.replace(/Đ/g, "D");
                        return str;
                      }

                      function applyPromoCode() {
                        updatePaymentAmounts();
                      }

                      function updatePaymentAmounts() {
                        const promoSelect = document.getElementById('payment-promo');
                        if (!promoSelect) return;
                        const selectedOpt = promoSelect.selectedIndex >= 0 ? promoSelect.options[promoSelect.selectedIndex] : null;
                        const pct = selectedOpt ? parseFloat(selectedOpt.getAttribute('data-pct') || (selectedOpt.dataset ? selectedOpt.dataset.pct : 0) || 0) : 0;
                        const promoCode = selectedOpt ? (selectedOpt.getAttribute('data-code') || (selectedOpt.dataset ? selectedOpt.dataset.code : '') || '') : '';

                        let totalRegCount = 0;
                        if (activeRegistrationId) {
                          const regIds = activeRegistrationId.toString().split(',').filter(x => x.trim() !== '');
                          totalRegCount = regIds.length;
                        }
                        if (promoCode === 'COMBO20') {
                          if (totalRegCount < 2) {
                            Swal.fire({
                              icon: 'warning',
                              title: 'Không đủ điều kiện',
                              text: 'Khuyến mãi "Combo 2 khóa học" (COMBO20) chỉ áp dụng khi thanh toán từ 2 lớp/khóa học trở lên. Vui lòng sử dụng tính năng Giỏ hàng để đăng ký cùng lúc.',
                              confirmButtonText: 'Đồng ý',
                              confirmButtonColor: '#3498db'
                            });
                            promoSelect.selectedIndex = 0;
                            activeFinalAmount = activeClassFee;
                            document.getElementById('payment-final-fee').innerText = Number(activeFinalAmount).toLocaleString('vi-VN') + ' đ';
                            document.getElementById('qr-detail-amount').innerText = Number(activeFinalAmount).toLocaleString('vi-VN') + ' đ';
                            return;
                          }
                          if (activeClassStartDate) {
                            const today = new Date();
                            today.setHours(0, 0, 0, 0);
                            const startDate = new Date(activeClassStartDate);
                            startDate.setHours(0, 0, 0, 0);
                            const diffDays = Math.ceil((startDate.getTime() - today.getTime()) / (1000 * 60 * 60 * 24));
                            if (diffDays < 10) {
                              Swal.fire({
                                icon: 'warning',
                                title: 'Không đủ điều kiện',
                                text: 'Khuyến mãi "Combo 2 khóa học" (COMBO20) yêu cầu đăng ký trước ngày khai giảng tối thiểu 10 ngày. Lớp học này khai giảng ngày ' + startDate.toLocaleDateString('vi-VN') + ' (chỉ còn ' + (diffDays < 0 ? 0 : diffDays) + ' ngày).',
                                confirmButtonText: 'Đồng ý',
                                confirmButtonColor: '#3498db'
                              });
                              promoSelect.selectedIndex = 0;
                              activeFinalAmount = activeClassFee;
                              document.getElementById('payment-final-fee').innerText = Number(activeFinalAmount).toLocaleString('vi-VN') + ' đ';
                              document.getElementById('qr-detail-amount').innerText = Number(activeFinalAmount).toLocaleString('vi-VN') + ' đ';
                              return;
                            }
                          }
                        }

                        if (promoCode === 'FLASHSALE15' && activeClassStartDate) {
                          const today = new Date();
                          today.setHours(0, 0, 0, 0);
                          const startDate = new Date(activeClassStartDate);
                          startDate.setHours(0, 0, 0, 0);
                          const diffTime = startDate.getTime() - today.getTime();
                          const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));

                          if (diffDays < 10) {
                            Swal.fire({
                              icon: 'warning',
                              title: 'Không đủ điều kiện',
                              text: 'Khuyến mãi "Đăng ký sớm" (FLASHSALE15) chỉ áp dụng khi thanh toán trước ngày khai giảng tối thiểu 10 ngày. Lớp học này khai giảng ngày ' + startDate.toLocaleDateString('vi-VN') + ' (chỉ còn ' + (diffDays < 0 ? 0 : diffDays) + ' ngày).',
                              confirmButtonText: 'Đồng ý',
                              confirmButtonColor: '#3498db'
                            });
                            promoSelect.selectedIndex = 0;
                            activeFinalAmount = activeClassFee;
                            document.getElementById('payment-final-fee').innerText = Number(activeFinalAmount).toLocaleString('vi-VN') + ' đ';
                            document.getElementById('qr-detail-amount').innerText = Number(activeFinalAmount).toLocaleString('vi-VN') + ' đ';
                            return;
                          }
                        }

                        const promoId = promoSelect.value;
                        activeFinalAmount = activeClassFee * (1 - pct / 100);
                        const finalAmount = activeFinalAmount;

                        const finalFeeEl = document.getElementById('payment-final-fee');
                        if (finalFeeEl) finalFeeEl.innerText = Number(finalAmount).toLocaleString('vi-VN') + ' đ';

                        const qrDetailFeeEl = document.getElementById('qr-detail-amount');
                        if (qrDetailFeeEl) qrDetailFeeEl.innerText = Number(finalAmount).toLocaleString('vi-VN') + ' đ';

                        const cleanTitle = removeVietnameseTones(activeClassTitle || 'Lop hoc').replace(/[^a-zA-Z0-9 ]/g, '').replace(/\s+/g, ' ').trim();
                        activeQrContent = `DK hoc lop ${cleanTitle} MaDK${activeRegistrationId}`.substring(0, 50);

                        const qrContentEl = document.getElementById('qr-detail-content');
                        if (qrContentEl) qrContentEl.innerText = activeQrContent;

                        const customQr = '<%= (typeof paymentConfig !== "undefined" && paymentConfig && paymentConfig.qrImage) ? paymentConfig.qrImage : "" %>';
                        let qrUrl = '';
                        if (customQr && customQr !== 'null' && customQr.trim() !== '') {
                          qrUrl = customQr;
                        } else {
                          const bankId = '<%= (typeof paymentConfig !== "undefined" && paymentConfig && paymentConfig.bankId) ? paymentConfig.bankId : "970436" %>';
                          const accountNo = '<%= (typeof paymentConfig !== "undefined" && paymentConfig && paymentConfig.accountNo) ? paymentConfig.accountNo : "" %>';
                          const template = '<%= (typeof paymentConfig !== "undefined" && paymentConfig && paymentConfig.template) ? paymentConfig.template : "compact2" %>';
                          const accountName = encodeURIComponent('<%= (typeof paymentConfig !== "undefined" && paymentConfig && paymentConfig.accountName) ? paymentConfig.accountName : "" %>');
                          qrUrl = `https://img.vietqr.io/image/${bankId}-${accountNo}-${template}.png?amount=${finalAmount}&addInfo=${encodeURIComponent(activeQrContent)}&accountName=${accountName}`;
                        }
                        const qrImg = document.getElementById('vietqr-image');
                        if (qrImg) qrImg.src = qrUrl;
                      }

                      function toggleSelectAllUnpaid(masterCb) {
                        const checkboxes = document.querySelectorAll('.unpaid-reg-checkbox');
