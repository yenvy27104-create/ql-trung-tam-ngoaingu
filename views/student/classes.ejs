                          icon: 'warning',
                          showCancelButton: true,
                          confirmButtonColor: '#d33',
                          cancelButtonColor: '#6c757d',
                          confirmButtonText: 'Xóa tất cả',
                          cancelButtonText: 'Hủy'
                        }).then((result) => {
                          if (result.isConfirmed) {
                            Swal.fire({
                              title: 'Đang xử lý...',
                              text: 'Vui lòng chờ trong giây lát',
                              allowOutsideClick: false,
                              didOpen: () => { Swal.showLoading(); }
                            });

                            const deletePromises = checked.map(cb => {
                              const regId = cb.value;
                              return fetch(`/classes/delete-registration/${regId}`, {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' }
                              }).then(res => res.json());
                            });

                            Promise.all(deletePromises)
                              .then(results => {
                                const allSuccess = results.every(r => r.success);

                                if (allSuccess) {
                                  Swal.fire({
                                    icon: 'success',
                                    title: 'Đã xóa thành công!',
                                    text: `Đã hủy đăng ký ${checked.length} lớp học.`,
                                    confirmButtonText: 'Đồng ý'
                                  }).then(() => {
                                    window.location.reload();
                                  });
                                } else {
                                  Swal.fire({
                                    icon: 'warning',
                                    title: 'Hoàn tất một phần',
                                    text: 'Một số lớp không thể xóa. Vui lòng kiểm tra lại.',
                                    confirmButtonText: 'Đồng ý'
                                  }).then(() => window.location.reload());
                                }
                              })
                              .catch(err => {
                                console.error('Lỗi khi xóa gộp:', err);
                                Swal.fire({
                                  icon: 'error',
                                  title: 'Lỗi',
                                  text: 'Có lỗi xảy ra trong quá trình xóa. Vui lòng thử lại sau.'
                                });
                              });
                          }
                        });
                      }
                      window.bulkDeleteRegistrations = bulkDeleteRegistrations;

