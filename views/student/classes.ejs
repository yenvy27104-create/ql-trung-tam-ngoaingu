                                                      <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 fw-bold rounded-pill">
                                                        <i class="bi bi-award-fill me-1"></i>Đã hoàn thành <%= completedClasses.length %> khóa học
