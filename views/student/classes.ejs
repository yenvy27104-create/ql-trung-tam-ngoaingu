                      function initTabFromUrl() {
                        const urlParams = new URLSearchParams(window.location.search);
                        const tabParam = urlParams.get('tab');
                        const searchParam = urlParams.get('search');
                        const autoOpenParam = urlParams.get('autoOpen');

                        if (tabParam) {
                          switchTab(tabParam);
                        } else if (searchParam) {
                          switchTab('registration');
                        } else {
                          switchTab('overview');
                        }

                        if (searchParam) {
                          const searchInput = document.getElementById('class-search-input');
                          if (searchInput) {
                            searchInput.value = searchParam;
                            if (typeof filterAvailableClasses === 'function') {
                              filterAvailableClasses();
                            }
                          }
                        }

                        if (tabParam === 'registration' || searchParam) {
                          setTimeout(() => {
                            const visibleCards = Array.from(document.querySelectorAll('.class-reg-card')).filter(c => c.style.display !== 'none');
                            const firstMatchingCard = visibleCards[0];
                            const targetEl = firstMatchingCard || document.getElementById('class-search-input') || document.getElementById('panel-registration');
                            if (targetEl) {
                              targetEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
                              if (firstMatchingCard && searchParam) {
                                firstMatchingCard.style.transition = 'all 0.3s ease';
                                firstMatchingCard.style.boxShadow = '0 0 0 4px rgba(52, 152, 219, 0.5)';
                                firstMatchingCard.style.borderRadius = '16px';
                                setTimeout(() => { firstMatchingCard.style.boxShadow = ''; }, 2500);
                              }
                            }
                          }, 200);
                        }
                      }

                      initTabFromUrl();
                      if (document.readyState === 'loading') {
                        document.addEventListener('DOMContentLoaded', initTabFromUrl);
                      }

                      const pageUrlParams = new URLSearchParams(window.location.search);
                      if (pageUrlParams.get('success') === 'payment_success' || window.location.hash === '#my-courses-section') {
                        setTimeout(function () {
                          const targetSec = document.getElementById('my-courses-section');
