      <script>
        function filterRoadmapType(type, btn) {
          document.querySelectorAll('#roadmapTypeFilter .btn').forEach(b => {
            b.classList.remove('active', 'btn-primary');
            b.classList.add('btn-outline-primary');
          });
          btn.classList.add('active', 'btn-primary');
          btn.classList.remove('btn-outline-primary');

          const rows = document.querySelectorAll('.roadmap-row');
          rows.forEach(r => {
            if (type === 'all' || r.dataset.loai === type) {
              r.style.display = '';
            } else {
              r.style.display = 'none';
            }
          });
        }

        function validateRoadmapForm(form, event) {
          const loaiLoTrinh = form.querySelector('[name="LoaiLoTrinh"]')?.value || 'Tiêu chuẩn';
          const currentId = form.getAttribute('data-roadmap-id');
          const diemTuInput = form.querySelector('[name="DiemTu"]');
          const diemDenInput = form.querySelector('[name="DiemDen"]');
          const diemTu = parseInt(diemTuInput.value);
          const diemDen = parseInt(diemDenInput.value);

          if (isNaN(diemTu) || isNaN(diemDen) || diemTu < 0 || diemDen > 990) {
            event.preventDefault();
            Swal.fire({
              icon: 'error',
              title: 'Dải điểm không hợp lệ!',
              text: 'Điểm Từ và Điểm Đến phải là số nguyên từ 0 đến 990.'
            });
            return false;
          }

          if (diemTu % 5 !== 0 || diemDen % 5 !== 0) {
            event.preventDefault();
            Swal.fire({
              icon: 'error',
              title: 'Điểm số không chuẩn bước nhảy TOEIC!',
              text: 'Điểm Từ và Điểm Đến phải chia hết cho 5 theo bước nhảy bài thi TOEIC.'
            });
            return false;
          }

          if (diemTu >= diemDen) {
            event.preventDefault();
            Swal.fire({
              icon: 'error',
              title: 'Dải điểm không hợp lệ!',
              text: 'Điểm bắt đầu phải nhỏ hơn điểm kết thúc (Điểm Từ < Điểm Đến).'
            });
            return false;
          }

          if (loaiLoTrinh === 'Mất gốc' && diemDen > 350) {
            event.preventDefault();
            Swal.fire({
              icon: 'error',
              title: 'Trần điểm loại Mất gốc!',
              text: 'Loại lộ trình "Mất gốc" quy định Điểm Đến tối đa không vượt quá 350 điểm.'
            });
            return false;
          }

          const rows = document.querySelectorAll('.roadmap-row');
          for (let row of rows) {
            const rowLoai = row.dataset.loai;
            const rowId = row.dataset.id;
            if (rowLoai === loaiLoTrinh && rowId !== currentId) {
              const existStart = parseInt(row.dataset.diemtu);
              const existEnd = parseInt(row.dataset.diemden);
              if (!isNaN(existStart) && !isNaN(existEnd)) {
                if (diemTu < existEnd && diemDen > existStart) {
                  event.preventDefault();
                  Swal.fire({
                    icon: 'error',
                    title: 'Lỗi giao dải điểm (Overlapping)!',
                    text: `Dải điểm (${diemTu} - ${diemDen}) bị đè/trùng lặp với dải điểm (${existStart} - ${existEnd}) của lộ trình khác trong loại "${loaiLoTrinh}".`
                  });
                  return false;
                }
              }
            }
          }
          return true;
        }
      </script>
    <% } %>

