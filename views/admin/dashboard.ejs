                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    <% } %>

    <!-- ========================================================================= -->
    <!-- CHỨC NĂNG 2: QUẢN LÝ TÀI KHOẢN NGƯỜI DÙNG (ADMIN)                       -->
    <!-- Cho phép Admin: Xem danh sách, Tìm kiếm, Tạo mới, Chỉnh sửa thông tin,   -->
    <!-- Đổi mật khẩu, Khóa/Kích hoạt tài khoản và Xóa tài khoản người dùng     -->
    <!-- ========================================================================= -->
    <% if (activeTab === 'accounts') { %>
      <div class="card border-0 shadow-sm rounded-4 p-4">
        <!-- Thanh công cụ: Ô tìm kiếm tài khoản & Nút Mở Modal Tạo tài khoản mới -->
        <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
          <h5 class="fw-bold mb-0"><i class="bi bi-people-fill me-2 text-primary"></i>Quản lý Tài khoản người dùng</h5>
          <div class="d-flex gap-2 ms-auto">
            <div class="input-group" style="width: 280px;">
              <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
              <input type="text" id="searchAccounts" class="form-control bg-light border-start-0" placeholder="Tìm kiếm tài khoản..." />
            </div>
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addAccountModal">
              <i class="bi bi-person-plus-fill me-2"></i>Tạo tài khoản mới
            </button>
          </div>
        </div>

        <!-- Bảng hiển thị danh sách Tài khoản người dùng -->
        <div class="table-responsive">
          <table class="table table-hover align-middle">
            <thead class="table-light">
              <tr>
                <th>Họ Tên</th>
                <th>Email</th>
                <th>SĐT</th>
                <th>Vai Trò</th>
                <th>Trạng Thái</th>
                <th class="text-end">Hành Động</th>
              </tr>
            </thead>
            <tbody>
              <% users.forEach(u => { %>
                <tr>
                  <td>
                    <div class="d-flex align-items-center">
                      <img src="<%= u.AnhDaiDien || '/images/avatar-default.png' %>" class="rounded-circle me-2" style="width: 35px; height: 35px; object-fit: cover;" />
                      <span class="fw-semibold"><%= u.HoTen %></span>
                    </div>
                  </td>
                  <td><%= u.Email %></td>
                  <td><%= u.SoDienThoai %></td>
                  <td>
                    <span class="badge rounded-pill bg-secondary-subtle text-secondary"><%= u.TenVaiTro %></span>
                  </td>
                  <td>
                    <span class="badge rounded-pill <%= u.TrangThai === 'Hoạt động' || u.TrangThai === 'Active' ? 'bg-success-subtle text-success' : 'bg-danger-subtle text-danger' %>">
                      <%= u.TrangThai %>
                    </span>
                  </td>
                  <td class="text-end">
                    <button class="btn btn-sm btn-outline-secondary me-1" data-bs-toggle="modal" data-bs-target="#editAccountModal<%= u.MaNguoiDung %>" title="Sửa thông tin">
                      <i class="bi bi-pencil"></i>
                    </button>
                    <button class="btn btn-sm btn-outline-warning me-1" data-bs-toggle="modal" data-bs-target="#changePasswordModal<%= u.MaNguoiDung %>" title="Đổi mật khẩu">
                      <i class="bi bi-key"></i>
                    </button>
                    <form action="/admin/accounts/delete/<%= u.MaNguoiDung %>" method="POST" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa tài khoản này và mọi dữ liệu liên quan?')">
                      <button class="btn btn-sm btn-outline-danger" title="Xóa tài khoản"><i class="bi bi-trash"></i></button>
                    </form>
                  </td>
                </tr>

                <!-- Edit Account Modal -->
                <div class="modal fade" id="editAccountModal<%= u.MaNguoiDung %>" tabindex="-1" aria-hidden="true">
                  <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content border-0 rounded-3 shadow">
                      <div class="modal-header border-0 bg-light">
                        <h5 class="modal-title fw-bold">Sửa tài khoản: <%= u.HoTen %></h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                      </div>
                      <form action="/admin/accounts/edit/<%= u.MaNguoiDung %>" method="POST" enctype="multipart/form-data" onsubmit="return confirm('Bạn có chắc chắn muốn cập nhật thông tin tài khoản này?')">
                        <div class="modal-body p-4">
                          <div class="mb-3">
                            <label class="form-label fw-semibold">Họ và tên</label>
                            <input type="text" class="form-control" name="HoTen" value="<%= u.HoTen %>" required />
                          </div>
                          <div class="mb-3">
                            <label class="form-label fw-semibold">Email <span class="text-muted fw-normal small">(Không thể thay đổi)</span></label>
                            <input type="email" class="form-control bg-light" name="Email" value="<%= u.Email %>" disabled readonly />
                          </div>
                          <div class="mb-3">
                            <label class="form-label fw-semibold">Số điện thoại</label>
                            <input type="text" class="form-control" name="SoDienThoai" value="<%= u.SoDienThoai %>" required />
                          </div>
                          <div class="mb-3">
                            <label class="form-label fw-semibold">Ảnh đại diện</label>
                            <input type="text" class="form-control mb-2" name="AnhDaiDien" value="<%= u.AnhDaiDien %>" placeholder="Đường dẫn ảnh (URL hoặc /images/...)" />
                            <input type="file" class="form-control" name="AnhDaiDienFile" accept="image/*" />
                            <div class="form-text">Nhập đường dẫn ảnh hoặc tải lên file ảnh mới.</div>
                          </div>
                          <div class="mb-3">
                            <label class="form-label fw-semibold">Vai trò</label>
                            <select class="form-select" name="MaVaiTro">
                              <% roles.forEach(r => { %>
                                <option value="<%= r.MaVaiTro %>" <%= u.MaVaiTro === r.MaVaiTro ? 'selected' : '' %>><%= r.TenVaiTro %></option>
                              <% }) %>
                            </select>
                          </div>
                          <div class="mb-3">
                            <label class="form-label fw-semibold">Trạng thái</label>
                            <select class="form-select" name="TrangThai">
                              <option value="Hoạt động" <%= u.TrangThai === 'Hoạt động' || u.TrangThai === 'Active' ? 'selected' : '' %>>Hoạt động</option>
                              <option value="Khóa" <%= u.TrangThai === 'Khóa' ? 'selected' : '' %>>Khóa</option>
                            </select>
                          </div>
                        </div>
                        <div class="modal-footer border-0">
                          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Đóng</button>
                          <button type="submit" class="btn btn-primary">Cập nhật</button>
                        </div>
                      </form>
                    </div>
                  </div>
                </div>

                <!-- Change Password Modal -->
                <div class="modal fade" id="changePasswordModal<%= u.MaNguoiDung %>" tabindex="-1" aria-hidden="true">
                  <div class="modal-dialog modal-dialog-centered modal-sm">
                    <div class="modal-content border-0 rounded-3 shadow">
                      <div class="modal-header border-0 bg-light">
                        <h5 class="modal-title fw-bold">Đổi Mật Khẩu</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                      </div>
                      <form action="/admin/accounts/change-password/<%= u.MaNguoiDung %>" method="POST" onsubmit="return confirm('Bạn có chắc chắn muốn đổi mật khẩu tài khoản này?')">
                        <div class="modal-body p-4">
                          <div class="mb-3">
                            <label class="form-label fw-semibold">Mật khẩu mới</label>
                            <input type="password" class="form-control" name="MatKhauMoi" placeholder="Tối thiểu 6 ký tự" required />
                          </div>
                        </div>
                        <div class="modal-footer border-0">
                          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
                          <button type="submit" class="btn btn-warning">Đổi mật khẩu</button>
                        </div>
                      </form>
                    </div>
                  </div>
                </div>

              <% }) %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Add Account Modal -->
      <div class="modal fade" id="addAccountModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
          <div class="modal-content border-0 rounded-3 shadow">
            <div class="modal-header border-0 bg-light">
              <h5 class="modal-title fw-bold">Tạo tài khoản mới</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="/admin/accounts/add" method="POST" enctype="multipart/form-data" onsubmit="return confirm('Bạn có chắc chắn muốn khởi tạo tài khoản mới này không?')">
              <div class="modal-body p-4">
                <div class="mb-3">
                  <label class="form-label fw-semibold">Họ và tên</label>
                  <input type="text" class="form-control" name="HoTen" required placeholder="Nguyễn Văn A" />
                </div>
                <div class="mb-3">
                  <label class="form-label fw-semibold">Email</label>
                  <input type="email" class="form-control" name="Email" required placeholder="email@example.com" />
                </div>
                <div class="mb-3">
                  <label class="form-label fw-semibold">Số điện thoại</label>
                  <input type="text" class="form-control" name="SoDienThoai" required placeholder="09xxxxxxxx" />
                </div>
                <div class="mb-3">
                  <label class="form-label fw-semibold">Ảnh đại diện</label>
                  <input type="text" class="form-control mb-2" name="AnhDaiDien" placeholder="Đường dẫn ảnh (URL hoặc /images/...)" />
                  <input type="file" class="form-control" name="AnhDaiDienFile" accept="image/*" />
                  <div class="form-text">Nhập đường dẫn ảnh hoặc tải lên file ảnh mới.</div>
                </div>
                <div class="mb-3">
                  <label class="form-label fw-semibold">Mật khẩu</label>
                  <input type="password" class="form-control" name="MatKhau" required placeholder="••••••••" />
                </div>
                <div class="mb-3">
                  <label class="form-label fw-semibold">Vai trò</label>
                  <select class="form-select" name="MaVaiTro">
                    <% roles.forEach(r => { %>
                      <option value="<%= r.MaVaiTro %>"><%= r.TenVaiTro %></option>
                    <% }) %>
                  </select>
                </div>
              </div>
              <div class="modal-footer border-0">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Đóng</button>
                <button type="submit" class="btn btn-primary">Tạo tài khoản</button>
              </div>
            </form>
          </div>
        </div>
      </div>
    <% } %>

    <!-- TAB: STUDENTS -->
    <% if (activeTab === 'students') { %>
      <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
        <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
          <h5 class="fw-bold mb-0"><i class="bi bi-mortarboard-fill me-2 text-primary"></i>Hồ sơ Học viên</h5>
          <div class="d-flex gap-2 ms-auto">
            <div class="input-group" style="width: 280px;">
              <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
              <input type="text" id="searchStudents" class="form-control bg-light border-start-0" placeholder="Tìm kiếm học viên..." />
            </div>
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addStudentModal">
              <i class="bi bi-person-plus-fill me-2"></i>Thêm học viên mới
            </button>
          </div>
        </div>
        <div class="table-responsive">
          <table class="table table-hover align-middle">
            <thead class="table-light">
              <tr class="text-nowrap">
                <th>Mã HV</th>
                <th>Họ Tên</th>
                <th>Email & SĐT</th>
                <th>Lớp Đang Học</th>
                <th>Tiến Độ Học Tập</th>
                <th>Trình Độ Hiện Tại</th>
                <th class="text-end">Thao Tác</th>
              </tr>
            </thead>
            <tbody>
              <% studentProfiles.forEach(s => { %>
                <tr>
                  <td class="fw-bold text-nowrap">HV#<%= s.MaHocVien %></td>
                  <td class="text-nowrap">
                    <div class="fw-bold text-dark"><%= s.HoTen %></div>
                    <% if (s.QuanHe && s.QuanHe !== 'Bản thân') { %>
                      <small class="badge bg-info-subtle text-info border border-info-subtle rounded-pill mt-1" style="font-size: 0.74rem;" title="Hồ sơ phụ thuộc do Phụ huynh <%= s.TenNguoiDungChinh %> quản lý">
                        <i class="bi bi-people-fill me-1"></i><%= s.QuanHe %> của <strong><%= s.TenNguoiDungChinh %></strong>
                      </small>
                    <% } else { %>
                      <small class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill mt-1" style="font-size: 0.74rem;">
                        <i class="bi bi-person-check-fill me-1"></i>Tài khoản chính
                      </small>
                    <% } %>
                  </td>
                  <td class="text-nowrap">
                    <div class="fw-medium text-dark"><%= s.Email %></div>
                    <small class="text-muted"><%= s.SoDienThoai %></small>
                  </td>
                  <td style="min-width: 260px; max-width: 360px;">
                    <% if (s.LopDangHocWithDate) { %>
                      <div class="d-flex flex-column gap-1.5 mb-1.5">
                        <% s.LopDangHocWithDate.split(';;').forEach(itemStr => { 
                             const parts = itemStr.split('||');
                             const clsName = parts[0];
                             const regDate = parts[1] || '';
                        %>
                          <div class="bg-light p-2 rounded-3 border border-light-subtle">
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 fw-semibold text-wrap text-start d-inline-block" style="font-size: 0.8rem; line-height: 1.35; white-space: normal;">
                              <i class="bi bi-journal-bookmark-fill me-1"></i><%= clsName %>
                            </span>
                            <% if (regDate) { %>
                              <div class="small text-muted mt-1" style="font-size: 0.78rem;">
                                <i class="bi bi-calendar-check text-primary me-1"></i><strong>Đăng ký:</strong> <%= regDate %>
                              </div>
                            <% } %>
                          </div>
                        <% }) %>
                      </div>
                      <div class="small text-secondary fw-semibold">
                        <i class="bi bi-person-badge text-primary me-1"></i>GV: <strong class="text-dark"><%= s.TenGiangVien || 'Đang phân công' %></strong>
                      </div>
                    <% } else { %>
                      <span class="badge bg-secondary-subtle text-secondary">Chưa ghi danh</span>
                    <% } %>
                  </td>
                  <td class="text-nowrap">
                    <% if (s.LopDangHocWithDate || s.LopDangHoc) { %>
                      <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1.5 fw-bold" style="font-size: 0.82rem;">
                        <i class="bi bi-check-circle-fill me-1"></i>Buổi <%= s.SoBuoiDaHoc || 0 %> / <%= s.TongSoBuoi %> buổi
                      </span>
                    <% } else { %>
                      <span class="text-muted small">--</span>
                    <% } %>
                  </td>
                  <td class="text-nowrap"><span class="badge bg-light text-dark border fw-semibold"><%= s.TrinhDoHienTai || 'Chưa thi đầu vào' %></span></td>
                  <td class="text-end text-nowrap">
                    <button class="btn btn-sm btn-outline-secondary me-1" data-bs-toggle="modal" data-bs-target="#editStudentModal<%= s.MaHocVien %>">
                      <i class="bi bi-pencil-square me-1"></i>Sửa hồ sơ
                    </button>
                    <form action="/admin/students/delete/<%= s.MaHocVien %>" method="POST" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa học viên này? Thao tác này sẽ xóa mọi lịch sử đăng ký, giao dịch và kết quả thi của học viên!')">
                      <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                    </form>
                  </td>
                </tr>

                <!-- Edit Student Profile Modal -->
                <div class="modal fade" id="editStudentModal<%= s.MaHocVien %>" tabindex="-1" aria-hidden="true">
                  <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content border-0 rounded-3 shadow">
                      <div class="modal-header border-0 bg-light">
                        <h5 class="modal-title fw-bold">Sửa hồ sơ: <%= s.HoTen %></h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                      </div>
                      <form action="/admin/students/edit/<%= s.MaHocVien %>" method="POST" onsubmit="return confirm('Bạn có chắc chắn muốn cập nhật hồ sơ học viên này không?')">
                        <div class="modal-body p-4">
                          <div class="mb-3">
                            <label class="form-label fw-semibold">Ngày sinh</label>
                            <input type="date" class="form-control" name="NgaySinh" value="<%= formatDateInput(s.NgaySinh) %>" />
                          </div>
                          <div class="mb-3">
                            <label class="form-label fw-semibold">Địa chỉ liên hệ</label>
                            <input type="text" class="form-control" name="DiaChi" value="<%= s.DiaChi %>" list="hcmDistricts" placeholder="Chọn Quận/Huyện hoặc nhập (Số nhà, tên đường...)" />
                          </div>
                          <div class="mb-3">
                            <label class="form-label fw-semibold">Trình độ hiện tại (Mục tiêu/Điểm TOEIC)</label>
                            <select class="form-select" name="TrinhDoHienTai">
                              <option value="Mất gốc (0-200)" <%= s.TrinhDoHienTai === 'Mất gốc (0-200)' || s.TrinhDoHienTai === 'Mất gốc (0 - 200)' ? 'selected' : '' %>>Mất gốc (0 - 200 TOEIC)</option>
                              <option value="Cơ bản (200-450)" <%= s.TrinhDoHienTai === 'Cơ bản (200-450)' || s.TrinhDoHienTai === 'Sơ cấp (200-300)' ? 'selected' : '' %>>Cơ bản (200 - 450 TOEIC)</option>
                              <option value="Trung cấp (450-650)" <%= s.TrinhDoHienTai === 'Trung cấp (450-650)' || s.TrinhDoHienTai === '450 TOEIC' ? 'selected' : '' %>>Trung cấp (450 - 650 TOEIC)</option>
                              <option value="Nâng cao (650-850)" <%= s.TrinhDoHienTai === 'Nâng cao (650-850)' ? 'selected' : '' %>>Nâng cao (650 - 850 TOEIC)</option>
                              <option value="Cao cấp VIP (850-990)" <%= s.TrinhDoHienTai === 'Cao cấp VIP (850-990)' ? 'selected' : '' %>>Cao cấp VIP (850 - 990 TOEIC)</option>
                              <option value="Luyện thi Cấp tốc" <%= s.TrinhDoHienTai === 'Luyện thi Cấp tốc' ? 'selected' : '' %>>Luyện thi Cấp tốc 2 kỹ năng</option>
                              <% if (s.TrinhDoHienTai && !['Mất gốc (0-200)', 'Mất gốc (0 - 200)', 'Cơ bản (200-450)', 'Trung cấp (450-650)', 'Nâng cao (650-850)', 'Cao cấp VIP (850-990)', 'Luyện thi Cấp tốc'].includes(s.TrinhDoHienTai)) { %>
                                <option value="<%= s.TrinhDoHienTai %>" selected><%= s.TrinhDoHienTai %></option>
                              <% } %>
                            </select>
                          </div>
                        </div>
                        <div class="modal-footer border-0">
                          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Đóng</button>
                          <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                        </div>
                      </form>
                    </div>
                  </div>
                </div>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Add Student Modal -->
      <div class="modal fade" id="addStudentModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
          <div class="modal-content border-0 rounded-3 shadow">
            <div class="modal-header border-0 bg-light">
              <h5 class="modal-title fw-bold">Thêm học viên mới</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="/admin/students/add" method="POST" onsubmit="return confirm('Bạn có chắc chắn muốn thêm hồ sơ học viên mới này không?')">
              <div class="modal-body p-4">
                <div class="mb-3">
                  <label class="form-label fw-semibold">Họ và tên</label>
                  <input type="text" class="form-control" name="HoTen" required placeholder="Nguyễn Văn A" />
                </div>
                <div class="mb-3">
                  <label class="form-label fw-semibold">Email</label>
                  <input type="email" class="form-control" name="Email" required placeholder="email@example.com" />
                </div>
                <div class="mb-3">
                  <label class="form-label fw-semibold">Số điện thoại</label>
                  <input type="text" class="form-control" name="SoDienThoai" required placeholder="09xxxxxxxx" />
                </div>
                <div class="mb-3">
                  <label class="form-label fw-semibold">Mật khẩu tài khoản</label>
                  <input type="password" class="form-control" name="MatKhau" placeholder="Mặc định: 123456" />
                </div>
                <div class="mb-3">
                  <label class="form-label fw-semibold">Ngày sinh</label>
                  <input type="date" class="form-control" name="NgaySinh" />
                </div>
                <div class="mb-3">
                  <label class="form-label fw-semibold">Địa chỉ liên hệ</label>
                  <input type="text" class="form-control" name="DiaChi" list="hcmDistricts" placeholder="Chọn Quận/Huyện hoặc nhập (Số nhà, tên đường...)" />
                </div>
                <div class="mb-3">
                  <label class="form-label fw-semibold">Trình độ hiện tại (Mục tiêu/Điểm TOEIC)</label>
                  <select class="form-select" name="TrinhDoHienTai">
                    <option value="Mất gốc (0-200)" selected>Mất gốc (0 - 200 TOEIC)</option>
                    <option value="Cơ bản (200-450)">Cơ bản (200 - 450 TOEIC)</option>
                    <option value="Trung cấp (450-650)">Trung cấp (450 - 650 TOEIC)</option>
                    <option value="Nâng cao (650-850)">Nâng cao (650 - 850 TOEIC)</option>
                    <option value="Cao cấp VIP (850-990)">Cao cấp VIP (850 - 990 TOEIC)</option>
                    <option value="Luyện thi Cấp tốc">Luyện thi Cấp tốc 2 kỹ năng</option>
                  </select>
                </div>
              </div>
              <div class="modal-footer border-0">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Đóng</button>
                <button type="submit" class="btn btn-primary">Thêm học viên</button>
              </div>
            </form>
          </div>
        </div>
      </div>

      <!-- Exam Results Card -->
      <div class="card border-0 shadow-sm rounded-4 p-4">
        <h5 class="fw-bold mb-4"><i class="bi bi-journal-check me-2 text-primary"></i>Lịch sử kiểm tra & thi thử TOEIC của học viên</h5>
        <div class="table-responsive">
          <table class="table table-hover align-middle">
            <thead class="table-light">
              <tr>
                <th>Học Viên</th>
                <th>Đề Thi</th>
                <th>Điểm Nghe</th>
                <th>Điểm Đọc</th>
                <th>Tổng Điểm</th>
                <th>Ngày Làm Bài</th>
              </tr>
            </thead>
            <tbody>
              <% examResults.forEach(r => { %>
                <tr>
                  <td class="fw-semibold"><%= r.TenHocVien %></td>
                  <td><%= r.TenDeThi %></td>
                  <td class="text-success fw-bold"><%= r.DiemNghe %> / 495</td>
                  <td class="text-info fw-bold"><%= r.DiemDoc %> / 495</td>
                  <td>
                    <span class="badge bg-success py-2 px-3 fw-bold fs-6"><%= r.DiemNghe + r.DiemDoc %> / 990</span>
                  </td>
                  <td><%= new Date(r.NgayThi).toLocaleString('vi-VN') %></td>
                </tr>
              <% }) %>
              <% if (examResults.length === 0) { %>
                <tr>
                  <td colspan="6" class="text-center text-muted py-3">Chưa có kết quả làm bài thi nào được ghi nhận.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>

    <!-- TAB 3: COURSES -->
    <% if (activeTab === 'courses') { %>
      <div class="card border-0 shadow-sm rounded-4 p-4">
        <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
          <h5 class="fw-bold mb-0"><i class="bi bi-journal-bookmark-fill me-2 text-primary"></i>Quản lý Khóa học</h5>
          <div class="d-flex gap-2 ms-auto">
            <div class="input-group" style="width: 280px;">
              <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
              <input type="text" id="searchCourses" class="form-control bg-light border-start-0" placeholder="Tìm kiếm khóa học..." />
            </div>
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addCourseModal">
              <i class="bi bi-plus-circle-fill me-2"></i>Thêm Khóa Học Mới
            </button>
          </div>
        </div>
        <div class="table-responsive">
          <table class="table table-hover align-middle">
            <thead class="table-light">
              <tr>
                <th>Tên Khóa Học</th>
                <th>Học Phí</th>
                <th>Thời Lượng</th>
                <th>Cấp Độ</th>
                <th class="text-end"></th>
              </tr>
            </thead>
            <tbody>
              <% courses.forEach(c => { %>
                <tr>
                  <td class="fw-semibold"><%= c.TenKhoaHoc %></td>
                  <td class="text-primary fw-semibold"><%= Number(c.HocPhi).toLocaleString('vi-VN') %>đ</td>
                  <td><span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1 fw-bold"><i class="bi bi-journal-check me-1"></i><%= c.ThoiLuong %> buổi học</span></td>
                  <td><span class="badge bg-info-subtle text-info"><%= c.CapDo %></span></td>
                  <td class="text-end text-nowrap">
                    <button class="btn btn-sm btn-outline-info me-1 fw-semibold" onclick="openAdminSyllabusModal(<%= c.MaKhoaHoc %>, <%= JSON.stringify(c.TenKhoaHoc) %>)" title="Xem Đề cương đào tạo chi tiết (Syllabus)">
                      <i class="bi bi-book-half me-1"></i>Xem Đề cương
                    </button>
                    <button class="btn btn-sm btn-outline-secondary me-1" data-bs-toggle="modal" data-bs-target="#editCourseModal<%= c.MaKhoaHoc %>" title="Sửa khóa học">
                      <i class="bi bi-pencil"></i>
                    </button>
                    <form action="/admin/courses/delete/<%= c.MaKhoaHoc %>" method="POST" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa khóa học này?')">
                      <button class="btn btn-sm btn-outline-danger" title="Xóa khóa học"><i class="bi bi-trash"></i></button>
                    </form>
                  </td>
                </tr>

                <!-- Edit Course Modal -->
                <div class="modal fade" id="editCourseModal<%= c.MaKhoaHoc %>" tabindex="-1" aria-hidden="true">
                  <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content border-0 rounded-3 shadow">
                      <div class="modal-header border-0 bg-light">
                        <h5 class="modal-title fw-bold">Sửa khóa học: <%= c.TenKhoaHoc %></h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                      </div>
                      <form action="/admin/courses/edit/<%= c.MaKhoaHoc %>" method="POST" onsubmit="return confirm('Bạn có chắc chắn muốn cập nhật thay đổi cho khóa học này không?')">
                        <div class="modal-body p-4">
                          <div class="mb-3">
                            <label class="form-label fw-semibold">Tên khóa học</label>
                            <input type="text" class="form-control" name="TenKhoaHoc" value="<%= c.TenKhoaHoc %>" oninput="autoSelectCapDoByCourseName(this)" onkeyup="autoSelectCapDoByCourseName(this)" onchange="autoSelectCapDoByCourseName(this)" required />
                          </div>
                          <div class="row mb-3">
                            <div class="col">
                              <label class="form-label fw-semibold">Học phí (đ)</label>
                              <input type="number" class="form-control" name="HocPhi" value="<%= c.HocPhi %>" min="0" step="1000" required />
                            </div>
                            <div class="col">
                              <label class="form-label fw-semibold">Thời lượng (buổi)</label>
                              <input type="number" class="form-control" name="ThoiLuong" value="<%= c.ThoiLuong %>" min="12" max="40" required />
                              <div class="invalid-feedback">Vui lòng nhập số buổi hợp lệ trong khoảng từ 12 đến 40 buổi.</div>
                            </div>
                          </div>
                          <div class="mb-3">
                            <label class="form-label fw-semibold">Cấp độ trình độ <span class="text-danger">*</span></label>
                            <select class="form-select border-2 fw-semibold text-primary" name="CapDo" required>
                              <option value="">-- Chọn Cấp độ Quy chuẩn --</option>
                              <option value="Foundation" <%= (c.CapDo === 'Foundation' || c.CapDo === 'foundation' || c.CapDo === 'A1') ? 'selected' : '' %>>🌱 Cấp độ 1: Beginner (A1) - Pre-TOEIC (0 - 250 -> 300 - 350)</option>
                              <option value="450+" <%= (c.CapDo === '450+' || c.CapDo === '450' || c.CapDo === 'A2') ? 'selected' : '' %>>📗 Cấp độ 2: Pre-Intermediate (A2) - TOEIC A (300 - 350 -> 450 - 500)</option>
                              <option value="650+" <%= (c.CapDo === '650+' || c.CapDo === '650' || c.CapDo === 'B1') ? 'selected' : '' %>>📙 Cấp độ 3: Intermediate (B1) - TOEIC B (450 - 500 -> 550 - 650)</option>
                              <option value="850+" <%= (c.CapDo === '850+' || c.CapDo === '850' || c.CapDo === 'B2') ? 'selected' : '' %>>📕 Cấp độ 4: Upper-Intermediate (B2) - TOEIC C (550 - 650 -> 700 - 800+)</option>
                              <option value="Cấp tốc" <%= (c.CapDo === 'Cấp tốc' || c.CapDo === 'Intensive') ? 'selected' : '' %>>🚀 Khóa Intensive (Tăng tốc ngắn hạn) - TOEIC Cấp tốc</option>
                              <option value="Luyện đề" <%= (c.CapDo === 'Luyện đề' || c.CapDo === 'Mastery') ? 'selected' : '' %>>🎯 Khóa Mastery (Thực chiến / Giải đề) - Lớp Luyện đề</option>
                            </select>
                          </div>
                          <div class="mb-3">
                            <label class="form-label fw-semibold">Trạng Thái Khóa Học <span class="text-danger">*</span></label>
                            <select class="form-select border-2" name="TrangThai" required>
                              <option value="Hoạt động" <%= (!c.TrangThai || c.TrangThai === 'Hoạt động' || c.TrangThai === 'Active') ? 'selected' : '' %>>🟢 Hoạt động</option>
                              <option value="Tạm ngưng" <%= c.TrangThai === 'Tạm ngưng' ? 'selected' : '' %>>🟡 Tạm ngưng</option>
                              <option value="Đã đóng" <%= c.TrangThai === 'Đã đóng' ? 'selected' : '' %>>🔴 Đã đóng</option>
                            </select>
                          </div>
                          <div class="mb-3">
                            <label class="form-label fw-semibold">Mô tả khóa học</label>
                            <textarea class="form-control" name="MoTa" rows="3"><%= c.MoTa %></textarea>
                          </div>
                        </div>
                        <div class="modal-footer border-0">
                          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Đóng</button>
                          <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                        </div>
                      </form>
                    </div>
                  </div>
                </div>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Add Course Modal -->
      <div class="modal fade" id="addCourseModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
          <div class="modal-content border-0 rounded-3 shadow">
            <div class="modal-header border-0 bg-light">
              <h5 class="modal-title fw-bold">Thêm khóa học mới</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="/admin/courses/add" method="POST" onsubmit="return confirm('Bạn có chắc chắn muốn thêm khóa học mới này không?')">
