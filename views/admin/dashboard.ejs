                  <label class="form-label fw-semibold">Loại Lộ Trình <span class="text-danger">*</span></label>
                  <select name="LoaiLoTrinh" class="form-select border-2" onchange="autoSuggestRoadmapScores(this)" required>
                    <option value="Tiêu chuẩn" selected>📘 Tiêu chuẩn (Vững chắc & Thong thả)</option>
