                  </div>
                </div>
                <div class="row mb-3">
                  <div class="col">
                    <label class="form-label fw-semibold">Ngày bắt đầu</label>
                    <input type="date" class="form-control" name="NgayBatDau" required />
                  </div>
                  <div class="col">
                    <label class="form-label fw-semibold">Ngày kết thúc</label>
                    <input type="date" class="form-control" name="NgayKetThuc" required />
                  </div>
                </div>
                <div class="mb-3">
                  <label class="form-label fw-semibold">Banner Khuyến Mãi</label>
                  <input type="file" class="form-control" name="HinhAnhFile" accept="image/*" />
                </div>
                <div class="mb-3">
                  <label class="form-label fw-semibold">Mô tả chi tiết chương trình</label>
                  <textarea class="form-control" name="NoiDung" rows="4" required placeholder="Nhập chi tiết điều khoản, đối tượng áp dụng..."></textarea>
                </div>
              </div>
              <div class="modal-footer border-0">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Đóng</button>
                <button type="submit" class="btn btn-primary">Tạo Khuyến Mãi</button>
              </div>
            </form>
          </div>
        </div>
      </div>
    <% } %>

