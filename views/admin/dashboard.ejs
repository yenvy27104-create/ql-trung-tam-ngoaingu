            </div>
            <form action="/admin/promotions/add" method="POST" enctype="multipart/form-data" onsubmit="return confirm('Bạn có chắc chắn muốn tạo chương trình khuyến mãi mới này không?')">
              <div class="modal-body p-4">
                <div class="mb-3">
                  <label class="form-label fw-semibold">Tên chương trình</label>
