                            <textarea class="form-control" name="NoiDung" rows="4" required placeholder="Nhập chi tiết điều khoản, đối tượng áp dụng..."><%= p.NoiDung || '' %></textarea>
                          </div>
                        </div>
                        <div class="modal-footer border-0">
                          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Đóng</button>
                          <button type="submit" class="btn btn-primary">Lưu cập nhật</button>
                        </div>
                      </form>
                    </div>
                  </div>
                </div>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Add Promo Modal -->
      <div class="modal fade" id="addPromoModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
          <div class="modal-content border-0 rounded-3 shadow">
            <div class="modal-header border-0 bg-light">
              <h5 class="modal-title fw-bold">Tạo chương trình khuyến mãi mới</h5>
