                            <label class="form-label fw-semibold">Tên chương trình khuyến mãi</label>
                            <input type="text" class="form-control" name="TenKhuyenMai" value="<%= p.TenKhuyenMai %>" required />
                          </div>
                          <div class="row mb-3">
                            <div class="col">
                              <label class="form-label fw-semibold">Mã code ưu đãi</label>
                              <input type="text" class="form-control" name="MaCode" value="<%= p.MaCode %>" required />
                            </div>
                            <div class="col">
                              <label class="form-label fw-semibold">Tỷ lệ giảm giá (%)</label>
                              <input type="number" step="0.01" class="form-control" name="PhanTramGiam" value="<%= p.PhanTramGiam %>" required />
                            </div>
                          </div>
                          <div class="row mb-3">
                            <div class="col">
                              <label class="form-label fw-semibold">Ngày bắt đầu</label>
                              <input type="date" class="form-control" name="NgayBatDau" value="<%= formatDateInput(p.NgayBatDau) %>" required />
                            </div>
                            <div class="col">
                              <label class="form-label fw-semibold">Ngày kết thúc</label>
                              <input type="date" class="form-control" name="NgayKetThuc" value="<%= formatDateInput(p.NgayKetThuc) %>" required />
