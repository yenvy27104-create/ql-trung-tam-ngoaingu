    <!-- TAB 11: EXAMS / PRACTICE MANAGEMENT -->
    <% if (activeTab === 'exams') { %>
      <div class="card border-0 shadow-sm rounded-4 p-4">
        <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
          <h5 class="fw-bold mb-0"><i class="bi bi-journal-check me-2 text-primary"></i>Quản lý Đề thi & Kho Luyện đề</h5>
          <div class="d-flex gap-2 ms-auto">
            <div class="input-group" style="width: 250px;">
              <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
              <input type="text" id="searchExams" class="form-control bg-light border-start-0" placeholder="Tìm kiếm đề thi..." onkeyup="filterExamsTable()" />
            </div>
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addExamModal">
              <i class="bi bi-file-earmark-plus me-2"></i>Thêm Đề Thi Mới
            </button>
          </div>
        </div>
        
        <p class="text-muted">Quản lý kho đề thi bao gồm <strong>Mẫu / Miễn phí</strong> (cho khách chưa mua khóa), <strong>Luyện đề chính thức</strong> (dành riêng cho Học viên chính thức đã thanh toán) và <strong>Bài test đầu vào</strong>.</p>

        <div class="table-responsive">
          <table class="table table-hover align-middle" id="examsTable">
            <thead class="table-light">
              <tr>
                <th>Mã Đề</th>
                <th>Tên Đề Thi</th>
                <th>Thời Gian</th>
                <th>Đối Tượng / Phân Loại</th>
                <th>File Cấu Trúc (JSON)</th>
                <th>Trạng Thái</th>
                <th class="text-end">Thao Tác</th>
              </tr>
            </thead>
            <tbody>
              <% (exams || []).forEach(ex => { %>
                <tr>
                  <td class="fw-bold">#<%= ex.MaDeThi %></td>
                  <td class="fw-semibold text-dark"><%= ex.TenDeThi %></td>
                  <td><span class="badge bg-light text-dark border"><i class="bi bi-clock me-1 text-primary"></i><%= ex.ThoiGianLamBai %> phút</span></td>
                  <td>
                    <% if (ex.LoaiDe === 'Mẫu / Miễn phí') { %>
                      <span class="badge bg-info-subtle text-info border border-info-subtle px-3 py-2 fw-semibold"><i class="bi bi-gift-fill me-1"></i>Miễn phí / Khách</span>
                    <% } else if (ex.LoaiDe === 'Luyện đề chính thức') { %>
                      <span class="badge bg-warning-subtle text-dark border border-warning-subtle px-3 py-2 fw-semibold"><i class="bi bi-star-fill me-1 text-warning"></i>VIP / Học viên</span>
                    <% } else if (ex.LoaiDe === 'Đầu vào') { %>
                      <span class="badge bg-light text-secondary border px-3 py-2 fw-semibold"><i class="bi bi-file-earmark-text-fill me-1"></i>Test Đầu vào</span>
                    <% } else { %>
                      <span class="badge bg-light text-dark border px-3 py-2 fw-semibold"><%= ex.LoaiDe %></span>
                    <% } %>
                  </td>
                  <td><code class="small text-primary"><%= ex.DuongDanFileJSON %></code></td>
                  <td>
                    <% if (ex.TrangThai === 1) { %>
                      <span class="badge bg-success-subtle text-success border border-success-subtle">Hiển thị</span>
                    <% } else { %>
                      <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Đang ẩn</span>
                    <% } %>
                  </td>
                  <td class="text-end text-nowrap">
                    <form action="/admin/exams/toggle-status/<%= ex.MaDeThi %>" method="POST" class="d-inline">
                      <button type="submit" class="btn btn-sm <%= ex.TrangThai === 1 ? 'btn-outline-warning' : 'btn-outline-success' %> me-1" title="<%= ex.TrangThai === 1 ? 'Ẩn đề thi' : 'Hiện đề thi' %>">
                        <i class="bi <%= ex.TrangThai === 1 ? 'bi-eye-slash-fill' : 'bi-eye-fill' %>"></i>
                      </button>
                    </form>
                    <a href="/admin/exams/edit-questions/<%= ex.MaDeThi %>" class="btn btn-sm btn-outline-primary me-1" title="Chỉnh sửa chi tiết câu hỏi & đáp án">
                      <i class="bi bi-journal-code me-1"></i>Sửa câu hỏi
                    </a>
                    <button class="btn btn-sm btn-outline-secondary me-1" data-bs-toggle="modal" data-bs-target="#editExamModal<%= ex.MaDeThi %>" title="Chỉnh sửa thông tin chung">
                      <i class="bi bi-pencil-square"></i>
                    </button>
                    <form action="/admin/exams/delete/<%= ex.MaDeThi %>" method="POST" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa đề thi này không?')">
                      <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa đề thi">
                        <i class="bi bi-trash-fill"></i>
                      </button>
                    </form>
                  </td>
                </tr>

                <!-- Edit Exam Modal -->
                <div class="modal fade" id="editExamModal<%= ex.MaDeThi %>" tabindex="-1" aria-hidden="true">
                  <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content border-0 rounded-3 shadow">
                      <div class="modal-header border-0 bg-light">
                        <h5 class="modal-title fw-bold">Sửa đề thi: <%= ex.TenDeThi %></h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                      </div>
                      <form action="/admin/exams/edit/<%= ex.MaDeThi %>" method="POST" enctype="multipart/form-data" onsubmit="return confirm('Bạn có chắc muốn cập nhật thông tin đề thi này?')">
                        <div class="modal-body p-4 text-start">
                          <div class="mb-3">
                            <label class="form-label fw-semibold">Tên đề thi</label>
                            <input type="text" class="form-control" name="TenDeThi" value="<%= ex.TenDeThi %>" required />
                          </div>
                          <div class="row mb-3">
                            <div class="col-6">
                              <label class="form-label fw-semibold">Thời gian làm bài (Phút)</label>
                              <input type="number" class="form-control" name="ThoiGianLamBai" value="<%= ex.ThoiGianLamBai %>" required min="1" />
                            </div>
                            <div class="col-6">
                              <label class="form-label fw-semibold">Đối tượng / Phân loại</label>
                              <select class="form-select" name="LoaiDe" required>
                                <option value="Mẫu / Miễn phí" <%= ex.LoaiDe === 'Mẫu / Miễn phí' ? 'selected' : '' %>>Mẫu / Miễn phí (Dành cho Khách chưa mua khóa)</option>
                                <option value="Luyện đề chính thức" <%= ex.LoaiDe === 'Luyện đề chính thức' ? 'selected' : '' %>>Luyện đề chính thức (VIP - Học viên đã thanh toán)</option>
                                <option value="Đầu vào" <%= ex.LoaiDe === 'Đầu vào' ? 'selected' : '' %>>Đầu vào (Test trình độ)</option>
                              </select>
                            </div>
                          </div>
                          <div class="mb-3">
                            <label class="form-label fw-semibold">Đường dẫn File JSON</label>
                            <input type="text" class="form-control mb-2" name="DuongDanFileJSON" value="<%= ex.DuongDanFileJSON %>" placeholder="Ví dụ: json/toeic_test_1.json" />
                            <label class="form-label fw-semibold small text-muted">Hoặc Tải lên File JSON mới</label>
                            <input type="file" class="form-control" name="JsonFile" accept=".json" />
                          </div>
                          <div class="mb-3">
                            <label class="form-label fw-semibold">Trạng thái hiển thị</label>
                            <select class="form-select" name="TrangThai">
                              <option value="1" <%= ex.TrangThai === 1 ? 'selected' : '' %>>1 - Cho phép hiển thị</option>
                              <option value="0" <%= ex.TrangThai === 0 ? 'selected' : '' %>>0 - Ẩn đề thi</option>
                            </select>
                          </div>
                          <div class="mb-3 p-3 bg-primary-subtle rounded-3 border border-primary-subtle">
                            <label class="form-label fw-bold text-primary mb-1"><i class="bi bi-journal-code me-1"></i>Quản lý bộ câu hỏi & đáp án</label>
                            <p class="small text-muted mb-2">Thêm mới, chỉnh sửa nội dung câu hỏi, đáp án A-B-C-D, hình ảnh và file audio cho đề thi này.</p>
                            <a href="/admin/exams/edit-questions/<%= ex.MaDeThi %>" class="btn btn-primary btn-sm rounded-pill w-100 fw-bold shadow-sm">
                              <i class="bi bi-pencil-square me-1"></i>Chuyển đến màn hình Chỉnh sửa & Thêm câu hỏi
                            </a>
                          </div>
                        </div>
                        <div class="modal-footer border-0">
                          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
                          <button type="submit" class="btn btn-primary">Lưu Thay Đổi</button>
                        </div>
                      </form>
                    </div>
                  </div>
                </div>
              <% }) %>
              <% if ((exams || []).length === 0) { %>
                <tr>
                  <td colspan="7" class="text-center py-4 text-muted">Chưa có đề thi nào trong hệ thống.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Add Exam Modal -->
      <div class="modal fade" id="addExamModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
          <div class="modal-content border-0 rounded-3 shadow">
            <div class="modal-header border-0 bg-light">
              <h5 class="modal-title fw-bold">Thêm Đề Thi / Luyện Đề Mới</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="/admin/exams/add" method="POST" enctype="multipart/form-data" onsubmit="return confirm('Bạn có chắc chắn muốn thêm đề thi mới này không?')">
              <div class="modal-body p-4 text-start">
                <div class="mb-3">
                  <label class="form-label fw-semibold">Tên đề thi</label>
                  <input type="text" class="form-control" name="TenDeThi" placeholder="Ví dụ: TOEIC Practice Test 05" required />
                </div>
                <div class="row mb-3">
                  <div class="col-6">
                    <label class="form-label fw-semibold">Thời gian làm bài (Phút)</label>
                    <input type="number" class="form-control" name="ThoiGianLamBai" value="120" required min="1" />
                  </div>
                  <div class="col-6">
                    <label class="form-label fw-semibold">Đối tượng / Phân loại</label>
                    <select class="form-select" name="LoaiDe" required>
                      <option value="Mẫu / Miễn phí">Mẫu / Miễn phí (Cho Khách vãng lai)</option>
                      <option value="Luyện đề chính thức">Luyện đề chính thức (VIP - Học viên chính thức)</option>
                      <option value="Đầu vào">Đầu vào (Test trình độ)</option>
                    </select>
                  </div>
                </div>
                <div class="mb-3">
                  <label class="form-label fw-semibold">Đường dẫn File JSON trong hệ thống</label>
                  <input type="text" class="form-control mb-2" name="DuongDanFileJSON" placeholder="Ví dụ: json/toeic_test_5.json" />
                  <label class="form-label fw-semibold small text-muted">Hoặc Tải lên File JSON mới</label>
                  <input type="file" class="form-control" name="JsonFile" accept=".json" />
                </div>
                <div class="mb-3">
                  <label class="form-label fw-semibold">Trạng thái</label>
                  <select class="form-select" name="TrangThai">
                    <option value="1">Hiển thị ngay</option>
                    <option value="0">Tạm ẩn</option>
                  </select>
                </div>
              </div>
              <div class="modal-footer border-0">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Đóng</button>
                <button type="submit" class="btn btn-primary">Tạo Đề Thi</button>
              </div>
            </form>
          </div>
        </div>
      </div>
    <% } %>

    <!-- TAB 10: STATS & CHARTS -->
    <% if (activeTab === 'stats') { %>
      <div class="card border-0 shadow-sm rounded-4 p-4">
        <h5 class="fw-bold mb-4"><i class="bi bi-bar-chart-line-fill me-2 text-primary"></i>Phân Tích Thống Kê Hoạt Động</h5>
        
        <!-- Form lọc thời gian báo cáo -->
        <form action="/admin/dashboard" method="GET" class="row g-3 align-items-center mb-4 pb-4 border-bottom">
          <input type="hidden" name="tab" value="stats" />
          <div class="col-md-4">
            <label class="form-label fw-semibold text-secondary small">Từ ngày</label>
            <input type="date" class="form-control" name="startDate" value="<%= startDate %>" required />
          </div>
          <div class="col-md-4">
            <label class="form-label fw-semibold text-secondary small">Đến ngày</label>
            <input type="date" class="form-control" name="endDate" value="<%= endDate %>" required />
          </div>
          <div class="col-md-4 d-flex align-items-end pt-4">
            <button type="submit" class="btn btn-primary me-2"><i class="bi bi-funnel-fill me-2"></i>Xem báo cáo</button>
            <% if (startDate && endDate) { %>
              <a href="/admin/dashboard?tab=stats" class="btn btn-outline-secondary"><i class="bi bi-x-circle me-2"></i>Xóa bộ lọc</a>
            <% } %>
          </div>
        </form>

        <!-- Thẻ KPI hiển thị số liệu trực quan -->
        <div class="row g-4 mb-5">
          <!-- Doanh thu -->
          <div class="col-md-3">
            <div class="card border-0 bg-primary-subtle text-primary p-3 rounded-4 shadow-sm h-100 position-relative">
              <p class="small fw-semibold text-uppercase mb-1 text-primary-emphasis">Tổng doanh thu</p>
              <h3 class="mb-0 fw-bold"><%= Number(stats.totalRevenue).toLocaleString('vi-VN') %> đ</h3>
              <i class="bi bi-wallet2 position-absolute end-0 bottom-0 me-3 mb-2 fs-1 opacity-25"></i>
            </div>
          </div>
          <!-- Học viên -->
          <div class="col-md-3">
            <div class="card border-0 bg-success-subtle text-success p-3 rounded-4 shadow-sm h-100 position-relative">
              <p class="small fw-semibold text-uppercase mb-1 text-success-emphasis">Học viên đăng ký</p>
              <h3 class="mb-0 fw-bold"><%= stats.studentCount %> học viên</h3>
              <i class="bi bi-people-fill position-absolute end-0 bottom-0 me-3 mb-2 fs-1 opacity-25"></i>
            </div>
          </div>
          <!-- Tỷ lệ lấp đầy -->
          <div class="col-md-3">
            <div class="card border-0 bg-info-subtle text-info p-3 rounded-4 shadow-sm h-100 position-relative">
              <p class="small fw-semibold text-uppercase mb-1 text-info-emphasis">Tỷ lệ lấp đầy</p>
              <h3 class="mb-0 fw-bold"><%= stats.avgFillRate %>%</h3>
              <i class="bi bi-door-open-fill position-absolute end-0 bottom-0 me-3 mb-2 fs-1 opacity-25"></i>
            </div>
          </div>
          <!-- Điểm trung bình -->
          <div class="col-md-3">
            <div class="card border-0 bg-warning-subtle text-warning p-3 rounded-4 shadow-sm h-100 position-relative">
              <p class="small fw-semibold text-uppercase mb-1 text-warning-emphasis">Điểm thi trung bình</p>
              <h3 class="mb-0 fw-bold"><%= stats.avgScore %> / 990</h3>
              <i class="bi bi-award-fill position-absolute end-0 bottom-0 me-3 mb-2 fs-1 opacity-25"></i>
            </div>
          </div>
        </div>

        <div class="row g-4 mb-5">
          <div class="col-md-6">
            <div class="card border-0 bg-light p-3 shadow-sm rounded-3">
              <h6 class="fw-bold mb-3 text-secondary text-center">Doanh thu theo nhóm khóa học</h6>
              <div style="height: 300px; position: relative;">
                <canvas id="courseRevenueChart"></canvas>
              </div>
            </div>
          </div>
          <div class="col-md-6">
            <div class="card border-0 bg-light p-3 shadow-sm rounded-3">
              <h6 class="fw-bold mb-3 text-secondary text-center">Biến động doanh thu theo tháng (2026)</h6>
              <div style="height: 300px; position: relative;">
                <canvas id="monthlyRevenueChart"></canvas>
              </div>
            </div>
          </div>
        </div>

        <div class="card border-0 bg-light p-4 rounded-3 shadow-sm">
          <h6 class="fw-bold mb-3 text-secondary"><i class="bi bi-activity me-2"></i>Báo cáo năng lực học tập bình quân</h6>
          <div class="row text-center">
            <div class="col-md-4">
              <div class="p-3 bg-white rounded shadow-sm">
                <p class="small text-muted mb-1">Điểm thi thử trung bình</p>
                <h3 class="mb-0 text-primary fw-bold"><%= stats.avgScore %> / 990</h3>
              </div>
            </div>
            <div class="col-md-4">
              <div class="p-3 bg-white rounded shadow-sm">
                <p class="small text-muted mb-1">Quy đổi nghe bình quân</p>
                <h3 class="mb-0 text-success fw-bold"><%= Math.round(stats.avgScore * 0.5) %>đ</h3>
              </div>
            </div>
            <div class="col-md-4">
              <div class="p-3 bg-white rounded shadow-sm">
                <p class="small text-muted mb-1">Quy đổi đọc bình quân</p>
                <h3 class="mb-0 text-info fw-bold"><%= Math.round(stats.avgScore * 0.5) %>đ</h3>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Import & Render Chart.js -->
      <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
      <script>
        (function() {
          function renderStatsCharts() {
            const chartCanvas1 = document.getElementById('courseRevenueChart');
            const chartCanvas2 = document.getElementById('monthlyRevenueChart');
            if (!chartCanvas1 || !chartCanvas2) return;

            if (typeof Chart === 'undefined') {
              setTimeout(renderStatsCharts, 100);
              return;
            }

            // Parse unescaped JSON data from EJS
            const courseData = <%- JSON.stringify(stats.revenueByCourse || []) %>;
            const courseLabels = courseData.map(d => d.TenKhoaHoc);
            const courseValues = courseData.map(d => parseFloat(d.Revenue || 0));

            const ctx1 = chartCanvas1.getContext('2d');
            new Chart(ctx1, {
              type: 'doughnut',
              data: {
                labels: courseLabels.length ? courseLabels : ['Chưa có dữ liệu'],
                datasets: [{
                  data: courseValues.length ? courseValues : [1],
                  backgroundColor: [
                    '#3498db',
                    '#2ecc71',
                    '#9b59b6',
                    '#f1c40f',
                    '#e67e22',
                    '#e74c3c'
                  ],
                  borderWidth: 1
                }]
              },
              options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                  legend: { position: 'bottom' }
                }
              }
            });

            // 2. Monthly Revenue Chart (Bar)
            const monthlyData = <%- JSON.stringify(stats.monthlyRevenue || []) %>;
            const monthlyLabels = monthlyData.map(d => d.Month);
            const monthlyValues = monthlyData.map(d => parseFloat(d.Revenue || 0));

            const ctx2 = chartCanvas2.getContext('2d');
            new Chart(ctx2, {
              type: 'bar',
              data: {
                labels: monthlyLabels.length ? monthlyLabels : ['Tháng 08'],
                datasets: [{
                  label: 'Doanh thu (đ)',
                  data: monthlyValues.length ? monthlyValues : [0],
                  backgroundColor: 'rgba(52, 152, 219, 0.7)',
                  borderColor: 'rgba(52, 152, 219, 1)',
                  borderWidth: 1,
                  borderRadius: 6
                }]
              },
              options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                  y: { beginAtZero: true }
                }
              }
            });
          }

          if (document.readyState === 'complete' || document.readyState === 'interactive') {
            setTimeout(renderStatsCharts, 50);
          } else {
            document.addEventListener('DOMContentLoaded', renderStatsCharts);
          }
        })();
      </script>
    <% } %>

  </div>
</div>

<style>
  /* Admin sidebar styling */
  .admin-sidebar .list-group-item {
    background-color: transparent;
    color: #4a5568;
    transition: all 0.2s ease;
  }
  .admin-sidebar .list-group-item:hover {
    background-color: rgba(52, 152, 219, 0.05);
    color: var(--accent-color);
  }
  .admin-sidebar .list-group-item.active {
    border-left: 4px solid var(--accent-color) !important;
  }
  .glass-card {
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.2) !important;
  }

  /* Gradient stat boxes */
  .stat-box {
    border-radius: 16px;
    position: relative;
    overflow: hidden;
    transition: transform 0.3s;
  }
  .stat-box:hover {
    transform: translateY(-5px);
  }
  .bg-gradient-purple {
    background: linear-gradient(135deg, #7028e4, #e20c8d);
  }
  .bg-gradient-blue {
    background: linear-gradient(135deg, #1572e8, #06c280);
  }
  .bg-gradient-green {
    background: linear-gradient(135deg, #11998e, #38ef7d);
  }
  .bg-gradient-orange {
    background: linear-gradient(135deg, #ff9900, #ff5e62);
  }
  .stat-icon-wrap {
    width: 48px;
    height: 48px;
    background: rgba(255, 255, 255, 0.15);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
</style>

<!-- Admin Syllabus Modal -->
<div class="modal fade" id="adminSyllabusModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable">
    <div class="modal-content border-0 rounded-4 shadow-lg">
      <div class="modal-header border-0 bg-primary text-white p-4 d-flex justify-content-between align-items-center">
        <div>
          <h4 class="modal-title fw-bold text-white mb-1" id="adminSyllabusTitle"><i class="bi bi-book-half me-2"></i>Đề cương đào tạo chi tiết</h4>
          <span class="text-white-50 small">Khung kiến thức chuẩn 2 kỹ năng Listening & Reading</span>
        </div>
        <div class="d-flex align-items-center gap-2">
          <button class="btn btn-warning btn-sm fw-bold shadow-sm" id="btnToggleEditSyllabus" onclick="toggleSyllabusEditMode()">
            <i class="bi bi-pencil-square me-1"></i><span id="editBtnText">Chỉnh sửa Đề cương</span>
          </button>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
      </div>
      <div class="modal-body p-4" id="adminSyllabusContainer">
        <!-- Loaded via JS -->
      </div>
      <div class="modal-footer border-top p-3 bg-light d-flex justify-content-between">
        <div>
          <span class="text-muted small" id="syllabusStatusNote"><i class="bi bi-info-circle me-1"></i>Bấm "Chỉnh sửa Đề cương" để thay đổi nội dung các buổi học và khung kiến thức.</span>
        </div>
        <div class="d-flex gap-2">
          <button type="button" class="btn btn-secondary px-4 fw-bold rounded-3" data-bs-dismiss="modal">Đóng</button>
          <button type="button" class="btn btn-success px-4 fw-bold rounded-3 d-none" id="btnSaveSyllabus" onclick="saveSyllabusChanges()">
            <i class="bi bi-floppy me-1"></i>Lưu Thay Đổi Đề Cương
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

  <script>
    let currentSyllabusCourseId = null;
    let currentSyllabusData = null;
    let isSyllabusEditMode = false;

    async function openAdminSyllabusModal(courseId, courseTitle) {
      currentSyllabusCourseId = courseId;
      isSyllabusEditMode = false;
      document.getElementById('editBtnText').innerText = 'Chỉnh sửa Đề cương';
      document.getElementById('btnToggleEditSyllabus').className = 'btn btn-warning btn-sm fw-bold shadow-sm';
      document.getElementById('btnSaveSyllabus').classList.add('d-none');
      document.getElementById('adminSyllabusTitle').innerHTML = `<i class="bi bi-book-half me-2"></i>Đề cương chi tiết: ${courseTitle}`;
      
      const container = document.getElementById('adminSyllabusContainer');
      container.innerHTML = '<div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div><p class="mt-2 text-muted">Đang tải đề cương đào tạo...</p></div>';
      
      const modalEl = document.getElementById('adminSyllabusModal');
      const bsModal = bootstrap.Modal.getOrCreateInstance(modalEl);
      bsModal.show();

      try {
        const res = await fetch(`/courses/syllabus/${courseId}`);
        const data = await res.json();
        if (data.success) {
          currentSyllabusData = data;
          renderSyllabusView();
        } else {
          container.innerHTML = '<div class="alert alert-warning">Chưa có đề cương chi tiết cho khóa học này.</div>';
        }
      } catch (err) {
        container.innerHTML = '<div class="alert alert-danger">Không thể tải đề cương đào tạo. Vui lòng thử lại sau.</div>';
      }
    }

    function renderSyllabusView() {
      const container = document.getElementById('adminSyllabusContainer');
      const data = currentSyllabusData;
      if (!data) return;

      if (isSyllabusEditMode) {
        renderSyllabusEditForm();
        return;
      }

      let metaHtml = '';
      if (data.meta) {
        metaHtml = `
          <div class="card border-0 bg-light rounded-3 mb-4 shadow-sm">
            <div class="card-body p-4">
              <div class="row g-3">
                <div class="col-md-6">
                  <div class="d-flex align-items-start gap-2 mb-2.5">
                    <i class="bi bi-person-badge-fill text-primary fs-5"></i>
                    <div>
                      <strong class="text-dark">Đối tượng đầu vào:</strong> <span class="text-secondary d-block mt-0.5">${data.meta.inputLevel || '--'}</span>
                    </div>
                  </div>
                  <div class="d-flex align-items-start gap-2 mb-2.5">
                    <i class="bi bi-headset text-success fs-5"></i>
                    <div>
                      <strong class="text-dark">Dịch vụ bổ trợ:</strong> <span class="text-secondary d-block mt-0.5">${data.meta.services || '--'}</span>
                    </div>
                  </div>
                  <div class="d-flex align-items-start gap-2">
                    <i class="bi bi-clipboard-check-fill text-warning fs-5"></i>
                    <div>
                      <strong class="text-dark">Kiểm tra đánh giá:</strong> <span class="text-secondary d-block mt-0.5">${data.meta.tests || '--'}</span>
                    </div>
                  </div>
                </div>
                <div class="col-md-6">
                  <div class="bg-white p-3.5 rounded-3 border">
                    <h6 class="fw-bold text-dark mb-2.5"><i class="bi bi-book-half text-danger me-2"></i>Trọng tâm kiến thức chính (Listening & Reading)</h6>
                    <ul class="list-unstyled mb-0 small text-secondary" style="line-height: 1.6;">
                      <li class="mb-2"><strong class="text-dark">🗣️ Ngữ âm:</strong> ${data.meta.phonetics || '--'}</li>
                      <li class="mb-2"><strong class="text-dark">📖 Từ vựng:</strong> ${data.meta.vocabulary || '--'}</li>
                      <li><strong class="text-dark">📝 Ngữ pháp:</strong> ${data.meta.grammar || '--'}</li>
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          </div>
        `;
      }

      let rowsHtml = '';
      if (data.syllabus && data.syllabus.length > 0) {
        data.syllabus.forEach(item => {
          let skillBadge = 'bg-primary-subtle text-primary';
          if (item.type.includes('Listening')) skillBadge = 'bg-info-subtle text-info-emphasis';
          else if (item.type.includes('Reading')) skillBadge = 'bg-success-subtle text-success';
          else if (item.type.includes('Exam') || item.type.includes('Test') || item.type.includes('PROGRESS')) skillBadge = 'bg-danger text-white';

          let testBadge = item.test ? `<span class="badge bg-warning-subtle text-dark border border-warning fw-bold"><i class="bi bi-pencil-square me-1"></i>${item.test}</span>` : '<span class="text-muted small">--</span>';

          rowsHtml += `
            <tr>
              <td class="text-center fw-bold text-dark align-middle">${item.session}</td>
              <td class="align-middle"><span class="badge ${skillBadge} px-2.5 py-1.5 fw-semibold" style="font-size: 0.82rem;">${item.type}</span></td>
              <td class="align-middle text-secondary" style="line-height: 1.5;">${item.content}</td>
              <td class="text-center align-middle">${testBadge}</td>
            </tr>
          `;
        });
      }

      container.innerHTML = `
        ${metaHtml}
        <div class="table-responsive rounded-3 border">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
              <tr>
                <th style="width: 10%;" class="text-center">Buổi học</th>
                <th style="width: 25%;">Kỹ năng / Chủ đề</th>
                <th style="width: 45%;">Nội dung chi tiết</th>
                <th style="width: 20%;" class="text-center">Bài kiểm tra / Đánh giá</th>
              </tr>
            </thead>
            <tbody>
              ${rowsHtml || '<tr><td colspan="4" class="text-center py-4 text-muted">Chưa có thông tin buổi học</td></tr>'}
            </tbody>
          </table>
        </div>
      `;
    }

    function renderSyllabusEditForm() {
      const container = document.getElementById('adminSyllabusContainer');
      const data = currentSyllabusData;
      const meta = data.meta || {};

      let rowsHtml = '';
      (data.syllabus || []).forEach((item, idx) => {
        rowsHtml += `
          <tr class="syllabus-edit-row">
            <td class="text-center fw-bold text-dark align-middle">
              <input type="number" class="form-control form-control-sm text-center edit-session-num" value="${item.session || (idx + 1)}" style="width: 65px; margin: 0 auto;" />
            </td>
            <td class="align-middle">
              <input type="text" class="form-control form-control-sm edit-session-type" value="${(item.type || '').replace(/"/g, '&quot;')}" placeholder="Chủ đề / Kỹ năng" />
            </td>
            <td class="align-middle">
              <textarea class="form-control form-control-sm edit-session-content" rows="2" placeholder="Nội dung chi tiết buổi học">${(item.content || '').replace(/"/g, '&quot;')}</textarea>
            </td>
            <td class="align-middle">
              <input type="text" class="form-control form-control-sm edit-session-test" value="${(item.test || '').replace(/"/g, '&quot;')}" placeholder="Tên bài test (nếu có)" />
            </td>
            <td class="text-center align-middle">
              <button type="button" class="btn btn-outline-danger btn-sm" onclick="removeSyllabusRow(this)" title="Xóa buổi học"><i class="bi bi-trash"></i></button>
            </td>
          </tr>
        `;
      });

      container.innerHTML = `
        <div class="card border border-warning bg-warning-subtle rounded-3 mb-4">
          <div class="card-body p-3.5">
            <h6 class="fw-bold text-dark mb-3"><i class="bi bi-pencil-fill me-2 text-warning"></i>Chỉnh sửa Khung tổng quan Đề cương</h6>
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label small fw-semibold text-dark">Đối tượng đầu vào</label>
                <input type="text" id="editMetaInputLevel" class="form-control form-control-sm" value="${(meta.inputLevel || '').replace(/"/g, '&quot;')}" />
              </div>
              <div class="col-md-6">
                <label class="form-label small fw-semibold text-dark">Dịch vụ bổ trợ</label>
                <input type="text" id="editMetaServices" class="form-control form-control-sm" value="${(meta.services || '').replace(/"/g, '&quot;')}" />
              </div>
              <div class="col-md-6">
                <label class="form-label small fw-semibold text-dark">Kiểm tra & Đánh giá</label>
                <input type="text" id="editMetaTests" class="form-control form-control-sm" value="${(meta.tests || '').replace(/"/g, '&quot;')}" />
              </div>
              <div class="col-md-6">
                <label class="form-label small fw-semibold text-dark">🗣️ Ngữ âm</label>
                <input type="text" id="editMetaPhonetics" class="form-control form-control-sm" value="${(meta.phonetics || '').replace(/"/g, '&quot;')}" />
              </div>
              <div class="col-md-6">
                <label class="form-label small fw-semibold text-dark">📖 Từ vựng</label>
                <input type="text" id="editMetaVocabulary" class="form-control form-control-sm" value="${(meta.vocabulary || '').replace(/"/g, '&quot;')}" />
              </div>
              <div class="col-md-6">
                <label class="form-label small fw-semibold text-dark">📝 Ngữ pháp</label>
                <input type="text" id="editMetaGrammar" class="form-control form-control-sm" value="${(meta.grammar || '').replace(/"/g, '&quot;')}" />
              </div>
            </div>
          </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-2">
          <h6 class="fw-bold text-dark mb-0"><i class="bi bi-list-task me-2 text-primary"></i>Danh sách các buổi học chi tiết</h6>
          <button type="button" class="btn btn-sm btn-outline-primary fw-semibold" onclick="addSyllabusRow()"><i class="bi bi-plus-circle me-1"></i>Thêm buổi học mới</button>
        </div>

        <div class="table-responsive rounded-3 border">
          <table class="table table-hover align-middle mb-0" id="syllabusEditTable">
            <thead class="table-dark">
              <tr>
                <th style="width: 10%;" class="text-center">Buổi</th>
                <th style="width: 25%;">Chủ đề / Kỹ năng</th>
                <th style="width: 45%;">Nội dung bài học</th>
                <th style="width: 15%;">Bài Test</th>
                <th style="width: 5%;" class="text-center">Xóa</th>
              </tr>
            </thead>
            <tbody id="syllabusEditTbody">
              ${rowsHtml}
            </tbody>
          </table>
        </div>
      `;
    }

    function toggleSyllabusEditMode(forceState) {
      isSyllabusEditMode = forceState !== undefined ? forceState : !isSyllabusEditMode;
      const btn = document.getElementById('btnToggleEditSyllabus');
      const btnText = document.getElementById('editBtnText');
      const btnSave = document.getElementById('btnSaveSyllabus');

      if (isSyllabusEditMode) {
        btnText.innerText = 'Hủy chỉnh sửa';
        btn.className = 'btn btn-secondary btn-sm fw-bold shadow-sm';
        btnSave.classList.remove('d-none');
      } else {
        btnText.innerText = 'Chỉnh sửa Đề cương';
        btn.className = 'btn btn-warning btn-sm fw-bold shadow-sm';
        btnSave.classList.add('d-none');
      }
      renderSyllabusView();
    }

    function addSyllabusRow() {
      const tbody = document.getElementById('syllabusEditTbody');
      if (!tbody) return;
      const nextNum = tbody.querySelectorAll('tr').length + 1;
      const tr = document.createElement('tr');
      tr.className = 'syllabus-edit-row';
      tr.innerHTML = `
        <td class="text-center fw-bold text-dark align-middle">
          <input type="number" class="form-control form-control-sm text-center edit-session-num" value="${nextNum}" style="width: 65px; margin: 0 auto;" />
        </td>
        <td class="align-middle">
          <input type="text" class="form-control form-control-sm edit-session-type" placeholder="Chủ đề / Kỹ năng" />
        </td>
        <td class="align-middle">
          <textarea class="form-control form-control-sm edit-session-content" rows="2" placeholder="Nội dung chi tiết buổi học"></textarea>
        </td>
        <td class="align-middle">
          <input type="text" class="form-control form-control-sm edit-session-test" placeholder="Tên bài test (nếu có)" />
        </td>
        <td class="text-center align-middle">
          <button type="button" class="btn btn-outline-danger btn-sm" onclick="removeSyllabusRow(this)" title="Xóa buổi học"><i class="bi bi-trash"></i></button>
        </td>
      `;
      tbody.appendChild(tr);
    }

    function removeSyllabusRow(btn) {
      const tr = btn.closest('tr');
      if (tr) tr.remove();
    }

    async function saveSyllabusChanges() {
      if (!currentSyllabusCourseId) return;

      const meta = {
        inputLevel: document.getElementById('editMetaInputLevel')?.value || '',
        services: document.getElementById('editMetaServices')?.value || '',
        tests: document.getElementById('editMetaTests')?.value || '',
        phonetics: document.getElementById('editMetaPhonetics')?.value || '',
        vocabulary: document.getElementById('editMetaVocabulary')?.value || '',
        grammar: document.getElementById('editMetaGrammar')?.value || ''
      };

      const rows = document.querySelectorAll('#syllabusEditTbody tr');
      const syllabus = [];
      rows.forEach(tr => {
        const session = parseInt(tr.querySelector('.edit-session-num')?.value || '0', 10);
        const type = tr.querySelector('.edit-session-type')?.value || '';
        const content = tr.querySelector('.edit-session-content')?.value || '';
        const test = tr.querySelector('.edit-session-test')?.value || '';

        if (type.trim() || content.trim()) {
          syllabus.push({ session, type, content, test });
        }
      });

      try {
        const res = await fetch(`/admin/courses/syllabus/${currentSyllabusCourseId}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ syllabus, meta })
        });
        const data = await res.json();
        if (data.success) {
          Swal.fire({
            icon: 'success',
            title: 'Thành công!',
            text: data.message || 'Đã lưu thay đổi đề cương thành công.',
            confirmButtonColor: '#3498db'
          });
          currentSyllabusData = { success: true, syllabus, meta };
          toggleSyllabusEditMode(false);
        } else {
          Swal.fire({ icon: 'error', title: 'Lỗi', text: data.message || 'Không thể lưu đề cương.' });
        }
      } catch (err) {
        Swal.fire({ icon: 'error', title: 'Lỗi máy chủ', text: 'Có lỗi xảy ra khi lưu đề cương: ' + err.message });
      }
    }

    function sortPromotionsTable(sortOrder) {
      const tbody = document.querySelector('#promotionsTable tbody');
      if (!tbody) return;
      const rows = Array.from(tbody.querySelectorAll('tr'));
      
      rows.sort((a, b) => {
        const timeA = parseInt(a.getAttribute('data-start-date') || '0', 10);
        const timeB = parseInt(b.getAttribute('data-start-date') || '0', 10);
        const discA = parseFloat(a.getAttribute('data-discount') || '0');
        const discB = parseFloat(b.getAttribute('data-discount') || '0');
        const idA = parseInt(a.getAttribute('data-id') || '0', 10);
        const idB = parseInt(b.getAttribute('data-id') || '0', 10);

        if (sortOrder === 'newest') {
          return timeB - timeA || idB - idA;
        } else if (sortOrder === 'oldest') {
          return timeA - timeB || idA - idB;
        } else if (sortOrder === 'discount-desc') {
          return discB - discA;
        } else if (sortOrder === 'discount-asc') {
          return discA - discB;
        }
        return 0;
      });

      rows.forEach(row => tbody.appendChild(row));
    }

    // Generic live search filter for all tables inside cards
    document.addEventListener('DOMContentLoaded', () => {
      const searchInputs = document.querySelectorAll('input[id^="search"]');
      searchInputs.forEach(input => {
        input.addEventListener('input', function() {
          const query = this.value.toLowerCase().trim();
          const card = this.closest('.card');
          if (!card) return;
          const table = card.querySelector('table');
          if (!table) return;
          const rows = table.querySelectorAll('tbody tr');
          rows.forEach(row => {
            // Ignore colspan warning/info rows
            if (row.cells.length === 1 && row.cells[0].getAttribute('colspan')) return;
            const text = row.innerText.toLowerCase();
            if (text.includes(query)) {
              row.style.display = '';
            } else {
              row.style.display = 'none';
            }
          });
        });
      });
    });
  function filterExamsTable() {
    const input = document.getElementById('searchExams');
    if (!input) return;
    const filter = input.value.toLowerCase();
    const rows = document.querySelectorAll('#examsTable tbody tr');
    rows.forEach(row => {
      const text = row.innerText.toLowerCase();
      row.style.display = text.includes(filter) ? '' : 'none';
    });
  }

  function confirmEditRoadmap(event) {
    event.preventDefault();
    const form = event.target;
    if (typeof Swal !== 'undefined') {
      Swal.fire({
        title: 'Xác nhận cập nhật lộ trình',
        text: 'Bạn có chắc chắn muốn lưu các thay đổi cấu hình cho lộ trình đề xuất này không?',
        icon: 'question',
        showCancelButton: true,
        confirmButtonColor: '#3498db',
        cancelButtonColor: '#6c757d',
        confirmButtonText: 'Đồng ý cập nhật',
        cancelButtonText: 'Hủy bỏ'
      }).then((result) => {
        if (result.isConfirmed) {
          form.submit();
        }
      });
    } else {
      if (confirm('Bạn có chắc chắn muốn lưu các thay đổi cấu hình cho lộ trình đề xuất này không?')) {
        form.submit();
      }
    }
    return false;
  }

  function confirmAddRoadmap(event) {
    event.preventDefault();
    const form = event.target;
    if (typeof Swal !== 'undefined') {
      Swal.fire({
        title: 'Xác nhận thêm lộ trình',
        text: 'Bạn có chắc chắn muốn thêm cấu hình lộ trình đề xuất mới này không?',
        icon: 'question',
        showCancelButton: true,
        confirmButtonColor: '#3498db',
        cancelButtonColor: '#6c757d',
        confirmButtonText: 'Đồng ý thêm',
        cancelButtonText: 'Hủy bỏ'
      }).then((result) => {
        if (result.isConfirmed) {
          form.submit();
        }
      });
    } else {
      if (confirm('Bạn có chắc chắn muốn thêm cấu hình lộ trình đề xuất mới này không?')) {
        form.submit();
      }
    }
    return false;
  }

  function confirmScheduleStatusChange(selectElem, className) {
    const newText = selectElem.options[selectElem.selectedIndex].text;
    const prevVal = selectElem.getAttribute('data-previous') || selectElem.value;
    
    if (typeof Swal !== 'undefined') {
      Swal.fire({
        title: 'Xác nhận thay đổi trạng thái?',
        html: `Bạn có chắc chắn muốn thay đổi trạng thái Lịch khai giảng lớp <b class="text-primary">${className}</b> sang <b class="text-danger">${newText}</b> không?`,
        icon: 'question',
        showCancelButton: true,
        confirmButtonColor: '#0d6efd',
        cancelButtonColor: '#6c757d',
        confirmButtonText: '<i class="bi bi-check-circle me-1"></i>Đồng ý thay đổi',
        cancelButtonText: 'Hủy bỏ',
        customClass: {
          popup: 'rounded-4 shadow-lg border-0',
          confirmButton: 'btn btn-primary px-4 py-2 fw-semibold me-2',
          cancelButton: 'btn btn-secondary px-4 py-2 fw-semibold'
        },
        buttonsStyling: false
      }).then((result) => {
        if (result.isConfirmed) {
          selectElem.form.submit();
        } else {
          selectElem.value = prevVal;
        }
      });
    } else {
      if (confirm(`Bạn có chắc chắn muốn thay đổi trạng thái lịch khai giảng lớp "${className}" sang "${newText}" không?`)) {
        selectElem.form.submit();
      } else {
        selectElem.value = prevVal;
      }
    }
  }

  // =========================================================
  // LOGIC DỊCH CHUYỂN (DRAGGABLE) & NỀN TRONG SUỐT CHO CÁC MODAL ADMIN
  // =========================================================
  function initDraggableModals() {
    document.querySelectorAll('.modal').forEach(function(modalElem) {
      const dialog = modalElem.querySelector('.modal-dialog');
      if (!dialog || modalElem.dataset.draggableInited) return;
      modalElem.dataset.draggableInited = 'true';

      const handle = modalElem.querySelector('.modal-header') || modalElem.querySelector('.modal-content');
      if (!handle) return;

      let isDragging = false;
      let startX, startY, initialX = 0, initialY = 0;
      let currentX = 0, currentY = 0;

      // Reset vị trí khi đóng modal
      modalElem.addEventListener('hidden.bs.modal', function() {
        dialog.style.transform = '';
        currentX = 0;
        currentY = 0;
      });

      handle.style.cursor = 'grab';

      handle.addEventListener('mousedown', function(e) {
        if (e.target.closest('.btn-close') || e.target.closest('button') || e.target.closest('input') || e.target.closest('select') || e.target.closest('textarea') || e.target.closest('a') || e.target.closest('label')) return;

        isDragging = true;
        startX = e.clientX;
        startY = e.clientY;
        initialX = currentX;
        initialY = currentY;
        handle.style.cursor = 'grabbing';
        document.body.style.userSelect = 'none';

        function onMouseMove(e) {
          if (!isDragging) return;
          const dx = e.clientX - startX;
          const dy = e.clientY - startY;
          currentX = initialX + dx;
          currentY = initialY + dy;
          dialog.style.transform = `translate(${currentX}px, ${currentY}px)`;
        }

        function onMouseUp() {
          if (isDragging) {
            isDragging = false;
            handle.style.cursor = 'grab';
            document.body.style.userSelect = '';
            document.removeEventListener('mousemove', onMouseMove);
            document.removeEventListener('mouseup', onMouseUp);
          }
        }

        document.addEventListener('mousemove', onMouseMove);
        document.addEventListener('mouseup', onMouseUp);
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDraggableModals);
  } else {
    initDraggableModals();
  }

  const modalObserver = new MutationObserver(initDraggableModals);
  modalObserver.observe(document.body, { childList: true, subtree: true });
  </script>

