                      <div class="modal-header border-0 bg-light">
                        <h5 class="modal-title fw-bold">Sửa mã khuyến mãi</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                      </div>
                      <form action="/admin/promotions/edit/<%= p.MaKhuyenMai %>" method="POST" enctype="multipart/form-data" onsubmit="return confirm('Bạn có chắc chắn muốn cập nhật thay đổi cho mã khuyến mãi này không?')">
