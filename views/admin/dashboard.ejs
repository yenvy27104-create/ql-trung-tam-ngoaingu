              <div>
                <p class="small text-white-50 mb-1">Tổng Doanh Thu</p>
                <h4 class="mb-0 fw-bold"><%= Number(stats.totalRevenue).toLocaleString('vi-VN') %>đ</h4>
              </div>
              <div class="stat-icon-wrap"><i class="bi bi-currency-dollar fs-4"></i></div>
            </div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="card border-0 shadow-sm rounded-4 p-3 stat-box bg-gradient-blue text-white">
            <div class="d-flex align-items-center justify-content-between">
              <div>
                <p class="small text-white-50 mb-1">Học Viên Đăng Ký</p>
                <h4 class="mb-0 fw-bold"><%= stats.studentCount %></h4>
              </div>
              <div class="stat-icon-wrap"><i class="bi bi-people fs-4"></i></div>
            </div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="card border-0 shadow-sm rounded-4 p-3 stat-box bg-gradient-green text-white">
            <div class="d-flex align-items-center justify-content-between">
              <div>
                <p class="small text-white-50 mb-1">Ghi Danh Đã Đóng Phí</p>
                <h4 class="mb-0 fw-bold"><%= stats.enrollCount %></h4>
              </div>
              <div class="stat-icon-wrap"><i class="bi bi-cart-check fs-4"></i></div>
            </div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="card border-0 shadow-sm rounded-4 p-3 stat-box bg-gradient-orange text-white">
            <div class="d-flex align-items-center justify-content-between">
              <div>
                <p class="small text-white-50 mb-1">Tỷ lệ Lấp Đầy Lớp</p>
                <h4 class="mb-0 fw-bold"><%= stats.avgFillRate %>%</h4>
              </div>
              <div class="stat-icon-wrap"><i class="bi bi-building fs-4"></i></div>
            </div>
          </div>
        </div>
      </div>

      <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
        <h5 class="fw-bold mb-3"><i class="bi bi-info-circle me-2 text-primary"></i>Chào mừng đến với Hệ thống Quản trị Y&V TOEIC</h5>
        <p class="text-muted mb-0">Hệ thống của bạn được vận hành dựa trên kiến trúc Hybrid Database (MySQL và dữ liệu đề thi/kết quả thi dạng JSON). Menu điều hướng bên trái cung cấp đầy đủ các nghiệp vụ quản lý đào tạo, nhân sự, tài chính và phân tích báo cáo trực quan cho trung tâm ngoại ngữ.</p>
      </div>

      <div class="row g-4">
        <div class="col-md-6">
          <div class="card border-0 shadow-sm rounded-4 p-4">
            <h6 class="fw-bold mb-3"><i class="bi bi-clock-history me-2 text-primary"></i>Phân bố Lớp học mới</h6>
            <div class="table-responsive">
              <table class="table align-middle">
                <thead>
                  <tr>
                    <th>Tên Lớp</th>
                    <th>Ngày Khai Giảng</th>
                    <th>Trạng Thái</th>
                  </tr>
                </thead>
                <tbody>
                  <% classes.slice(0, 5).forEach(c => { %>
                    <tr>
                      <td class="fw-semibold"><%= c.TenLop %></td>
                      <td><%= new Date(c.NgayKhaiGiang).toLocaleDateString('vi-VN') %></td>
                      <td>
                        <span class="badge rounded-pill <%= c.TrangThaiLop === 'Đang diễn ra' ? 'bg-success-subtle text-success' : 'bg-warning-subtle text-warning' %>">
                          <%= c.TrangThaiLop %>
                        </span>
                      </td>
                    </tr>
                  <% }) %>
