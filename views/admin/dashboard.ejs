                  </td>
                  <td class="text-nowrap">
                    <% const isClassFull = (c.SiSoHienTai !== undefined && c.SiSoHienTai !== null && c.SiSoToiDa) ? Number(c.SiSoHienTai) >= Number(c.SiSoToiDa) : false; %>
                    <% if (c.TrangThaiLop === 'Đang diễn ra') { %>
                      <span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle fw-bold">
                        <i class="bi bi-play-circle-fill me-1"></i>Đang diễn ra
                      </span>
                    <% } else if (isClassFull) { %>
                      <span class="badge rounded-pill bg-danger-subtle text-danger border border-danger-subtle fw-bold">
                        <i class="bi bi-person-fill-x me-1"></i>Đã đầy (<%= c.SiSoHienTai %>/<%= c.SiSoToiDa %>)
                      </span>
                    <% } else { %>
                      <span class="badge rounded-pill <%= (c.TrangThaiLop === 'Sắp mở' || c.TrangThaiLop === 'sắp mở' || c.TrangThaiLop === 'Đang mở') ? 'bg-primary-subtle text-primary' : 'bg-secondary-subtle text-secondary' %>">
                        <%= (c.TrangThaiLop === 'Sắp mở' || c.TrangThaiLop === 'sắp mở' || c.TrangThaiLop === 'Đang mở') ? 'Sắp mở' : c.TrangThaiLop %>
                      </span>
                    <% } %>
                  </td>
                  <td class="text-end text-nowrap">
                    <button class="btn btn-sm btn-outline-secondary me-1" data-bs-toggle="modal" data-bs-target="#editClassModal<%= c.MaLopHoc %>" title="Sửa lớp">
                      <i class="bi bi-pencil"></i>
                    </button>
                    <form action="/admin/classes/delete/<%= c.MaLopHoc %>" method="POST" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa lớp học này?')">
                      <button class="btn btn-sm btn-outline-danger" title="Xóa lớp"><i class="bi bi-trash"></i></button>
                    </form>
                  </td>
                </tr>

                <!-- Edit Class Modal -->
                <div class="modal fade" id="editClassModal<%= c.MaLopHoc %>" tabindex="-1" aria-hidden="true">
                  <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content border-0 rounded-3 shadow">
                      <div class="modal-header border-0 bg-light">
                        <h5 class="modal-title fw-bold">Sửa lớp: <%= c.TenLop %></h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                      </div>
                      <form action="/admin/classes/edit/<%= c.MaLopHoc %>" method="POST" id="editClassForm_<%= c.MaLopHoc %>" data-old-max="<%= c.SiSoToiDa %>" data-room-cap="<%= c.SucChuaPhong || 999 %>" data-room-name="<%= c.TenPhongHoc || 'Phòng học' %>" data-sess-count="<%= c.SoBuoiDaHoc || 0 %>" data-start-date="<%= formatDateInput(c.NgayKhaiGiang) %>" data-end-date="<%= formatDateInput(c.NgayKetThuc) %>" onsubmit="return handleEditClassSubmit(event, <%= c.MaLopHoc %>, <%= c.SiSoHienTai %>, '<%= formatDateInput(c.NgayKhaiGiang) %>')">
                        <div class="modal-body p-4">
                          <div class="mb-3">
                            <label class="form-label fw-semibold">
                              Tên lớp học
                              <% if (c.SiSoHienTai > 0 || (c.TongSoHocVien && c.TongSoHocVien > 0)) { %>
                                <span class="badge bg-warning text-dark ms-1" style="font-size: 0.72rem;" title="Đã có học viên đăng ký -> Không được sửa tên lớp"><i class="bi bi-lock-fill me-1"></i>Đã khóa</span>
                              <% } %>
                            </label>
                            <input type="text" class="form-control <%= (c.SiSoHienTai > 0 || (c.TongSoHocVien && c.TongSoHocVien > 0)) ? 'bg-light border-warning-subtle text-muted' : '' %>" name="TenLop" value="<%= c.TenLop %>" <%= (c.SiSoHienTai > 0 || (c.TongSoHocVien && c.TongSoHocVien > 0)) ? 'readonly' : 'onkeyup="autoDetectClassProperties(this)" onchange="autoDetectClassProperties(this)"' %> required />
                            <% if (c.SiSoHienTai > 0 || (c.TongSoHocVien && c.TongSoHocVien > 0)) { %>
                              <small class="text-danger d-block mt-1" style="font-size: 0.75rem;"><i class="bi bi-info-circle me-1"></i>Lớp đã có học viên đăng ký, không thể thay đổi tên lớp học.</small>
                            <% } %>
                          </div>
                          <div class="row mb-3">
                            <div class="col">
                              <label class="form-label fw-semibold">
                                Loại lớp học
                                <% if (c.TrangThaiLop === 'Đang diễn ra') { %>
                                  <span class="badge bg-warning text-dark ms-1" style="font-size: 0.72rem;" title="Lớp học đang diễn ra, không được sửa loại lớp!"><i class="bi bi-lock-fill me-1"></i>Đã khóa</span>
                                <% } %>
                              </label>
                              <select class="form-select <%= c.TrangThaiLop === 'Đang diễn ra' ? 'bg-light text-muted' : '' %>" name="LoaiLop" <%= c.TrangThaiLop === 'Đang diễn ra' ? 'disabled' : '' %>>
                                <option value="Tiêu chuẩn" <%= c.LoaiLop === 'Tiêu chuẩn' ? 'selected' : '' %> <%= (c.LoaiLop === 'Cấp tốc' || (c.TenLop && c.TenLop.toUpperCase().startsWith('CT'))) ? 'disabled' : '' %>>📗 Tiêu chuẩn (2-3 tháng)</option>
                                <option value="Cấp tốc" <%= c.LoaiLop === 'Cấp tốc' ? 'selected' : '' %> <%= (c.LoaiLop === 'Tiêu chuẩn' && c.TenLop && !c.TenLop.toUpperCase().startsWith('CT')) ? 'disabled' : '' %>>🔥 Cấp tốc (1 tháng)</option>
                              </select>
                              <% if (c.TrangThaiLop === 'Đang diễn ra') { %>
                                <input type="hidden" name="LoaiLop" value="<%= c.LoaiLop %>" />
                              <% } %>
                            </div>
                            <div class="col">
                              <label class="form-label fw-semibold text-secondary">Học phí (Đồng bộ Khóa học)</label>
                              <div class="form-control bg-light text-primary fw-bold text-nowrap">
                                <i class="bi bi-tag-fill me-1"></i><%= Number(c.HocPhi).toLocaleString('vi-VN') %>đ
                              </div>
                            </div>
                          </div>
                          <div class="mb-3">
                            <label class="form-label fw-semibold">
                              Thuộc Khóa Học
                              <% if (c.TrangThaiLop === 'Đang diễn ra') { %>
                                <span class="badge bg-warning text-dark ms-1" style="font-size: 0.72rem;" title="Lớp học đang diễn ra, không được sửa khóa học!"><i class="bi bi-lock-fill me-1"></i>Đã khóa</span>
                              <% } %>
                            </label>
                            <select class="form-select <%= c.TrangThaiLop === 'Đang diễn ra' ? 'bg-light text-muted' : '' %>" name="MaKhoaHoc" onchange="autoDetectClassTypeByCourse(this)" <%= c.TrangThaiLop === 'Đang diễn ra' ? 'disabled' : '' %>>
                              <% courses.forEach(cr => { %>
                                <option value="<%= cr.MaKhoaHoc %>" <%= c.MaKhoaHoc === cr.MaKhoaHoc ? 'selected' : '' %>><%= cr.TenKhoaHoc %></option>
                              <% }) %>
                            </select>
                            <% if (c.TrangThaiLop === 'Đang diễn ra') { %>
                              <input type="hidden" name="MaKhoaHoc" value="<%= c.MaKhoaHoc %>" />
                            <% } %>
                          </div>
                          <div class="mb-3">
                            <label class="form-label fw-semibold">
                              Trạng thái lớp
                              <% if (c.TrangThaiLop === 'Đang diễn ra') { %>
                                <span class="badge bg-success-subtle text-success border border-success-subtle ms-1" style="font-size: 0.72rem;">
                                  <i class="bi bi-lock-fill me-1"></i>Đang diễn ra (Tự động đóng khi bế giảng)
                                </span>
                              <% } %>
                            </label>
                            <select class="form-select <%= c.TrangThaiLop === 'Đang diễn ra' ? 'bg-light text-muted' : '' %>" name="TrangThaiLop" <%= c.TrangThaiLop === 'Đang diễn ra' ? 'disabled' : '' %>>
                              <option value="Sắp mở" <%= c.TrangThaiLop === 'Sắp mở' ? 'selected' : '' %> <%= c.TrangThaiLop === 'Đang diễn ra' ? 'disabled' : '' %>>Sắp mở</option>
                              <option value="Đang diễn ra" <%= (c.SiSoHienTai === 0 || (c.TongSoHocVien && c.TongSoHocVien === 0) || new Date(c.NgayKhaiGiang) > new Date()) ? 'disabled' : '' %> <%= c.TrangThaiLop === 'Đang diễn ra' ? 'selected' : '' %>>
                                Đang diễn ra <%= (new Date(c.NgayKhaiGiang) > new Date()) ? '(Khóa: Chưa khai giảng)' : (c.SiSoHienTai === 0 || (c.TongSoHocVien && c.TongSoHocVien === 0)) ? '(Khóa: Sĩ số = 0)' : '' %>
                              </option>
                              <option value="Đã đóng" <%= (new Date(c.NgayKhaiGiang) > new Date() && c.SiSoHienTai < c.SiSoToiDa) ? 'disabled' : '' %> <%= c.TrangThaiLop === 'Đã đóng' ? 'selected' : '' %>>
                                Đã đóng <%= (new Date(c.NgayKhaiGiang) > new Date() && c.SiSoHienTai < c.SiSoToiDa) ? '(Khóa: Lớp đang tuyển sinh)' : '' %>
                              </option>
                            </select>
                            <% if (c.TrangThaiLop === 'Đang diễn ra') { %>
                              <input type="hidden" name="TrangThaiLop" value="Đang diễn ra" />
                              <small class="text-muted d-block mt-1" style="font-size: 0.75rem;">
                                <i class="bi bi-info-circle me-1"></i>Lớp học đang trong thời gian đào tạo. Hệ thống sẽ tự động chuyển sang trạng thái "Đã đóng" khi qua ngày bế giảng (<%= formatDateInput(c.NgayKetThuc) %>).
                              </small>
                            <% } %>
                          </div>
                          <div class="mb-3">
                            <label class="form-label fw-semibold">
                              Giảng viên phụ trách
                              <% if (c.TrangThaiLop === 'Đang diễn ra') { %>
                                <span class="badge bg-warning text-dark ms-1" style="font-size: 0.72rem;" title="Lớp học đang diễn ra, không được sửa giảng viên!"><i class="bi bi-lock-fill me-1"></i>Đã khóa</span>
                              <% } %>
                            </label>
                            <select class="form-select <%= c.TrangThaiLop === 'Đang diễn ra' ? 'bg-light text-muted' : '' %>" name="MaGiangVien" <%= c.TrangThaiLop === 'Đang diễn ra' ? 'disabled' : '' %>>
                              <option value="">Chưa phân công</option>
                              <% staffProfiles.forEach(s => { %>
                                <option value="<%= s.MaNhanSu %>" <%= c.MaGiangVien === s.MaNhanSu ? 'selected' : '' %>><%= s.HoTen %> (<%= s.ChucVu %>)</option>
                              <% }) %>
                            </select>
                            <% if (c.TrangThaiLop === 'Đang diễn ra') { %>
                              <input type="hidden" name="MaGiangVien" value="<%= c.MaGiangVien %>" />
                            <% } %>
                          </div>
                          <div class="row mb-3">
                            <div class="col">
                              <label class="form-label fw-semibold">
                                Ngày khai giảng
                                <% if (c.TrangThaiLop === 'Đang diễn ra') { %>
                                  <span class="badge bg-warning text-dark ms-1" style="font-size: 0.72rem;" title="Lớp học đang diễn ra, không được sửa thời gian!"><i class="bi bi-lock-fill me-1"></i>Đã khóa</span>
                                <% } %>
                              </label>
                              <input type="date" class="form-control" name="NgayKhaiGiang" value="<%= formatDateInput(c.NgayKhaiGiang) %>" <% if (c.TrangThaiLop === 'Đang diễn ra') { %> readonly style="background-color: #e9ecef;" <% } %> required />
                            </div>
                            <div class="col">
                              <label class="form-label fw-semibold text-secondary">
                                Ngày bế giảng
                                <span class="badge bg-secondary-subtle text-secondary border ms-1" style="font-size: 0.72rem;" title="Ngày bế giảng được tự động tính toán theo Lịch học và Thời lượng khóa học"><i class="bi bi-magic me-1"></i>Tự động tính</span>
                              </label>
                              <input type="date" class="form-control bg-light border-secondary-subtle text-muted" name="NgayKetThuc" value="<%= formatDateInput(c.NgayKetThuc) %>" readonly tabindex="-1" style="background-color: #e9ecef !important; cursor: not-allowed;" title="Ngày bế giảng được hệ thống tự động tính toán, không thể sửa trực tiếp." />
                            </div>
                          </div>
                          <div class="mb-3">
                            <label class="form-label fw-semibold">Sĩ số tối đa</label>
                            <input type="number" class="form-control" name="SiSoToiDa" id="editSiSoToiDa_<%= c.MaLopHoc %>" value="<%= c.SiSoToiDa %>" oninput="validateEditSiSoToiDa(<%= c.MaLopHoc %>, <%= c.SiSoHienTai %>)" required />
                            <small id="sisoError_<%= c.MaLopHoc %>" class="text-danger fw-semibold d-none mt-1" style="font-size: 0.78rem;"><i class="bi bi-exclamation-triangle-fill me-1"></i>Sĩ số tối đa không được nhỏ hơn sĩ số hiện tại (<%= c.SiSoHienTai %> học viên)</small>
                          </div>
                        </div>
                        <div class="modal-footer border-0">
                          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Đóng</button>
                          <button type="submit" id="editSubmitBtn_<%= c.MaLopHoc %>" class="btn btn-primary">Lưu lớp học</button>
                        </div>
                      </form>
                    </div>
                  </div>
                </div>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>

    <% if (activeTab === 'classes' || activeTab === 'public-schedules') { %>
      <!-- Add Class Modal -->
      <div class="modal fade" id="addClassModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
          <div class="modal-content border-0 rounded-3 shadow">
            <div class="modal-header border-0 bg-light">
              <h5 class="modal-title fw-bold">Mở lớp học mới</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
         <form action="/admin/classes/add" method="POST" onsubmit="return confirm('Bạn có chắc chắn muốn mở lớp học mới này không?')">
  <input type="hidden" name="redirectTab" value="<%= activeTab %>" />
  <div class="modal-body p-4">
    <div class="mb-3">
      <label class="form-label fw-semibold">Tên lớp học <span class="text-danger">*</span></label>
      <input type="text" class="form-control border-2 fw-bold text-primary" name="TenLop" onkeyup="autoDetectClassProperties(this)" onchange="autoDetectClassProperties(this)" required placeholder="Ví dụ: PRE_101, A_101, B_101, DE_101..." />
      <small class="text-muted d-block mt-1" style="font-size: 0.78rem;"><i class="bi bi-magic me-1 text-primary"></i>Nhập mã lớp chuẩn Cách 1 (VD: PRE_101, A_101, B_101, DE_101...) để tự động chọn Khóa học & Loại lớp.</small>
    </div>
    <div class="row mb-3">
      <div class="col">
        <label class="form-label fw-semibold">Loại lớp học</label>
        <select class="form-select" name="LoaiLop">
          <option value="Tiêu chuẩn">📗 Tiêu chuẩn (2-3 tháng)</option>
          <option value="Cấp tốc">🔥 Cấp tốc (1 tháng)</option>
        </select>
      </div>
      <div class="col">
        <label class="form-label fw-semibold text-secondary">Học phí</label>
        <div class="form-control bg-light text-muted small">
          <i class="bi bi-info-circle me-1 text-primary"></i>Tự động lấy theo Khóa học
        </div>
      </div>
    </div>
    <div class="mb-3">
      <label class="form-label fw-semibold">Thuộc Khóa Học</label>
      <select class="form-select" name="MaKhoaHoc" onchange="autoDetectClassTypeByCourse(this)">
        <% courses.forEach(cr => { %>
          <option value="<%= cr.MaKhoaHoc %>" data-thoiluong="<%= cr.ThoiLuong || '' %>"><%= cr.TenKhoaHoc %></option>
        <% }) %>
      </select>
    </div>
    <div class="mb-3">
      <label class="form-label fw-semibold">Giảng viên phụ trách</label>
      <select class="form-select" name="MaGiangVien">
        <option value="">Chưa phân công</option>
        <% staffProfiles.forEach(s => { %>
          <option value="<%= s.MaNhanSu %>"><%= s.HoTen %> (<%= s.ChucVu %>)</option>
        <% }) %>
      </select>
    </div>
    
    <div class="row mb-3">
      <div class="col">
        <label class="form-label fw-semibold">Ngày khai giảng <span class="text-danger">*</span></label>
        <input type="date" class="form-control" name="NgayKhaiGiang" required />
      </div>
      <div class="col">
        <label class="form-label fw-semibold text-secondary">Số buổi học</label>
        <div class="form-control bg-light text-muted small" id="addClassSoBuoiHocDisplay">
          <i class="bi bi-info-circle me-1 text-primary"></i>Tự động lấy theo Khóa học
        </div>
        <small class="text-muted d-block mt-1" style="font-size: 0.8rem;">Ngày bế giảng sẽ tự động tính</small>
      </div>
    </div>

    <div class="row mb-3">
      <div class="col">
        <label class="form-label fw-semibold">Sĩ số tối đa</label>
        <input type="number" class="form-control" name="SiSoToiDa" required placeholder="25" />
      </div>
      <div class="col">
        <label class="form-label fw-semibold">Trạng thái lớp</label>
        <select class="form-select" name="TrangThaiLop">
          <option value="Sắp mở">Sắp mở</option>
          <option value="Đang diễn ra" disabled>Đang diễn ra (Khóa: Sĩ số = 0)</option>
          <option value="Đã đóng">Đã đóng</option>
        </select>
      </div>
    </div>
  </div>
  <div class="modal-footer border-0">
    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Đóng</button>
    <button type="submit" class="btn btn-primary">Tạo lớp học</button>
  </div>
</form>
          </div>
        </div>
      </div>
    <% } %>

    <!-- TAB: PUBLIC SCHEDULES (QUẢN LÝ LỊCH KHAI GIẢNG) -->
    <% if (activeTab === 'public-schedules') { %>
      <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
        <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-3">
          <div>
            <h5 class="fw-bold mb-1"><i class="bi bi-calendar2-week me-2 text-primary"></i>Quản lý Lịch khai giảng</h5>
            <p class="text-muted small mb-0">Thiết lập trạng thái hiển thị lớp học ngoài Lịch khai giảng công khai và trang tuyển sinh.</p>
          </div>
          <div class="d-flex gap-2 ms-auto">
            <div class="input-group" style="width: 260px;">
              <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
              <input type="text" id="searchPublicSchedules" class="form-control bg-light border-start-0" placeholder="Tìm kiếm lớp..." />
            </div>
            <button class="btn btn-primary fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#addClassModal">
              <i class="bi bi-plus-circle-fill me-1.5"></i>Mở Lớp Khai Giảng Mới
            </button>
          </div>
        </div>

        <div class="alert alert-info border-0 rounded-3 small mb-4">
          <i class="bi bi-info-circle-fill me-2"></i>
          <strong>Quy tắc hiển thị:</strong> Chỉ các lớp học có trạng thái <span class="badge bg-success">Sắp mở</span> mới được hiển thị trên Trang chủ, Lịch khai giảng công khai và trang tuyển sinh. Các trạng thái khác sẽ tự động ẩn đi.
        </div>

        <div class="table-responsive">
          <table class="table table-hover align-middle">
            <thead class="table-light">
              <tr>
                <th>Tên Lớp</th>
                <th>Khóa Học</th>
                <th>Ngày Khai Giảng</th>
                <th>Trạng thái lớp</th>
                <th>Hiển thị công khai</th>
                <th>Thay đổi trạng thái nhanh</th>
              </tr>
            </thead>
            <tbody>
              <% classes.forEach(c => { 
                const isPublic = (c.TrangThaiLop === 'Sắp mở' || c.TrangThaiLop === 'sắp mở' || c.TrangThaiLop === 'Đang mở');
                const isFull2 = (c.SiSoHienTai !== undefined && c.SiSoHienTai !== null && c.SiSoToiDa) ? Number(c.SiSoHienTai) >= Number(c.SiSoToiDa) : false;
                const isOngoing = (c.TrangThaiLop === 'Đang học' || c.TrangThaiLop === 'Đang diễn ra');
                const isClosed = (c.TrangThaiLop === 'Đã đóng' || c.TrangThaiLop === 'Đã kết thúc' || c.TrangThaiLop === 'Kết thúc');
                const noStudent = (c.SiSoHienTai === 0 || (c.TongSoHocVien && c.TongSoHocVien === 0));
                const notStarted = new Date(c.NgayKhaiGiang) > new Date();
                const notEnded = new Date(c.NgayKetThuc) >= new Date();
              %>
                <tr>
                  <td class="fw-bold text-dark"><%= c.TenLop %></td>
                  <td><%= c.TenKhoaHoc %></td>
                  <td><%= new Date(c.NgayKhaiGiang).toLocaleDateString('vi-VN') %></td>
                  <td>
                    <% if (isFull2) { %>
                      <span class="badge rounded-pill bg-danger-subtle text-danger border border-danger-subtle fw-bold">
                        <i class="bi bi-person-fill-x me-1"></i>Đã đầy (<%= c.SiSoHienTai %>/<%= c.SiSoToiDa %>)
                      </span>
                    <% } else { %>
                      <span class="badge rounded-pill <%= isPublic ? 'bg-success-subtle text-success' : isOngoing ? 'bg-info-subtle text-info' : 'bg-secondary-subtle text-secondary' %>">
                        <%= isPublic ? 'Sắp mở' : c.TrangThaiLop %>
                      </span>
                    <% } %>
                  </td>
                  <td>
                    <% if (isFull2) { %>
                      <span class="badge bg-warning text-dark px-3 py-1.5"><i class="bi bi-eye-fill me-1"></i> Đang hiện (Hết chỗ)</span>
                    <% } else if (isPublic) { %>
                      <span class="badge bg-success text-white px-3 py-1.5"><i class="bi bi-eye-fill me-1"></i> Đang hiển thị</span>
                    <% } else { %>
                      <span class="badge bg-secondary text-white px-3 py-1.5"><i class="bi bi-eye-slash-fill me-1"></i> Đã ẩn</span>
                    <% } %>
                  </td>
                  <td>
                    <!-- Quick Toggle Form -->
                    <form action="/admin/classes/edit/<%= c.MaLopHoc %>" method="POST" class="d-inline">
                      <input type="hidden" name="redirectTab" value="public-schedules" />
                      <input type="hidden" name="TenLop" value="<%= c.TenLop %>" />
                      <input type="hidden" name="MaKhoaHoc" value="<%= c.MaKhoaHoc %>" />
                      <input type="hidden" name="MaGiangVien" value="<%= c.MaGiangVien || '' %>" />
                      <input type="hidden" name="NgayKhaiGiang" value="<%= formatDateInput(c.NgayKhaiGiang) %>" />
                      <input type="hidden" name="NgayKetThuc" value="<%= formatDateInput(c.NgayKetThuc) %>" />
                      <input type="hidden" name="SiSoToiDa" value="<%= c.SiSoToiDa %>" />
                      
                      <div class="d-flex align-items-center gap-2">
                        <select name="TrangThaiLop" class="form-select form-select-sm" style="width: 210px;" data-previous="<%= c.TrangThaiLop %>" onchange="confirmScheduleStatusChange(this, '<%= c.TenLop %>')">
                          <option value="Sắp mở" <%= isPublic ? 'selected' : '' %> <%= (isOngoing || isClosed) ? 'disabled' : '' %>>
                            Sắp mở (Hiện) <%= (isOngoing || isClosed) ? '(Khóa)' : '' %>
                          </option>
                          <option value="Đang diễn ra" <%= isOngoing ? 'selected' : '' %> <%= (noStudent || isClosed || notStarted) ? 'disabled' : '' %>>
                            Đang diễn ra <%= notStarted ? '(Khóa: Chưa khai giảng)' : noStudent ? '(Khóa: Sĩ số = 0)' : isClosed ? '(Khóa: Đã bế giảng)' : '' %>
                          </option>
                          <option value="Đã đóng" <%= isClosed ? 'selected' : '' %> <%= notEnded ? 'disabled' : '' %>>
                            Đã đóng <%= notEnded ? '(Khóa: Chưa bế giảng)' : '' %>
                          </option>
                        </select>
                      </div>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>

    <!-- TAB 5: SCHEDULES & ROOMS -->
    <% if (activeTab === 'schedules') { %>
      <% if (typeof unscheduledClasses !== 'undefined' && unscheduledClasses.length > 0) { %>
        <div class="alert d-flex justify-content-between align-items-center shadow-sm mb-4" role="alert" style="background-color: #fff8e1; border: 1.5px solid #ffc107; border-radius: 8px; color: #5a4000;">
          <div>
            <h5 class="alert-heading mb-1" style="font-weight: bold; font-size: 16px; color: #b27b00;">
              <i class="fas fa-exclamation-triangle text-warning me-1"></i> Cảnh báo: Có <%= unscheduledClasses.length %> lớp học chưa được xếp Thời khóa biểu!
            </h5>
            <p class="mb-1" style="font-size: 14px;">
              Danh sách lớp chờ xếp lịch: 
              <strong><%= unscheduledClasses.map(c => c.TenLop).join(', ') %></strong>
            </p>
            <p class="mb-0 text-muted" style="font-size: 13px; font-style: italic;">
              <i class="bi bi-info-circle me-1"></i> Chú ý: Lớp học CHỈ được đăng lên Trang chủ & Lịch khai giảng công khai sau khi Admin xếp Thời khóa biểu.
            </p>
          </div>
          <div>
            <button class="btn shadow-sm px-3 py-2" data-bs-toggle="modal" data-bs-target="#addTkbModal" style="font-weight: bold; background-color: #ffc107; border: none; color: #000; border-radius: 6px;">
              <i class="bi bi-calendar-plus me-1"></i> Xếp lịch ngay
            </button>
          </div>
        </div>
      <% } %>

      <!-- Nav tabs inside layout to separate Rooms, Ca Học and TKB -->
      <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
        <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
          <h5 class="fw-bold mb-0"><i class="bi bi-calendar3 me-2 text-primary"></i>Quản lý Thời khóa biểu</h5>
          <div class="d-flex gap-2 ms-auto">
            <div class="input-group" style="width: 280px;">
              <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
              <input type="text" id="searchSchedules" class="form-control bg-light border-start-0" placeholder="Tìm kiếm lịch học..." />
            </div>
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addTkbModal">
              <i class="bi bi-calendar-plus me-2"></i>Xếp Lịch Học Mới
            </button>
          </div>
        </div>
        <div class="table-responsive">
          <table class="table table-hover align-middle">
            <thead class="table-light">
              <tr class="text-nowrap">
                <th>Lớp Học (Khóa)</th>
                <th>Giảng Viên</th>
                <th>Phòng Học</th>
                <th>Ca Học (Giờ)</th>
                <th>Các Thứ Trong Tuần</th>
                <th class="text-end">Thao Tác</th>
              </tr>
            </thead>
            <tbody>
              <% schedules.forEach(s => { %>
                <tr>
                  <td class="fw-bold text-primary text-nowrap">
                    <%= s.TenLop %>
                    <small class="text-muted d-block fw-normal"><%= s.TenKhoaHoc %></small>
                  </td>
                  <td class="text-nowrap">
                    <span class="fw-medium text-dark"><i class="bi bi-person-badge me-1 text-primary"></i><%= s.TenGiangVien || 'Chưa phân công' %></span>
                  </td>
                  <td class="text-nowrap"><span class="badge bg-secondary-subtle text-secondary px-2.5 py-1.5 fs-6"><i class="bi bi-building me-1"></i><%= s.TenPhong %></span></td>
                  <td class="text-nowrap">
                    <strong class="text-dark"><%= s.TenBuoi %></strong>
                    <div class="small text-muted"><%= s.GioBatDau %> - <%= s.GioKetThuc %></div>
                  </td>
                  <td>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1.5 rounded-pill fw-semibold" style="font-size: 0.85rem;">
                      <i class="bi bi-calendar-week me-1"></i><%= s.CacThu %>
                    </span>
                  </td>
                  <td class="text-end text-nowrap">
                    <button class="btn btn-sm btn-outline-secondary me-1" data-bs-toggle="modal" data-bs-target="#editTkbModal<%= s.MaLopHoc %>" title="Chỉnh sửa lịch lớp">
                      <i class="bi bi-pencil"></i>
                    </button>
                    <form action="/admin/tkb/delete/<%= s.MaLopHoc %>" method="POST" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa toàn bộ lịch học của lớp <%= s.TenLop %>?')">
                      <button class="btn btn-sm btn-outline-danger" title="Xóa lịch lớp"><i class="bi bi-trash"></i></button>
                    </form>
                  </td>
                </tr>

                <!-- Edit TKB Modal -->
                <div class="modal fade" id="editTkbModal<%= s.MaLopHoc %>" tabindex="-1" aria-hidden="true">
                  <div class="modal-dialog modal-dialog-centered modal-lg">
                    <div class="modal-content border-0 rounded-3 shadow">
                      <div class="modal-header border-0 bg-light">
                        <h5 class="modal-title fw-bold">Chỉnh sửa thời khóa biểu lớp: <%= s.TenLop %></h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                      </div>
                      <form action="/admin/schedules/update/<%= s.MaLopHoc %>" method="POST" onsubmit="return confirm('Bạn có chắc chắn muốn cập nhật thời khóa biểu cho lớp này không?')">
                        <input type="hidden" name="MaLopHoc" value="<%= s.MaLopHoc %>" />
                        <div class="modal-body p-4 text-start">
                          <div class="mb-3">
                            <label class="form-label fw-semibold">Lớp học</label>
                            <input type="text" class="form-control bg-light fw-bold text-primary" value="<%= s.TenLop %> (Khóa: <%= s.TenKhoaHoc %>)" readonly />
                          </div>
                          <div class="mb-3">
                            <label class="form-label fw-semibold">Chọn phòng học</label>
                            <select class="form-select" name="MaPhongHoc" required>
                              <% classrooms.forEach(r => { %>
                                <option value="<%= r.MaPhongHoc %>" <%= r.MaPhongHoc === s.MaPhongHoc ? 'selected' : '' %>><%= r.TenPhong %> (<%= r.ViTri %> - Sức chứa: <%= r.SucChua %>)</option>
                              <% }) %>
                            </select>
                          </div>
                          <div class="mb-3">
                            <label class="form-label fw-semibold">Chọn ca học (Buổi)</label>
                            <select class="form-select" name="MaBuoiHoc" required>
                              <% sessions.forEach(se => { %>
                                <option value="<%= se.MaBuoiHoc %>" <%= se.MaBuoiHoc === s.MaBuoiHoc ? 'selected' : '' %>><%= se.TenBuoi %> (<%= se.GioBatDau %> - <%= se.GioKetThuc %>)</option>
                              <% }) %>
                            </select>
                          </div>
                          <div class="mb-3">
                            <label class="form-label fw-semibold">Chọn các Thứ học trong tuần</label>
                            <div class="d-flex flex-wrap gap-2">
                              <% ['Thứ Hai', 'Thứ Ba', 'Thứ Tư', 'Thứ Năm', 'Thứ Sáu', 'Thứ Bảy', 'Chủ Nhật'].forEach(day => { %>
                                <div class="form-check form-check-inline bg-light px-3 py-2 rounded-3 border">
                                  <input class="form-check-input" type="checkbox" name="ThuTrongTuan" value="<%= day %>" id="chk_<%= s.MaLopHoc %>_<%= day %>" <%= (s.CacThu || '').includes(day) ? 'checked' : '' %>>
                                  <label class="form-check-label fw-medium ms-1" for="chk_<%= s.MaLopHoc %>_<%= day %>"><%= day %></label>
                                </div>
                              <% }) %>
                            </div>
                          </div>
                        </div>
                        <div class="modal-footer border-0">
                          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Đóng</button>
                          <button type="submit" class="btn btn-primary">Lưu Lịch Lớp</button>
                        </div>
                      </form>
                    </div>
                  </div>
                </div>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Classrooms list card -->
      <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
        <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-3">
          <h6 class="fw-bold mb-0"><i class="bi bi-door-open-fill text-primary me-2"></i>Danh mục Phòng học vật lý</h6>
          <div class="d-flex gap-2 ms-auto">
            <div class="input-group" style="width: 250px;">
              <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
              <input type="text" id="searchClassrooms" class="form-control form-control-sm bg-light border-start-0" placeholder="Tìm kiếm phòng..." />
            </div>
            <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#addRoomModal">Thêm phòng mới</button>
          </div>
        </div>
        <div class="table-responsive">
          <table class="table table-hover align-middle">
            <thead>
              <tr>
                <th>Tên Phòng</th>
                <th>Sức Chứa</th>
                <th>Vị Trí</th>
                <th class="text-end"></th>
              </tr>
            </thead>
            <tbody>
              <% classrooms.forEach(r => { %>
                <tr>
                  <td class="fw-bold"><%= r.TenPhong %></td>
                  <td><%= r.SucChua %> chỗ ngồi</td>
                  <td><%= r.ViTri %></td>
                  <td class="text-end">
                    <button class="btn btn-sm btn-light me-1" data-bs-toggle="modal" data-bs-target="#editRoomModal<%= r.MaPhongHoc %>"><i class="bi bi-pencil-square"></i></button>
                    <form action="/admin/rooms/delete/<%= r.MaPhongHoc %>" method="POST" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa phòng học này không?')">
                      <button class="btn btn-sm btn-light text-danger"><i class="bi bi-trash"></i></button>
                    </form>
                  </td>
                </tr>

                <!-- Edit Room Modal -->
                <div class="modal fade" id="editRoomModal<%= r.MaPhongHoc %>" tabindex="-1" aria-hidden="true">
                  <div class="modal-dialog modal-dialog-centered modal-sm">
                    <div class="modal-content border-0 rounded-3 shadow">
                      <div class="modal-header border-0 bg-light">
                        <h6 class="modal-title fw-bold mb-0">Sửa phòng học</h6>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                      </div>
                      <form action="/admin/rooms/edit/<%= r.MaPhongHoc %>" method="POST" id="editRoomForm_<%= r.MaPhongHoc %>" data-max-siso="<%= r.MaxClassSiSo || 0 %>" data-max-classname="<%= r.MaxClassName || '' %>" onsubmit="return handleEditRoomSubmit(event, <%= r.MaPhongHoc %>)">
                        <div class="modal-body p-4">
                          <div class="mb-3">
                            <label class="form-label">Tên phòng</label>
                            <input type="text" class="form-control" name="TenPhong" id="editTenPhong_<%= r.MaPhongHoc %>" value="<%= r.TenPhong %>" required />
                          </div>
                          <div class="mb-3">
                            <label class="form-label">Sức chứa</label>
                            <input type="number" class="form-control" name="SucChua" id="editSucChua_<%= r.MaPhongHoc %>" value="<%= r.SucChua %>" required />
                          </div>
                          <div class="mb-3">
                            <label class="form-label">Vị trí</label>
                            <input type="text" class="form-control" name="ViTri" value="<%= r.ViTri %>" required />
                          </div>
                        </div>
                        <div class="modal-footer border-0">
                          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Đóng</button>
                          <button type="submit" class="btn btn-primary">Lưu</button>
                        </div>
                      </form>
                    </div>
                  </div>
                </div>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Add TKB Modal -->
      <div class="modal fade" id="addTkbModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
          <div class="modal-content border-0 rounded-3 shadow">
            <div class="modal-header border-0 bg-light">
              <h5 class="modal-title fw-bold">Xếp thời khóa biểu mới</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="/admin/tkb/add" method="POST" onsubmit="return confirm('Bạn có chắc chắn muốn xếp thời khóa biểu mới này không?')">
              <div class="modal-body p-4">
                <div class="mb-3">
                  <label class="form-label fw-semibold">Chọn lớp học</label>
                  <select class="form-select" name="MaLopHoc" required>
                    <% classes.forEach(c => { %>
                      <option value="<%= c.MaLopHoc %>"><%= c.TenLop %> (Khóa: <%= c.TenKhoaHoc %>)</option>
                    <% }) %>
                  </select>
                </div>
                <div class="mb-3">
                  <label class="form-label fw-semibold">Chọn phòng học</label>
                  <select class="form-select" name="MaPhongHoc" required>
                    <% classrooms.forEach(r => { %>
                      <option value="<%= r.MaPhongHoc %>"><%= r.TenPhong %> (<%= r.ViTri %> - Sức chứa: <%= r.SucChua %>)</option>
                    <% }) %>
                  </select>
                </div>
                <div class="mb-3">
                  <label class="form-label fw-semibold">Chọn ca học (Buổi)</label>
                  <select class="form-select" name="MaBuoiHoc" required>
                    <% sessions.forEach(s => { %>
                      <option value="<%= s.MaBuoiHoc %>"><%= s.TenBuoi %> (<%= s.GioBatDau %> - <%= s.GioKetThuc %>)</option>
                    <% }) %>
                  </select>
                </div>
                <div class="mb-3">
                  <label class="form-label fw-semibold">Chọn các Thứ học trong tuần</label>
                  <div class="d-flex flex-wrap gap-2">
                    <% ['Thứ Hai', 'Thứ Ba', 'Thứ Tư', 'Thứ Năm', 'Thứ Sáu', 'Thứ Bảy', 'Chủ Nhật'].forEach(day => { %>
                      <div class="form-check form-check-inline bg-light px-3 py-2 rounded-3 border">
                        <input class="form-check-input" type="checkbox" name="ThuTrongTuan" value="<%= day %>" id="add_chk_<%= day %>">
                        <label class="form-check-label fw-medium ms-1" for="add_chk_<%= day %>"><%= day %></label>
                      </div>
                    <% }) %>
                  </div>
                </div>
              </div>
              <div class="modal-footer border-0">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Đóng</button>
                <button type="submit" class="btn btn-primary">Lưu Thời Khóa Biểu</button>
              </div>
            </form>
          </div>
        </div>
      </div>

      <!-- Add Room Modal -->
      <div class="modal fade" id="addRoomModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
          <div class="modal-content border-0 rounded-3 shadow">
            <div class="modal-header border-0 bg-light">
              <h6 class="modal-title fw-bold mb-0">Tạo phòng học mới</h6>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="/admin/rooms/add" method="POST" onsubmit="return confirm('Bạn có chắc chắn muốn tạo phòng học mới này không?')">
              <div class="modal-body p-4">
                <div class="mb-3">
                  <label class="form-label">Tên phòng</label>
                  <input type="text" class="form-control" name="TenPhong" placeholder="Ví dụ: Phòng 302" required />
                </div>
                <div class="mb-3">
                  <label class="form-label">Sức chứa</label>
                  <input type="number" class="form-control" name="SucChua" placeholder="30" required />
                </div>
                <div class="mb-3">
                  <label class="form-label">Vị trí</label>
                  <input type="text" class="form-control" name="ViTri" placeholder="Tầng 3 - Tòa A" required />
                </div>
              </div>
              <div class="modal-footer border-0">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
                <button type="submit" class="btn btn-primary">Thêm</button>
              </div>
            </form>
          </div>
        </div>
      </div>
    <% } %>

    <!-- TAB 6: CONTENT MANAGEMENT (NEWS) -->
    <% if (activeTab === 'content') { %>
      <%
        const formatNews2 = news.find(n => n.MaTinTuc === 1 || n.TieuDe.toLowerCase().includes('format') || n.TieuDe.toLowerCase().includes('cấu trúc'));
        const meoNews2 = news.find(n => n.MaTinTuc === 2 || n.TieuDe.toLowerCase().includes('mẹo') || n.TieuDe.toLowerCase().includes('listening'));
        const tuvungNews2 = news.find(n => n.MaTinTuc === 3 || n.TieuDe.toLowerCase().includes('từ vựng') || n.TieuDe.toLowerCase().includes('văn phòng'));
      %>

      <!-- ===== SECTION 1: Tin tức nổi bật (giống Home) ===== -->
      <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
        <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
          <h5 class="fw-bold mb-0"><i class="bi bi-newspaper me-2 text-primary"></i>Tin tức nổi bật (Hiển thị trên Trang chủ)</h5>
          <span class="badge bg-primary-subtle text-primary px-3 py-2 fw-semibold rounded-pill">Tổng số <%= news ? news.length : 0 %> bài viết</span>
        </div>
        
        <div class="row g-4">
          <% if (news && news.length > 0) { %>
            <% news.forEach(n => { 
              const titleLower = (n.TieuDe || '').toLowerCase();
              let badgeColor = 'bg-primary';
              let badgeIcon = 'bi-newspaper';
              let badgeText = 'Tin tức';
              let customEditUrl = null;
              let publicUrl = `/news/detail/${n.MaTinTuc}`;

              if (n.MaTinTuc === 1 || titleLower.includes('format') || titleLower.includes('cấu trúc')) {
                badgeColor = 'bg-primary'; badgeIcon = 'bi-layout-text-sidebar-reverse'; badgeText = 'Format TOEIC';
                customEditUrl = '/admin/news/edit-format'; publicUrl = '/format-toeic';
              } else if (n.MaTinTuc === 2 || titleLower.includes('mẹo') || titleLower.includes('listening')) {
                badgeColor = 'bg-success'; badgeIcon = 'bi-headphones'; badgeText = 'Mẹo Listening';
                customEditUrl = '/admin/news/edit-listening'; publicUrl = '/meo-toeic-listening';
              } else if (n.MaTinTuc === 3 || titleLower.includes('từ vựng') || titleLower.includes('văn phòng')) {
                badgeColor = 'bg-warning text-dark'; badgeIcon = 'bi-book'; badgeText = 'Kho Từ Vựng';
                customEditUrl = '/admin/news/edit-vocab'; publicUrl = '/tu-vung-van-phong';
              }
            %>
              <div class="col-md-4">
                <div class="card border-0 shadow-sm overflow-hidden rounded-3 h-100" style="transition: all 0.3s;">
                  <div class="position-relative" style="height: 200px; background-color: #f8f9fa;">
                    <img src="<%= n.HinhAnh ? n.HinhAnh : '/images/Cap_Nhat_Fomat.png' %>" class="img-fluid w-100 h-100" style="object-fit: cover;" alt="<%= n.TieuDe %>" onerror="this.onerror=null; this.src='/images/logo.png';" />
                    <span class="position-absolute top-0 start-0 m-2 badge <%= badgeColor %> rounded-pill px-3 py-2 shadow-sm">
                      <i class="bi <%= badgeIcon %> me-1"></i><%= badgeText %>
                    </span>
                  </div>
                  <div class="card-body p-3 d-flex flex-column justify-content-between">
                    <div>
                      <h6 class="fw-bold text-dark mb-1 line-clamp-2"><%= n.TieuDe %></h6>
                      <p class="small text-secondary mb-3 line-clamp-2"><%= n.TomTat || 'Nội dung bài viết...' %></p>
                    </div>
                    <div class="d-flex gap-2 flex-wrap pt-2 border-top">
                      <% if (customEditUrl) { %>
                        <a href="<%= customEditUrl %>" class="btn btn-sm btn-primary flex-grow-1"><i class="bi bi-pencil-square me-1"></i>Sửa chi tiết</a>
                      <% } else { %>
                        <button class="btn btn-sm btn-primary flex-grow-1" data-bs-toggle="modal" data-bs-target="#editNewsModal<%= n.MaTinTuc %>"><i class="bi bi-pencil-square me-1"></i>Sửa bài viết</button>
                      <% } %>
                      <button class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#editNewsModal<%= n.MaTinTuc %>" title="Sửa tiêu đề & ảnh bìa"><i class="bi bi-image"></i></button>
                      <form action="/admin/news/delete/<%= n.MaTinTuc %>" method="POST" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa bài viết này không?')">
                        <button class="btn btn-sm btn-outline-danger" title="Xóa bài viết"><i class="bi bi-trash"></i></button>
                      </form>
                      <a href="<%= publicUrl %>" target="_blank" class="btn btn-sm btn-outline-dark" title="Xem trang công khai"><i class="bi bi-box-arrow-up-right"></i></a>
                    </div>
                  </div>
                </div>
              </div>
            <% }); %>
          <% } else { %>
            <div class="col-12 text-center py-4 text-muted">Chưa có bài viết nào.</div>
          <% } %>
        </div>
      </div>

      <!-- ===== SECTION 2: Danh sách bài viết (Bảng quản lý) ===== -->
      <div class="card border-0 shadow-sm rounded-4 p-4">
        <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
          <h5 class="fw-bold mb-0"><i class="bi bi-file-text-fill me-2 text-primary"></i>Tất cả bài viết</h5>
          <div class="d-flex gap-2 ms-auto">
            <div class="input-group" style="width: 280px;">
              <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
              <input type="text" id="searchNews" class="form-control bg-light border-start-0" placeholder="Tìm kiếm tin tức..." />
            </div>
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addNewsModal">
              <i class="bi bi-plus-circle-fill me-2"></i>Đăng Bài Viết Mới
            </button>
          </div>
        </div>
        <div class="table-responsive">
          <table class="table table-hover align-middle">
            <thead class="table-light">
              <tr>
                <th>Ảnh Bìa</th>
                <th>Tiêu Đề Tin</th>
                <th>Tóm Tắt</th>
                <th>Ngày Đăng</th>
                <th>Người Đăng</th>
                <th class="text-end">Thao tác</th>
              </tr>
            </thead>
            <tbody>
              <% news.forEach(n => { %>
                <tr>
                  <td>
                    <img src="<%= n.HinhAnh || '/images/logo.png' %>" style="width: 60px; height: 40px; object-fit: cover;" class="rounded shadow-sm" />
                  </td>
                  <td class="fw-semibold text-dark" style="max-width: 200px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"><%= n.TieuDe %></td>
                  <td style="max-width: 250px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: #7f8c8d;"><%= n.TomTat %></td>
                  <td><%= new Date(n.NgayDang).toLocaleDateString('vi-VN') %></td>
                  <td><span class="text-muted"><%= n.NguoiDang %></span></td>
                  <td class="text-end">
                    <button class="btn btn-sm btn-outline-secondary me-1" data-bs-toggle="modal" data-bs-target="#editNewsModal<%= n.MaTinTuc %>">
                      <i class="bi bi-pencil me-1"></i>Sửa
                    </button>
                    <form action="/admin/news/delete/<%= n.MaTinTuc %>" method="POST" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa bài viết này không?')">
                      <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                    </form>
                  </td>
                </tr>

                <!-- Edit News Modal -->
                <div class="modal fade" id="editNewsModal<%= n.MaTinTuc %>" tabindex="-1" aria-hidden="true">
                  <div class="modal-dialog modal-dialog-centered modal-lg">
                    <div class="modal-content border-0 rounded-3 shadow">
                      <div class="modal-header border-0 bg-light">
                        <h5 class="modal-title fw-bold">Sửa tin tức</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                      </div>
                      <form action="/admin/news/edit/<%= n.MaTinTuc %>" method="POST" onsubmit="return confirm('Bạn có chắc chắn muốn cập nhật thay đổi cho bài viết này không?')">
                        <div class="modal-body p-4">
                          <div class="mb-3">
                            <label class="form-label fw-semibold">Tiêu đề bài viết</label>
                            <input type="text" class="form-control" name="TieuDe" value="<%= n.TieuDe %>" required />
                          </div>
                          <div class="mb-3">
                            <label class="form-label fw-semibold">Đường dẫn hình ảnh bìa</label>
                            <input type="text" class="form-control" name="HinhAnh" value="<%= n.HinhAnh %>" />
                          </div>
                          <div class="mb-3">
                            <label class="form-label fw-semibold">Tóm tắt nội dung (Mô tả ngắn)</label>
                            <input type="text" class="form-control" name="TomTat" value="<%= n.TomTat %>" required />
                          </div>
                          <div class="mb-3">
                            <label class="form-label fw-semibold">Nội dung chi tiết (Có thể dùng HTML)</label>
                            <textarea class="form-control" name="NoiDung" rows="6" required><%= n.NoiDung %></textarea>
                          </div>
                        </div>
                        <div class="modal-footer border-0">
                          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Đóng</button>
                          <button type="submit" class="btn btn-primary">Lưu cập nhật</button>
                        </div>
                      </form>
                    </div>
                  </div>
                </div>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Add News Modal -->
      <div class="modal fade" id="addNewsModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
          <div class="modal-content border-0 rounded-3 shadow">
            <div class="modal-header border-0 bg-light">
              <h5 class="modal-title fw-bold">Đăng bài viết mới</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="/admin/news/add" method="POST" onsubmit="return confirm('Bạn có chắc chắn muốn đăng bài viết mới này lên hệ thống không?')">
              <div class="modal-body p-4">
                <div class="mb-3">
                  <label class="form-label fw-semibold">Tiêu đề bài viết</label>
                  <input type="text" class="form-control" name="TieuDe" required placeholder="VD: Khai giảng lớp TOEIC 650+ tháng sau..." />
                </div>
                <div class="mb-3">
                  <label class="form-label fw-semibold">Đường dẫn hình ảnh bìa</label>
                  <input type="text" class="form-control" name="HinhAnh" placeholder="/images/tin-tuc-1.jpg" />
                </div>
                <div class="mb-3">
                  <label class="form-label fw-semibold">Tóm tắt nội dung (Mô tả ngắn)</label>
                  <input type="text" class="form-control" name="TomTat" required placeholder="Nhập mô tả tóm tắt..." />
                </div>
                <div class="mb-3">
                  <label class="form-label fw-semibold">Nội dung chi tiết (HTML)</label>
                  <textarea class="form-control" name="NoiDung" rows="6" required placeholder="Nhập nội dung đầy đủ bài viết..."></textarea>
                </div>
              </div>
              <div class="modal-footer border-0">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Đóng</button>
                <button type="submit" class="btn btn-primary">Đăng Bài Viết</button>
              </div>
            </form>
          </div>
        </div>
      </div>
    <% } %>

    <!-- TAB 7: ENROLLMENTS & TRANSACTIONS -->
    <% if (activeTab === 'enrollments') { %>
      <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
        <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
          <h5 class="fw-bold mb-0"><i class="bi bi-cart-check-fill me-2 text-primary"></i>Quản lý Đơn Đăng Ký Học</h5>
          <div class="d-flex gap-2 ms-auto">
            <div class="input-group" style="width: 280px;">
              <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
              <input type="text" id="searchEnrollments" class="form-control bg-light border-start-0" placeholder="Tìm kiếm đơn đăng ký..." />
            </div>
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addEnrollmentModal">
              <i class="bi bi-person-plus-fill me-2"></i>Ghi danh học viên trực tiếp
            </button>
          </div>
        </div>
        <div class="table-responsive">
          <table class="table table-hover align-middle">
            <thead class="table-light">
              <tr>
                <th>Học Viên</th>
                <th>Lớp Học</th>
                <th>Học Phí Phải Đóng</th>
                <th>Ngày Đăng Ký</th>
                <th>Trạng Thái</th>
                <th class="text-end"></th>
              </tr>
            </thead>
            <tbody>
              <% enrollments.forEach(e => { %>
                <tr>
                  <td>
                    <div class="fw-bold"><%= e.TenHocVien %></div>
                    <small class="text-muted">Bởi: <%= e.TenNguoiDangKy %> <%= e.TenHocVien !== e.TenNguoiDangKy ? '(Đăng ký hộ)' : '' %></small>
                  </td>
                  <td>
                    <div class="fw-semibold text-primary"><%= e.TenLop %></div>
                    <small class="text-muted"><%= e.TenKhoaHoc %></small>
                  </td>
                  <td>
                    <div class="fw-bold text-success"><%= Number(e.HocPhiDaGiam).toLocaleString('vi-VN') %>đ</div>
                    <% if (e.MaKhuyenMai) { %>
                      <small class="text-decoration-line-through text-muted"><%= Number(e.HocPhiGoc).toLocaleString('vi-VN') %>đ</small>
                      <small class="badge bg-danger-subtle text-danger"><%= e.TenKhuyenMai %></small>
                    <% } %>
                  </td>
                  <td><%= new Date(e.NgayDangKy).toLocaleDateString('vi-VN') %></td>
                  <td>
                    <% 
                      let badgeClass = 'bg-secondary-subtle text-secondary';
                      const st = (e.TrangThai || '').trim();
                      if (st === 'Đang học') {
                        badgeClass = 'bg-primary-subtle text-primary border border-primary-subtle';
                      } else if (st === 'Thành công') {
                        badgeClass = 'bg-success-subtle text-success border border-success-subtle';
                      } else if (st === 'Hoàn thành' || st === 'Đã hoàn thành') {
                        badgeClass = 'bg-success text-white border border-success';
                      } else if (st === 'Bảo lưu') {
                        badgeClass = 'bg-info-subtle text-info border border-info-subtle';
                      } else if (st === 'Ngừng học' || st === 'Đã ngừng học') {
                        badgeClass = 'bg-secondary-subtle text-dark border border-secondary';
                      } else if (st === 'Chờ thanh toán') {
                        badgeClass = 'bg-warning-subtle text-warning-emphasis border border-warning';
                      } else if (st.includes('Xin chuyển lớp') || st.includes('Chờ xử lý')) {
                        badgeClass = 'bg-warning text-dark border border-warning';
                      } else if (st === 'Chờ duyệt') {
                        badgeClass = 'bg-info-subtle text-info border border-info-subtle';
                      } else if (st === 'Chờ xếp ca đợt sau' || st.includes('Chờ xếp ca')) {
                        badgeClass = 'bg-info text-dark border border-info-subtle';
                      } else if (st === 'Đã hủy') {
                        badgeClass = 'bg-danger-subtle text-danger border border-danger-subtle';
                      }
                    %>
                    <span class="badge rounded-pill px-3 py-1.5 fw-semibold <%= badgeClass %>">
                      <%= e.TrangThai %>
                    </span>
                    <% if (e.GhiChu) { %>
                      <small class="d-block text-muted fw-normal mt-1" style="max-width: 240px; font-size: 0.78rem;" title="<%= e.GhiChu %>">
                        <i class="bi bi-info-circle me-1 text-primary"></i><%= e.GhiChu %>
                      </small>
                      <% if (e.GhiChu.includes('>2 buổi') || e.GhiChu.includes('tư vấn trực tiếp')) { %>
                        <span class="badge bg-danger text-white rounded-pill px-2.5 py-1 mt-1 d-inline-block shadow-sm" style="font-size: 0.73rem;">
                          <i class="bi bi-telephone-outbound-fill me-1"></i>Vắng trễ >2 buổi (Cần gọi tư vấn!)
                        </span>
                      <% } %>
                    <% } %>
                  </td>
                  <td class="text-end">
                    <% if (e.TrangThai === 'Chờ xếp ca đợt sau' || e.TrangThai.includes('Chờ xếp ca')) { %>
                      <button class="btn btn-sm btn-primary me-1 fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#assignFutureModal<%= e.MaDangKy %>" title="Xếp ca đợt mở mới cho học viên"><i class="bi bi-person-workspace me-1"></i>Xếp ca đợt mới</button>

                      <!-- Modal Xếp Ca Đợt Mới -->
                      <div class="modal fade" id="assignFutureModal<%= e.MaDangKy %>" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                          <div class="modal-content border-0 rounded-4 shadow-lg">
                            <div class="modal-header border-bottom py-3 bg-light">
                              <h5 class="modal-title fw-bold text-primary"><i class="bi bi-person-workspace me-2"></i>Xếp ca đợt mới cho học viên</h5>
                              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <form action="/admin/enrollments/assign-future-shift" method="POST">
                              <input type="hidden" name="MaDangKy" value="<%= e.MaDangKy %>" />
                              <div class="modal-body p-4 text-start">
                                <div class="alert alert-info py-2 mb-3 small fw-semibold">
                                  <i class="bi bi-person-fill me-1"></i>Học viên: <strong><%= e.TenHocVien %></strong> — Lớp giữ chỗ hiện tại: <strong><%= e.TenLop %></strong> (<%= e.TenKhoaHoc %>)
                                </div>
                                <div class="mb-3">
                                  <label class="form-label fw-semibold">Chọn lớp đợt mở mới gán cho học viên <span class="text-danger">*</span></label>
                                  <select class="form-select border-2" name="MaLopHocMoi" required>
                                    <option value="">-- Chọn lớp đợt mở mới --</option>
                                    <% classes.filter(c => c.MaLopHoc !== e.MaLopHoc).forEach(c => { %>
                                      <option value="<%= c.MaLopHoc %>"><%= c.TenLop %> - <%= c.TenKhoaHoc %> (Khai giảng: <%= new Date(c.NgayKhaiGiang).toLocaleDateString('vi-VN') %>)</option>
                                    <% }) %>
                                  </select>
                                </div>
                              </div>
                              <div class="modal-footer border-top bg-light px-4 py-3">
                                <button type="button" class="btn btn-outline-secondary rounded-3" data-bs-dismiss="modal">Hủy</button>
                                <button type="submit" class="btn btn-primary fw-bold px-4 rounded-3"><i class="bi bi-check-circle-fill me-1"></i>Xác nhận gán ca mới</button>
                              </div>
                            </form>
                          </div>
                        </div>
                      </div>
                    <% } %>
                    <% const isTransferPending = (e.TrangThai === 'Chờ xử lý - Xin chuyển lớp' || (e.GhiChu && e.GhiChu.includes('Xin chuyển lớp') && !e.GhiChu.includes('Đã chuyển sang lớp') && !e.GhiChu.includes('Từ chối chuyển'))); %>
                    <% if (isTransferPending) { %>
                      <form action="/admin/enrollments/approve-transfer/<%= e.MaDangKy %>" method="POST" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn DUYỆT chuyển lớp cho học viên <%= e.TenHocVien %> không?')">
                        <button class="btn btn-sm btn-success me-1 fw-bold shadow-sm" title="Duyệt phiếu xin chuyển lớp"><i class="bi bi-check-circle-fill me-1"></i>Duyệt chuyển lớp</button>
                      </form>
                      <button class="btn btn-sm btn-outline-danger me-1 fw-semibold shadow-sm" data-bs-toggle="modal" data-bs-target="#rejectTransferModal<%= e.MaDangKy %>" title="Từ chối phiếu xin chuyển lớp"><i class="bi bi-x-circle me-1"></i>Từ chối</button>

                      <!-- Modal Từ Chối Phiếu Xin Chuyển Lớp -->
                      <div class="modal fade" id="rejectTransferModal<%= e.MaDangKy %>" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                          <div class="modal-content border-0 rounded-4 shadow-lg">
                            <div class="modal-header border-bottom py-3 bg-light">
                              <h5 class="modal-title fw-bold text-danger"><i class="bi bi-x-circle-fill me-2"></i>Từ chối phiếu xin chuyển lớp</h5>
                              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <form action="/admin/enrollments/reject-transfer/<%= e.MaDangKy %>" method="POST">
                              <div class="modal-body p-4 text-start">
                                <div class="alert alert-warning py-2 mb-3 small fw-semibold">
                                  <i class="bi bi-person-fill me-1"></i>Học viên: <strong><%= e.TenHocVien %></strong> — Lớp: <strong><%= e.TenLop %></strong>
                                </div>
                                <% if (e.GhiChu) { %>
                                  <div class="mb-3 p-2.5 bg-light rounded border small">
                                    <strong>Nội dung yêu cầu chuyển lớp:</strong><br>
                                    <span class="text-secondary"><%= e.GhiChu %></span>
                                  </div>
                                <% } %>
                                <div class="mb-3">
                                  <label class="form-label fw-semibold text-dark">Lý do từ chối <span class="text-danger">*</span></label>
                                  <textarea class="form-control border-2" name="LyDoTuChoi" rows="3" placeholder="Nhập lý do từ chối (ví dụ: Lớp mới không đúng cấp độ trình độ, phải đợi đợt lớp Pre mở mới, chưa đạt điểm test đầu vào...)" required></textarea>
                                </div>
                                <div class="mb-3">
                                  <label class="form-label fw-semibold text-dark">Trạng thái xử lý của đơn sau khi từ chối</label>
                                  <select class="form-select border-2" name="TrangThaiSauTuChoi">
                                    <option value="Bảo lưu" selected>Bảo lưu (Đợi đợt mở lớp mới phù hợp)</option>
                                    <option value="Đang học">Đang học (Tiếp tục học lớp cũ hiện tại)</option>
                                  </select>
                                </div>
                              </div>
                              <div class="modal-footer border-top bg-light py-2">
                                <button type="button" class="btn btn-secondary btn-sm rounded-3" data-bs-dismiss="modal">Hủy</button>
                                <button type="submit" class="btn btn-danger btn-sm fw-bold rounded-3"><i class="bi bi-x-circle-fill me-1"></i>Xác nhận từ chối</button>
                              </div>
                            </form>
                          </div>
                        </div>
                      </div>
                    <% } %>
                    <button class="btn btn-sm btn-outline-warning me-1 fw-semibold shadow-sm" data-bs-toggle="modal" data-bs-target="#editStatusModal<%= e.MaDangKy %>" title="Cập nhật trạng thái học viên / đơn đăng ký"><i class="bi bi-pencil-square me-1"></i>Trạng thái</button>
                    <% if (e.TrangThai !== 'Đã hủy' && e.TrangThai !== 'Đã chuyển lớp') { %>
                      <button class="btn btn-sm btn-outline-primary me-1 fw-semibold shadow-sm" data-bs-toggle="modal" data-bs-target="#transferClassModal<%= e.MaDangKy %>" title="Chuyển lớp cho học viên khi có sự cố"><i class="bi bi-arrow-left-right me-1"></i>Chuyển lớp</button>
                    <% } %>
                    <% if (e.TrangThai === 'Chờ thanh toán' || e.TrangThai === 'Chờ duyệt') { %>
                      <form action="/admin/enrollments/edit-status/<%= e.MaDangKy %>" method="POST" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn duyệt thanh toán học phí thành công cho đơn đăng ký này không?')">
                        <input type="hidden" name="TrangThai" value="Thành công" />
                        <button class="btn btn-sm btn-success me-1 fw-bold shadow-sm" title="Duyệt thủ công khi gián đoạn Webhook Sepay"><i class="bi bi-check2-circle me-1"></i>Duyệt thủ công đơn treo</button>
                      </form>
                    <% } %>
                    <form action="/admin/enrollments/delete/<%= e.MaDangKy %>" method="POST" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa đơn đăng ký này không?')">
                      <button class="btn btn-sm btn-outline-danger" title="Xóa đơn đăng ký"><i class="bi bi-trash"></i></button>
                    </form>

                    <!-- Modal Cập Nhật Trạng Thái -->
                    <div class="modal fade" id="editStatusModal<%= e.MaDangKy %>" tabindex="-1" aria-hidden="true">
                      <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
                          <div class="modal-header border-bottom bg-light py-3 px-4">
                            <h5 class="modal-title fw-bold text-primary"><i class="bi bi-pencil-square me-2"></i>Cập nhật trạng thái học viên</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                          </div>
                          <form action="/admin/enrollments/edit-status/<%= e.MaDangKy %>" method="POST" onsubmit="return confirm('Bạn có chắc chắn muốn cập nhật trạng thái đơn này?')">
                            <div class="modal-body p-4 text-start">
                              <div class="mb-3 p-3 bg-light rounded-3 border">
                                <div><strong>Học viên:</strong> <%= e.TenHocVien %></div>
                                <div><strong>Lớp học:</strong> <span class="text-primary fw-bold"><%= e.TenLop %></span></div>
                                <div><strong>Trạng thái hiện tại:</strong> <span class="badge bg-secondary"><%= e.TrangThai %></span></div>
                                <% if (e.GhiChu) { %>
                                  <div class="mt-2 text-danger small"><strong>Ghi chú / Kiến nghị:</strong> <%= e.GhiChu %></div>
                                <% } %>
                              </div>
                              <div class="mb-3">
                                <label class="form-label fw-semibold">Chọn trạng thái chuyển tiếp phù hợp</label>
                                <select class="form-select border-2" name="TrangThai" id="statusSelect<%= e.MaDangKy %>" required onchange="toggleReasonField(this, '<%= e.MaDangKy %>')">
                                  <% 
                                    const currentSt = e.TrangThai || 'Chờ thanh toán';
                                    const allowedMap = {
                                      'Chờ thanh toán': [
                                        { val: 'Thành công', label: 'Thành công (Duyệt thanh toán)' },
                                        { val: 'Đang học', label: 'Đang học (Kích hoạt học)' },
                                        { val: 'Đã hủy', label: 'Đã hủy (Hủy đơn chưa thanh toán)' }
                                      ],
                                      'Chờ duyệt': [
                                        { val: 'Thành công', label: 'Thành công (Duyệt thanh toán)' },
                                        { val: 'Đang học', label: 'Đang học (Kích hoạt học)' },
                                        { val: 'Đã hủy', label: 'Đã hủy' }
                                      ],
                                      'Chờ xử lý - Xin chuyển lớp': [
                                        { val: 'Chờ xử lý - Xin chuyển lớp', label: 'Chờ xử lý - Xin chuyển lớp' },
                                        { val: 'Đang học', label: 'Đang học (Từ chối chuyển - giữ lớp cũ)' }
                                      ],
                                      'Thành công': [
                                        { val: 'Đang học', label: 'Đang học' },
                                        { val: 'Bảo lưu', label: 'Bảo lưu' },
                                        { val: 'Ngừng học', label: 'Ngừng học' },
                                        { val: 'Hoàn thành', label: 'Hoàn thành' }
                                      ],
                                      'Đang học': [
                                        { val: 'Đang học', label: 'Đang học' },
                                        { val: 'Bảo lưu', label: 'Bảo lưu' },
                                        { val: 'Ngừng học', label: 'Ngừng học' },
                                        { val: 'Hoàn thành', label: 'Hoàn thành' }
                                      ],
                                      'Bảo lưu': [
                                        { val: 'Bảo lưu', label: 'Bảo lưu' },
                                        { val: 'Đang học', label: 'Đang học (Kích hoạt học lại)' },
                                        { val: 'Ngừng học', label: 'Ngừng học' }
                                      ],
                                      'Ngừng học': [
                                        { val: 'Ngừng học', label: 'Ngừng học' },
                                        { val: 'Đang học', label: 'Đang học (Khôi phục học)' }
                                      ],
                                      'Hoàn thành': [
                                        { val: 'Hoàn thành', label: 'Hoàn thành' },
                                        { val: 'Đang học', label: 'Đang học (Học lại)' }
                                      ],
                                      'Đã hoàn thành': [
                                        { val: 'Hoàn thành', label: 'Hoàn thành' },
                                        { val: 'Đang học', label: 'Đang học (Học lại)' }
                                      ],
                                      'Đã hủy': [
                                        { val: 'Đã hủy', label: 'Đã hủy' },
                                        { val: 'Chờ thanh toán', label: 'Chờ thanh toán (Khôi phục đơn)' }
                                      ]
                                    };
                                    const optionsList = allowedMap[currentSt] || [
                                      { val: 'Đang học', label: 'Đang học' },
                                      { val: 'Bảo lưu', label: 'Bảo lưu' },
                                      { val: 'Ngừng học', label: 'Ngừng học' },
                                      { val: 'Hoàn thành', label: 'Hoàn thành' }
                                    ];
                                  %>
                                  <% optionsList.forEach(opt => { %>
                                    <option value="<%= opt.val %>" <%= currentSt === opt.val ? 'selected' : '' %>><%= opt.label %></option>
                                  <% }) %>
                                </select>
                              </div>
                              <div class="mb-3" id="reasonField<%= e.MaDangKy %>" style="display: none;">
                                <label class="form-label fw-semibold text-danger"><i class="bi bi-exclamation-circle me-1"></i>Lý do ngừng học</label>
                                <textarea class="form-control border-2" name="LyDo" id="reasonInput<%= e.MaDangKy %>" rows="3" placeholder="Nhập lý do ngừng học của học viên (ví dụ: Vắng 3 buổi không có lý do, Bỏ học...)"></textarea>
                                <small class="text-muted d-block mt-1">Lý do này sẽ được ghi vào hồ sơ và gửi thông báo đến email học viên</small>
                              </div>
                            </div>
                            <div class="modal-footer border-top bg-light px-4 py-3">
                              <button type="button" class="btn btn-outline-secondary rounded-3" data-bs-dismiss="modal">Hủy</button>
                              <button type="submit" class="btn btn-primary fw-bold px-4 rounded-3"><i class="bi bi-save me-1"></i>Lưu trạng thái</button>
                            </div>
                          </form>
                        </div>
                      </div>
                    </div>

                    <!-- Modal Chuyển Lớp -->
                    <div class="modal fade" id="transferClassModal<%= e.MaDangKy %>" tabindex="-1" aria-hidden="true">
                      <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
                          <div class="modal-header border-bottom bg-light py-3 px-4">
                            <h5 class="modal-title fw-bold text-primary"><i class="bi bi-arrow-left-right me-2"></i>Chuyển lớp cho học viên</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                          </div>
                          <form action="/admin/enrollments/transfer" method="POST" onsubmit="return confirm('Bạn có chắc chắn muốn chuyển học viên này sang lớp mới không?')">
                            <input type="hidden" name="MaDangKy" value="<%= e.MaDangKy %>" />
                            <div class="modal-body p-4 text-start">
                              <div class="mb-3 p-3 bg-light rounded-3 border">
                                <div><strong>Học viên:</strong> <%= e.TenHocVien %></div>
                                <div><strong>Lớp hiện tại:</strong> <span class="text-danger fw-bold"><%= e.TenLop %></span> (<%= e.TenKhoaHoc %>)</div>
                              </div>
                              <div class="mb-3">
                                <label class="form-label fw-semibold">Chọn lớp học mới chuyển tới</label>
                                <select class="form-select border-2" name="MaLopHocMoi" required>
                                  <% classes.forEach(c => { if (c.MaLopHoc != e.MaLopHoc) { %>
                                    <option value="<%= c.MaLopHoc %>"><%= c.TenLop %> - <%= c.TenKhoaHoc %> (Sĩ số: <%= c.SiSoHienTai %> / <%= c.SiSoToiDa %>)</option>
                                  <% } }) %>
                                </select>
                              </div>
                              <div class="mb-3">
                                <label class="form-label fw-semibold">Lý do / Trạng thái chuyển lớp</label>
                                <select class="form-select border-2 mb-2" onchange="const txt = this.form.querySelector('textarea[name=\'LyDoChuyenLop\']'); if (this.value === 'Chuyển đổi cấp độ/Sai trình độ') { txt.value = 'Chuyển đổi cấp độ/Sai trình độ'; } else if (this.value && this.value !== 'Khác') { txt.value = this.value; } else if (this.value === 'Khác') { txt.value = ''; txt.focus(); }">
                                  <option value="">-- Chọn lý do mẫu hoặc nhập bên dưới --</option>
                                  <option value="Chuyển đổi cấp độ/Sai trình độ" selected>🎯 Chuyển đổi cấp độ/Sai trình độ</option>
                                  <option value="Trùng lịch học trường / ca làm việc">⏰ Trùng lịch học trường / ca làm việc</option>
                                  <option value="Theo yêu cầu nguyện vọng học viên">🙋‍♂️ Theo yêu cầu nguyện vọng học viên</option>
                                  <option value="Khác">📝 Lý do khác (Tự nhập...)</option>
                                </select>
                                <textarea class="form-control border-2" name="LyDoChuyenLop" rows="2" placeholder="Chi tiết lý do chuyển lớp..." required>Chuyển đổi cấp độ/Sai trình độ</textarea>
                                <small class="text-muted mt-1 d-block"><i class="bi bi-shield-check text-success me-1"></i>Hệ thống sẽ tự động kiểm tra sĩ số và trùng lịch học trước khi chuyển.</small>
                              </div>
                            </div>
                            <div class="modal-footer border-top bg-light px-4 py-3">
                              <button type="button" class="btn btn-outline-secondary rounded-3" data-bs-dismiss="modal">Hủy</button>
                              <button type="submit" class="btn btn-primary fw-bold px-4 rounded-3"><i class="bi bi-check-circle-fill me-1"></i>Xác nhận chuyển lớp</button>
                            </div>
                          </form>
                        </div>
                      </div>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Financial transactions list card -->
      <div class="card border-0 shadow-sm rounded-4 p-4">
        <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
          <h5 class="fw-bold mb-0"><i class="bi bi-wallet2 me-2 text-primary"></i>Nhật Ký Giao Dịch Chuyển Khoản (Sepay VietQR)</h5>
          <div class="d-flex gap-2 ms-auto">
            <div class="input-group" style="width: 280px;">
              <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
              <input type="text" id="searchTransactions" class="form-control bg-light border-start-0" placeholder="Tìm kiếm giao dịch..." />
            </div>
            <button class="btn btn-sm btn-outline-success" data-bs-toggle="modal" data-bs-target="#addTransactionModal">
              Tự tạo giao dịch thủ công
            </button>
          </div>
        </div>
        <div class="table-responsive">
          <table class="table table-hover align-middle">
            <thead class="table-light">
              <tr>
                <th>Mã GD</th>
                <th>Số Đơn ĐK</th>
                <th>Học Viên</th>
                <th>Lớp Học</th>
                <th>Số Tiền Nhận</th>
                <th>Nội Dung Chuyển Khoản</th>
                <th>Thời Gian</th>
                <th>Trạng Thái</th>
              </tr>
            </thead>
            <tbody>
              <% transactions.forEach(t => { %>
                <tr>
                  <td><strong>GD#<%= t.MaGiaoDich %></strong></td>
                  <td>DK#<%= t.MaDangKy %></td>
                  <td class="fw-semibold"><%= t.TenHocVien %></td>
                  <td><%= t.TenLop %></td>
                  <td class="text-success fw-bold">+<%= Number(t.SoTien).toLocaleString('vi-VN') %>đ</td>
                  <td><code class="text-dark bg-light px-2 py-1 rounded"><%= (t.NoiDungChuyenKhoan || '').replace(/NONG\s*MINH\s*TUAN/gi, 'TRUNG TÂM ANH NGỮ Y&V') %></code></td>
                  <td><%= new Date(t.NgayGiaoDich).toLocaleString('vi-VN') %></td>
                  <td>
                    <span class="badge rounded-pill <%= t.TrangThai === 'Thành công' ? 'bg-success-subtle text-success' : t.TrangThai === 'Chờ duyệt' ? 'bg-info-subtle text-info' : 'bg-warning-subtle text-warning' %>">
                      <%= t.TrangThai %>
                    </span>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Add Enrollment Modal -->
      <div class="modal fade" id="addEnrollmentModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
          <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
            <div class="modal-header border-bottom bg-light py-3 px-4">
              <h5 class="modal-title fw-bold text-primary"><i class="bi bi-person-check-fill me-2"></i>Ghi danh & Thu tiền mặt tại quầy (Đăng ký Offline)</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="/admin/enrollments/add" method="POST" onsubmit="return confirm('Bạn có chắc chắn muốn xác nhận ghi danh và thu tiền mặt trực tiếp cho học viên này không?')">
              <div class="modal-body p-4">
                <div class="alert alert-info p-3 small mb-3 rounded-3 border-0 bg-info-subtle text-dark">
                  <i class="bi bi-info-circle-fill text-info me-1.5"></i> Dành cho học viên đăng ký và thanh toán trực tiếp tại quầy trung tâm. Hệ thống sẽ tự động <strong>Xếp lớp</strong>, kích hoạt trạng thái <strong>Thành công</strong> và khởi tạo <strong>Chứng từ thu tiền mặt</strong>.
                </div>
                <input type="hidden" name="StudentLevel" id="studentLevelHiddenInput" />
                <div class="mb-3">
                  <label class="form-label fw-semibold">Chọn học viên đăng ký <span class="text-danger">*</span></label>
                  <select class="form-select border-2" name="MaHocVien" id="selectStudentEnroll" required onchange="suggestClassesForSelectedStudent(this)">
                    <option value="">-- Chọn học viên --</option>
                    <% studentProfiles.forEach(s => { %>
                      <option value="<%= s.MaHocVien %>" data-trinhdo="<%= s.TrinhDoHienTai || '' %>" data-hoten="<%= s.HoTen %>"><%= s.HoTen %> - Trình độ: <%= s.TrinhDoHienTai || 'Chưa cập nhật' %></option>
                    <% }) %>
                  </select>
                </div>

                <!-- Alert gợi ý lớp học phù hợp với trình độ học viên -->
                <div id="enrollClassSuggestionAlert" class="alert alert-success p-2.5 small mb-3 rounded-3 border-0 bg-success-subtle text-success-emphasis d-none">
                  <i class="bi bi-lightbulb-fill me-1 fs-6"></i> <span id="enrollClassSuggestionText"></span>
                </div>

                <div class="mb-3">
                  <label class="form-label fw-semibold">Chọn lớp ghi danh (Đã tự động gợi ý theo trình độ)</label>
                  <select class="form-select border-2" name="MaLopHoc" id="selectClassEnroll" required>
                    <option value="">-- Chọn lớp ghi danh --</option>
                    <% classes.forEach(c => { 
                      const isClosed = (c.TrangThaiLop === 'Đã đóng' || c.TrangThaiLop === 'Kết thúc' || c.TrangThaiLop === 'Đã kết thúc');
                      const start = new Date(c.NgayKhaiGiang);
                      const end = new Date(c.NgayKetThuc);
                      const now = new Date();
                      const totalMs = end.getTime() - start.getTime();
                      const elapsedMs = now.getTime() - start.getTime();
                      let isLateExceeded = false;
                      let pctText = '';
                      if ((c.TrangThaiLop === 'Đang diễn ra' || (start <= now)) && totalMs > 0 && elapsedMs > 0) {
                        const pct = (elapsedMs / totalMs) * 100;
                        if (pct > 10) {
                          isLateExceeded = true;
                          pctText = ` (Khóa: Đăng ký trễ ${pct.toFixed(1)}% > 10% mốc giới hạn)`;
                        } else {
                          pctText = ` (Đang diễn ra ${pct.toFixed(1)}% ≤ 10% mốc đăng ký trễ)`;
                        }
                      }
                    %>
                      <option value="<%= c.MaLopHoc %>" data-capdo="<%= c.CapDo || '' %>" data-tenlop="<%= c.TenLop || '' %>" data-tenkhoahoc="<%= c.TenKhoaHoc || '' %>" <%= (isClosed || isLateExceeded) ? 'disabled' : '' %>>
                        <%= c.TenLop %> - <%= c.TenKhoaHoc %> (Sĩ số: <%= c.SiSoHienTai %>/<%= c.SiSoToiDa %>)<%= isClosed ? ' (Khóa: Lớp đã đóng)' : pctText %>
                      </option>
                    <% }) %>
                  </select>
                </div>
                <div class="mb-3">
                  <label class="form-label fw-semibold">Áp dụng mã khuyến mãi (nếu có)</label>
                  <select class="form-select border-2" name="MaKhuyenMai">
                    <option value="">Không áp dụng</option>
                    <% promotions.forEach(p => { %>
                      <option value="<%= p.MaKhuyenMai %>"><%= p.TenKhuyenMai %> (-<%= p.PhanTramGiam %>%)</option>
                    <% }) %>
                  </select>
                </div>
              </div>
              <div class="modal-footer border-top bg-light px-4 py-3">
                <button type="button" class="btn btn-outline-secondary rounded-3" data-bs-dismiss="modal">Đóng</button>
                <button type="submit" class="btn btn-primary fw-bold px-4 rounded-3 shadow-sm"><i class="bi bi-cash-stack me-2"></i>Ghi danh & Thu tiền mặt</button>
              </div>
            </form>
          </div>
        </div>
      </div>

      <!-- Add Transaction Modal -->
      <div class="modal fade" id="addTransactionModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
          <div class="modal-content border-0 rounded-3 shadow">
            <div class="modal-header border-0 bg-light">
              <h5 class="modal-title fw-bold">Tạo giao dịch thủ công</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="/admin/transactions/add" method="POST" onsubmit="return confirm('Bạn có chắc chắn muốn tạo giao dịch thủ công này không?')">
              <div class="modal-body p-4">
                <div class="mb-3">
                  <label class="form-label fw-semibold">Chọn đơn đăng ký (Chờ đóng tiền)</label>
                  <select class="form-select" name="MaDangKy" required>
                    <% enrollments.forEach(e => { %>
                      <option value="<%= e.MaDangKy %>">DK#<%= e.MaDangKy %> - Học viên: <%= e.TenHocVien %> (<%= e.TenLop %>) - Cần đóng: <%= Number(e.HocPhiDaGiam).toLocaleString('vi-VN') %>đ</option>
                    <% }) %>
                  </select>
                </div>
                <div class="mb-3">
                  <label class="form-label fw-semibold">Số tiền nhận thực tế (đ)</label>
                  <input type="number" class="form-control" name="SoTien" required />
                </div>
                <div class="mb-3">
                  <label class="form-label fw-semibold">Cú pháp/Nội dung chuyển khoản</label>
                  <input type="text" class="form-control" name="NoiDungChuyenKhoan" placeholder="Sử dụng đối soát: MANUAL_TRANSFER..." required />
                </div>
                <div class="mb-3">
                  <label class="form-label fw-semibold">Trạng thái</label>
                  <select class="form-select" name="TrangThai">
                    <option value="Thành công">Thành công</option>
                    <option value="Chờ thanh toán">Chờ thanh toán</option>
                  </select>
                </div>
              </div>
              <div class="modal-footer border-0">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Đóng</button>
                <button type="submit" class="btn btn-primary">Lưu giao dịch</button>
              </div>
            </form>
          </div>
        </div>
      </div>
    <% } %>

    <!-- TAB 8: PROMOTIONS -->
    <% if (activeTab === 'promotions') { %>
      <div class="card border-0 shadow-sm rounded-4 p-4">
        <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
          <h5 class="fw-bold mb-0"><i class="bi bi-tags-fill me-2 text-primary"></i>Quản lý Chương Trình Khuyến Mãi</h5>
          <div class="d-flex gap-2 ms-auto align-items-center flex-wrap">
            <!-- Thanh Sắp Xếp Khuyến Mãi -->
            <div class="input-group" style="width: 230px;">
              <span class="input-group-text bg-light border-end-0"><i class="bi bi-sort-down text-primary"></i></span>
              <select id="sortPromotions" class="form-select bg-light border-start-0 fw-semibold" onchange="sortPromotionsTable(this.value)">
                <option value="newest" selected>Mới nhất ➔ Cũ nhất</option>
                <option value="oldest">Cũ nhất ➔ Mới nhất</option>
                <option value="discount-desc">% Giảm cao nhất</option>
                <option value="discount-asc">% Giảm thấp nhất</option>
              </select>
            </div>
            <!-- Thanh Tìm Kiếm -->
            <div class="input-group" style="width: 250px;">
              <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
              <input type="text" id="searchPromotions" class="form-control bg-light border-start-0" placeholder="Tìm kiếm khuyến mãi..." />
            </div>
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addPromoModal">
              <i class="bi bi-plus-circle-fill me-2"></i>Tạo mã khuyến mãi mới
            </button>
          </div>
        </div>
        <div class="table-responsive">
