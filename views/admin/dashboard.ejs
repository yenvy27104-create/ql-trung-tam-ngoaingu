                    <tr>
                      <td class="fw-semibold">DK#<%= t.MaDangKy %></td>
                      <td class="text-success fw-bold"><%= Number(t.SoTien).toLocaleString('vi-VN') %>đ</td>
                      <td><%= new Date(t.NgayGiaoDich).toLocaleDateString('vi-VN') %></td>
                    </tr>
