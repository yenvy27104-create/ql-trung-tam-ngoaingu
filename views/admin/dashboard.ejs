<script>
function autoSelectCapDoByCourseName(nameInput) {
  const form = nameInput.closest('form');
  if (!form) return;
  const capDoSelect = form.querySelector('[name="CapDo"]');
  const thoiLuongInput = form.querySelector('[name="ThoiLuong"]');
  if (!capDoSelect) return;

  const val = (nameInput.value || '').toLowerCase().trim();
  if (!val) return;

  const isToeicC = /\btoeic\s+c(?![a-zA-Zàáảãạâầấẩẫậăằắẳẵặèéẻẽẹêềếểễệđìíỉĩịòóỏõọôồốổỗộơờớởỡợùúủũụưừứửữựỳýỷỹỵ])/i.test(val);
  const isToeicB = /\btoeic\s+b(?![a-zA-Zàáảãạâầấẩẫậăằắẳẵặèéẻẽẹêềếểễệđìíỉĩịòóỏõọôồốổỗộơờớởỡợùúủũụưừứửữựỳýỷỹỵ])/i.test(val);
  const isToeicA = /\btoeic\s+a(?![a-zA-Zàáảãạâầấẩẫậăằắẳẵặèéẻẽẹêềếểễệđìíỉĩịòóỏõọôồốổỗộơờớởỡợùúủũụưừứửữựỳýỷỹỵ])/i.test(val);

  // 1. Cấp tốc / Bứt tốc
  if (val.includes('cấp tốc') || val.includes('cap toc') || val.includes('bứt tốc')) {
    capDoSelect.value = 'Cấp tốc';
    if (thoiLuongInput && !thoiLuongInput.dataset.userEdited && !thoiLuongInput.value) thoiLuongInput.value = 24;
  }
  // 2. Luyện đề / Giải đề
  else if (val.includes('luyện đề') || val.includes('luyen de') || val.includes('giải đề') || val.includes('giai de')) {
    capDoSelect.value = 'Luyện đề';
    if (thoiLuongInput && !thoiLuongInput.dataset.userEdited && !thoiLuongInput.value) thoiLuongInput.value = 14;
  }
  // 3. TOEIC C / Cao cấp / 850+ / (700-800) / C1 / Advanced
  else if (isToeicC || val.includes('850') || val.includes('800') || val.includes('900') || val.includes('700-800') || val.includes('700-850') || val.includes('c1') || val.includes('advanced') || val.includes('cao cấp')) {
    capDoSelect.value = '850+';
    if (thoiLuongInput && !thoiLuongInput.dataset.userEdited && !thoiLuongInput.value) thoiLuongInput.value = 26;
  }
  // 4. TOEIC B / Trung cấp / 650+ / (550-650) / (600-650) / B2
  else if (isToeicB || val.includes('650') || val.includes('600') || val.includes('550-650') || val.includes('600-650') || val.includes('b2') || val.includes('trung cấp')) {
    capDoSelect.value = '650+';
    if (thoiLuongInput && !thoiLuongInput.dataset.userEdited && !thoiLuongInput.value) thoiLuongInput.value = 26;
  }
  // 5. TOEIC A / Sơ cấp / 450+ / (450-500) / B1
  else if (isToeicA || val.includes('450') || val.includes('500') || val.includes('450-500') || val.includes('sơ cấp') || val.includes('b1')) {
    capDoSelect.value = '450+';
    if (thoiLuongInput && !thoiLuongInput.dataset.userEdited && !thoiLuongInput.value) thoiLuongInput.value = 26;
  }
  // 6. Pre-TOEIC / Nền tảng / Foundation / (0-300) / A1 / Mất gốc
  else if (val.includes('pre') || val.includes('foundation') || val.includes('mất gốc') || val.includes('nền tảng') || val.includes('300') || val.includes('a1') || val.includes('breakthrough')) {
    capDoSelect.value = 'Foundation';
    if (thoiLuongInput && !thoiLuongInput.dataset.userEdited && !thoiLuongInput.value) thoiLuongInput.value = 24;
  }
}

function autoSuggestRoadmapScores(elem) {
  const form = elem.closest('form');
  if (!form) return;

  const loaiSelect = form.querySelector('[name="LoaiLoTrinh"]');
  const khoaSelect = form.querySelector('[name="MaKhoaHoc"]');
  const diemTuInput = form.querySelector('[name="DiemTu"]');
  const diemDenInput = form.querySelector('[name="DiemDen"]');
  const moTaInput = form.querySelector('[name="MoTa"]');

  if (!khoaSelect || !diemTuInput || !diemDenInput) return;

  const selectedOpt = khoaSelect.options[khoaSelect.selectedIndex];
  if (!selectedOpt || !selectedOpt.value) return;

  const courseName = (selectedOpt.text || '').toLowerCase();

  const isCapToc = courseName.includes('cấp tốc') || courseName.includes('cap toc') || courseName.includes('bứt tốc');
  const isLuyenDe = courseName.includes('luyện đề') || courseName.includes('luyen de') || courseName.includes('giải đề');

  const isToeicC = /\btoeic\s+c(?![a-zA-Zàáảãạâầấẩẫậăằắẳẵặèéẻẽẹêềếểễệđìíỉĩịòóỏõọôồốổỗộơờớởỡợùúủũụưừứửữựỳýỷỹỵ])/i.test(courseName);
  const isToeicB = /\btoeic\s+b(?![a-zA-Zàáảãạâầấẩẫậăằắẳẵặèéẻẽẹêềếểễệđìíỉĩịòóỏõọôồốổỗộơờớởỡợùúủũụưừứửữựỳýỷỹỵ])/i.test(courseName);
  const isToeicA = /\btoeic\s+a(?![a-zA-Zàáảãạâầấẩẫậăằắẳẵặèéẻẽẹêềếểễệđìíỉĩịòóỏõọôồốổỗộơờớởỡợùúủũụưừứửữựỳýỷỹỵ])/i.test(courseName);

  // 1. Cấp tốc / Bứt tốc
  if (isCapToc) {
    if (loaiSelect && loaiSelect.value !== 'Cấp tốc') {
      loaiSelect.value = 'Cấp tốc';
    }
    diemTuInput.value = 400;
    diemDenInput.value = 500;
    if (moTaInput) {
      moTaInput.value = 'Học cường độ cao. Tổng ôn kiến thức cốt lõi và luyện kỹ năng quét nhanh các dạng bài.';
    }
  }
  // 2. Luyện đề / Giải đề
  else if (isLuyenDe) {
    if (loaiSelect && loaiSelect.value !== 'Cấp tốc') {
      loaiSelect.value = 'Cấp tốc';
    }
    diemTuInput.value = 500;
    diemDenInput.value = 900;
    if (moTaInput) {
      moTaInput.value = 'Thực hành giải đề liên tục dưới áp lực thời gian thực, chữa chi tiết lỗi sai và tối ưu chiến thuật phòng thi.';
    }
  }
  // 3. Pre-TOEIC / Nền tảng / Mất gốc / 300+
  else if (courseName.includes('pre') || courseName.includes('nền tảng') || courseName.includes('300') || courseName.includes('mất gốc')) {
    if (loaiSelect && loaiSelect.value === 'Cấp tốc') {
      loaiSelect.value = 'Tiêu chuẩn';
    }
    const loaiStr = loaiSelect ? (loaiSelect.value || 'Tiêu chuẩn') : 'Tiêu chuẩn';
    diemTuInput.value = 0;
    diemDenInput.value = (loaiStr === 'Mất gốc') ? 350 : 300;
    if (moTaInput) {
      moTaInput.value = 'Lấy lại gốc ngữ pháp, xây dựng từ vựng căn bản và chuẩn hóa phát âm.';
    }
  }
  // 4. TOEIC A / Sơ cấp (Input 300-350)
  else if (isToeicA || courseName.includes('sơ cấp') || courseName.includes('450')) {
    if (loaiSelect && loaiSelect.value === 'Cấp tốc') {
      loaiSelect.value = 'Tiêu chuẩn';
    }
    diemTuInput.value = 300;
    diemDenInput.value = 450;
    if (moTaInput) {
      moTaInput.value = 'Làm quen cấu trúc đề thi. Nắm vững mẹo làm phần nghe dễ (Part 1, 2) và cấu trúc ngữ pháp Part 5.';
    }
  }
  // 5. TOEIC B / Trung cấp (Input 450-500)
  else if (isToeicB || courseName.includes('trung cấp') || courseName.includes('600') || courseName.includes('650')) {
    if (loaiSelect && loaiSelect.value === 'Cấp tốc') {
      loaiSelect.value = 'Tiêu chuẩn';
    }
    diemTuInput.value = 450;
    diemDenInput.value = 600;
    if (moTaInput) {
      moTaInput.value = 'Phát triển kỹ năng nghe bắt từ khóa đoạn hội thoại (Part 3, 4) và đọc hiểu văn bản dài (Part 6, 7).';
    }
  }
  // 6. TOEIC C / Cao cấp (Input 550-650)
  else if (isToeicC || courseName.includes('cao cấp') || courseName.includes('700') || courseName.includes('800') || courseName.includes('850')) {
    if (loaiSelect && loaiSelect.value === 'Cấp tốc') {
      loaiSelect.value = 'Tiêu chuẩn';
    }
    diemTuInput.value = 550;
    diemDenInput.value = 800;
    if (moTaInput) {
      moTaInput.value = 'Xử lý bẫy ngữ pháp khó, mở rộng từ vựng chuyên sâu về kinh tế và tối ưu hóa thời gian làm bài.';
    }
  }
}

function validateEditSiSoToiDa(classId, currentCount) {
  const inputEl = document.getElementById(`editSiSoToiDa_${classId}`);
  const errEl = document.getElementById(`sisoError_${classId}`);
  const submitBtn = document.getElementById(`editSubmitBtn_${classId}`);
  if (!inputEl) return;

  const val = parseInt(inputEl.value || '0');
  if (val < currentCount) {
    if (errEl) errEl.classList.remove('d-none');
    inputEl.classList.add('border-danger', 'is-invalid');
    if (submitBtn) submitBtn.disabled = true;
  } else {
    if (errEl) errEl.classList.add('d-none');
    inputEl.classList.remove('border-danger', 'is-invalid');
    if (submitBtn) submitBtn.disabled = false;
  }
}

function handleEditClassSubmit(event, classId, currentCount, defaultStartDate) {
  const form = event.target || document.getElementById(`editClassForm_${classId}`);
  if (!form) return true;

  const statusInput = form.querySelector('[name="TrangThaiLop"]');
  const statusVal = statusInput ? statusInput.value : '';

  const startDateInput = form.querySelector('[name="NgayKhaiGiang"]');
  const startDateStr = (startDateInput && startDateInput.value) || form.dataset?.startDate || defaultStartDate;

  const endDateInput = form.querySelector('[name="NgayKetThuc"]');
  const endDateStr = (endDateInput && endDateInput.value) || form.dataset?.endDate;

  const maxCapInput = document.getElementById(`editSiSoToiDa_${classId}`) || form.querySelector('[name="SiSoToiDa"]');
  const maxCapVal = maxCapInput ? parseInt(maxCapInput.value || '0', 10) : 0;

  const oldMaxCap = parseInt(form.dataset?.oldMax || '0', 10);
  const roomCap = parseInt(form.dataset?.roomCap || '999', 10);
  const roomName = form.dataset?.roomName || 'Phòng học';
  const sessCount = parseInt(form.dataset?.sessCount || '0', 10);

  // BẮT LỖI 0: Lớp đang diễn ra -> Không cho phép thay đổi Ngày khai giảng
  if (statusVal === 'Đang diễn ra' && defaultStartDate && startDateStr && startDateStr !== defaultStartDate) {
    const errorMsg = `Lớp học đang diễn ra, không được sửa thời gian và phòng học!`;
    if (typeof Swal !== 'undefined') {
      Swal.fire({ icon: 'error', title: 'Lớp đang diễn ra', text: errorMsg, confirmButtonColor: '#e74c3c' });
    } else {
      alert(errorMsg);
    }
    return false;
  }

  // BẮT LỖI 1: Check SiSoToiDa < SiSoHienTai
  if (maxCapVal < currentCount) {
    const errorMsg = `Cập nhật thất bại: Sĩ số tối đa mới (${maxCapVal}) không được nhỏ hơn số học viên hiện tại đang có trong lớp (${currentCount}).`;
    if (typeof Swal !== 'undefined') {
      Swal.fire({ icon: 'error', title: 'Cập nhật thất bại', text: errorMsg, confirmButtonColor: '#e74c3c' });
    } else {
      alert(errorMsg);
    }
    return false;
  }

  // BẮT LỖI KHI CÓ THAY ĐỔI SĨ SỐ TỐI ĐA (maxCapVal !== oldMaxCap)
  if (maxCapVal !== oldMaxCap) {
    const startDateObj = startDateStr ? new Date(startDateStr) : null;
    const endDateObj = endDateStr ? new Date(endDateStr) : null;
    const today = new Date();
    today.setHours(0, 0, 0, 0);

    // TRƯỜNG HỢP 1: Lớp học đã diễn ra từ 10% số buổi / thời lượng khóa học -> KHÔNG CHO SỬA SĨ SỐ
    let isPassed10 = false;
    if (startDateObj && startDateObj <= today) {
      if (sessCount >= 3) {
        isPassed10 = true;
      } else if (endDateObj) {
        const totalMs = endDateObj.getTime() - startDateObj.getTime();
        const elapsedMs = today.getTime() - startDateObj.getTime();
        if (totalMs > 0 && (elapsedMs / totalMs) * 100 >= 10) {
          isPassed10 = true;
        }
      }
    }

    if (isPassed10) {
      const errorMsg = `Lớp học đã diễn ra từ 10% khóa học rồi! Không thể sửa sĩ số tối đa.`;
      if (typeof Swal !== 'undefined') {
        Swal.fire({ icon: 'error', title: 'Không thể sửa sĩ số', text: errorMsg, confirmButtonColor: '#e74c3c' });
      } else {
        alert(errorMsg);
      }
      return false;
    }

    // TRƯỜNG HỢP 3: Khi < 10% số buổi nhưng Sức chứa phòng KHÔNG ĐỦ -> BÁO LỖI SỨC CHỨA KHÔNG ĐỦ
    if (maxCapVal > roomCap) {
      const errorMsg = `Sức chứa của phòng học không đủ! (Phòng ${roomName} chỉ có sức chứa ${roomCap} chỗ, không đủ cho ${maxCapVal} học viên). Vui lòng chọn phòng lớn hơn!`;
      if (typeof Swal !== 'undefined') {
        Swal.fire({ icon: 'error', title: 'Sức chứa phòng không đủ', text: errorMsg, confirmButtonColor: '#e74c3c' });
      } else {
        alert(errorMsg);
      }
      return false;
    }

    // TRƯỜNG HỢP 2: Khi < 10% số buổi VÀ phòng còn sức chứa -> Cho phép gửi Form sau khi xác nhận SweetAlert!
  }

  if (!form.dataset.confirmed) {
    if (typeof Swal !== 'undefined') {
      Swal.fire({
        title: 'Xác nhận cập nhật',
        text: 'Bạn có chắc chắn muốn cập nhật thay đổi cho lớp học này không?',
        icon: 'question',
        showCancelButton: true,
        confirmButtonColor: '#3085d6',
        cancelButtonColor: '#6c757d',
        confirmButtonText: 'Đồng ý',
        cancelButtonText: 'Hủy'
      }).then((result) => {
        if (result.isConfirmed) {
          form.dataset.confirmed = 'true';
          form.submit();
        }
      });
      return false;
    }
  }

  delete form.dataset.confirmed;
  return true;
}

function handleEditRoomSubmit(event, roomId) {
  const form = document.getElementById(`editRoomForm_${roomId}`) || (event && event.target ? event.target.closest('form') : null);

  const roomNameInput = document.getElementById(`editTenPhong_${roomId}`) || (form && form.querySelector('[name="TenPhong"]'));
  const roomName = roomNameInput ? roomNameInput.value.trim() : 'Phòng';

  const roomCapInput = document.getElementById(`editSucChua_${roomId}`) || (form && form.querySelector('[name="SucChua"]'));
  const newCap = roomCapInput ? parseInt(roomCapInput.value || '0', 10) : 0;

  const maxClassSiSo = form ? parseInt(form.dataset?.maxSiso || '0', 10) : 0;

  if (maxClassSiSo > 0 && newCap < maxClassSiSo) {
    const errorMsg = `Sức chứa của phòng học không được nhỏ hơn sĩ số tối đa của lớp (Sĩ số tối đa: ${maxClassSiSo} học viên). Vui lòng chọn phòng khác hoặc điều chỉnh lại thông tin!`;
    if (typeof Swal !== 'undefined') {
      Swal.fire({ icon: 'error', title: 'Sức chứa phòng không đủ', text: errorMsg, confirmButtonColor: '#e74c3c' });
    } else {
      alert(errorMsg);
    }
    return false;
  }

  if (!form.dataset.confirmed) {
    if (typeof Swal !== 'undefined') {
      Swal.fire({
        title: 'Xác nhận cập nhật',
        text: 'Bạn có chắc chắn muốn cập nhật thay đổi cho phòng học này không?',
        icon: 'question',
        showCancelButton: true,
        confirmButtonColor: '#3085d6',
        cancelButtonColor: '#6c757d',
        confirmButtonText: 'Đồng ý',
        cancelButtonText: 'Hủy'
      }).then((result) => {
        if (result.isConfirmed) {
          form.dataset.confirmed = 'true';
          form.submit();
        }
      });
      return false;
    }
  }

  delete form.dataset.confirmed;
  return true;
}

function autoDetectClassProperties(nameInput) {
  const form = nameInput.closest('form');
  if (!form) return;

  const loaiLopSelect = form.querySelector('[name="LoaiLop"]');
  const maKhoaHocSelect = form.querySelector('[name="MaKhoaHoc"]');
  const val = (nameInput.value || '').trim();
  const valUpper = val.toUpperCase();

  // 1. Nhận diện Loại Lớp
  if (valUpper.startsWith('CT') || valUpper.includes('CẤP TỐC') || valUpper.includes('FAST')) {
    if (loaiLopSelect) {
      loaiLopSelect.value = 'Cấp tốc';
    }
  } else if (valUpper.startsWith('A') || valUpper.startsWith('B') || valUpper.startsWith('PRE') || valUpper.startsWith('DE')) {
    if (loaiLopSelect) {
      loaiLopSelect.value = 'Tiêu chuẩn';
    }
  }

  // 2. Nhận diện Thuộc Khóa Học (MaKhoaHoc)
  if (maKhoaHocSelect && valUpper) {
    const options = Array.from(maKhoaHocSelect.options);
    let matchedOption = null;

    if (valUpper.startsWith('A_') || /^A\d+/.test(valUpper) || valUpper === 'A' || valUpper.includes('TOEIC A')) {
      matchedOption = options.find(opt => opt.text.toUpperCase().includes('TOEIC A') || opt.text.includes('450'));
    } else if (valUpper.startsWith('B_') || /^B\d+/.test(valUpper) || valUpper === 'B' || valUpper.includes('TOEIC B')) {
      matchedOption = options.find(opt => opt.text.toUpperCase().includes('TOEIC B') || opt.text.includes('650'));
    } else if (valUpper.startsWith('CT_') || /^CT\d+/.test(valUpper) || valUpper.startsWith('CT') || valUpper.includes('CẤP TỐC')) {
      matchedOption = options.find(opt => opt.text.toUpperCase().includes('CẤP TỐC'));
    } else if (valUpper.startsWith('PRE_') || /^PRE\d+/.test(valUpper) || valUpper.startsWith('PRE')) {
      matchedOption = options.find(opt => opt.text.toUpperCase().includes('PRE') || opt.text.includes('300'));
    } else if (valUpper.startsWith('DE_') || /^DE\d+/.test(valUpper) || valUpper.startsWith('DE') || valUpper.includes('LUYỆN ĐỀ')) {
      matchedOption = options.find(opt => opt.text.toUpperCase().includes('LUYỆN ĐỀ') || opt.text.toUpperCase().includes('LUYEN DE'));
    } else if (valUpper.startsWith('C1_') || /^C1\d+/.test(valUpper) || valUpper.startsWith('C1') || valUpper.includes('ADVANCED')) {
      matchedOption = options.find(opt => opt.text.toUpperCase().includes('C1') || opt.text.toUpperCase().includes('CHUYÊN SÂU') || opt.text.toUpperCase().includes('ADVANCED'));
    }

    if (matchedOption) {
      maKhoaHocSelect.value = matchedOption.value;
      if (matchedOption.text.toUpperCase().includes('CẤP TỐC') && loaiLopSelect) {
        loaiLopSelect.value = 'Cấp tốc';
      }
      autoDetectClassTypeByCourse(maKhoaHocSelect);
    }
  }
}

function autoDetectClassTypeByCourse(courseSelect) {
  const form = courseSelect.closest('form');
  if (!form) return;
  const loaiLopSelect = form.querySelector('[name="LoaiLop"]');
  const displayBox = form.querySelector('#addClassSoBuoiHocDisplay');

  const selectedOpt = courseSelect.options[courseSelect.selectedIndex];
  if (!selectedOpt) return;
  const selectedText = (selectedOpt.text || '').toLowerCase();
  
  if (loaiLopSelect) {
    const isCapTocCourse = selectedText.includes('cấp tốc');
    Array.from(loaiLopSelect.options).forEach(opt => {
      if (isCapTocCourse) {
        if (opt.value === 'Tiêu chuẩn') opt.disabled = true;
        if (opt.value === 'Cấp tốc') opt.disabled = false;
      } else {
        if (opt.value === 'Cấp tốc') opt.disabled = true;
        if (opt.value === 'Tiêu chuẩn') opt.disabled = false;
      }
    });
    loaiLopSelect.value = isCapTocCourse ? 'Cấp tốc' : 'Tiêu chuẩn';
  }

  if (displayBox) {
    const thoiluong = selectedOpt.dataset ? selectedOpt.dataset.thoiluong : null;
    if (thoiluong) {
      displayBox.innerHTML = `<i class="bi bi-info-circle me-1 text-primary"></i>Tự động: ${thoiluong} buổi (theo Khóa học)`;
    } else {
      displayBox.innerHTML = `<i class="bi bi-info-circle me-1 text-primary"></i>Tự động lấy theo Khóa học`;
    }
  }
}

// Gợi ý lớp học phù hợp với trình độ khi chọn học viên trong modal Ghi danh Offline
function suggestClassesForSelectedStudent(studentSelect) {
  const selectedOpt = studentSelect.options[studentSelect.selectedIndex];
  const hiddenInput = document.getElementById('studentLevelHiddenInput');
  const alertBox = document.getElementById('enrollClassSuggestionAlert');
  const alertText = document.getElementById('enrollClassSuggestionText');
  const classSelect = document.getElementById('selectClassEnroll');

  if (!classSelect) return;

  // Cache HTML ban đầu của selectLopHoc nếu chưa có
  if (!classSelect.dataset.originalHtml) {
    classSelect.dataset.originalHtml = classSelect.innerHTML;
  }

  if (!selectedOpt || !selectedOpt.value) {
    if (hiddenInput) hiddenInput.value = '';
    if (alertBox) alertBox.classList.add('d-none');
    classSelect.innerHTML = classSelect.dataset.originalHtml;
    return;
  }

  const studentName = selectedOpt.getAttribute('data-hoten') || (selectedOpt.text || '').split(' - ')[0];
  const trinhDo = selectedOpt.getAttribute('data-trinhdo') || '';
  if (hiddenInput) hiddenInput.value = trinhDo;

  const tempDiv = document.createElement('select');
  tempDiv.innerHTML = classSelect.dataset.originalHtml;
  const allOptions = Array.from(tempDiv.querySelectorAll('option')).filter(opt => opt.value !== '');

  if (!allOptions.length) return;

  function isMatching(sLevel, cCapDo, cTenKhoaHoc, cTenLop) {
    if (!sLevel || sLevel.includes('Chưa cập nhật') || sLevel.includes('Chưa xác định')) return true;
    const s = sLevel.toLowerCase();
    const cap = (cCapDo || '').toLowerCase();
    const name = ((cTenKhoaHoc || '') + ' ' + (cTenLop || '')).toLowerCase();

    if (s.includes('mất gốc') || s.includes('0-200') || s.includes('foundation')) {
      return cap.includes('foundation') || cap.includes('300') || name.includes('foundation') || name.includes('300') || name.includes('pre');
    }
    if (s.includes('cơ bản') || s.includes('200-450')) {
      return cap.includes('300') || cap.includes('450') || cap.includes('foundation') || name.includes('300') || name.includes('450') || name.includes('toeic a') || name.includes('pre');
    }
    if (s.includes('trung cấp') || s.includes('450-650')) {
      return cap.includes('450') || cap.includes('650') || name.includes('450') || name.includes('650') || name.includes('toeic a') || name.includes('toeic b');
    }
    if (s.includes('nâng cao') || s.includes('650-850')) {
      return cap.includes('650') || cap.includes('850') || cap.includes('luyện đề') || name.includes('650') || name.includes('850') || name.includes('toeic b') || name.includes('c1') || name.includes('luyện đề');
    }
    if (s.includes('cao cấp') || s.includes('850-990')) {
      return cap.includes('850') || cap.includes('c1') || cap.includes('advanced') || name.includes('850') || name.includes('c1') || name.includes('luyện đề');
    }
    if (s.includes('cấp tốc')) {
      return cap.includes('cấp tốc') || name.includes('cấp tốc') || name.includes('ct');
    }
    return cap.includes(s) || name.includes(s);
  }

  const matchedOptions = [];
  const otherOptions = [];

  allOptions.forEach(opt => {
    const capdo = opt.getAttribute('data-capdo') || '';
    const tenlop = opt.getAttribute('data-tenlop') || '';
    const tenkhoahoc = opt.getAttribute('data-tenkhoahoc') || '';
    
    if (isMatching(trinhDo, capdo, tenkhoahoc, tenlop)) {
      matchedOptions.push(opt);
    } else {
      otherOptions.push(opt);
    }
  });

  let newHtml = '<option value="">-- Chọn lớp ghi danh --</option>';

  if (matchedOptions.length > 0 && trinhDo && !trinhDo.includes('Chưa')) {
    newHtml += `<optgroup label="⭐ LỚP PHÙ HỢP GỢI Ý (Trình độ: ${trinhDo})">`;
    matchedOptions.forEach(opt => {
      const clone = opt.cloneNode(true);
      if (!clone.text.startsWith('⭐')) {
        clone.text = '⭐ [GỢI Ý] ' + clone.text;
      }
      newHtml += clone.outerHTML;
    });
    newHtml += '</optgroup>';

    if (otherOptions.length > 0) {
      newHtml += '<optgroup label="📋 CÁC LỚP HỌC KHÁC">';
      otherOptions.forEach(opt => {
        const clone = opt.cloneNode(true);
        newHtml += clone.outerHTML;
      });
      newHtml += '</optgroup>';
    }
  } else {
    allOptions.forEach(opt => {
      newHtml += opt.outerHTML;
    });
  }

  classSelect.innerHTML = newHtml;

  // Tự động chọn lớp đầu tiên trong nhóm gợi ý
  let firstSelectableVal = '';
  if (matchedOptions.length > 0) {
    firstSelectableVal = matchedOptions[0].value;
  } else if (allOptions.length > 0) {
    firstSelectableVal = allOptions[0].value;
  }
  if (firstSelectableVal) {
    classSelect.value = firstSelectableVal;
  }

  // Cập nhật thông báo alert
  if (alertBox && alertText) {
    alertBox.classList.remove('d-none');
    if (!trinhDo || trinhDo.includes('Chưa')) {
      alertText.innerHTML = `Học viên <strong>${studentName}</strong> chưa cập nhật trình độ đầu vào. Đã hiển thị toàn bộ danh sách lớp.`;
      alertBox.className = 'alert alert-warning p-2.5 small mb-3 rounded-3 border-0 bg-warning-subtle text-warning-emphasis';
    } else if (matchedOptions.length > 0) {
      alertText.innerHTML = `Đã tìm thấy <strong>${matchedOptions.length} lớp</strong> phù hợp với trình độ <strong>${trinhDo}</strong> của học viên <strong>${studentName}</strong>. Hệ thống đã tự động gợi ý & chọn lớp tốt nhất!`;
      alertBox.className = 'alert alert-success p-2.5 small mb-3 rounded-3 border-0 bg-success-subtle text-success-emphasis';
    } else {
      alertText.innerHTML = `Hiện chưa có lớp mở đúng với trình độ <strong>${trinhDo}</strong>. Bạn có thể tham khảo thêm các lớp học khác ở bên dưới.`;
      alertBox.className = 'alert alert-info p-2.5 small mb-3 rounded-3 border-0 bg-info-subtle text-info-emphasis';
    }
  }
}

// Trigger initial update for Add Class Modal on DOM content loaded
document.addEventListener('DOMContentLoaded', () => {
  const addClassSelect = document.querySelector('#addClassModal select[name="MaKhoaHoc"]');
  if (addClassSelect) {
    autoDetectClassTypeByCourse(addClassSelect);
  }

  const addEnrollmentModalEl = document.getElementById('addEnrollmentModal');
  if (addEnrollmentModalEl) {
    addEnrollmentModalEl.addEventListener('shown.bs.modal', () => {
      const studentSelect = document.getElementById('selectStudentEnroll');
      if (studentSelect && studentSelect.value) {
        suggestClassesForSelectedStudent(studentSelect);
      }
    });
  }
});

// Hiển thị/ẩn field nhập lý do ngừng học
function toggleReasonField(selectElement, dkId) {
  const newStatus = selectElement.value;
  const reasonField = document.getElementById(`reasonField${dkId}`);
  const reasonInput = document.getElementById(`reasonInput${dkId}`);
  
  if (newStatus === 'Ngừng học') {
    reasonField.style.display = 'block';
    if (reasonInput) reasonInput.focus();
  } else {
    reasonField.style.display = 'none';
    if (reasonInput) reasonInput.value = '';
  }
}
