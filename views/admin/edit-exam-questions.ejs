<%- include('../layouts/header.ejs') %>

<div class="container-fluid py-4" style="background-color: #f8f9fa; min-height: 100vh;">
  <div class="container">
    <!-- Header & Navigation -->
    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
      <div>
        <a href="<%= user.TenVaiTro === 'Admin' ? '/admin/dashboard?tab=exams' : '/classes/dashboard?tab=practice' %>" class="btn btn-outline-secondary btn-sm rounded-pill mb-2">
          <i class="bi bi-arrow-left me-1"></i>Quay lại danh sách đề thi
        </a>
        <h3 class="fw-bold text-dark mb-0">
          <i class="bi bi-journal-text text-primary me-2"></i>Chỉnh sửa Chi tiết Câu hỏi & Đáp án
        </h3>
        <p class="text-muted mb-0 small">Đề thi: <strong><%= exam.TenDeThi %></strong> (#<%= exam.MaDeThi %>) | File: <code class="text-primary"><%= exam.DuongDanFileJSON %></code></p>
      </div>

      <style>
        .question-card-item .card-body { display: none; }
        .question-card-item.expanded .card-body { display: block !important; }
        .question-card-item .card-header { cursor: pointer; user-select: none; }
        .question-card-item .card-header:hover { background-color: #e9ecef !important; }
        .card-toggle-icon { transition: transform 0.2s; }
        .question-card-item.expanded .card-toggle-icon { transform: rotate(90deg); }
      </style>

      <div>
        <button type="button" onclick="confirmSaveExamQuestions()" class="btn btn-primary btn-lg rounded-3 fw-bold px-4 shadow-sm">
          <i class="bi bi-cloud-upload me-2"></i>Lưu Tất Cả
        </button>
      </div>
    </div>

    <!-- Cấu hình chung -->
    <form id="metaForm">
      <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">
          <h5 class="fw-bold text-primary mb-3"><i class="bi bi-gear-fill me-2"></i>Cấu hình chung của Đề thi</h5>
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label fw-semibold">Tên đề thi</label>
              <input type="text" id="examTitle" class="form-control" value="<%= testData.title || exam.TenDeThi %>" required />
            </div>
            <div class="col-md-3">
              <label class="form-label fw-semibold">Thời gian (Phút)</label>
              <input type="number" id="examDuration" class="form-control" value="<%= testData.duration || exam.ThoiGianLamBai %>" required min="1" />
            </div>
            <div class="col-md-3">
              <label class="form-label fw-semibold">Phân loại</label>
              <input type="text" class="form-control bg-light" value="<%= testData.type || exam.LoaiDe %>" readonly />
            </div>
            <div class="col-12">
              <label class="form-label fw-semibold">File nghe chung (Audio URL)</label>
              <input type="text" id="examAudio" class="form-control" value="<%= testData.audio || '' %>" placeholder="https://... hoặc /uploads/..." />
            </div>
          </div>
        </div>
      </div>
    </form>

    <!-- Thanh điều hướng Part -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 sticky-top bg-white" style="top: 15px; z-index: 1020;">
      <div class="card-body p-3 d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div class="d-flex align-items-center gap-1 flex-wrap" id="partFilterGroup">
          <span class="fw-semibold text-muted me-2 small"><i class="bi bi-layers me-1"></i>Trang:</span>
          <% [1,2,3,4,5,6,7].forEach(p => { %>
            <button type="button" class="btn btn-sm <%= p === 1 ? 'btn-primary active' : 'btn-outline-secondary' %> rounded-pill px-3 part-filter-btn fw-medium" id="btn-filter-part-<%= p %>" onclick="changePart(<%= p %>)">Part <%= p %></button>
          <% }) %>
          <div class="vr mx-1 d-none d-md-block"></div>
          <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3 part-filter-btn" id="btn-filter-part-all" onclick="changePart('all')">Tất cả</button>
        </div>

        <div class="d-flex align-items-center gap-2">
          <div class="input-group input-group-sm" style="width: 150px;">
            <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
            <input type="number" id="jumpQuestionInput" class="form-control" placeholder="Đến câu..." min="1" onchange="jumpToQuestion(this.value)" onkeyup="if(event.key==='Enter') jumpToQuestion(this.value)" />
          </div>
          <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3" onclick="toggleCollapseAll(this)">
            <i class="bi bi-arrows-expand me-1"></i>Mở rộng tất cả
          </button>
        </div>
      </div>
    </div>

    <!-- Tiêu đề danh sách -->
    <div class="d-flex align-items-center justify-content-between mb-3 px-1">
      <h5 class="fw-bold text-dark mb-0">Danh sách <span id="questionCountBadge" class="badge bg-primary fs-6">0</span> câu hỏi</h5>
      <button type="button" class="btn btn-success fw-bold rounded-pill px-3 shadow-sm" onclick="addNewQuestionCard()">
        <i class="bi bi-plus-circle-fill me-1.5"></i>Thêm câu hỏi mới
      </button>
    </div>

    <!-- Vùng chứa HTML sẽ được render bằng JavaScript -->
    <div id="questionsContainer"></div>

    <!-- Phân trang -->
    <div class="d-flex align-items-center justify-content-between mb-5 mt-4">
      <button type="button" class="btn btn-outline-secondary btn-lg rounded-pill px-4" id="prevPartBtn" onclick="navigatePart(-1)" style="display: none;">
        <i class="bi bi-arrow-left me-2"></i>Về Part trước
      </button>
      <button type="button" class="btn btn-primary btn-lg rounded-pill px-4 shadow-sm ms-auto" id="nextPartBtn" onclick="navigatePart(1)">
        Sang Part tiếp theo <i class="bi bi-arrow-right ms-2"></i>
      </button>
    </div>

    <!-- Nút lưu cuối trang -->
    <div class="text-center py-4 border-top">
      <button type="button" onclick="confirmSaveExamQuestions()" class="btn btn-success btn-lg rounded-3 fw-bold px-5 shadow">
        <i class="bi bi-cloud-upload me-2"></i>Lưu Tất Cả Bài Thi
      </button>
    </div>

  </div>
</div>

<script>
  // Quản lý Dữ Liệu Toàn Cục (State Management)
  // Lấy dữ liệu từ Server, map các options về mảng chuẩn nếu cần
  let allQuestions = <%- JSON.stringify(testData.questions || []) %>;
  allQuestions.forEach(q => {
    if (q.options && typeof q.options === 'object' && !Array.isArray(q.options)) {
      q.options = Object.values(q.options);
    }
    if (!q.options || q.options.length < 4) {
      q.options = [q.options?.[0]||'', q.options?.[1]||'', q.options?.[2]||'', q.options?.[3]||''];
    }
  });

  let currentPartView = 1;
  window.isCollapsedAll = false;
  const saveActionUrl = "<%= user.TenVaiTro === 'Admin' ? '/admin/exams/save-questions/' + exam.MaDeThi : '/classes/exams/save-questions/' + exam.MaDeThi %>";

  // Hàm khởi chạy
  document.addEventListener('DOMContentLoaded', () => {
    const savedPart = sessionStorage.getItem('editExamActivePart');
    if (savedPart) {
      currentPartView = savedPart === 'all' ? 'all' : parseInt(savedPart);
      sessionStorage.removeItem('editExamActivePart');
    }
    renderUI();
  });

  // Đóng/Mở card
  function toggleQuestionCard(headerEl, event) {
    if (event && event.target.closest('button, select, input, label, a')) return;
    const card = headerEl.closest('.question-card-item');
    if (card) card.classList.toggle('expanded');
  }

  // Đóng/Mở tất cả card đang hiển thị
  function toggleCollapseAll(btn) {
    window.isCollapsedAll = !window.isCollapsedAll;
    document.querySelectorAll('.question-card-item').forEach(card => {
      window.isCollapsedAll ? card.classList.remove('expanded') : card.classList.add('expanded');
    });
    btn.innerHTML = window.isCollapsedAll 
      ? '<i class="bi bi-arrows-expand me-1"></i>Mở rộng tất cả' 
      : '<i class="bi bi-arrows-collapse me-1"></i>Thu gọn tất cả';
  }

  // LƯU Ý QUAN TRỌNG: Đồng bộ giao diện đang nhập vào biến State trước khi xóa thẻ HTML
  function syncDOMToState() {
    document.querySelectorAll('.question-card-item').forEach(card => {
      const idx = parseInt(card.dataset.idx); // Vị trí thật trong mảng allQuestions
      if (isNaN(idx)) return;
      
      allQuestions[idx].part = parseInt(card.querySelector('.q-part-select').value);
      allQuestions[idx].question = card.querySelector('.q-question-input').value;
      allQuestions[idx].passage = card.querySelector('.q-passage-input').value;
      allQuestions[idx].audio = card.querySelector('.q-audio-input').value;
      allQuestions[idx].image = card.querySelector('.q-image-input').value;
      
      allQuestions[idx].options = [
        card.querySelector('.q-opt-0').value,
        card.querySelector('.q-opt-1').value,
        card.querySelector('.q-opt-2').value,
        card.querySelector('.q-opt-3').value
      ];
      
      const ansChecked = card.querySelector('.q-ans-radio:checked');
      allQuestions[idx].answer = ansChecked ? ansChecked.value : 'A';
      allQuestions[idx].script = card.querySelector('.q-script-input').value;
      allQuestions[idx].explanation = card.querySelector('.q-explanation-input').value;
    });
  }

  // Render HTML cho Part hiện tại
  function renderUI() {
    const container = document.getElementById('questionsContainer');
    container.innerHTML = ''; // Dọn dẹp DOM cũ cho nhẹ bộ nhớ

    // Lọc các câu hỏi khớp với Part đang xem
    let htmlString = '';
    
    allQuestions.forEach((q, idx) => {
      const qPart = parseInt(q.part) || 1;
      if (currentPartView !== 'all' && qPart !== currentPartView) return;

      const currentAns = (q.answer || 'A').toUpperCase().trim();
      const isExpandedClass = window.isCollapsedAll ? '' : 'expanded';

      htmlString += `
        <div class="card border-0 shadow-sm rounded-4 mb-4 question-card-item ${isExpandedClass}" id="question-card-${idx}" data-idx="${idx}">
          <div class="card-header border-0 bg-light p-3 d-flex align-items-center justify-content-between flex-wrap gap-2" onclick="toggleQuestionCard(this, event)">
            <div class="d-flex align-items-center gap-2 flex-wrap">
              <i class="bi bi-chevron-right card-toggle-icon text-muted"></i>
              <span class="badge bg-primary rounded-pill px-3 py-1.5 fw-bold">Câu ${idx + 1}</span>
              <span class="small text-muted" style="max-width:350px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${(q.question || '').substring(0, 60)}</span>
              
              <div class="d-flex align-items-center gap-1" onclick="event.stopPropagation()">
                <span class="small fw-semibold text-muted">Part:</span>
                <select class="form-select form-select-sm py-0 px-2 q-part-select bg-white" style="width: auto;">
                  ${[1,2,3,4,5,6,7].map(p => `<option value="${p}" ${qPart === p ? 'selected' : ''}>Part ${p}</option>`).join('')}
                </select>
              </div>
            </div>
            <div class="d-flex align-items-center gap-2" onclick="event.stopPropagation()">
              <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3" onclick="event.stopPropagation(); removeQuestionCard(${idx})">
                <i class="bi bi-trash-fill me-1"></i>Xóa
              </button>
            </div>
          </div>

          <div class="card-body p-4">
            <div class="mb-3">
              <label class="form-label fw-semibold text-dark">Nội dung câu hỏi</label>
              <input type="text" class="form-control fw-medium q-question-input" value="${q.question || ''}" placeholder="Nhập nội dung câu hỏi..." />
            </div>

            <div class="mb-3">
              <label class="form-label fw-semibold text-secondary">Đoạn văn đọc hiểu (Passage)</label>
              <textarea class="form-control font-monospace text-dark q-passage-input" rows="3" placeholder="Nhập văn bản đọc hiểu (nếu có)...">${q.passage || ''}</textarea>
            </div>

            <div class="row g-3 mb-3">
              <div class="col-md-6">
                <label class="form-label fw-semibold text-secondary small"><i class="bi bi-volume-up me-1"></i>Audio URL</label>
                <input type="text" class="form-control form-control-sm q-audio-input" value="${q.audio || ''}" />
              </div>
              <div class="col-md-6">
                <label class="form-label fw-semibold text-secondary small"><i class="bi bi-image me-1"></i>Image URL</label>
                <input type="text" class="form-control form-control-sm q-image-input" value="${q.image || ''}" />
              </div>
            </div>

            <div class="mb-3">
              <label class="form-label fw-semibold text-dark">Các Lựa Chọn Đáp Án (Options)</label>
              <div class="row g-2">
                ${['A', 'B', 'C', 'D'].map((letter, optIdx) => `
                  <div class="col-md-6">
                    <div class="input-group input-group-sm">
                      <span class="input-group-text fw-bold bg-light">${letter}</span>
                      <input type="text" class="form-control q-opt-${optIdx}" value="${q.options[optIdx] || ''}" placeholder="Đáp án ${letter}" />
                    </div>
                  </div>
                `).join('')}
              </div>
            </div>

            <div class="bg-primary-subtle p-3 rounded-3 mb-3 border border-primary-subtle">
              <label class="form-label fw-bold text-primary mb-2"><i class="bi bi-check-circle-fill me-1"></i>Chọn Đáp Án Đúng:</label>
              <div class="d-flex gap-4 align-items-center flex-wrap">
                ${['A', 'B', 'C', 'D'].map(letter => `
                  <div class="form-check">
                    <input class="form-check-input q-ans-radio" type="radio" name="q_ans_${idx}" id="q_${idx}_ans_${letter}" value="${letter}" ${currentAns === letter ? 'checked' : ''}>
                    <label class="form-check-label fw-bold text-dark" for="q_${idx}_ans_${letter}">Đáp án ${letter}</label>
                  </div>
                `).join('')}
              </div>
            </div>

            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label fw-semibold text-primary small"><i class="bi bi-chat-left-text me-1"></i>Transcript</label>
                <textarea class="form-control form-control-sm q-script-input" rows="2">${q.script || q.transcript || ''}</textarea>
              </div>
              <div class="col-md-6">
                <label class="form-label fw-semibold text-warning small"><i class="bi bi-lightbulb me-1"></i>Explanation</label>
                <textarea class="form-control form-control-sm q-explanation-input" rows="2">${q.explanation || ''}</textarea>
              </div>
            </div>
          </div>
        </div>
      `;
    });

    container.innerHTML = htmlString;
    document.getElementById('questionCountBadge').textContent = allQuestions.length;
    updateUIControls();
  }

  function updateUIControls() {
    // 1. Cập nhật Tab Buttons
    document.querySelectorAll('.part-filter-btn').forEach(b => {
      b.classList.remove('btn-primary', 'active');
      b.classList.add('btn-outline-secondary');
    });
    
    const activeBtn = document.getElementById(currentPartView === 'all' ? 'btn-filter-part-all' : `btn-filter-part-${currentPartView}`);
    if (activeBtn) {
      activeBtn.classList.remove('btn-outline-secondary');
      activeBtn.classList.add('btn-primary', 'active');
    }

    // 2. Cập nhật nút Pagination
    const prevBtn = document.getElementById('prevPartBtn');
    const nextBtn = document.getElementById('nextPartBtn');
    
    if (currentPartView === 'all') {
      prevBtn.style.display = 'none';
      nextBtn.style.display = 'none';
    } else {
      prevBtn.style.display = currentPartView > 1 ? 'block' : 'none';
      if (currentPartView < 7) {
        nextBtn.style.display = 'block';
        nextBtn.innerHTML = `Sang Part ${currentPartView + 1} <i class="bi bi-arrow-right ms-2"></i>`;
      } else {
        nextBtn.style.display = 'none';
      }
      if(currentPartView > 1) {
        prevBtn.innerHTML = `<i class="bi bi-arrow-left me-2"></i> Về Part ${currentPartView - 1}`;
      }
    }
  }

  // Chuyển đổi Part (Lưu ý: Phải gọi syncDOMToState() trước khi đổi trang)
  function changePart(partNum) {
    syncDOMToState();
    currentPartView = partNum;
    renderUI();
    
    // Cuộn nhẹ lên đầu danh sách
    const stickyHeader = document.querySelector('.sticky-top');
    if (stickyHeader) {
      window.scrollTo({ top: stickyHeader.getBoundingClientRect().top + window.scrollY - 20, behavior: 'smooth' });
    }
  }

  function navigatePart(direction) {
    if (currentPartView === 'all') return;
    let targetPart = currentPartView + direction;
    if (targetPart >= 1 && targetPart <= 7) changePart(targetPart);
  }

  function jumpToQuestion(qNum) {
    if (!qNum) return;
    const targetIdx = parseInt(qNum) - 1;
    if (targetIdx >= 0 && targetIdx < allQuestions.length) {
      const targetPart = parseInt(allQuestions[targetIdx].part) || 1;
      
      // Nếu câu hỏi nằm ở Part khác, phải lưu trạng thái và chuyển trang
      if (currentPartView !== 'all' && targetPart !== currentPartView) {
        syncDOMToState();
        currentPartView = targetPart;
        renderUI();
      }

      // Cuộn tới
      setTimeout(() => {
        const targetCard = document.getElementById(`question-card-${targetIdx}`);
        if (targetCard) {
          targetCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
          targetCard.classList.add('border', 'border-3', 'border-primary', 'shadow-lg', 'expanded');
          setTimeout(() => targetCard.classList.remove('border', 'border-3', 'border-primary', 'shadow-lg'), 2500);
        }
      }, 100);
    }
  }

  function addNewQuestionCard() {
    syncDOMToState();
    const newPart = currentPartView !== 'all' ? currentPartView : 1;
    
    // Đẩy một Object trắng vào mảng gốc
    allQuestions.push({
      id: allQuestions.length + 1,
      part: newPart,
      question: '', passage: '', audio: '', image: '',
      options: ['', '', '', ''],
      answer: 'A', script: '', explanation: ''
    });

    renderUI(); // Vẽ lại giao diện cực nhanh

    setTimeout(() => {
      const cards = document.querySelectorAll('.question-card-item');
      if(cards.length > 0) {
        cards[cards.length - 1].scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    }, 100);
  }

  function removeQuestionCard(idx) {
    syncDOMToState();
    allQuestions.splice(idx, 1);
    
    // Cập nhật lại ID cho đồng bộ
    allQuestions.forEach((q, i) => q.id = i + 1);
    
    renderUI();
  }

  // Gửi API siêu tốc bằng Fetch và JSON Object
  async function confirmSaveExamQuestions() {
    syncDOMToState(); // Đảm bảo gom hết dữ liệu mới nhất trên DOM vào biến

    const executeSave = async () => {
      if (typeof Swal !== 'undefined') {
        Swal.fire({
          title: 'Đang lưu dữ liệu...',
          text: 'Vui lòng chờ (hệ thống xử lý tốc độ cao)...',
          allowOutsideClick: false,
          didOpen: () => { Swal.showLoading(); }
        });
      }

      try {
        const payload = {
          title: document.getElementById('examTitle').value,
          duration: parseInt(document.getElementById('examDuration').value) || 120,
          audio: document.getElementById('examAudio').value,
          questions: allQuestions // Mảng đã được đồng bộ chuẩn 100%
        };

        const response = await fetch(saveActionUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify(payload)
        });

        const result = await response.json();

        if (response.ok && result.success) {
          sessionStorage.setItem('editExamActivePart', currentPartView); 
          if (typeof Swal !== 'undefined') {
            await Swal.fire({ icon: 'success', title: 'Thành công!', text: 'Đã lưu toàn bộ thay đổi!', timer: 1500, showConfirmButton: false });
          } else {
            alert('Lưu thành công!');
          }
          window.location.reload();
        } else {
          throw new Error(result.message || 'Lỗi xử lý từ máy chủ.');
        }
      } catch (err) {
        if (typeof Swal !== 'undefined') {
          Swal.fire({ icon: 'error', title: 'Lỗi lưu bài thi!', text: err.message });
        } else {
          alert('Lỗi: ' + err.message);
        }
      }
    };

    if (typeof Swal !== 'undefined') {
      Swal.fire({
        title: 'Xác nhận lưu thay đổi',
        text: 'Lưu toàn bộ cấu hình đề thi này?',
        icon: 'question',
        showCancelButton: true,
        confirmButtonColor: '#3498db',
        cancelButtonColor: '#6c757d',
        confirmButtonText: 'Đồng ý',
        cancelButtonText: 'Hủy'
      }).then((result) => { if (result.isConfirmed) executeSave(); });
    } else {
      if (confirm('Lưu tất cả thay đổi đề thi?')) executeSave();
    }
  }
</script>

<%- include('../layouts/footer.ejs') %>