<%- include('../layouts/header') %>
<div class="row justify-content-center my-5">
  <div class="col-md-5">
    <div class="card border-0 rounded-3 shadow-sm p-4">
      <h3 class="fw-bold mb-3 text-center">Quên mật khẩu</h3>
      <p class="text-center text-muted mb-4">Nhập Email đã đăng ký, chúng tôi sẽ gửi mã xác nhận (OTP) cho bạn.</p>
      
      <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>

      <form method="POST" action="/auth/forgot-password">
        <div class="mb-4">
          <label class="form-label fw-semibold">Email của bạn</label>
          <input type="email" class="form-control" name="Email" required placeholder="name@example.com" />
        </div>
        <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">Nhận mã xác nhận</button>
      </form>
      <div class="text-center mt-3"><a href="/auth/login" class="text-decoration-none">Quay lại đăng nhập</a></div>
    </div>
  </div>
</div>
<%- include('../layouts/footer') %>
