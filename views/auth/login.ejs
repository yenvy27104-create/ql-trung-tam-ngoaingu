<%- include('../layouts/header') %>

<div class="row justify-content-center my-5">
  <div class="col-md-5">
    <div class="card border-0 rounded-3 shadow-sm p-4" style="background: #ffffff;">
      <div class="card-body">
        <h3 class="fw-bold mb-4 text-center">Đăng nhập tài khoản</h3>
        
        <% if (error) { %>
          <div class="alert alert-danger" role="alert">
            <%= error %>
          </div>
        <% } %>

        <% if (typeof message !== 'undefined' && message) { %>
          <div class="alert alert-success" role="alert">
            <%= message %>
          </div>
        <% } %>

        <form method="POST" action="/auth/login">
          <% if (typeof redirect !== 'undefined' && redirect) { %>
            <input type="hidden" name="redirect" value="<%= redirect %>" />
          <% } %>
          <div class="mb-3">
            <label class="form-label fw-semibold">Email</label>
            <input type="email" class="form-control" name="Email" required placeholder="name@example.com" />
          </div>
          <div class="mb-4">
            <div class="d-flex justify-content-between align-items-center mb-1">
              <label class="form-label fw-semibold mb-0">Mật khẩu</label>
              <a href="/auth/forgot-password" class="text-decoration-none small text-primary fw-semibold">Quên mật khẩu?</a>
            </div>
            <div class="input-group">
              <input type="password" class="form-control" name="MatKhau" id="loginPassword" required placeholder="••••••••" />
              <button class="btn btn-outline-secondary toggle-password" type="button" data-target="loginPassword">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-eye" viewBox="0 0 16 16">
                  <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5s3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5s-3.879-1.168-5.168-2.457A13 13 0 0 1 1.172 8z"/>
                  <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0"/>
                </svg>
              </button>
            </div>
          </div>
          <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">Đăng nhập</button>
          
          <div class="d-flex align-items-center mb-3">
            <hr class="flex-grow-1 m-0">
            <span class="px-3 text-muted small">hoặc</span>
            <hr class="flex-grow-1 m-0">
          </div>
          
          <a href="/auth/google<%= typeof redirect !== 'undefined' && redirect ? '?redirect=' + encodeURIComponent(redirect) : '' %>" class="btn btn-outline-dark w-100 py-2 fw-semibold d-flex justify-content-center align-items-center gap-2">
            <img src="https://upload.wikimedia.org/wikipedia/commons/c/c1/Google_%22G%22_logo.svg" alt="Google Logo" width="20" height="20">
            Đăng nhập với Google
          </a>
        </form>

        <hr class="my-4">
        <p class="text-center text-secondary small mb-0">
          Chưa có tài khoản? <a href="#" data-bs-toggle="modal" data-bs-target="#registerModal" class="text-decoration-none text-primary fw-semibold">Đăng ký ngay</a>
        </p>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('expired') || urlParams.get('reason') === 'session_expired' || <%= typeof isExpired !== 'undefined' && isExpired ? 'true' : 'false' %>) {
      if (typeof Swal !== 'undefined') {
        Swal.fire({
          icon: 'warning',
          title: 'Hết hạn phiên làm việc',
          html: 'Phiên làm việc của bạn đã hết hạn.<br>Hệ thống tự động chuyển về trang <b>Đăng nhập</b>. Vui lòng đăng nhập lại!',
          confirmButtonText: 'Đã hiểu',
          confirmButtonColor: '#0d6efd',
          customClass: {
            popup: 'rounded-4 shadow-lg'
          }
        });
      }
    }
  });
</script>

<%- include('../layouts/footer') %>
