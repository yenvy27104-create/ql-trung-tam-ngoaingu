<%- include('../layouts/header') %>
<div class="row justify-content-center my-5">
  <div class="col-md-5">
    <div class="card border-0 rounded-3 shadow-sm p-4">
      <h3 class="fw-bold mb-4 text-center">Tạo mật khẩu mới</h3>
      
      <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>

      <form method="POST" action="/auth/reset-password/<%= id %>">
        <div class="mb-3">
          <label class="form-label fw-semibold">Mật khẩu mới</label>
          <div class="input-group">
            <input type="password" class="form-control" name="password" id="resetPassword" required placeholder="••••••••" />
            <button class="btn btn-outline-secondary toggle-password" type="button" data-target="resetPassword">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-eye" viewBox="0 0 16 16">
                <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5s3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5s-3.879-1.168-5.168-2.457A13 13 0 0 1 1.172 8z"/>
                <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0"/>
              </svg>
            </button>
          </div>
        </div>
        <div class="mb-4">
          <label class="form-label fw-semibold">Xác nhận mật khẩu</label>
          <div class="input-group">
            <input type="password" class="form-control" name="confirmPassword" id="confirmResetPassword" required placeholder="••••••••" />
            <button class="btn btn-outline-secondary toggle-password" type="button" data-target="confirmResetPassword">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-eye" viewBox="0 0 16 16">
                <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5s3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5s-3.879-1.168-5.168-2.457A13 13 0 0 1 1.172 8z"/>
                <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0"/>
              </svg>
            </button>
          </div>
        </div>
        <button type="submit" class="btn btn-success w-100 py-2 fw-semibold">Lưu mật khẩu mới</button>
      </form>
    </div>
  </div>
</div>
<%- include('../layouts/footer') %>
